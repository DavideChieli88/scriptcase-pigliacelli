    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_sottoconti_flusso (societa_sga, conto_gruppo, conto, sottoconto),
    KEY idx_sottoconti_flusso (flusso_controllo_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COMMENT='Mappatura sottoconto SGA -> flusso controllo fattura';


