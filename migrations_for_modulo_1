-- Mappatura sottoconto contabile (SGA) -> flusso
-- conto_gruppo / conto / sottoconto da BaCliForInfoContabili
CREATE TABLE IF NOT EXISTS sottoconti_flusso (
    id INT(11) NOT NULL AUTO_INCREMENT,
    societa_sga INT(11) NOT NULL DEFAULT 1,
    conto_gruppo VARCHAR(20) NOT NULL,
    conto VARCHAR(20) NOT NULL,
    sottoconto VARCHAR(20) NOT NULL,
