    descrizione VARCHAR(255) NOT NULL,
    attivo TINYINT(1) NOT NULL DEFAULT 1,
    ordine INT(11) NOT NULL DEFAULT 0,
    PRIMARY KEY (id),
    UNIQUE KEY uq_tipi_doc_codice (codice)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;

