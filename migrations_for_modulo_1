-- =============================================================================
-- E) SEGREGAZIONE UTENTI PER SOCIETA
-- =============================================================================
-- Ogni utente ScriptCase vede solo le fatture delle societa' assegnate.
-- login = sec_users.login

CREATE TABLE IF NOT EXISTS utenti_societa (
    id INT(11) NOT NULL AUTO_INCREMENT,
    login VARCHAR(255) NOT NULL COMMENT 'sec_users.login',
    societa_id INT(11) NOT NULL COMMENT 'societa.id',
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_utenti_societa (login, societa_id),
    KEY idx_utenti_societa_login (login),
    KEY idx_utenti_societa_soc (societa_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COMMENT='Assegnazione utente -> societa visibili';


-- =============================================================================
-- F) FLUSSI CONTROLLO FATTURA (sottoconto -> tipo controllo)
