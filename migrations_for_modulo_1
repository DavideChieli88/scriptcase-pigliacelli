    fornitore_codice VARCHAR(50) NOT NULL,
    fornitore_id INT(11) DEFAULT NULL COMMENT 'FK fornitori.id',
    aperto CHAR(1) DEFAULT NULL COMMENT 'S/N',
    confermato CHAR(1) DEFAULT NULL COMMENT 'S/N',
    saldato CHAR(1) DEFAULT NULL COMMENT 'S/N',
    riferimento VARCHAR(255) DEFAULT NULL,
    note TEXT DEFAULT NULL,
    destinazione_ragione_sociale VARCHAR(255) DEFAULT NULL,
    destinazione_indirizzo VARCHAR(255) DEFAULT NULL,
    destinazione_localita VARCHAR(255) DEFAULT NULL,
    destinazione_cap VARCHAR(20) DEFAULT NULL,
    destinazione_provincia VARCHAR(10) DEFAULT NULL,
    destinazione_nazione VARCHAR(10) DEFAULT NULL,
    contratto_anno SMALLINT DEFAULT NULL,
    contratto_filiale VARCHAR(10) DEFAULT NULL,
    contratto_numero INT(11) DEFAULT NULL,
    confermato_data_ora DATETIME DEFAULT NULL,
    sga_update_data_ora DATETIME DEFAULT NULL COMMENT 'MaOrdiniForTestata.UPDATE_DATA_ORA',
