-- Allegati manuali operatore (contratti, cedolini, ricevute, ecc.)
CREATE TABLE IF NOT EXISTS fatture_passive_allegati (
    id INT(11) NOT NULL AUTO_INCREMENT,
    fattura_passiva_id INT(11) NOT NULL,
    tipo_documento_id INT(11) DEFAULT NULL COMMENT 'FK verso tipi_documento_fattura',
    tipo_documento_altro VARCHAR(255) DEFAULT NULL COMMENT 'Se tipo = Altro',
    nome_file VARCHAR(255) NOT NULL,
    percorso_file VARCHAR(500) NOT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    KEY idx_allegati_fattura (fattura_passiva_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COMMENT='Allegati manuali su fattura prima approvazione';


-- Tipologie documento per menu a tendina (Contratto, Cedolino, Ricevuta, Altro, ...)
CREATE TABLE IF NOT EXISTS tipi_documento_fattura (
    id INT(11) NOT NULL AUTO_INCREMENT,
