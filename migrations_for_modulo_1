-- =============================================================================
-- migrations_for_modulo_1
-- Database: pigliacelli (MySQL / MariaDB)
-- Scopo: allineare DEV -> UAT -> PROD per Modulo 1 (fatture passive)
--
-- Ordine esecuzione consigliato:
--   1) Sezione A (societa)
--   2) Sezione B (fornitori)
--   3) Sezione C (sec_settings chiavi modulo 1)
--   4) Sezione D (fatture_passive + allegati) — quando si attiva get_invoices
--   5) Sezione E (utenti <-> societa) — segregazione dati
--
-- Note:
--   - Usare CREATE TABLE IF NOT EXISTS dove possibile (idempotente).
--   - Gli ALTER in fondo sezione servono solo se le tabelle esistono gia'
--     con nomi colonna diversi (es. partita_iva vs piva).
--   - Dopo le migration: lanciare blank upsert_societa_and_fornitori per popolare dati.
--   - Charset allineato a subvettori esistente: utf8mb3
-- =============================================================================


-- =============================================================================
-- A) SOCIETA  (mappatura BaSocieta + Zucchetti Digitale)
-- =============================================================================
-- Campi previsti dal Modulo 1:
--   codice_sga      -> BaSocieta.CODICE
--   codice_zucchetti-> mappatura manuale verso Zucchetti (non sovrascritta da upsert)
--   piva            -> BaSocieta.PARTITA_IVA / match fatture
--   ragione_sociale -> BaSocieta.RAGIONE_SOCIALE
--   cod_fiscale     -> BaSocieta.CODICE_FISCALE

CREATE TABLE IF NOT EXISTS societa (
    id INT(11) NOT NULL AUTO_INCREMENT,
    codice_sga VARCHAR(50) NOT NULL COMMENT 'Codice societa su SGA (BaSocieta.CODICE)',
    ragione_sociale VARCHAR(255) DEFAULT NULL,
    piva VARCHAR(50) DEFAULT NULL COMMENT 'Partita IVA',
    cod_fiscale VARCHAR(50) DEFAULT NULL,
    codice_zucchetti VARCHAR(50) DEFAULT NULL COMMENT 'Codice/cessionario Zucchetti Digitale - compilazione manuale',
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_societa_codice_sga (codice_sga),
    KEY idx_societa_piva (piva),
    KEY idx_societa_codice_zucchetti (codice_zucchetti)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COMMENT='Societa del gruppo (SGA + mappatura Zucchetti)';


-- =============================================================================
-- B) FORNITORI  (sottoinsieme BaCliFor, modello subvettori)
-- =============================================================================
-- Differenza rispetto a subvettori:
--   - chiave composta (societa_sga, codice_sga) perche' lo stesso CODICE fornitore
--     puo' esistere su piu' societa' SGA
--   - email dedicata (in subvettori e' login_subvettore)
--
-- Sorgente upsert: BaCliFor WHERE CLIENTE_FORNITORE='F' AND ATTIVO='S'

CREATE TABLE IF NOT EXISTS fornitori (
    id INT(11) NOT NULL AUTO_INCREMENT,
    societa_sga INT(11) NOT NULL COMMENT 'BaCliFor.SOCIETA',
    codice_sga VARCHAR(255) NOT NULL COMMENT 'BaCliFor.CODICE',
    ragione_sociale VARCHAR(255) DEFAULT NULL,
    cod_fiscale VARCHAR(50) DEFAULT NULL,
    piva VARCHAR(50) DEFAULT NULL,
    phone VARCHAR(50) DEFAULT NULL,
    cellphone VARCHAR(50) DEFAULT NULL,
    email VARCHAR(255) DEFAULT NULL COMMENT 'BaCliFor.E_MAIL',
    indirizzo VARCHAR(255) DEFAULT NULL,
    civico VARCHAR(50) DEFAULT NULL,
    sede_citta VARCHAR(255) DEFAULT NULL,
    sede_prov VARCHAR(50) DEFAULT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_fornitori_soc_cod (societa_sga, codice_sga),
    KEY idx_fornitori_piva (piva),
    KEY idx_fornitori_cf (cod_fiscale),
    KEY idx_fornitori_email (email)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COMMENT='Fornitori attivi da SGA (tutte le societa)';


