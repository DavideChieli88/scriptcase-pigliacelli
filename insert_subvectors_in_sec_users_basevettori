// Scriptcase app: insert_subvectors_in_sec_users_basevettori
// Versione da usare con subvettori importati da insert_new_subvectors_basevettori / check_new_trips*_basevettori.
// App parallela a insert_subvectors_in_sec_users (originale BaCliFor).
// Bootstrap T0: crea sec_users + sec_users_groups per ogni subvettore senza utenza.
// Solo DB pigliacelli (MySQL): nessun accesso SGA / MS SQL.
// login_subvettore viene da T2BaseVettori.E_MAIL / B2B_EMAIL (import in insert_new_subvectors_basevettori).
// Crea utenza solo se login_subvettore e' una email valida; nessuna utenza tecnica SUBVETTORE_{id}.

if (!function_exists('sql_quote')) {
    function sql_quote($v)
    {
        if ($v === null) {
            return "NULL";
        }
        return "'" . str_replace("'", "''", (string)$v) . "'";
    }
}

if (!function_exists('sql_num')) {
    function sql_num($v)
    {
        if ($v === null || $v === '') {
            return "NULL";
        }
        return (string)(0 + $v);
    }
}

if (!function_exists('generateTempPassword')) {
    function generateTempPassword()
    {
        $characters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_!+-*';
        $charactersLength = strlen($characters);
        $temporaryPassword = '';

        for ($i = 0; $i < 12; $i++) {
            $temporaryPassword .= $characters[random_int(0, $charactersLength - 1)];
        }

        return $temporaryPassword;
    }
}

if (!function_exists('emailValidaSingola')) {
    function emailValidaSingola($email)
    {
        $email = trim((string)$email);

        if ($email === '') {
            return false;
        }

        if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
            return false;
        }

        return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
    }
}

if (!function_exists('utenza_esistente_per_subvettore')) {
    function utenza_esistente_per_subvettore($subvettore_id)
    {
        sc_lookup(checkSubUser, "
            SELECT login
            FROM sec_users
            WHERE subvettore_id = " . sql_num($subvettore_id) . "
            LIMIT 1
        ", "pigliacelli");

        if (!empty({checkSubUser})) {
            return (string){checkSubUser[0][0]};
        }

        return null;
    }
}

if (!function_exists('inserisci_utenza')) {
    function inserisci_utenza($login, $email, $ragione_sociale, $phone, $subvettore_id, $group_id)
    {
        $login = trim((string)$login);
        if ($login === '') {
            return false;
        }

        $password_hash = md5(generateTempPassword());

        sc_exec_sql("
            INSERT INTO sec_users (
                login,
                pswd,
                name,
                email,
                phone,
                active,
                subvettore_id
            ) VALUES (
                " . sql_quote($login) . ",
                " . sql_quote($password_hash) . ",
                " . sql_quote($ragione_sociale) . ",
                " . sql_quote($email) . ",
                " . sql_quote($phone) . ",
                'N',
                " . sql_num($subvettore_id) . "
            )
        ", "pigliacelli");

        sc_exec_sql("
            INSERT INTO sec_users_groups (
                login,
                group_id
            ) VALUES (
                " . sql_quote($login) . ",
                " . sql_num($group_id) . "
            )
        ", "pigliacelli");

        return true;
    }
}

if (!function_exists('crea_utenza_subvettore')) {
    function crea_utenza_subvettore($subvettore_id, $email, $ragione_sociale, $phone)
    {
        $group_id = 2;
        $email = trim((string)$email);

        if (!emailValidaSingola($email)) {
            return null;
        }

        sc_lookup(check_user, "
            SELECT login, subvettore_id
            FROM sec_users
            WHERE login = " . sql_quote($email) . "
            LIMIT 1
        ", "pigliacelli");

        if (!empty({check_user})) {
            $login_esistente = (string){check_user[0][0]};
            $sub_esistente = isset({check_user[0][1]}) ? (int){check_user[0][1]} : 0;
            if ($sub_esistente === (int)$subvettore_id) {
                return $login_esistente;
            }
            return null;
        }

        if (inserisci_utenza($email, $email, $ragione_sociale, $phone, $subvettore_id, $group_id)) {
            return $email;
        }

        return null;
    }
}

$group_id = 2;
$creati_email = 0;
$saltati_gia_presenti = 0;
$saltati_email_non_valida = 0;
$saltati_login_occupato = 0;
$errori = 0;

sc_log_add('INSERT_SEC_USERS', 'START bootstrap utenze subvettori (solo email valide)');

sc_lookup(subRows, "
    SELECT id, login_subvettore, ragione_sociale, phone, cellphone
    FROM subvettori
    ORDER BY id
", "pigliacelli");

if (empty({subRows})) {
    sc_log_add('INSERT_SEC_USERS', 'Nessun subvettore in tabella subvettori (o query senza risultati)');
    return;
}

foreach ({subRows} as $row) {
    $subvettore_id    = (int)$row[0];
    $login_subvettore = trim((string)$row[1]);
    $ragione_sociale  = trim((string)$row[2]);
    $phone            = trim((string)$row[3]);
    $cellphone        = trim((string)$row[4]);

    if ($phone === '' && $cellphone !== '') {
        $phone = $cellphone;
    }

    if ($subvettore_id <= 0) {
        continue;
    }

    $login_gia_collegato = utenza_esistente_per_subvettore($subvettore_id);
    if ($login_gia_collegato !== null) {
        $saltati_gia_presenti++;
        continue;
    }

    if (!emailValidaSingola($login_subvettore)) {
        $saltati_email_non_valida++;
        continue;
    }

    $login = crea_utenza_subvettore(
        $subvettore_id,
        $login_subvettore,
        $ragione_sociale,
        $phone
    );

    if ($login !== null) {
        $creati_email++;
        continue;
    }

    $saltati_login_occupato++;
    sc_log_add(
        'INSERT_SEC_USERS',
        'skip subvettore_id=' . $subvettore_id .
        ': login email gia\' presente per altro subvettore (' . $login_subvettore . ')'
    );
}

sc_log_add(
    'INSERT_SEC_USERS',
    'Riepilogo: creati=' . $creati_email .
    ', gia\' collegate=' . $saltati_gia_presenti .
    ', email_non_valida=' . $saltati_email_non_valida .
    ', login_occupato=' . $saltati_login_occupato .
    ', errori=' . $errori
);
