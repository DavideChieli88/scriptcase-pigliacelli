/**
 * form_subvettori_contratti
 * → onAfterUpdate
 *
 * Sync campi virtuali su subvettori + subvettori_contratti (connessione pigliacelli,
 * fuori dal rollback della transazione Ajax del form).
 *
 * Invio magic link: pulsante Ajax save_and_send_magic_link (sc_redir → send_magic_link).
 */

if (!function_exists('form_subvettori_contratti_post_field')) {
    function form_subvettori_contratti_post_field($scValue, $postKey)
    {
        $v = trim((string)$scValue);
        if ($v !== '') {
            return $v;
        }
        if (isset($_POST[$postKey])) {
            return trim((string)$_POST[$postKey]);
        }
        if (isset($_REQUEST[$postKey])) {
            return trim((string)$_REQUEST[$postKey]);
        }
        return '';
    }
}

if (!function_exists('form_subvettori_contratti_sql_quote')) {
    function form_subvettori_contratti_sql_quote($v)
    {
        if ($v === null) {
            return 'NULL';
        }
        return "'" . str_replace("'", "''", (string)$v) . "'";
    }
}

if (!function_exists('form_subvettori_contratti_normalize_date_db')) {
    function form_subvettori_contratti_normalize_date_db($value)
    {
        $value = trim((string)$value);
        if ($value === '' || $value === '0000-00-00' || $value === '00/00/0000') {
            return null;
        }
        if (preg_match('/^(\d{4})-(\d{2})-(\d{2})/', $value, $m) === 1) {
            $year  = (int)$m[1];
            $month = (int)$m[2];
            $day   = (int)$m[3];
            if ($year >= 1900 && checkdate($month, $day, $year)) {
                return sprintf('%04d-%02d-%02d', $year, $month, $day);
            }
            return null;
        }
        if (preg_match('/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/', $value, $m) === 1) {
            $day   = (int)$m[1];
            $month = (int)$m[2];
            $year  = (int)$m[3];
            if (checkdate($month, $day, $year)) {
                return sprintf('%04d-%02d-%02d', $year, $month, $day);
            }
            return null;
        }
        return null;
    }
}

if (!function_exists('form_subvettori_contratti_prov_nascita_value')) {
    function form_subvettori_contratti_prov_nascita_value()
    {
        if (isset({prov_luogo_nascita_rappresentante}) && trim((string){prov_luogo_nascita_rappresentante}) !== '') {
            return trim((string){prov_luogo_nascita_rappresentante});
        }
        if (isset({prov_nascita_rappresentante}) && trim((string){prov_nascita_rappresentante}) !== '') {
            return trim((string){prov_nascita_rappresentante});
        }
        return '';
    }
}

if (!function_exists('form_subvettori_contratti_sync_after_save')) {
    function form_subvettori_contratti_sync_after_save()
    {
        $scId = 0;
        if (isset({id}) && (int){id} > 0) {
            $scId = (int){id};
        } elseif (isset([subvettore_contratto_id]) && (int)[subvettore_contratto_id] > 0) {
            $scId = (int)[subvettore_contratto_id];
        }

        $subvettoreId = 0;
        if (isset({subvettore_id}) && (int){subvettore_id} > 0) {
            $subvettoreId = (int){subvettore_id};
        }

        if ($subvettoreId <= 0 && $scId > 0) {
            sc_lookup(rsSubIdSync, "
                SELECT subvettore_id
                FROM subvettori_contratti
                WHERE id = " . (int)$scId . "
                LIMIT 1
            ", 'pigliacelli');
            if (!empty({rsSubIdSync[0][0]})) {
                $subvettoreId = (int){rsSubIdSync[0][0]};
            }
        }

        $ragione_sociale                  = isset({ragione_sociale})                  ? trim((string){ragione_sociale})                  : '';
        $sede_citta                       = isset({sede_citta})                       ? trim((string){sede_citta})                       : '';
        $sede_prov                        = isset({sede_prov})                        ? trim((string){sede_prov})                        : '';
        $indirizzo                        = isset({indirizzo})                        ? trim((string){indirizzo})                        : '';
        $civico                           = isset({civico})                           ? trim((string){civico})                           : '';
        $cod_fiscale                      = isset({cod_fiscale})                      ? trim((string){cod_fiscale})                      : '';
        $piva                             = isset({piva})                             ? trim((string){piva})                             : '';
        $num_iscrizione_reg_imprese       = isset({num_iscrizione_reg_imprese})       ? trim((string){num_iscrizione_reg_imprese})       : '';
        $locazione_iscrizione_reg_imprese = isset({locazione_iscrizione_reg_imprese}) ? trim((string){locazione_iscrizione_reg_imprese}) : '';
        $rea                              = isset({rea})                              ? trim((string){rea})                              : '';
        $cellphone                        = isset({phone})                            ? trim((string){phone})                            : '';

        if ($subvettoreId > 0) {
            sc_exec_sql("
                UPDATE subvettori
                SET
                    ragione_sociale                  = " . form_subvettori_contratti_sql_quote($ragione_sociale) . ",
                    sede_citta                       = " . form_subvettori_contratti_sql_quote($sede_citta) . ",
                    sede_prov                        = " . form_subvettori_contratti_sql_quote($sede_prov) . ",
                    indirizzo                        = " . form_subvettori_contratti_sql_quote($indirizzo) . ",
                    civico                           = " . form_subvettori_contratti_sql_quote($civico) . ",
                    cod_fiscale                      = " . form_subvettori_contratti_sql_quote($cod_fiscale) . ",
                    piva                             = " . form_subvettori_contratti_sql_quote($piva) . ",
                    num_iscrizione_reg_imprese       = " . form_subvettori_contratti_sql_quote($num_iscrizione_reg_imprese) . ",
                    locazione_iscrizione_reg_imprese = " . form_subvettori_contratti_sql_quote($locazione_iscrizione_reg_imprese) . ",
                    rea                              = " . form_subvettori_contratti_sql_quote($rea) . ",
                    cellphone                        = " . form_subvettori_contratti_sql_quote($cellphone) . "
                WHERE id = " . (int)$subvettoreId . "
                LIMIT 1
            ", 'pigliacelli');
            sc_log_add('SUB_SYNC', 'subvettori aggiornato id=' . (int)$subvettoreId);
        }

        if ($scId > 0) {
            $nome_rappresentante          = form_subvettori_contratti_post_field(
                isset({nome_rappresentante}) ? {nome_rappresentante} : '',
                'nome_rappresentante'
            );
            $cognome_rappresentante       = form_subvettori_contratti_post_field(
                isset({cognome_rappresentante}) ? {cognome_rappresentante} : '',
                'cognome_rappresentante'
            );
            $email_rappresentante         = form_subvettori_contratti_post_field(
                isset({email_rappresentante}) ? {email_rappresentante} : '',
                'email_rappresentante'
            );
            $telefono_rappresentante      = form_subvettori_contratti_post_field(
                isset({telefono_rappresentante}) ? {telefono_rappresentante} : '',
                'telefono_rappresentante'
            );
            $num_iscrizione_albo          = form_subvettori_contratti_post_field(
                isset({num_iscrizione_albo}) ? {num_iscrizione_albo} : '',
                'num_iscrizione_albo'
            );
            $luogo_nascita_rappresentante = form_subvettori_contratti_post_field(
                isset({luogo_nascita_rappresentante}) ? {luogo_nascita_rappresentante} : '',
                'luogo_nascita_rappresentante'
            );
            $prov_nascita                 = form_subvettori_contratti_prov_nascita_value();
            if ($prov_nascita === '') {
                $prov_nascita = form_subvettori_contratti_post_field('', 'prov_luogo_nascita_rappresentante');
            }
            if ($prov_nascita === '') {
                $prov_nascita = form_subvettori_contratti_post_field('', 'prov_nascita_rappresentante');
            }
            $data_nascita_raw = form_subvettori_contratti_post_field(
                isset({data_nascita_rappresentante}) ? {data_nascita_rappresentante} : '',
                'data_nascita_rappresentante'
            );
            $data_nascita_db  = form_subvettori_contratti_normalize_date_db($data_nascita_raw);

            $setSc = array();
            if ($nome_rappresentante !== '') {
                $setSc[] = 'nome_rappresentante = ' . form_subvettori_contratti_sql_quote($nome_rappresentante);
            }
            if ($cognome_rappresentante !== '') {
                $setSc[] = 'cognome_rappresentante = ' . form_subvettori_contratti_sql_quote($cognome_rappresentante);
            }
            if ($email_rappresentante !== '') {
                $setSc[] = 'email_rappresentante = ' . form_subvettori_contratti_sql_quote($email_rappresentante);
            }
            if ($telefono_rappresentante !== '') {
                $setSc[] = 'telefono_rappresentante = ' . form_subvettori_contratti_sql_quote($telefono_rappresentante);
            }
            if ($num_iscrizione_albo !== '') {
                $setSc[] = 'num_iscrizione_albo = ' . form_subvettori_contratti_sql_quote($num_iscrizione_albo);
            }
            if ($luogo_nascita_rappresentante !== '') {
                $setSc[] = 'luogo_nascita_rappresentante = ' . form_subvettori_contratti_sql_quote($luogo_nascita_rappresentante);
            }
            if ($prov_nascita !== '') {
                $setSc[] = 'prov_luogo_nascita_rappresentante = ' . form_subvettori_contratti_sql_quote($prov_nascita);
            }
            if ($data_nascita_db !== null) {
                $setSc[] = 'data_nascita_rappresentante = ' . form_subvettori_contratti_sql_quote($data_nascita_db);
            }

            if (!empty($setSc)) {
                $sqlSubContrattiSync = 'UPDATE subvettori_contratti SET '
                    . implode(', ', $setSc)
                    . ' WHERE id = ' . (int)$scId
                    . ' LIMIT 1';
                sc_exec_sql($sqlSubContrattiSync, 'pigliacelli');
                sc_log_add(
                    'SUB_SYNC',
                    'subvettori_contratti aggiornato id=' . (int)$scId
                    . ' email=' . $email_rappresentante
                    . ' campi=' . count($setSc)
                );
            } else {
                sc_log_add('SUB_SYNC', 'subvettori_contratti skip sync id=' . (int)$scId . ' (campi vuoti in afterUpdate)');
            }
        } elseif ($subvettoreId <= 0) {
            sc_log_add('SUB_SYNC', 'subvettore_id non risolvibile, skip sync');
        }
    }
}

form_subvettori_contratti_sync_after_save();
