/**
 * form_subvettori_autisti_wizard → onLoadRecord
 * Campi: patente, cqc, formazione_sicurezza, idoneita_sanitaria,
 * dpi_iii_categoria, permesso_soggiorno
 *
 * tipo 19: 1ª riga → patente, 2ª riga → cqc
 */

$autistaId = (int){id};
if ($autistaId <= 0) {
    // nuovo
} else {

    sc_lookup(rsL18, "
        SELECT file FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 18
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    {idoneita_sanitaria} = !empty({rsL18[0][0]}) ? trim((string){rsL18[0][0]}) : '';

    sc_lookup(rsL19a, "
        SELECT file FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 19
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    {patente} = !empty({rsL19a[0][0]}) ? trim((string){rsL19a[0][0]}) : '';

    $idPrima = 0;
    sc_lookup(rsL19id, "
        SELECT id FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 19
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsL19id[0][0]})) {
        $idPrima = (int){rsL19id[0][0]};
    }

    sc_lookup(rsL19b, "
        SELECT file FROM documenti
        WHERE subvettore_autista_id = $autistaId
          AND tipo_documento_id = 19
          AND id <> $idPrima
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    {cqc} = !empty({rsL19b[0][0]}) ? trim((string){rsL19b[0][0]}) : '';

    sc_lookup(rsL20, "
        SELECT file FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 20
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    {formazione_sicurezza} = !empty({rsL20[0][0]}) ? trim((string){rsL20[0][0]}) : '';

    sc_lookup(rsL21, "
        SELECT file FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 21
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    {dpi_iii_categoria} = !empty({rsL21[0][0]}) ? trim((string){rsL21[0][0]}) : '';

    sc_lookup(rsL30, "
        SELECT file FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 30
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    {permesso_soggiorno} = !empty({rsL30[0][0]}) ? trim((string){rsL30[0][0]}) : '';
}
