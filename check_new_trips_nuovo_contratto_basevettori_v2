/**
 * Solo per assicurare un legame gia esistente (nessuna variazione): riusa il contratto
 * gia collegato alla tratta, senza crearne uno nuovo.
 */
function tipo_contratto_nuove_tratte($subvettore_id, $subvettori_nuovi_run) {
    return isset($subvettori_nuovi_run[(int)$subvettore_id]) ? 1 : 2;
}

function aggiungi_tratta_pending_run(
    $subvettore_id,
    $tratta_id,
    $subvettori_nuovi_run,
    &$pending_tratte_tipo1,
    &$pending_tratte_tipo2
) {
    $subvettore_id = (int)$subvettore_id;
    $tratta_id = (int)$tratta_id;
    if ($tratta_id <= 0) {
        return;
    }
    if (isset($subvettori_nuovi_run[$subvettore_id])) {
        $pending_tratte_tipo1[$subvettore_id][$tratta_id] = true;
    } else {
        $pending_tratte_tipo2[$subvettore_id][$tratta_id] = true;
    }
}

function aggiungi_modifica_tariffa_pending(
    $subvettore_id,
    $tratta_id,
    $subvettori_nuovi_run,
    $tratte_inserite_run,
    &$pending_tratte_tipo1,
    &$pending_tratte_tipo2,
    &$pending_modifiche_tariffa
) {
    $subvettore_id = (int)$subvettore_id;
    $tratta_id = (int)$tratta_id;
    if ($tratta_id <= 0) {
        return;
    }
    if (isset($subvettori_nuovi_run[$subvettore_id]) || isset($tratte_inserite_run[$tratta_id])) {
        aggiungi_tratta_pending_run(
            $subvettore_id,
            $tratta_id,
            $subvettori_nuovi_run,
            $pending_tratte_tipo1,
            $pending_tratte_tipo2
        );
    } else {
        $pending_modifiche_tariffa[$subvettore_id][$tratta_id] = true;
    }
}

function contratto_per_assicura($tratta_id, $tipo_contratto_id, $intestatario, $subvettore_id) {
    sc_lookup(contrattoTratta, "
        SELECT ct.contratto_id
        FROM contratti_tratte ct
        INNER JOIN contratti c ON c.id = ct.contratto_id
        WHERE ct.tratta_id = " . sql_num($tratta_id) . "
          AND c.tipo_contratto_id = " . sql_num($tipo_contratto_id) . "
        ORDER BY ct.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (!empty({contrattoTratta})) {
        return {contrattoTratta[0][0]};
    }

    sc_lookup(ultimoContratto, "
        SELECT c.id
        FROM contratti c
        INNER JOIN subvettori_contratti sc ON sc.contratto_id = c.id
        WHERE c.tipo_contratto_id = " . sql_num($tipo_contratto_id) . "
          AND c.intestatario = " . sql_quote($intestatario) . "
          AND sc.subvettore_id = " . sql_num($subvettore_id) . "
        ORDER BY c.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (!empty({ultimoContratto})) {
        return {ultimoContratto[0][0]};
    }

    return null;
}

/** Tipo 1: primo contratto quadro per subvettore appena creato (una tantum). */
function recupera_contratto_quadro(&$contratti_batch, $intestatario, $subvettore_id) {
    $key = (string)$subvettore_id . '|1';
    if (isset($contratti_batch[$key])) {
        return $contratti_batch[$key];
    }

    sc_lookup(contrattoEsistente, "
        SELECT c.id
        FROM contratti c
        INNER JOIN subvettori_contratti sc ON sc.contratto_id = c.id
        WHERE c.tipo_contratto_id = 1
          AND c.intestatario = " . sql_quote($intestatario) . "
          AND sc.subvettore_id = " . sql_num($subvettore_id) . "
        ORDER BY c.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (!empty({contrattoEsistente})) {
        $contratti_batch[$key] = {contrattoEsistente[0][0]};
        return $contratti_batch[$key];
    }

    $contratto_id = crea_contratto_subvettore(1, $intestatario, $subvettore_id);
    $contratti_batch[$key] = $contratto_id;
    return $contratto_id;
}

function log_export_tratte($azione, $messaggio) {
    sc_log_add("EXPORT_TRATTE_" . $azione, $messaggio);
}

function log_sga_testo_breve($s, $max = 36) {
    $s = trim((string)$s);
    if (strlen($s) <= $max) {
        return $s;
    }
    return substr($s, 0, $max - 3) . '...';
}

function log_sga_viaggio_ref($viaggio) {
    $anno = isset($viaggio['ANNO']) ? (int)$viaggio['ANNO'] : 0;
    $numero = isset($viaggio['NUMERO']) ? (int)$viaggio['NUMERO'] : 0;
    $vet = isset($viaggio['codice_vettore']) ? trim((string)$viaggio['codice_vettore']) : '';
    return 'a' . $anno . '/n' . $numero . ' vet=' . $vet;
}

function log_sga_skip($anno, $numero, $codice_vettore, $motivo, $dettaglio = '') {
    $msg = 'a' . (int)$anno . '/n' . (int)$numero
        . ' vet=' . trim((string)$codice_vettore)
        . ' motivo=' . $motivo;
    if ($dettaglio !== '') {
        $msg .= ' ' . $dettaglio;
    }
    log_export_tratte('SGA_SKIP', $msg);
}

function log_sga_candidato($viaggio) {
    $sync = isset($viaggio['sync_data_ora']) ? trim((string)$viaggio['sync_data_ora']) : '';
    $importo = isset($viaggio['importo_unitario']) ? (string)$viaggio['importo_unitario'] : '';
    $partenza = isset($viaggio['partenza_data_ora']) ? trim((string)$viaggio['partenza_data_ora']) : '';
    $carico = log_sga_testo_breve(isset($viaggio['carico_str']) ? $viaggio['carico_str'] : '');
    $scarico = log_sga_testo_breve(isset($viaggio['scarico_str']) ? $viaggio['scarico_str'] : '');
    log_export_tratte(
        'SGA_CAND',
        log_sga_viaggio_ref($viaggio) .
        ' sync=' . $sync .
        ' imp=' . $importo .
        ' part=' . $partenza .
        " C='" . $carico . "'" .
        " S='" . $scarico . "'"
    );
}

function log_viaggio_esito($viaggio, $esito, $extra = '') {
    $msg = log_sga_viaggio_ref($viaggio) . ' esito=' . $esito;
    if ($extra !== '') {
        $msg .= ' ' . $extra;
    }
    log_export_tratte('VIAGGIO', $msg);
}

function partenza_data_ora_valida($value) {
    $value = trim((string)$value);
    if ($value === '') {
        return false;
    }
    if ($value === '1900-01-01 00:00:00' || strpos($value, '1900-01-01') === 0) {
        return false;
    }
    return strtotime($value) !== false;
}

function importo_unitario_valido($value) {
    if ($value === null) {
        return false;
    }
    if (is_string($value) && trim($value) === '') {
        return false;
    }
    if (!is_numeric($value)) {
        return false;
    }
    return round((float)$value, 2) > 0;
}

function importo_unitario_normalizzato($value) {
    if ($value === null) {
        return null;
    }
    if (is_string($value) && trim($value) === '') {
        return null;
    }
    if (!is_numeric($value)) {
        return null;
    }
    $importo = round((float)$value, 2);
    if ($importo <= 0) {
        return null;
    }
    return $importo;
}

function tariffa_db_valida($tariffa) {
    if ($tariffa === null) {
        return false;
    }
    if (is_string($tariffa) && trim($tariffa) === '') {
        return false;
    }
    if (!is_numeric($tariffa)) {
        return false;
    }
    return round((float)$tariffa, 2) > 0;
}

function tratta_ha_tariffa_valida($tratta_id) {
    $tratta_id = (int)$tratta_id;
    if ($tratta_id <= 0) {
        return false;
    }

    sc_lookup(rsTarVal, "
        SELECT tariffa
        FROM tratte
        WHERE id = " . sql_num($tratta_id) . "
        LIMIT 1
    ", "pigliacelli");

    if (empty({rsTarVal})) {
        return false;
    }

    $tariffa = {rsTarVal[0][0]};
    return tariffa_db_valida($tariffa);
}

function viaggio_ammesso_per_contratto($partenza_data_ora, $importo_unitario, &$motivo_skip) {
    $motivo_skip = '';

    if (!partenza_data_ora_valida($partenza_data_ora)) {
        $motivo_skip = 'partenza_data_ora_mancante';
        return false;
    }

    if (!importo_unitario_valido($importo_unitario)) {
        $motivo_skip = 'importo_unitario_non_valido';
        return false;
    }

    return true;
}

