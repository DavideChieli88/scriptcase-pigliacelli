    log_export_tratte(
        'NUOVO_CONTRATTO',
        'tipo=2 subvettore=' . (int)$subvettore_id .
        ' contratto=' . (int)$contratto_id .
        ' tratte_run=' . count($nuove_tratte_ids)
    );

    foreach ($nuove_tratte_ids as $tratta_id) {
        allega_tratta_a_contratto($contratto_id, $tratta_id);
    }
}

/**
 * Fine run: un contratto tipo 3 con SOLO le tratte modificate nel run (da firmare).
 */
function consolida_contratto_tipo3_run($subvettore_id, $intestatario, $tratte_modificate_ids) {
    $tratte_modificate_ids = filtra_tratte_importo_valido($tratte_modificate_ids);
