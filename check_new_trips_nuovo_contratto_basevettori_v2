// Scriptcase app: check_new_trips_nuovo_contratto_basevettori_v2
// Come _basevettori ma popola merce, caricatore, proprietario_merce da SGA (Cerroni 09/07/2026).
// Versione T2BaseVettori: JOIN T2BaseVettori al posto di BaCliFor per anagrafica vettore.
// App parallela a check_new_trips_nuovo_contratto (originale BaCliFor).
// A fine job: un contratto per run con SOLO le tratte rilevate in quel ciclo.
// Subvettore NUOVO (creato nel run): un solo contratto tipo 1 con tutte le nuove tratte.
// Subvettore ESISTENTE: contratto tipo 2 con le nuove tratte (assenti in `tratte`
// per quel subvettore_id, non globalmente); tipo 3 se variano tariffe su tratte
// gia' presenti a DB per quel subvettore prima del run.
// Senza mail automatica (credenziali: app _credenziali).
// Multi-utenza: email SGA diversa → nuova utenza, disabilita vecchia, aggiorna login_subvettore.
// Autisti onboarding: aggancia_autisti_onboarding_a_contratto() in crea_contratto_subvettore.
function sql_quote($v) {
    if ($v === null) return "NULL";
    return "'" . str_replace("'", "''", (string)$v) . "'";
}
function sql_num($v) {
    if ($v === null || $v === '') return "NULL";
    return (string)(0 + $v);
}
function allegato_testo_sql($v) {
    $v = trim((string)$v);
    if ($v === '') return "NULL";
    return sql_quote($v);
}
function merce_label_da_riga($codice, $descrizione) {
    $codice = trim((string)$codice);
    $descrizione = trim((string)$descrizione);
    if ($codice !== '' && $descrizione !== '') {
        return $codice . ' - ' . $descrizione;
    }
    if ($codice !== '') return $codice;
    if ($descrizione !== '') return $descrizione;
    return '';
}

function split_localita($s) {
    $s = trim((string)$s);
    if ($s === '') return [];

    // Split su "+" con o senza spazi, preservando l'ordine.
    $parts = preg_split('/\s*\+\s*/', $s);

    return array_values(array_filter($parts, fn($x) => $x !== ''));
}

function normalizza_stringa($s) {
    $s = trim((string)$s);
    $s = strtoupper($s);
    $s = preg_replace('/\s+/', ' ', $s);
    return $s;
}

function crea_hash_tratta($carico_str, $scarico_str, $codice_vettore, $importo_unitario) {
    $carichi = [];
    foreach (split_localita($carico_str) as $loc) {
        $carichi[] = normalizza_stringa($loc);
    }

    $scarichi = [];
    foreach (split_localita($scarico_str) as $loc) {
        $scarichi[] = normalizza_stringa($loc);
    }

    $carico_norm  = implode('|', $carichi);
    $scarico_norm = implode('|', $scarichi);
    $vettore      = normalizza_stringa($codice_vettore);
    $importo      = number_format((float)$importo_unitario, 2, '.', '');

    return hash('sha256', $carico_norm . '#' . $scarico_norm . '#' . $vettore . '#' . $importo);
}

function crea_contratto($tipo_contratto_id, $intestatario) {
    sc_exec_sql("
        INSERT INTO contratti
          (tipo_contratto_id, intestatario, stato_contratto_id)
        VALUES
          (" . sql_num($tipo_contratto_id) . ", " . sql_quote($intestatario) . ",
           (SELECT id FROM stati_contratti WHERE nome = 'Da inviare al subvettore' LIMIT 1))
    ", "pigliacelli");

    sc_lookup(lastContrattoId, "SELECT LAST_INSERT_ID()", "pigliacelli");
    if (empty({lastContrattoId})) {
        return null;
    }

    return {lastContrattoId[0][0]};
}

function crea_contratto_subvettore($tipo_contratto_id, $intestatario, $subvettore_id) {
    $contratto_id = crea_contratto($tipo_contratto_id, $intestatario);

    if ($contratto_id === null) {
        return null;
    }

    sc_exec_sql("
        INSERT INTO subvettori_contratti
          (subvettore_id, contratto_id)
        VALUES
          (" . sql_num($subvettore_id) . ", " . sql_num($contratto_id) . ")
    ", "pigliacelli");

    sc_lookup(lastSubContrattoId, "SELECT LAST_INSERT_ID()", "pigliacelli");
    $subvettore_contratto_id = 0;
    if (!empty({lastSubContrattoId[0][0]})) {
        $subvettore_contratto_id = (int){lastSubContrattoId[0][0]};
    }

    if ($subvettore_contratto_id > 0) {
        aggancia_autisti_onboarding_a_contratto((int)$subvettore_id, $subvettore_contratto_id);
    }

    return $contratto_id;
}

/**
 * Autisti inseriti in wizard (subvettore_contratto_id NULL) → legame al nuovo subvettori_contratti.
 */
function aggancia_autisti_onboarding_a_contratto($subvettore_id, $subvettore_contratto_id) {
    $subvettore_id = (int)$subvettore_id;
    $subvettore_contratto_id = (int)$subvettore_contratto_id;

    if ($subvettore_id <= 0 || $subvettore_contratto_id <= 0) {
        return 0;
    }

    sc_lookup(rsAutistiDaAgg, "
        SELECT COUNT(*)
        FROM subvettori_autisti
        WHERE subvettore_id = " . sql_num($subvettore_id) . "
          AND (subvettore_contratto_id IS NULL OR subvettore_contratto_id = 0)
    ", "pigliacelli");

    $da_agg = 0;
    if (!empty({rsAutistiDaAgg[0][0]})) {
        $da_agg = (int){rsAutistiDaAgg[0][0]};
    }

    if ($da_agg <= 0) {
        return 0;
    }

    sc_exec_sql("
        UPDATE subvettori_autisti
        SET subvettore_contratto_id = " . sql_num($subvettore_contratto_id) . "
        WHERE subvettore_id = " . sql_num($subvettore_id) . "
          AND (subvettore_contratto_id IS NULL OR subvettore_contratto_id = 0)
    ", "pigliacelli");

    log_export_tratte(
        'AUT_ONB_AGG',
        'sub=' . $subvettore_id
        . ' subvettore_contratto_id=' . $subvettore_contratto_id
        . ' n=' . $da_agg
    );

    return $da_agg;
}

function ultimo_contratto_tipo($subvettore_id, $tipo_contratto_id) {
    sc_lookup(rsUlt, "
        SELECT c.id
        FROM contratti c
        INNER JOIN subvettori_contratti sc ON sc.contratto_id = c.id
        WHERE sc.subvettore_id = " . sql_num($subvettore_id) . "
          AND c.tipo_contratto_id = " . sql_num($tipo_contratto_id) . "
        ORDER BY c.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (empty({rsUlt})) {
        return null;
    }
    return (int){rsUlt[0][0]};
}

function tratte_ids_del_contratto($contratto_id) {
    sc_lookup(rsTr, "
        SELECT DISTINCT tratta_id
        FROM contratti_tratte
        WHERE contratto_id = " . sql_num($contratto_id) . "
        ORDER BY tratta_id
    ", "pigliacelli");

    $ids = array();
    if (!empty({rsTr})) {
        foreach ({rsTr} as $row) {
            $ids[] = (int)$row[0];
        }
    }
    return $ids;
}

function carica_carico_scarico_tratta($tratta_id) {
    sc_lookup(rsC, "
        SELECT GROUP_CONCAT(localita ORDER BY progressivo SEPARATOR ' + ')
        FROM tratte_localita
        WHERE tratta_id = " . sql_num($tratta_id) . "
          AND tipo_tratta = 'C'
    ", "pigliacelli");
    sc_lookup(rsS, "
        SELECT GROUP_CONCAT(localita ORDER BY progressivo SEPARATOR ' + ')
        FROM tratte_localita
        WHERE tratta_id = " . sql_num($tratta_id) . "
          AND tipo_tratta = 'S'
    ", "pigliacelli");

    $carico = empty({rsC[0][0]}) ? '' : (string){rsC[0][0]};
    $scarico = empty({rsS[0][0]}) ? '' : (string){rsS[0][0]};
    return array($carico, $scarico);
}

function allega_tratta_a_contratto($contratto_id, $tratta_id) {
    sc_lookup(rsT, "
        SELECT tipo_tariffa_id, tariffa, extra, totale, hash, version
        FROM tratte
        WHERE id = " . sql_num($tratta_id) . "
        LIMIT 1
    ", "pigliacelli");

    if (empty({rsT})) {
        return;
    }

    $tariffa = {rsT[0][1]};
    $extra = {rsT[0][2]};
    $totale = {rsT[0][3]};
    $hash = {rsT[0][4]};
    $tipo_tariffa_id = {rsT[0][0]};
    if (!tariffa_db_valida($tariffa)) {
        log_export_tratte(
            'SKIP_ALLEGATO',
            'contratto=' . (int)$contratto_id .
            ' tratta=' . (int)$tratta_id .
            ' tariffa_non_valida=' . (string)$tariffa
        );
        return;
    }

    [$carico, $scarico] = carica_carico_scarico_tratta($tratta_id);
    $version = ({rsT[0][5]} === null || {rsT[0][5]} === '') ? 1 : (int){rsT[0][5]};

    crea_contratto_tratta(
        $tratta_id,
        $contratto_id,
        $version,
        $carico,
        $scarico,
        $tipo_tariffa_id,
        $tariffa,
        $extra,
        $totale,
        $hash
    );
}

function filtra_tratte_importo_valido($tratte_ids) {
    global $stat_skip_tratta_importo;
    $valide = array();
    foreach (array_values(array_unique(array_filter(array_map('intval', $tratte_ids)))) as $tratta_id) {
        if ($tratta_id <= 0) {
            continue;
        }
        sc_lookup(rsTrFil, "
            SELECT tariffa
            FROM tratte
            WHERE id = " . sql_num($tratta_id) . "
            LIMIT 1
        ", "pigliacelli");
        $tariffa = empty({rsTrFil}) ? null : {rsTrFil[0][0]};
        if (tariffa_db_valida($tariffa)) {
            $valide[] = $tratta_id;
        } else {
            $stat_skip_tratta_importo++;
            log_export_tratte(
                'SKIP_FILTRA',
                'tratta=' . (int)$tratta_id .
                ' tariffa_non_valida=' . (string)$tariffa
            );
        }
    }
    return $valide;
}

/**
 * Fine run: contratto tipo 1 per subvettore appena censito, con tutte le tratte del run.
 */
function consolida_contratto_tipo1_run(&$contratti_batch, $subvettore_id, $intestatario, $nuove_tratte_ids) {
    $nuove_tratte_ids = filtra_tratte_importo_valido($nuove_tratte_ids);
    if (empty($nuove_tratte_ids)) {
        return;
    }

    $contratto_id = recupera_contratto_quadro($contratti_batch, $intestatario, $subvettore_id);
    if ($contratto_id === null) {
        return;
    }

    log_export_tratte(
        'NUOVO_CONTRATTO',
        'tipo=1 subvettore=' . (int)$subvettore_id .
        ' contratto=' . (int)$contratto_id .
        ' tratte_run=' . count($nuove_tratte_ids)
    );

    foreach ($nuove_tratte_ids as $tratta_id) {
        allega_tratta_a_contratto($contratto_id, $tratta_id);
    }
}

/**
 * Fine run: un contratto tipo 2 con SOLO le nuove tratte rilevate nel run (da firmare).
 */
function consolida_contratto_tipo2_run($subvettore_id, $intestatario, $nuove_tratte_ids) {
    $nuove_tratte_ids = filtra_tratte_importo_valido($nuove_tratte_ids);
    if (empty($nuove_tratte_ids)) {
