    $stat_contratti_tipo1++;
    $stat_tratte_in_contratto_t1 += count($tratte_map);
    consolida_contratto_tipo1_run($contratti_batch, $sub_id, $intest, array_keys($tratte_map));
}

foreach ($pending_tratte_tipo2 as $sub_id => $tratte_map) {
