function recupera_intestatario_contratto($subvettore_id, $email, $ragione_sociale, $phone) {
    $subvettore_id = (int)$subvettore_id;
    $email = trim((string)$email);

    sc_lookup(rsSubMail, "
        SELECT login_subvettore
        FROM subvettori
        WHERE id = " . sql_num($subvettore_id) . "
        LIMIT 1
    ", "pigliacelli");

    $login_db = !empty({rsSubMail[0][0]}) ? trim((string){rsSubMail[0][0]}) : '';

    if (!emailValidaSingola($email)) {
        $login = intestatario_primo_utente_sub($subvettore_id);
        if ($login !== null) {
            return $login;
        }
        return crea_utenza_tecnica_subvettore($subvettore_id, $ragione_sociale, $phone);
    }

    if (login_sub_gia_usato_da_altro_sub($email, $subvettore_id)) {
        log_export_tratte(
            'SUB_UTENZA',
            'email SGA=' . $email . ' gia login altro sub — intestatario fallback subvettore_id=' . $subvettore_id
        );
        $login = intestatario_primo_utente_sub($subvettore_id);
        if ($login !== null) {
            return $login;
        }
        return crea_utenza_tecnica_subvettore($subvettore_id, $ragione_sociale, $phone);
    }

    if (login_collegato_a_sub($email, $subvettore_id)) {
        aggiorna_anagrafica_utenza_sub($subvettore_id, $email, $email, $ragione_sociale, $phone);
        if ($login_db !== '' && strcasecmp($login_db, $email) !== 0) {
            sc_exec_sql("
                UPDATE subvettori
                SET login_subvettore = " . sql_quote($email) . "
                WHERE id = " . sql_num($subvettore_id) . "
            ", "pigliacelli");
        }
        return $email;
    }

    if ($login_db !== '' && strcasecmp($login_db, $email) !== 0 && login_collegato_a_sub($login_db, $subvettore_id)) {
        $vecchio_usato = utenza_ha_mai_acceduto($login_db, $subvettore_id);
        disabilita_utenza_subvettore($subvettore_id, $login_db);
        log_export_tratte(
            'SUB_UTENZA',
            'cambio_email sub=' . $subvettore_id .
            ' da=' . $login_db .
            ' a=' . $email .
            ' vecchio_usato=' . ($vecchio_usato ? '1' : '0')
        );
        $login = crea_utenza_subvettore($subvettore_id, $email, $ragione_sociale, $phone, 'N');
        if ($login === null) {
            $login = intestatario_primo_utente_sub($subvettore_id);
            if ($login !== null) {
                return $login;
            }
            return crea_utenza_tecnica_subvettore($subvettore_id, $ragione_sociale, $phone);
        }

        sc_exec_sql("
            UPDATE subvettori
            SET login_subvettore = " . sql_quote($email) . "
            WHERE id = " . sql_num($subvettore_id) . "
        ", "pigliacelli");

        return $login;
    }

    $login = crea_utenza_subvettore($subvettore_id, $email, $ragione_sociale, $phone, 'N');
    if ($login === null) {
        $login = intestatario_primo_utente_sub($subvettore_id);
        if ($login !== null) {
            return $login;
        }
        return crea_utenza_tecnica_subvettore($subvettore_id, $ragione_sociale, $phone);
    }

    sc_exec_sql("
        UPDATE subvettori
        SET login_subvettore = " . sql_quote($email) . "
        WHERE id = " . sql_num($subvettore_id) . "
    ", "pigliacelli");

    return $login;
}

function data_compare_value($value) {
    if ($value === null || $value === '') {
        return PHP_INT_MIN;
    }

    $ts = strtotime((string)$value);
    return $ts === false ? PHP_INT_MIN : $ts;
}

function viaggio_piu_recente($nuovo, $corrente) {
    $nuovo_partenza = data_compare_value($nuovo['partenza_data_ora']);
    $corrente_partenza = data_compare_value($corrente['partenza_data_ora']);

    if ($nuovo_partenza !== $corrente_partenza) {
        return $nuovo_partenza > $corrente_partenza;
    }

    if ((int)$nuovo['ANNO'] !== (int)$corrente['ANNO']) {
        return (int)$nuovo['ANNO'] > (int)$corrente['ANNO'];
    }

    return (int)$nuovo['NUMERO'] > (int)$corrente['NUMERO'];
}

function carica_localita_viaggio($stmt_localita, $societa, $anno, $numero) {
    $stmt_localita->execute([
        'societa' => $societa,
        'anno' => $anno,
        'numero' => $numero,
    ]);

    $carichi = [];
    $scarichi = [];

    while (($row = $stmt_localita->fetch(PDO::FETCH_NUM)) !== false) {
        if ($row[0] === 'C') {
            $carichi[] = $row[1];
        } elseif ($row[0] === 'S') {
            $scarichi[] = $row[1];
        }
    }
    $stmt_localita->closeCursor();

    return [
        implode(' + ', $carichi),
        implode(' + ', $scarichi),
    ];
}

function carica_extra_viaggio($stmt_extra, $societa, $anno, $numero) {
    $stmt_extra->execute([
        'societa' => $societa,
        'anno' => $anno,
        'numero' => $numero,
    ]);

    $extra = $stmt_extra->fetchColumn();
    $stmt_extra->closeCursor();
    return $extra === null || $extra === false ? 0 : $extra;
}

function carica_allegato_viaggio($stmt_allegato, $societa, $anno, $numero) {
    $stmt_allegato->execute([
        'societa' => $societa,
        'anno' => $anno,
        'numero' => $numero,
    ]);

    $caricatore = null;
    $proprietario_merce = null;
    $merce_parts = [];

    while (($row = $stmt_allegato->fetch(PDO::FETCH_NUM)) !== false) {
        if ($caricatore === null) {
            $c = trim((string)$row[0]);
            if ($c !== '') {
                $caricatore = $c;
            }
            $p = trim((string)$row[1]);
            if ($p !== '') {
                $proprietario_merce = $p;
            }
        }

        $label = merce_label_da_riga($row[2], $row[3]);
        if ($label !== '' && !in_array($label, $merce_parts, true)) {
            $merce_parts[] = $label;
        }
    }
    $stmt_allegato->closeCursor();

    $merce = count($merce_parts) > 0 ? implode('; ', $merce_parts) : null;

    return [$caricatore, $proprietario_merce, $merce];
}

