function sql_quote($v) {
    if ($v === null) return "NULL";
    return "'" . str_replace("'", "''", (string)$v) . "'";
}
function sql_num($v) {
    if ($v === null || $v === '') return "NULL";
    return (string)(0 + $v);
}
function split_localita($s) {
    $s = trim((string)$s);
    if ($s === '') return [];

    // Split su "+" con o senza spazi, preservando l'ordine.
    $parts = preg_split('/\s*\+\s*/', $s);

    return array_values(array_filter($parts, fn($x) => $x !== ''));
}

function normalizza_stringa($s) {
    $s = trim((string)$s);
    $s = strtoupper($s);
    $s = preg_replace('/\s+/', ' ', $s);
    return $s;
}

function crea_hash_tratta($carico_str, $scarico_str, $codice_vettore, $importo_unitario) {
    $carichi = [];
    foreach (split_localita($carico_str) as $loc) {
        $carichi[] = normalizza_stringa($loc);
    }

    $scarichi = [];
    foreach (split_localita($scarico_str) as $loc) {
        $scarichi[] = normalizza_stringa($loc);
    }

    $carico_norm  = implode('|', $carichi);
    $scarico_norm = implode('|', $scarichi);
    $vettore      = normalizza_stringa($codice_vettore);
    $importo      = number_format((float)$importo_unitario, 2, '.', '');

    return hash('sha256', $carico_norm . '#' . $scarico_norm . '#' . $vettore . '#' . $importo);
}

if (!function_exists('carica_localita_viaggio')) {
function carica_localita_viaggio($stmt_localita, $societa, $anno, $numero) {
    $stmt_localita->execute([
        'societa' => $societa,
        'anno' => $anno,
        'numero' => $numero,
    ]);

    $carichi = [];
    $scarichi = [];

    while (($row = $stmt_localita->fetch(PDO::FETCH_NUM)) !== false) {
        if ($row[0] === 'C') {
            $carichi[] = $row[1];
        } elseif ($row[0] === 'S') {
            $scarichi[] = $row[1];
        }
    }
    $stmt_localita->closeCursor();

    return [
        implode(' + ', $carichi),
        implode(' + ', $scarichi),
    ];
}
}

if (!function_exists('carica_extra_viaggio')) {
function carica_extra_viaggio($stmt_extra, $societa, $anno, $numero) {
    $stmt_extra->execute([
        'societa' => $societa,
        'anno' => $anno,
        'numero' => $numero,
    ]);

    $extra = $stmt_extra->fetchColumn();
    $stmt_extra->closeCursor();
    return $extra === null || $extra === false ? 0 : $extra;
}
}

if (!function_exists('data_compare_value')) {
function data_compare_value($value) {
    if ($value === null || $value === '') {
        return PHP_INT_MIN;
    }

    $ts = strtotime((string)$value);
    return $ts === false ? PHP_INT_MIN : $ts;
}
}

if (!function_exists('viaggio_piu_recente')) {
function viaggio_piu_recente($nuovo, $corrente) {
    $nuovo_partenza = data_compare_value($nuovo['partenza_data_ora']);
    $corrente_partenza = data_compare_value($corrente['partenza_data_ora']);

    if ($nuovo_partenza !== $corrente_partenza) {
        return $nuovo_partenza > $corrente_partenza;
    }

    if ((int)$nuovo['ANNO'] !== (int)$corrente['ANNO']) {
        return (int)$nuovo['ANNO'] > (int)$corrente['ANNO'];
    }

    return (int)$nuovo['NUMERO'] > (int)$corrente['NUMERO'];
}
}

function crea_contratto($tipo_contratto_id, $intestatario) {
    sc_exec_sql("
        INSERT INTO contratti
          (tipo_contratto_id, intestatario, stato_contratto_id)
        VALUES
          (" . sql_num($tipo_contratto_id) . ", " . sql_quote($intestatario) . ",
           (SELECT id FROM stati_contratti WHERE nome = 'Da inviare al subvettore' LIMIT 1))
    ", "pigliacelli");

    sc_lookup(lastContrattoId, "SELECT LAST_INSERT_ID()", "pigliacelli");
    if (empty({lastContrattoId})) {
        return null;
    }

    return {lastContrattoId[0][0]};
}

function crea_contratto_subvettore($tipo_contratto_id, $intestatario, $subvettore_id) {
    $contratto_id = crea_contratto($tipo_contratto_id, $intestatario);

    if ($contratto_id === null) {
        return null;
    }

    sc_exec_sql("
        INSERT INTO subvettori_contratti
          (subvettore_id, contratto_id)
        VALUES
          (" . sql_num($subvettore_id) . ", " . sql_num($contratto_id) . ")
    ", "pigliacelli");

    return $contratto_id;
}

function recupera_contratto_batch(&$contratti_batch, $tipo_contratto_id, $intestatario, $subvettore_id) {
    $key = (string)$subvettore_id . '|' . (string)$tipo_contratto_id;

    if (isset($contratti_batch[$key])) {
        return $contratti_batch[$key];
    }

    sc_lookup(contrattoEsistente, "
        SELECT c.id
        FROM contratti c
        JOIN subvettori_contratti sc
          ON sc.contratto_id = c.id
        WHERE c.tipo_contratto_id = " . sql_num($tipo_contratto_id) . "
          AND c.intestatario = " . sql_quote($intestatario) . "
          AND sc.subvettore_id = " . sql_num($subvettore_id) . "
        ORDER BY c.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (!empty({contrattoEsistente})) {
        $contratti_batch[$key] = {contrattoEsistente[0][0]};
        return $contratti_batch[$key];
    }

    $contratto_id = crea_contratto_subvettore($tipo_contratto_id, $intestatario, $subvettore_id);
    $contratti_batch[$key] = $contratto_id;

    // Nuovo contratto (es. tipo 1 per subvettore appena creato): notifica magic link.
    if ($contratto_id !== null) {
        registra_contratto_da_notificare($contratto_id, $subvettore_id);
    }

    return $contratto_id;
}

/**
 * Accoda un contratto per l'invio del magic link a fine run.
