if (!function_exists('recupera_email_subvettore_export')) {
function recupera_email_subvettore_export($subvettore_id, $subvettore_info) {
    $subvettore_id = (int)$subvettore_id;
    if ($subvettore_id <= 0) {
        return '';
    }

    if (isset($subvettore_info[$subvettore_id]['email'])) {
        $email = trim((string)$subvettore_info[$subvettore_id]['email']);
        if (emailValidaSingola($email)) {
            return $email;
        }
    }

    sc_lookup(rsSubEmail, "
        SELECT login_subvettore
        FROM subvettori
        WHERE id = " . $subvettore_id . "
        LIMIT 1
    ", "pigliacelli");
    if (!empty({rsSubEmail})) {
        $email = trim((string){rsSubEmail[0][0]});
        if (emailValidaSingola($email)) {
            return $email;
        }
    }

    sc_lookup(rsUsrEmail, "
        SELECT email
        FROM sec_users
        WHERE subvettore_id = " . $subvettore_id . "
          AND email IS NOT NULL
          AND email <> ''
        ORDER BY login
        LIMIT 1
    ", "pigliacelli");
    if (!empty({rsUsrEmail})) {
        $email = trim((string){rsUsrEmail[0][0]});
        if (emailValidaSingola($email)) {
            return $email;
        }
    }

    return '';
}
}

if (!function_exists('invia_magic_link_subvettore')) {
function invia_magic_link_subvettore(
    $contratto_id,
    $subvettore_id,
    $emailTo,
    $displayName,
    $cypherKey,
    $magicLinkUrl,
    $ttlDays,
    $smtpCfg,
    $mailLogoUrl,
    $subjectTpl
) {
    $emailTo = trim((string)$emailTo);
    if ($emailTo === '' || filter_var($emailTo, FILTER_VALIDATE_EMAIL) === false) {
        log_export_tratte('MAGIC_LINK', "skip contratto $contratto_id: email non valida [$emailTo]");
        return false;
    }

    sc_lookup(rsScId, "
        SELECT id
        FROM subvettori_contratti
        WHERE contratto_id = " . (int)$contratto_id . "
          AND subvettore_id = " . (int)$subvettore_id . "
        ORDER BY id DESC
        LIMIT 1
    ", "pigliacelli");
    if (empty({rsScId})) {
        log_export_tratte('MAGIC_LINK', "skip contratto $contratto_id: subvettori_contratti mancante");
        return false;
    }
    $scId = (int){rsScId[0][0]};

    $payload = json_encode(array(
        'scId'         => $scId,
        'contrattoId'  => (int)$contratto_id,
        'subvettoreId' => (int)$subvettore_id,
        'exp'          => time() + ($ttlDays * 86400),
    ), JSON_UNESCAPED_UNICODE);

    $token = magic_link_encryptData($payload, $cypherKey);
    $base = rtrim((string)$magicLinkUrl, '?&');
    $join = (strpos($base, '?') !== false) ? '&' : '?';
    $magicUrl = $base . $join . 't=' . rawurlencode($token);

    if (!function_exists('sc_send_mail_api')) {
        log_export_tratte('MAGIC_LINK', "skip contratto $contratto_id: sc_send_mail_api non disponibile");
        return false;
    }

    $displayName = trim((string)$displayName);
    if ($displayName === '') {
        $displayName = 'Gentile subvettore';
    }

    $titolo = ((string)$subjectTpl !== '')
        ? str_replace(array('{contrattoId}', '{subvettoreId}'), array((string)$contratto_id, (string)$subvettore_id), (string)$subjectTpl)
        : 'Compilazione dati contratto #' . (int)$contratto_id;

    $safeUrl = htmlspecialchars($magicUrl, ENT_QUOTES, 'UTF-8');
    $safeNome = htmlspecialchars($displayName, ENT_QUOTES, 'UTF-8');

    $messaggioTesto = $displayName . ",\n\n"
        . "Per compilare i dati del contratto #" . (int)$contratto_id . " apra il link seguente:\n\n"
        . $magicUrl . "\n\n"
        . "Il link è personale, cifrato e scade tra " . (int)$ttlDays . " giorni.\n\n"
        . "Messaggio automatico — non rispondere.";

    $mailInner = '<p style="margin:0 0 16px;">' . $safeNome . ',</p>'
        . '<p style="margin:0 0 24px;">Le chiediamo di compilare i dati per il contratto <strong>#' . (int)$contratto_id . '</strong>.</p>'
        . '<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;"><tr>'
        . '<td align="center" bgcolor="#5b2d8e" style="border-radius:8px;background-color:#5b2d8e;">'
        . '<a href="' . $safeUrl . '" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;'
        . 'color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;">Apri il modulo</a>'
        . '</td></tr></table>'
        . '<p style="margin:0 0 8px;font-size:13px;color:#718096;">Oppure copi questo indirizzo nel browser:</p>'
        . '<p style="margin:0;word-break:break-all;font-size:13px;">'
        . '<a href="' . $safeUrl . '" style="color:#5b2d8e;">' . $safeUrl . '</a></p>';
    $htmlContent = pigliacelli_mail_layout($titolo, $mailInner, $mailLogoUrl);

    try {
        sc_send_mail_api(array_merge((array)$smtpCfg, array(
            'message' => array(
                'html'    => $htmlContent,
                'text'    => $messaggioTesto,
                'to'      => $emailTo,
                'subject' => $titolo,
            ),
        )));
    } catch (Throwable $e) {
        log_export_tratte('MAGIC_LINK', "EXCEPTION invio contratto $contratto_id: " . $e->getMessage());
        return false;
    }

    log_export_tratte('MAGIC_LINK', "inviato contratto $contratto_id subvettore $subvettore_id to $emailTo");
    return true;
}
}

// === Invio automatico magic link: contratti con attività nuova in questo run ===
// (nuovo contratto, nuova tratta tipo 2, variazione tariffa tipo 3 — anche se il contratto esiste già a DB)
$contratti_da_notificare = isset($GLOBALS['contratti_da_notificare']) && is_array($GLOBALS['contratti_da_notificare'])
    ? $GLOBALS['contratti_da_notificare']
    : array();

if (!empty($contratti_da_notificare)) {
    // Configurazione magic link + SMTP da sec_settings.
    sc_lookup(rsAllSettings, "SELECT set_name, set_value FROM sec_settings", "pigliacelli");
    $cfg = [];
    if (!empty({rsAllSettings})) {
        foreach ({rsAllSettings} as $rSet) {
            $cfg[$rSet[0]] = $rSet[1];
            $_SESSION['sett_' . $rSet[0]] = $rSet[1];
        }
    }

    $cypherKey    = isset($cfg['sett_cypher_key']) ? trim((string)$cfg['sett_cypher_key']) : '';
    $magicLinkUrl = isset($cfg['sett_magic_link_url']) ? trim((string)$cfg['sett_magic_link_url']) : '';
    $ttlDays      = isset($cfg['magic_link_ttl_days']) ? (int)$cfg['magic_link_ttl_days'] : 30;
    if ($ttlDays <= 0) {
        $ttlDays = 30;
    }
    $subjectTpl  = isset($cfg['magic_link_mail_subject']) ? trim((string)$cfg['magic_link_mail_subject']) : '';

    if ($cypherKey === '' || $magicLinkUrl === '' || preg_match('#^https?://#i', $magicLinkUrl) !== 1) {
        log_export_tratte('MAGIC_LINK', 'config mancante: sett_cypher_key e/o sett_magic_link_url');
    } else {
        $cfgVal = function ($keys, $default = '') use ($cfg) {
            foreach ((array)$keys as $k) {
                if (isset($cfg[$k]) && trim((string)$cfg[$k]) !== '') {
                    return (string)$cfg[$k];
                }
            }
            return $default;
        };

        $smtpApi = $cfgVal(array('smtp_api', 'sett_smtp_api'));
        if ($smtpApi === 'custom') {
            $smtpCfg = array('settings' => array(
                'gateway'       => 'smtp',
                'smtp_server'   => $cfgVal(array('smtp_server', 'sett_smtp_server')),
                'smtp_protocol' => $cfgVal(array('smtp_security', 'sett_smtp_security')),
                'smtp_port'     => $cfgVal(array('smtp_port', 'sett_smtp_port')),
                'smtp_user'     => $cfgVal(array('smtp_user', 'sett_smtp_user')),
                'smtp_password' => $cfgVal(array('smtp_pass', 'sett_smtp_pass')),
                'from_email'    => $cfgVal(array('smtp_from_email', 'sett_smtp_from_email')),
                'from_name'     => $cfgVal(array('smtp_from_name', 'sett_smtp_from_name')),
            ));
        } else {
            $smtpCfg = array('profile' => $smtpApi);
        }

        $getSetting = function ($name, $default = '') use ($cfg) {
            return isset($cfg[$name]) ? (string)$cfg[$name] : $default;
        };
        $mailLogoUrl = pigliacelli_mail_logo_src($getSetting, __FILE__);

        $mailOverride = '';
        if (!empty($MAGIC_LINK_MAIL_OVERRIDE_ENABLED)) {
            $mailOverride = trim((string)$MAGIC_LINK_MAIL_OVERRIDE_TO);
            if ($mailOverride !== '' && !emailValidaSingola($mailOverride)) {
                log_export_tratte('MAGIC_LINK', 'override email non valida, ignorato: ' . $mailOverride);
                $mailOverride = '';
            } elseif ($mailOverride !== '') {
                log_export_tratte('MAGIC_LINK', 'override attivo (codice): tutte le mail a ' . $mailOverride);
            }
        }

        foreach ($contratti_da_notificare as $cid => $sid) {
            $cid = (int)$cid;
            $sid = (int)$sid;
            $info = isset($subvettore_info[$sid]) ? $subvettore_info[$sid] : null;
            $emailTo = recupera_email_subvettore_export($sid, $subvettore_info);
            if ($mailOverride !== '') {
                $emailTo = $mailOverride;
            }
            $ragione = $info !== null ? (string)$info['ragione_sociale'] : '';
            if ($ragione === '') {
                sc_lookup(rsRag, "
                    SELECT ragione_sociale
                    FROM subvettori
                    WHERE id = " . $sid . "
                    LIMIT 1
                ", "pigliacelli");
                if (!empty({rsRag})) {
                    $ragione = trim((string){rsRag[0][0]});
                }
            }

            if (!emailValidaSingola($emailTo)) {
                log_export_tratte('MAGIC_LINK', "skip contratto $cid: email subvettore non valida");
                continue;
            }

            $ok = invia_magic_link_subvettore(
                $cid,
                $sid,
                $emailTo,
                $ragione,
                $cypherKey,
                $magicLinkUrl,
                $ttlDays,
                $smtpCfg,
                $mailLogoUrl,
                $subjectTpl
            );

            if ($ok) {
                sc_exec_sql("UPDATE contratti SET magic_link_sent_at = NOW() WHERE id = " . $cid, "pigliacelli");
            }
        }
    }
}

$nuova_sync_data_ora = $fine_sync_data_ora;
if ($ultima_sync_data_ora !== null && $ultima_sync_data_ora > $fine_sync_data_ora) {
    $nuova_sync_data_ora = $ultima_sync_data_ora;
}

sc_exec_sql("
    UPDATE sec_settings
    SET set_value = " . sql_quote($nuova_sync_data_ora) . "
    WHERE set_name = 'sync_date'
", "pigliacelli");

