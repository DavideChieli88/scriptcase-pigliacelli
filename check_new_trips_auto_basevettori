function crea_contratto_tratta($tratta_id, $contratto_id, $version, $carico, $scarico, $tipo_tariffa_id, $tariffa, $extra, $totale, $hash) {
    if ($contratto_id === null) {
        log_export_tratte("WARNING", "Contratto nullo: salto collegamento tratta " . $tratta_id);
        return;
    }

    [$merce, $caricatore, $proprietario_merce] = recupera_campi_tratta_allegato($tratta_id);
    $tipo_tariffa_sql = $tipo_tariffa_id === null ? "NULL" : sql_num($tipo_tariffa_id);

    sc_exec_sql("
        INSERT INTO contratti_tratte
          (tratta_id, contratto_id, version, carico, scarico, merce, caricatore, proprietario_merce, tipo_tariffa_id, tariffa, extra, totale, hash)
        VALUES
          (" . sql_num($tratta_id) . ",
           " . sql_num($contratto_id) . ",
           " . sql_num($version) . ",
           " . sql_quote($carico) . ",
           " . sql_quote($scarico) . ",
           " . sql_quote($merce) . ",
           " . sql_quote($caricatore) . ",
           " . sql_quote($proprietario_merce) . ",
           " . $tipo_tariffa_sql . ",
           " . sql_num($tariffa) . ",
           " . sql_num($extra) . ",
           " . sql_num($totale) . ",
           " . sql_quote($hash) . ")
    ", "pigliacelli");

    // Notifica solo se l'INSERT ha effettivamente inserito una riga.
    sc_lookup(rsCtIns, "SELECT ROW_COUNT()", "pigliacelli");
    $rowCount = !empty({rsCtIns}) ? (int){rsCtIns[0][0]} : 0;
    if ($rowCount <= 0) {
        return;
    }

    sc_lookup(rsSubvContr, "
        SELECT subvettore_id
        FROM subvettori_contratti
        WHERE contratto_id = " . sql_num($contratto_id) . "
        ORDER BY id DESC
        LIMIT 1
    ", "pigliacelli");
    if (!empty({rsSubvContr})) {
        registra_contratto_da_notificare($contratto_id, (int){rsSubvContr[0][0]});
    }
}

function assicura_contratto_tratta($tratta_id, $contratto_id, $version, $carico, $scarico, $tipo_tariffa_id, $tariffa, $extra, $totale, $hash) {
    if ($contratto_id === null) {
        log_export_tratte("WARNING", "Contratto nullo: salto collegamento tratta " . $tratta_id);
        return;
    }

    sc_lookup(contrattoTrattaEsistente, "
        SELECT id
        FROM contratti_tratte
        WHERE contratto_id = " . sql_num($contratto_id) . "
          AND tratta_id = " . sql_num($tratta_id) . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({contrattoTrattaEsistente})) {
        return;
    }

    crea_contratto_tratta(
        $tratta_id,
        $contratto_id,
        $version,
        $carico,
        $scarico,
        $tipo_tariffa_id,
        $tariffa,
        $extra,
        $totale,
        $hash
    );
}

function generateTempPassword() {
    $characters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=';
    $charactersLength = strlen($characters);
    $temporaryPassword = '';

    for ($i = 0; $i < 12; $i++) {
        $temporaryPassword .= $characters[random_int(0, $charactersLength - 1)];
    }

    return $temporaryPassword;
}

function emailValidaSingola($email) {
    $email = trim((string)$email);

    if ($email === '') {
        return false;
    }

    if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
        return false;
    }

    return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
}

function crea_utenza_subvettore($subvettore_id, $email, $ragione_sociale, $phone) {
    $group_id = 2;
    $email = trim((string)$email);

    if (!emailValidaSingola($email)) {
        return null;
    }

    sc_lookup(check_user, "
        SELECT login
        FROM sec_users
        WHERE login = " . sql_quote($email) . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({check_user})) {
        return {check_user[0][0]};
    }

    $tempPassword = generateTempPassword();
    $password_hash = md5($tempPassword);

    sc_exec_sql("
        INSERT INTO sec_users (
            login,
            pswd,
            name,
            email,
            phone,
            active,
            subvettore_id
        ) VALUES (
            " . sql_quote($email) . ",
            " . sql_quote($password_hash) . ",
            " . sql_quote($ragione_sociale) . ",
            " . sql_quote($email) . ",
            " . sql_quote($phone) . ",
            'N',
            " . sql_num($subvettore_id) . "
        )
    ", "pigliacelli");

    sc_exec_sql("
        INSERT INTO sec_users_groups (
            login,
            group_id
        ) VALUES (
            " . sql_quote($email) . ",
            " . sql_num($group_id) . "
        )
    ", "pigliacelli");

    return $email;
}

