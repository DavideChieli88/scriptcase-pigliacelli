            'indirizzo' => $indirizzo,
            'sede_citta' => $sede_citta,
            'sede_prov' => $sede_prov,
            'phone' => $phone,
            'cellphone' => $cellphone,
            'email' => $email,
            'piva' => $piva,
            'cod_fiscale' => $cod_fiscale,
            'carico_str' => $carico_str,
            'scarico_str' => $scarico_str,
            'tariffa_sigla' => $tariffa_sigla,
            'importo_unitario' => $importo_unitario,
            'extra_totale' => $extra_totale,
            'partenza_data_ora' => $partenza_data_ora,
            'sync_data_ora' => $sync_data_ora,
        ];

        if (!isset($viaggi_unici[$key]) || viaggio_piu_recente($viaggio, $viaggi_unici[$key])) {
            $viaggi_unici[$key] = $viaggio;
        }
    }
} catch (PDOException $e) {
    sc_error_message("Errore elaborazione dati PDO SGA: " . $e->getMessage());
    return;
}

ksort($viaggi_unici);

$contratti_batch = [];
$GLOBALS['contratti_da_notificare'] = array();
$subvettore_info = [];

foreach ($viaggi_unici as $viaggio) {
    $codice_vettore   = $viaggio['codice_vettore'];
    $ragione_sociale  = $viaggio['ragione_sociale'];
    $indirizzo        = $viaggio['indirizzo'];
    $sede_citta       = $viaggio['sede_citta'];
    $sede_prov        = $viaggio['sede_prov'];
    $phone            = $viaggio['phone'];
    $cellphone        = $viaggio['cellphone'];
    $email            = $viaggio['email'];
    $piva             = $viaggio['piva'];
    $cod_fiscale      = $viaggio['cod_fiscale'];
    $carico_str       = $viaggio['carico_str'];
    $scarico_str      = $viaggio['scarico_str'];
    $tariffa_sigla    = $viaggio['tariffa_sigla'];
    $importo_unitario = $viaggio['importo_unitario'];
    $extra_totale     = $viaggio['extra_totale'];
    $hash             = crea_hash_tratta($carico_str, $scarico_str, $codice_vettore, $importo_unitario);

    // Recupera o crea il subvettore su pigliacelli.
    $qSub = "SELECT id FROM subvettori WHERE codice_sga = " . sql_quote($codice_vettore) . " LIMIT 1";
    sc_lookup(sub, $qSub, "pigliacelli");
    if (empty({sub})) {
        $insSub = "
          INSERT INTO subvettori
            (login_subvettore, ragione_sociale, cod_fiscale, piva, phone, cellphone,
             indirizzo, sede_citta, sede_prov, codice_sga)
          VALUES
            (" . sql_quote($email) . ",
             " . sql_quote($ragione_sociale) . ",
             " . sql_quote($cod_fiscale) . ",
             " . sql_quote($piva) . ",
             " . sql_quote($phone) . ",
             " . sql_quote($cellphone) . ",
             " . sql_quote($indirizzo) . ",
             " . sql_quote($sede_citta) . ",
             " . sql_quote($sede_prov) . ",
             " . sql_quote($codice_vettore) . ")
        ";
        sc_exec_sql($insSub, "pigliacelli");

        sc_lookup(lastSubId, "SELECT LAST_INSERT_ID()", "pigliacelli");
        if (empty({lastSubId})) {
            continue;
        }
        $subvettore_id = {lastSubId[0][0]};

        $intestatario_contratto = recupera_intestatario_contratto($subvettore_id, $email, $ragione_sociale, $phone);
    } else {
        $subvettore_id = {sub[0][0]};
        $intestatario_contratto = recupera_intestatario_contratto($subvettore_id, $email, $ragione_sociale, $phone);
    }

    if ($intestatario_contratto === null) {
        $intestatario_contratto = 'SUBVETTORE_' . $subvettore_id;
    }

    // Dati subvettore (email SGA + ragione sociale) per l'invio del magic link.
    $subvettore_info[$subvettore_id] = array(
        'email' => $email,
        'ragione_sociale' => $ragione_sociale,
    );

    if (empty({sub})) {
        // Tipo 1: Accettazione nuovo contratto quadro.
        recupera_contratto_batch($contratti_batch, 1, $intestatario_contratto, $subvettore_id);
    }

    if ($tariffa_sigla === '') $tariffa_sigla = null;
    $totale  = (0 + $importo_unitario) + (0 + $extra_totale);

    // Mappa sigla tariffa (P/G/F) -> tipo_tariffa_id
    $tipo_tariffa_id = null;
    if ($tariffa_sigla !== null) {
        $tariffa_sigla = strtoupper($tariffa_sigla);
        $qTipoTar = "SELECT id FROM tipo_tariffe WHERE UPPER(descrizione) = " . sql_quote($tariffa_sigla) . " LIMIT 1";
        sc_lookup(tipotar, $qTipoTar, "pigliacelli");
        if (!empty({tipotar})) {
            $tipo_tariffa_id = {tipotar[0][0]};
        }
    }
    $tipo_tariffa_sql = $tipo_tariffa_id === null ? "NULL" : sql_num($tipo_tariffa_id);

    // Controllo veloce per hash: se esiste, la tratta e' gia' presente.
    $qHash = "
      SELECT id
      FROM tratte
      WHERE hash = " . sql_quote($hash) . "
        AND subvettore_id = " . sql_num($subvettore_id) . "
      LIMIT 1
    ";
    sc_lookup(hashRow, $qHash, "pigliacelli");
    if (!empty({hashRow})) {
        $tratta_id_esistente = {hashRow[0][0]};
        $contratto_id = recupera_contratto_batch($contratti_batch, 2, $intestatario_contratto, $subvettore_id);
        assicura_contratto_tratta(
            $tratta_id_esistente,
            $contratto_id,
            1,
            $carico_str,
            $scarico_str,
            $tipo_tariffa_id,
            $importo_unitario,
            $extra_totale,
            $totale,
            $hash
        );
        log_tratta_senza_localita($tratta_id_esistente, $subvettore_id, $hash, $carico_str, $scarico_str);
        continue;
    }

    // Se cambia solo l'importo, l'hash cambia: cerco allora la tratta per localita.
    $qExist = "
        SELECT t.id, t.tariffa, t.extra, t.totale, t.version
        FROM tratte t
        WHERE t.subvettore_id = " . sql_num($subvettore_id) . "
          AND (
                SELECT GROUP_CONCAT(tl.localita ORDER BY tl.progressivo SEPARATOR ' + ')
                FROM tratte_localita tl
                WHERE tl.tratta_id = t.id AND tl.tipo_tratta = 'C'
              ) = " . sql_quote($carico_str) . "
          AND (
                SELECT GROUP_CONCAT(tl.localita ORDER BY tl.progressivo SEPARATOR ' + ')
                FROM tratte_localita tl
                WHERE tl.tratta_id = t.id AND tl.tipo_tratta = 'S'
              ) = " . sql_quote($scarico_str) . "
        LIMIT 1
    ";
    sc_lookup(existRow, $qExist, "pigliacelli");

    if (!empty({existRow})) {
        $tratta_id_esistente = {existRow[0][0]};
        $importo_esistente   = {existRow[0][1]};
        $extra_esistente     = {existRow[0][2]};
        $totale_esistente    = {existRow[0][3]};
        $version_esistente   = {existRow[0][4]};

        $has_modifica_tratta = (
            abs((float)$importo_esistente - (float)$importo_unitario) > 0.0001 ||
            abs((float)$extra_esistente - (float)$extra_totale) > 0.0001 ||
            abs((float)$totale_esistente - (float)$totale) > 0.0001
        );

        if ($has_modifica_tratta) {
            // Tipo 3: Modifica tariffa/tratta.
            $contratto_id = recupera_contratto_batch($contratti_batch, 3, $intestatario_contratto, $subvettore_id);
            $nuova_version = ($version_esistente === null || $version_esistente === '') ? 2 : ((int)$version_esistente + 1);

            sc_exec_sql("
                UPDATE tratte
                SET tipo_tariffa_id = " . $tipo_tariffa_sql . ",
                    tariffa = " . sql_num($importo_unitario) . ",
                    extra = " . sql_num($extra_totale) . ",
                    totale = " . sql_num($totale) . ",
                    hash = " . sql_quote($hash) . ",
                    version = " . sql_num($nuova_version) . "
                WHERE id = " . sql_num($tratta_id_esistente),
                "pigliacelli");

            crea_contratto_tratta(
                $tratta_id_esistente,
                $contratto_id,
                $nuova_version,
                $carico_str,
                $scarico_str,
                $tipo_tariffa_id,
                $importo_unitario,
                $extra_totale,
                $totale,
                $hash
            );
        } else {
            $contratto_id = recupera_contratto_batch($contratti_batch, 2, $intestatario_contratto, $subvettore_id);
            $version = ($version_esistente === null || $version_esistente === '') ? 1 : (int)$version_esistente;
            assicura_contratto_tratta(
                $tratta_id_esistente,
                $contratto_id,
                $version,
                $carico_str,
                $scarico_str,
                $tipo_tariffa_id,
                $importo_unitario,
                $extra_totale,
                $totale,
                $hash
            );
        }

        continue;
    }

    // Tipo 2: Nuovo viaggio/tratta.
    $insTratta = "
      INSERT INTO tratte
        (subvettore_id, merce, caricatore, proprietario_merce, tipo_tariffa_id, tariffa, extra, totale, hash, version)
      VALUES
        (" . sql_num($subvettore_id) . ",
         NULL, NULL, NULL,
         " . $tipo_tariffa_sql . ",
         " . sql_num($importo_unitario) . ",
         " . sql_num($extra_totale) . ",
         " . sql_num($totale) . ",
         " . sql_quote($hash) . ",
         1)
      ON DUPLICATE KEY UPDATE id = LAST_INSERT_ID(id)
    ";
    sc_exec_sql($insTratta, "pigliacelli");

    sc_lookup(lastId, "SELECT LAST_INSERT_ID(), ROW_COUNT()", "pigliacelli");
    if (empty({lastId}) || {lastId[0][0]} === null || {lastId[0][0]} === '') {
        log_export_tratte(
            "ERROR",
            "Impossibile recuperare LAST_INSERT_ID per subvettore " . $subvettore_id .
            ", hash " . $hash .
            ", carico '" . $carico_str .
            "', scarico '" . $scarico_str . "'"
        );
        continue;
    }

    $tratta_id = {lastId[0][0]};
    $row_count = (int){lastId[0][1]};

    if ($row_count !== 1) {
        log_export_tratte(
            "DUPLICATE",
            "Tratta gia' presente o inserita da job concorrente: uso tratta " . $tratta_id .
            " per subvettore " . $subvettore_id .
            ", hash " . $hash .
            ", carico '" . $carico_str .
            "', scarico '" . $scarico_str . "'"
        );
        $contratto_id = recupera_contratto_batch($contratti_batch, 2, $intestatario_contratto, $subvettore_id);
        assicura_contratto_tratta(
            $tratta_id,
            $contratto_id,
            1,
            $carico_str,
            $scarico_str,
            $tipo_tariffa_id,
            $importo_unitario,
            $extra_totale,
            $totale,
            $hash
        );
        log_tratta_senza_localita($tratta_id, $subvettore_id, $hash, $carico_str, $scarico_str);
        continue;
    }

    $contratto_id = recupera_contratto_batch($contratti_batch, 2, $intestatario_contratto, $subvettore_id);

    crea_contratto_tratta(
        $tratta_id,
        $contratto_id,
        1,
        $carico_str,
        $scarico_str,
        $tipo_tariffa_id,
        $importo_unitario,
        $extra_totale,
        $totale,
        $hash
    );

    // Inserisci località con progressivo (ordine preservato)
    $i = 1;
    foreach (split_localita($carico_str) as $loc) {
        $insLoc = "
          INSERT INTO tratte_localita (tratta_id, tipo_tratta, localita, progressivo)
          VALUES (" . sql_num($tratta_id) . ", 'C', " . sql_quote($loc) . ", " . sql_num($i) . ")
        ";
        sc_exec_sql($insLoc, "pigliacelli");
        $i++;
    }

    $i = 1;
    foreach (split_localita($scarico_str) as $loc) {
        $insLoc = "
          INSERT INTO tratte_localita (tratta_id, tipo_tratta, localita, progressivo)
          VALUES (" . sql_num($tratta_id) . ", 'S', " . sql_quote($loc) . ", " . sql_num($i) . ")
        ";
        sc_exec_sql($insLoc, "pigliacelli");
        $i++;
    }
}

