if (!function_exists('registra_contratto_da_notificare')) {
function registra_contratto_da_notificare($contratto_id, $subvettore_id) {
    $contratto_id = (int)$contratto_id;
    $subvettore_id = (int)$subvettore_id;
    if ($contratto_id <= 0 || $subvettore_id <= 0) {
        return;
    }
    if (!isset($GLOBALS['contratti_da_notificare']) || !is_array($GLOBALS['contratti_da_notificare'])) {
        $GLOBALS['contratti_da_notificare'] = array();
    }
    $GLOBALS['contratti_da_notificare'][$contratto_id] = $subvettore_id;
}
}

