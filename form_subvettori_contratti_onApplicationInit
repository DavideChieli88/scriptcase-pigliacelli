/**
 * form_subvettori_contratti (operatore) → onApplicationInit
 *
 * Configura form detail form_contratti_tratte:
 * - group_id <> 2 → insert/update/delete ON
 * - solo group 2 (subvettore) o guest → OFF
 */

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}
$_SESSION['pigliacelli_contract_form_mode'] = 'operatore';

if (!function_exists('pigliacelli_apl_conf_contratti_tratte')) {
    function pigliacelli_apl_conf_contratti_tratte($allowSave)
    {
        $state = $allowSave ? 'on' : 'off';
        sc_apl_conf('form_contratti_tratte', 'insert', $state);
        sc_apl_conf('form_contratti_tratte', 'update', $state);
        sc_apl_conf('form_contratti_tratte', 'delete', $state);
    }
}

$allowTratteSave = false;
$login = isset([usr_login]) ? trim((string)[usr_login]) : '';

if ($login !== '' && strcasecmp($login, 'guest') !== 0) {
    $loginSql = str_replace("'", "''", $login);
    sc_lookup(rsPigliacelliTratteGrp, "
        SELECT COUNT(*)
        FROM sec_users_groups
        WHERE login = '" . $loginSql . "'
          AND group_id <> 2
    ", "pigliacelli");

    if (!empty({rsPigliacelliTratteGrp[0][0]}) && (int){rsPigliacelliTratteGrp[0][0]} > 0) {
        $allowTratteSave = true;
    }
}

pigliacelli_apl_conf_contratti_tratte($allowTratteSave);
