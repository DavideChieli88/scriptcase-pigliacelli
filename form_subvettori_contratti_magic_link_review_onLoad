/**
 * form_subvettori_contratti_for_subvectors_magic_link_review
 * → onLoad
 *
 * Allineato a form_subvettori_contratti_for_subvectors_magic_link:
 * 1) Modale errore EasyGN
 * 2) Visibilità blocco autisti per tipoContrattoId (tipo 2/3 nascosto)
 *    num_iscrizione_albo resta sempre visibile; obbligatorio solo tipo 1 in onValidate.
 * 3) Precaricamento anagrafica da subvettori (campi virtuali)
 * 4) Precaricamento dati legale rappresentante da subvettori_contratti
 *    (email/telefono rappresentante: fallback da subvettori se vuoti sul contratto)
 * 5) Campi *_firmatario nascosti (non più usati: firma/mail solo su rappresentante)
 */

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}

if (!empty($_SESSION['easygn_error_modal'])) {
    $msg = $_SESSION['easygn_error_modal'];
    unset($_SESSION['easygn_error_modal']);

    sc_ajax_message(
        $msg,
        "Dati mancanti per la firma",
        "error",
        "Y",
        0,
        "OK",
        "Y",
        "350",
        "auto"
    );
}

if (!function_exists('magic_link_review_form_tipo_contratto_id_onload')) {
    function magic_link_review_form_tipo_contratto_id_onload($scId)
    {
        if ((int)$scId > 0) {
            sc_lookup(rsReviewTipoContrattoForm, "
                SELECT c.tipo_contratto_id
                FROM subvettori_contratti sc
                INNER JOIN contratti c ON c.id = sc.contratto_id
                WHERE sc.id = " . (int)$scId . "
                LIMIT 1
            ", "pigliacelli");

            if (!empty({rsReviewTipoContrattoForm[0][0]})) {
                return (int){rsReviewTipoContrattoForm[0][0]};
            }
        }

        if (isset({contratto_id}) && (int){contratto_id} > 0) {
            sc_lookup(rsReviewTipoContrattoByContratto, "
                SELECT tipo_contratto_id
                FROM contratti
                WHERE id = " . (int){contratto_id} . "
                LIMIT 1
            ", "pigliacelli");

            if (!empty({rsReviewTipoContrattoByContratto[0][0]})) {
                return (int){rsReviewTipoContrattoByContratto[0][0]};
            }
        }

        return 0;
    }
}

if (!function_exists('magic_link_review_form_apply_tipo_contratto_visibility')) {
    function magic_link_review_form_apply_tipo_contratto_visibility($tipoContrattoId)
    {
        // num_iscrizione_albo: sempre visibile; obbligatorio solo tipo 1 in onValidate.
        $displayAutisti = in_array((int)$tipoContrattoId, array(2, 3), true) ? 'off' : 'on';
        sc_block_display(subvettori_autisti, $displayAutisti);
    }
}

$subvettoreId = 0;
$emailRappSub = '';
$telRappSub   = '';
if (isset({subvettore_id}) && (int){subvettore_id} > 0) {
    $subvettoreId = (int){subvettore_id};
}

$scId = 0;
if (isset({id}) && (int){id} > 0) {
    $scId = (int){id};
} elseif (isset([subvettore_contratto_id]) && (int)[subvettore_contratto_id] > 0) {
    $scId = (int)[subvettore_contratto_id];
} elseif (isset($_GET['subvettore_contratto_id']) && (int)$_GET['subvettore_contratto_id'] > 0) {
    $scId = (int)$_GET['subvettore_contratto_id'];
} elseif (isset($_GET['id']) && (int)$_GET['id'] > 0) {
    $scId = (int)$_GET['id'];
}

magic_link_review_form_apply_tipo_contratto_visibility(
    magic_link_review_form_tipo_contratto_id_onload($scId)
);

if ($subvettoreId <= 0 && $scId > 0) {
    sc_lookup(rsReviewSubId, "
        SELECT subvettore_id
        FROM subvettori_contratti
        WHERE id = " . (int)$scId . "
        LIMIT 1
    ", "pigliacelli");
    if (!empty({rsReviewSubId[0][0]})) {
        $subvettoreId = (int){rsReviewSubId[0][0]};
    }
}

if ($subvettoreId > 0) {
    sc_lookup(rsReviewSub, "
        SELECT
            ragione_sociale,
            sede_citta,
            sede_prov,
            indirizzo,
            civico,
            cod_fiscale,
            piva,
            num_iscrizione_reg_imprese,
            locazione_iscrizione_reg_imprese,
            rea,
            cellphone,
            email_rappresentante,
            telefono_rappresentante
        FROM subvettori
        WHERE id = " . (int)$subvettoreId . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({rsReviewSub})) {
        {ragione_sociale}                  = (string){rsReviewSub[0][0]};
        {sede_citta}                       = (string){rsReviewSub[0][1]};
        {sede_prov}                        = (string){rsReviewSub[0][2]};
        {indirizzo}                        = (string){rsReviewSub[0][3]};
        {civico}                           = (string){rsReviewSub[0][4]};
        {cod_fiscale}                      = (string){rsReviewSub[0][5]};
        {piva}                             = (string){rsReviewSub[0][6]};
        {num_iscrizione_reg_imprese}       = (string){rsReviewSub[0][7]};
        {locazione_iscrizione_reg_imprese} = (string){rsReviewSub[0][8]};
        {rea}                              = (string){rsReviewSub[0][9]};
        {phone}                            = (string){rsReviewSub[0][10]};
        $emailRappSub                      = isset({rsReviewSub[0][11]}) ? trim((string){rsReviewSub[0][11]}) : '';
        $telRappSub                        = isset({rsReviewSub[0][12]}) ? trim((string){rsReviewSub[0][12]}) : '';
    }
}

if ($scId > 0) {
    sc_lookup(rsReviewScLegal, "
        SELECT
            num_iscrizione_albo,
            nome_rappresentante,
            cognome_rappresentante,
            email_rappresentante,
            telefono_rappresentante,
            luogo_nascita_rappresentante,
            prov_luogo_nascita_rappresentante,
            data_nascita_rappresentante
        FROM subvettori_contratti
        WHERE id = " . (int)$scId . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({rsReviewScLegal})) {
        {num_iscrizione_albo}               = (string){rsReviewScLegal[0][0]};
        {nome_rappresentante}               = (string){rsReviewScLegal[0][1]};
        {cognome_rappresentante}            = (string){rsReviewScLegal[0][2]};
        {email_rappresentante}              = (string){rsReviewScLegal[0][3]};
        {telefono_rappresentante}           = (string){rsReviewScLegal[0][4]};
        {luogo_nascita_rappresentante}      = (string){rsReviewScLegal[0][5]};
        {prov_luogo_nascita_rappresentante} = (string){rsReviewScLegal[0][6]};
        {data_nascita_rappresentante}       = {rsReviewScLegal[0][7]};
    }
}

if ($emailRappSub !== '' && trim((string){email_rappresentante}) === '') {
    {email_rappresentante} = $emailRappSub;
}
if ($telRappSub !== '' && trim((string){telefono_rappresentante}) === '') {
    {telefono_rappresentante} = $telRappSub;
}

if (!function_exists('pigliacelli_hide_campi_firmatario_form')) {
    function pigliacelli_hide_campi_firmatario_form()
    {
        foreach (array('nome_firmatario', 'cognome_firmatario', 'email_firmatario', 'telefono_firmatario') as $campo) {
            sc_field_display($campo, 'off');
        }
    }
}
pigliacelli_hide_campi_firmatario_form();
