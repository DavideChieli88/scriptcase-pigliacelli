/**
 * Scriptcase blank: webhook_simulate_upsert_subvector
 *
 * Simula l'arrivo di un nuovo subvettore SENZA passare da SGA, allineato a
 * upsert_subvectors_basevettori:
 *   1) subvettori              (find o insert per codice_sga)
 *   2) sec_users + group 2     (utenza attiva, password placeholder)
 *   3) CALL bootstrap_documenti_from_preset(sub_id, login)
 *   4) mail_credenziali_inviata_at = NULL (coda)
 *   5) opzionale: invio mail credenziali subito (come send_credenziali_subvettori_batch)
 *
 * UAT: di default la mail va a davide.chieli@digiwebuno.it (override).
 *      Per To=login reale: ?mail_override=0 oppure payload "mail_override": "0"
 *
 * POST JSON body (o form field "payload"):
 * {
 *   "subvettore": {
 *     "codice_sga": "TEST001",
 *     "ragione_sociale": "ACME Trasporti SRL",
 *     "email": "test.sub@example.com",
 *     "piva": "01234567890",
 *     "cod_fiscale": "01234567890",
 *     "phone": "061234567",
 *     "cellphone": "3331234567",
 *     "indirizzo": "Via Roma 1",
 *     "sede_citta": "Roma",
 *     "sede_prov": "RM",
 *     "pec": "acme@pec.it"
 *   },
 *   "send_mail": true,
 *   "mail_override": "davide.chieli@digiwebuno.it"
 * }
 *
 * GET senza body → esempio JSON + hint.
 *
 * NB: helper come CLOSURE (pattern webhook_simulate_check_new_trips).
 */

@set_time_limit(0);
@ini_set('memory_limit', '256M');

if (!headers_sent()) {
    header('Content-Type: application/json; charset=UTF-8');
    header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
}

$wh_sql_quote = function ($v) {
    if ($v === null) {
        return 'NULL';
    }
    return "'" . str_replace("'", "''", (string)$v) . "'";
};

$wh_sql_num = function ($v) {
    if ($v === null || $v === '') {
        return 'NULL';
    }
    return (string)(0 + $v);
};

$wh_valore = function ($arr, $key, $default = null) {
    if (!is_array($arr) || !array_key_exists($key, $arr)) {
        return $default;
    }
    $v = $arr[$key];
    if (is_string($v)) {
        $v = trim($v);
        if ($v === '') {
            return $default;
        }
    }
    return $v;
};

$wh_respond = function ($httpCode, array $body) {
    if (!headers_sent()) {
        http_response_code($httpCode);
    }
    echo json_encode($body, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT);
    exit;
};

$wh_email_valida = function ($email) {
    $email = trim((string)$email);
    if ($email === '') {
        return false;
    }
    if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
        return false;
    }
    return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
};

$wh_log = function ($msg) {
    sc_log_add('WEBHOOK_UPSERT_SUB', (string)$msg);
};

$wh_mail_setting = function ($name, $default = '') use ($wh_sql_quote) {
    sc_lookup(rsWhSet, "
        SELECT set_value FROM sec_settings
        WHERE set_name = " . $wh_sql_quote(trim((string)$name)) . "
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsWhSet[0][0]})) {
        return trim((string){rsWhSet[0][0]});
    }
    return (string)$default;
};

$wh_generate_temp_password = function () {
    $characters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=';
    $len = strlen($characters);
    $out = '';
    for ($i = 0; $i < 12; $i++) {
        $out .= $characters[random_int(0, $len - 1)];
    }
    return $out;
};

$wh_portal_url = function () use ($wh_mail_setting) {
    $loginUrl = rtrim($wh_mail_setting('login_url', ''), '/');
    if ($loginUrl !== '') {
        return $loginUrl;
    }
    $portalUrl = rtrim($wh_mail_setting('portal_url', ''), '/');
    if ($portalUrl !== '') {
        return $portalUrl;
    }
    return rtrim($wh_mail_setting('app_url', ''), '/');
};

$wh_risolvi_mail_override = function ($payloadOverride) use ($wh_email_valida) {
    $uatTo = 'davide.chieli@digiwebuno.it';

    $raw = '';
    if (isset($_GET['mail_override'])) {
        $raw = trim((string)$_GET['mail_override']);
    }
    if ($raw === '' && $payloadOverride !== null && $payloadOverride !== '') {
        $raw = trim((string)$payloadOverride);
    }
    if ($raw === '0') {
        return '';
    }
    if ($raw !== '' && $raw !== '1' && $wh_email_valida($raw)) {
        return $raw;
    }
    if ($raw === '1') {
        $mailTo = isset($_GET['mail_to']) ? trim((string)$_GET['mail_to']) : '';
        if ($mailTo !== '' && $wh_email_valida($mailTo)) {
            return $mailTo;
        }
    }
    return $uatTo;
};

$wh_get_smtp_config = function () use ($wh_log) {
    // Come send_credenziali_subvettori_batch: carica SMTP da sec_settings in sessione
    sc_lookup(rsWhSmtpAll, 'SELECT set_name, set_value FROM sec_settings', 'pigliacelli');
    if (!empty({rsWhSmtpAll})) {
        foreach ({rsWhSmtpAll} as $f) {
            $_SESSION['sett_' . $f[0]] = $f[1];
        }
    }

    $smtpApi = isset($_SESSION['sett_smtp_api']) ? trim((string)$_SESSION['sett_smtp_api']) : '';
    if ($smtpApi === 'custom') {
        $cfg = array(
            'settings' => array(
                'gateway'       => 'smtp',
                'smtp_server'   => isset($_SESSION['sett_smtp_server']) ? (string)$_SESSION['sett_smtp_server'] : '',
                'smtp_protocol' => isset($_SESSION['sett_smtp_security']) ? (string)$_SESSION['sett_smtp_security'] : '',
                'smtp_port'     => isset($_SESSION['sett_smtp_port']) ? (string)$_SESSION['sett_smtp_port'] : '',
                'smtp_user'     => isset($_SESSION['sett_smtp_user']) ? (string)$_SESSION['sett_smtp_user'] : '',
                'smtp_password' => isset($_SESSION['sett_smtp_pass']) ? (string)$_SESSION['sett_smtp_pass'] : '',
                'from_email'    => isset($_SESSION['sett_smtp_from_email']) ? (string)$_SESSION['sett_smtp_from_email'] : '',
                'from_name'     => isset($_SESSION['sett_smtp_from_name']) ? (string)$_SESSION['sett_smtp_from_name'] : '',
            ),
        );
        $wh_log(
            'smtp mode=custom'
            . ' server=' . ($cfg['settings']['smtp_server'] !== '' ? 'set' : 'empty')
            . ' from=' . ($cfg['settings']['from_email'] !== '' ? 'set' : 'empty')
            . ' user=' . ($cfg['settings']['smtp_user'] !== '' ? 'set' : 'empty')
        );
        return $cfg;
    }
    $wh_log('smtp mode=profile value=' . ($smtpApi !== '' ? $smtpApi : '(empty)'));
    return array('profile' => $smtpApi);
};

$wh_smtp_diag = function ($smtpCfg) {
    if (isset($smtpCfg['settings']) && is_array($smtpCfg['settings'])) {
        $s = $smtpCfg['settings'];
        return array(
            'mode'        => 'custom',
            'smtp_server' => (!empty($s['smtp_server']) ? 'set' : 'empty'),
            'smtp_port'   => isset($s['smtp_port']) ? (string)$s['smtp_port'] : '',
            'smtp_user'   => (!empty($s['smtp_user']) ? 'set' : 'empty'),
            'from_email'  => (!empty($s['from_email']) ? 'set' : 'empty'),
        );
    }
    $profile = isset($smtpCfg['profile']) ? (string)$smtpCfg['profile'] : '';
    return array(
        'mode'    => 'profile',
        'profile' => ($profile !== '' ? $profile : '(empty)'),
    );
};

// Layout mail minimale allineato allo shell Pigliacelli (logo se trovabile)
$wh_mail_logo_src = function () use ($wh_mail_setting) {
    $rel = '_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png';
    $dir = realpath(dirname(__FILE__));
    for ($i = 0; $i < 12 && $dir; $i++) {
        $try = $dir . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $rel);
        if (is_readable($try)) {
            $bin = @file_get_contents($try);
            if ($bin !== false && $bin !== '' && strlen($bin) < 500000) {
                return 'data:image/png;base64,' . base64_encode($bin);
            }
        }
        $p = dirname($dir);
        if ($p === $dir) {
            break;
        }
        $dir = $p;
    }
    $base = rtrim($wh_mail_setting('mail_base_url', ''), '/');
    if ($base !== '' && preg_match('#^https?://#i', $base) === 1) {
        return htmlspecialchars($base . '/' . $rel, ENT_QUOTES, 'UTF-8');
    }
    return '';
};

$wh_mail_layout = function ($title, $innerHtml) use ($wh_mail_logo_src) {
    $t = htmlspecialchars((string)$title, ENT_QUOTES, 'UTF-8');
    $mailLogoUrl = $wh_mail_logo_src();
    $logoTd = '';
    if ($mailLogoUrl !== '') {
        $logoTd = '<td align="right" valign="middle" style="width:148px;padding-left:16px;">'
            . '<img src="' . $mailLogoUrl . '" alt="Pigliacelli" width="140" '
            . 'style="display:block;max-width:140px;width:140px;height:auto;border:0;" />'
            . '</td>';
    }
    return '<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8">'
        . '<meta name="viewport" content="width=device-width,initial-scale=1">'
        . '<title>' . $t . '</title></head>'
        . '<body style="margin:0;padding:0;background:#eef1f4;">'
        . '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#eef1f4;">'
        . '<tr><td align="center" style="padding:32px 16px;">'
        . '<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" '
        . 'style="max-width:600px;width:100%;background:#fff;border-radius:12px;border:1px solid #dde1e6;">'
        . '<tr><td style="padding:22px 28px 18px;border-bottom:1px solid #e8ebef;background:#fafbfc;">'
        . '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>'
        . '<td valign="middle" style="font-family:Arial,Helvetica,sans-serif;font-size:19px;font-weight:bold;color:#1a3a5c;line-height:1.3;">' . $t . '</td>'
        . $logoTd . '</tr></table></td></tr>'
        . '<tr><td style="padding:26px 28px 22px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#2d3748;">'
        . $innerHtml . '</td></tr>'
        . '<tr><td style="padding:14px 28px;background:#f4f6f8;border-top:1px solid #e8ebef;'
        . 'font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#718096;">'
        . 'Messaggio automatico &mdash; non rispondere.</td></tr>'
        . '</table></td></tr></table></body></html>';
};

$wh_invia_mail_credenziali = function ($to, $login, $plainPassword, $displayName, $mailOverride)
    use ($wh_email_valida, $wh_portal_url, $wh_get_smtp_config, $wh_smtp_diag, $wh_mail_layout, $wh_log) {
    $toOrig = trim((string)$to);
    $to = ($mailOverride !== '') ? $mailOverride : $toOrig;
    $login = trim((string)$login);
    $plainPassword = (string)$plainPassword;

    if ($plainPassword === '' || !$wh_email_valida($to) || $login === '') {
        return array(
            'esito' => 'skip',
            'error' => 'to/login/password non validi',
            'smtp_diag' => null,
        );
    }
    if (!function_exists('sc_send_mail_api')) {
        $wh_log('SKIP sc_send_mail_api assente login=' . $login);
        return array(
            'esito' => 'errore',
            'error' => 'sc_send_mail_api non disponibile in questa blank',
            'smtp_diag' => null,
        );
    }

    $portalUrl = $wh_portal_url();
    $nome = trim((string)$displayName);
    if ($nome === '') {
        $nome = 'Gentile subvettore';
    }

    $titolo = 'Credenziali area riservata — Pigliacelli';
    if ($mailOverride !== '') {
        $titolo = '(UAT) ' . $titolo;
    }

    $testo = $nome . ",\n\n"
        . "E' stato creato il tuo accesso all'area riservata subvettori.\n"
        . "Puoi accedere con le credenziali seguenti (password temporanea).\n\n"
        . "Login: " . $login . "\n"
        . "Password: " . $plainPassword . "\n";
    if ($portalUrl !== '') {
        $testo .= "\nArea riservata: " . $portalUrl . "\n";
    }
    $testo .= "\nMessaggio automatico — non rispondere.";

    $safeLogin = htmlspecialchars($login, ENT_QUOTES, 'UTF-8');
    $safePwd = htmlspecialchars($plainPassword, ENT_QUOTES, 'UTF-8');
    $safeNome = htmlspecialchars($nome, ENT_QUOTES, 'UTF-8');
    $inner = '<p style="margin:0 0 16px;">' . $safeNome . ',</p>'
        . '<p style="margin:0 0 20px;">E\' stato creato il tuo accesso all\'<strong>area riservata subvettori</strong>. '
        . 'Ecco le credenziali (password temporanea).</p>'
        . '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" '
        . 'style="margin:0 0 20px;background:#f8f9fb;border:1px solid #e2e6ea;border-radius:8px;">'
        . '<tr><td style="padding:16px 18px;font-size:14px;line-height:1.6;">'
        . '<strong>Login:</strong> ' . $safeLogin . '<br><strong>Password:</strong> ' . $safePwd
        . '</td></tr></table>';
    if ($portalUrl !== '') {
        $safePortal = htmlspecialchars($portalUrl, ENT_QUOTES, 'UTF-8');
        $inner .= '<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px;"><tr>'
            . '<td align="center" bgcolor="#5b2d8e" style="border-radius:8px;background-color:#5b2d8e;">'
            . '<a href="' . $safePortal . '" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;'
            . 'color:#ffffff;text-decoration:none;">Accedi all\'area riservata</a>'
            . '</td></tr></table>';
    }

    $html = $wh_mail_layout($titolo, $inner);
    $smtpCfg = $wh_get_smtp_config();
    $smtpDiag = $wh_smtp_diag($smtpCfg);

    if (
        (isset($smtpCfg['profile']) && trim((string)$smtpCfg['profile']) === '')
        || (
            isset($smtpCfg['settings'])
            && (
                trim((string)$smtpCfg['settings']['smtp_server']) === ''
                || trim((string)$smtpCfg['settings']['from_email']) === ''
            )
        )
    ) {
        $err = 'SMTP non configurato (sec_settings smtp_api/server/from vuoti). Controlla smtp_diag.';
        $wh_log('ERRORE mail ' . $err);
        return array('esito' => 'errore', 'error' => $err, 'smtp_diag' => $smtpDiag);
    }

    try {
        $mailOk = sc_send_mail_api(array_merge($smtpCfg, array(
            'message' => array(
                'html'    => $html,
                'text'    => $testo,
                'to'      => $to,
                'subject' => $titolo,
            ),
        )));
    } catch (Exception $e) {
        $lastError = $e->getMessage();
        $wh_log('ERRORE mail Exception login=' . $login . ' to=' . $to . ' msg=' . $lastError);
        return array('esito' => 'errore', 'error' => $lastError, 'smtp_diag' => $smtpDiag);
    } catch (Throwable $e) {
        $lastError = $e->getMessage();
        $wh_log('ERRORE mail Throwable login=' . $login . ' to=' . $to . ' msg=' . $lastError);
        return array('esito' => 'errore', 'error' => $lastError, 'smtp_diag' => $smtpDiag);
    }

    if ($mailOk === false || $mailOk === null) {
        $err = 'sc_send_mail_api ha restituito false/null (SMTP rifiutato o profilo errato)';
        $wh_log('ERRORE mail login=' . $login . ' to=' . $to . ' msg=' . $err);
        return array('esito' => 'errore', 'error' => $err, 'smtp_diag' => $smtpDiag);
    }

    $wh_log('OK mail login=' . $login . ' to=' . $to . ($toOrig !== $to ? ' orig=' . $toOrig : ''));
    return array('esito' => 'inviata', 'error' => '', 'smtp_diag' => $smtpDiag);
};

// --- Lettura payload ---
$rawBody = (string)@file_get_contents('php://input');
if (trim($rawBody) === '' && isset($_POST['payload'])) {
    $rawBody = (string)$_POST['payload'];
}
if (trim($rawBody) === '' && isset($GLOBALS['HTTP_RAW_POST_DATA'])) {
    $rawBody = (string)$GLOBALS['HTTP_RAW_POST_DATA'];
}
if (trim($rawBody) === '' && is_array($_POST) && count($_POST) === 1) {
    $solaChiave = array_keys($_POST)[0];
    $solaValore = $_POST[$solaChiave];
    if (is_string($solaValore) && trim($solaValore) === '' && strpos($solaChiave, '{') === 0) {
        $rawBody = $solaChiave;
    } elseif (is_string($solaValore) && strpos(trim($solaValore), '{') === 0) {
        $rawBody = $solaValore;
    }
}
$rawBody = preg_replace('/^\xEF\xBB\xBF/', '', $rawBody);

$examplePayload = array(
    'subvettore' => array(
        'codice_sga'      => 'TEST_SIM_' . date('YmdHis'),
        'ragione_sociale' => 'ACME Trasporti SRL',
        'email'           => 'test.sub.sim@example.com',
        'piva'            => '01234567890',
        'cod_fiscale'     => '01234567890',
        'phone'           => '061234567',
        'cellphone'       => '3331234567',
        'indirizzo'       => 'Via Roma 1',
        'sede_citta'      => 'Roma',
        'sede_prov'       => 'RM',
        'pec'             => 'acme@pec.it',
    ),
    'send_mail'     => true,
    'mail_override' => 'davide.chieli@digiwebuno.it',
);

if (trim($rawBody) === '') {
    $wh_respond(200, array(
        'ok'      => true,
        'help'    => 'POST JSON per simulare upsert subvettore (utenza + bootstrap docs + mail).',
        'example' => $examplePayload,
        'query'   => array(
            'mail_override' => 'email | 1 | 0 (0 = invio al login reale)',
            'send_mail'     => '0 per non inviare (solo coda)',
            'dry_run'       => '1 = nessuna scrittura',
        ),
    ));
}

$data = json_decode(trim($rawBody), true);
if (!is_array($data)) {
    $wh_respond(400, array(
        'ok'    => false,
        'error' => 'Payload JSON mancante o non valido.',
        'hint'  => 'Usare URL con slash finale; body Content-Type: application/json.',
        'example' => $examplePayload,
    ));
}

$dryRun = (isset($_GET['dry_run']) && (string)$_GET['dry_run'] === '1');
$sendMail = true;
if (isset($_GET['send_mail']) && (string)$_GET['send_mail'] === '0') {
    $sendMail = false;
}
if (array_key_exists('send_mail', $data)) {
    $sendMail = (bool)$data['send_mail'];
}

$sub = is_array($wh_valore($data, 'subvettore')) ? $data['subvettore'] : $data;

$codice_sga      = $wh_valore($sub, 'codice_sga', $wh_valore($sub, 'codice_vettore'));
$ragione_sociale = $wh_valore($sub, 'ragione_sociale');
$piva            = $wh_valore($sub, 'piva');
$cod_fiscale     = $wh_valore($sub, 'cod_fiscale');
$indirizzo       = $wh_valore($sub, 'indirizzo');
$sede_citta      = $wh_valore($sub, 'sede_citta');
$sede_prov       = $wh_valore($sub, 'sede_prov');
$phone           = $wh_valore($sub, 'phone');
$cellphone       = $wh_valore($sub, 'cellphone');
$email           = $wh_valore($sub, 'email', $wh_valore($sub, 'login_subvettore'));
$pec             = $wh_valore($sub, 'pec');

if ($codice_sga === null) {
    $wh_respond(400, array('ok' => false, 'error' => 'subvettore.codice_sga (o codice_vettore) obbligatorio.'));
}
if (!$wh_email_valida($email)) {
    $wh_respond(400, array('ok' => false, 'error' => 'subvettore.email obbligatoria e valida (diventa login).'));
}

$mailOverride = $wh_risolvi_mail_override($wh_valore($data, 'mail_override'));

$wh_log(
    'START codice_sga=' . $codice_sga
    . ' email=' . $email
    . ($dryRun ? ' [DRY_RUN]' : '')
    . ' send_mail=' . ($sendMail ? '1' : '0')
    . ($mailOverride !== '' ? ' override=' . $mailOverride : ' override=OFF')
);

// --- 1) Find o insert subvettore ---
sc_lookup(rsWhSub, "
    SELECT id, login_subvettore
    FROM subvettori
    WHERE codice_sga = " . $wh_sql_quote($codice_sga) . "
    LIMIT 1
", 'pigliacelli');

$subvettore_creato = false;
$subvettore_id = 0;
$utenza_creata = false;
$bootstrap_ok = false;
$mail_coda = false;
$mail_esito = 'skip';
$mail_error = '';
$smtp_diag = null;
$docs_count = 0;
$plainPassword = '';

if (!empty({rsWhSub[0][0]})) {
    $subvettore_id = (int){rsWhSub[0][0]};
    $wh_log('subvettore esistente id=' . $subvettore_id . ' codice_sga=' . $codice_sga);
} else {
    if ($dryRun) {
        $wh_respond(200, array(
            'ok'                => true,
            'dry_run'           => true,
            'would_insert'      => true,
            'codice_sga'        => $codice_sga,
            'email'             => $email,
            'send_mail'         => $sendMail,
            'mail_override'     => $mailOverride !== '' ? $mailOverride : null,
        ));
    }

    sc_exec_sql("
        INSERT INTO subvettori
            (login_subvettore, ragione_sociale, cod_fiscale, piva, phone, cellphone,
             indirizzo, sede_citta, sede_prov, codice_sga, pec, wizard_complete,
             mail_credenziali_inviata_at)
        VALUES
            (" . $wh_sql_quote($email) . ",
             " . $wh_sql_quote($ragione_sociale) . ",
             " . $wh_sql_quote($cod_fiscale) . ",
             " . $wh_sql_quote($piva) . ",
             " . $wh_sql_quote($phone) . ",
             " . $wh_sql_quote($cellphone) . ",
             " . $wh_sql_quote($indirizzo) . ",
             " . $wh_sql_quote($sede_citta) . ",
             " . $wh_sql_quote($sede_prov) . ",
             " . $wh_sql_quote($codice_sga) . ",
             " . $wh_sql_quote($pec) . ",
             0,
             NULL)
    ", 'pigliacelli');

    sc_lookup(rsWhLastSub, 'SELECT LAST_INSERT_ID()', 'pigliacelli');
    $subvettore_id = !empty({rsWhLastSub[0][0]}) ? (int){rsWhLastSub[0][0]} : 0;
    if ($subvettore_id <= 0) {
        $wh_respond(500, array('ok' => false, 'error' => 'Inserimento subvettore fallito.'));
    }
    $subvettore_creato = true;
    $wh_log('INSERT subvettore id=' . $subvettore_id);
}

// --- 2) Utenza (active=Y, group 2) ---
sc_lookup(rsWhUser, "
    SELECT login, active
    FROM sec_users
    WHERE login = " . $wh_sql_quote($email) . "
    LIMIT 1
", 'pigliacelli');

if (!empty({rsWhUser[0][0]})) {
    $loginEsistenteSub = null;
    sc_lookup(rsWhUserSub, "
        SELECT subvettore_id FROM sec_users
        WHERE login = " . $wh_sql_quote($email) . "
        LIMIT 1
    ", 'pigliacelli');
    $ownerSub = !empty({rsWhUserSub[0][0]}) ? (int){rsWhUserSub[0][0]} : 0;
    if ($ownerSub > 0 && $ownerSub !== $subvettore_id) {
        $wh_respond(409, array(
            'ok'    => false,
            'error' => 'email già usata come login di un altro subvettore.',
            'subvettore_id_esistente' => $ownerSub,
        ));
    }
    sc_exec_sql("
        UPDATE sec_users
        SET email = " . $wh_sql_quote($email) . ",
            name = " . $wh_sql_quote($ragione_sociale) . ",
            phone = " . $wh_sql_quote($phone) . ",
            active = 'Y',
            subvettore_id = " . $wh_sql_num($subvettore_id) . "
        WHERE login = " . $wh_sql_quote($email) . "
    ", 'pigliacelli');
    sc_lookup(rsWhGrp, "
        SELECT 1 FROM sec_users_groups
        WHERE login = " . $wh_sql_quote($email) . " AND group_id = 2
        LIMIT 1
    ", 'pigliacelli');
    if (empty({rsWhGrp})) {
        sc_exec_sql("
            INSERT INTO sec_users_groups (login, group_id)
            VALUES (" . $wh_sql_quote($email) . ", 2)
        ", 'pigliacelli');
    }
    sc_exec_sql("
        UPDATE subvettori
        SET login_subvettore = " . $wh_sql_quote($email) . "
        WHERE id = " . $wh_sql_num($subvettore_id) . "
    ", 'pigliacelli');
    $wh_log('UTENZA aggiornata login=' . $email);
} else {
    $plainPlaceholder = $wh_generate_temp_password();
    sc_exec_sql("
        INSERT INTO sec_users (login, pswd, name, email, phone, active, subvettore_id)
        VALUES (
            " . $wh_sql_quote($email) . ",
            " . $wh_sql_quote(md5($plainPlaceholder)) . ",
            " . $wh_sql_quote($ragione_sociale) . ",
            " . $wh_sql_quote($email) . ",
            " . $wh_sql_quote($phone) . ",
            'Y',
            " . $wh_sql_num($subvettore_id) . "
        )
    ", 'pigliacelli');
    sc_exec_sql("
        INSERT INTO sec_users_groups (login, group_id)
        VALUES (" . $wh_sql_quote($email) . ", 2)
    ", 'pigliacelli');
    sc_exec_sql("
        UPDATE subvettori
        SET login_subvettore = " . $wh_sql_quote($email) . "
        WHERE id = " . $wh_sql_num($subvettore_id) . "
    ", 'pigliacelli');
    $utenza_creata = true;
    $wh_log('UTENZA creata login=' . $email . ' sub=' . $subvettore_id);
}

// --- 3) Bootstrap documenti preset ---
try {
    sc_exec_sql("
        CALL bootstrap_documenti_from_preset(
            " . $wh_sql_num($subvettore_id) . ",
            " . $wh_sql_quote($email) . "
        )
    ", 'pigliacelli');
    $bootstrap_ok = true;
    $wh_log('bootstrap_documenti_from_preset ok sub=' . $subvettore_id);
} catch (Throwable $e) {
    $wh_log('bootstrap ERRORE sub=' . $subvettore_id . ' — ' . $e->getMessage());
}

sc_lookup(rsWhDocs, "
    SELECT COUNT(*) FROM documenti WHERE subvettore_id = " . $wh_sql_num($subvettore_id) . "
", 'pigliacelli');
$docs_count = !empty({rsWhDocs[0][0]}) ? (int){rsWhDocs[0][0]} : 0;

// --- 4) Coda mail ---
sc_exec_sql("
    UPDATE subvettori
    SET mail_credenziali_inviata_at = NULL
    WHERE id = " . $wh_sql_num($subvettore_id) . "
", 'pigliacelli');
$mail_coda = true;
$wh_log('MAIL_CRED in coda sub=' . $subvettore_id);

// --- 5) Invio mail immediato (opzionale) ---
if ($sendMail) {
    $plainPassword = $wh_generate_temp_password();
    sc_exec_sql("
        UPDATE sec_users
        SET pswd = " . $wh_sql_quote(md5($plainPassword)) . "
        WHERE login = " . $wh_sql_quote($email) . "
          AND subvettore_id = " . $wh_sql_num($subvettore_id) . "
        LIMIT 1
    ", 'pigliacelli');

    $mailRes = $wh_invia_mail_credenziali(
        $email,
        $email,
        $plainPassword,
        $ragione_sociale !== null ? $ragione_sociale : '',
        $mailOverride
    );
    $mail_esito = isset($mailRes['esito']) ? (string)$mailRes['esito'] : 'errore';
    $mail_error = isset($mailRes['error']) ? (string)$mailRes['error'] : '';
    $smtp_diag = isset($mailRes['smtp_diag']) ? $mailRes['smtp_diag'] : null;

    if ($mail_esito === 'inviata') {
        sc_exec_sql("
            UPDATE subvettori
            SET mail_credenziali_inviata_at = NOW()
            WHERE id = " . $wh_sql_num($subvettore_id) . "
        ", 'pigliacelli');
        $mail_coda = false;
    }
}

sc_lookup(rsBase, "SELECT set_value FROM sec_settings WHERE set_name = 'mail_base_url' LIMIT 1", 'pigliacelli');
$baseUrl = empty({rsBase[0][0]}) ? '' : rtrim((string){rsBase[0][0]}, '/');
$batchUrl = ($baseUrl !== '')
    ? ($baseUrl . '/send_credenziali_subvettori_batch/?limit=1')
    : '';

$wh_log(
    'FINE sub=' . $subvettore_id
    . ' creato=' . ($subvettore_creato ? '1' : '0')
    . ' utenza_nuova=' . ($utenza_creata ? '1' : '0')
    . ' docs=' . $docs_count
    . ' mail=' . $mail_esito
);

$wh_respond(200, array(
    'ok'                  => true,
    'subvettore_id'       => $subvettore_id,
    'subvettore_creato'   => $subvettore_creato,
    'codice_sga'          => $codice_sga,
    'login'               => $email,
    'utenza_creata'       => $utenza_creata,
    'bootstrap_ok'        => $bootstrap_ok,
    'documenti_count'     => $docs_count,
    'mail_in_coda'        => $mail_coda,
    'mail_inviata'        => ($mail_esito === 'inviata'),
    'mail_esito'          => $mail_esito,
    'mail_error'          => ($mail_error !== '' ? $mail_error : null),
    'smtp_diag'           => $smtp_diag,
    'code_version'        => 'upsert_sub_wh_mail_v2',
    'mail_to'             => ($mailOverride !== '' ? $mailOverride : $email),
    'mail_override'       => ($mailOverride !== '' ? $mailOverride : null),
    'password_temporanea' => ($mail_esito === 'inviata' ? $plainPassword : null),
    'test_urls'           => array(
        'send_credenziali_batch' => $batchUrl,
        'starting_wizard_hint'   => 'Login con login/password ricevuti → form_subvettori_starting_wizard se wizard_complete=0',
    ),
));
