/**
 * form_subvettori_for_subvectors → onScriptInit
 *
 * Scriptcase NON espande subquery/COALESCE nella WHERE della form
 * (errore: "where (id = )"). Serve globale numerica + WHERE semplice.
 *
 * Setup Scriptcase:
 * 1) Variabile globale: subvettoreId (Integer, default 0)
 * 2) Sezione SQL → WHERE: id = [subvettoreId]
 * 3) Connessione: pigliacelli
 * 4) Form tipo Update (un record)
 */

[subvettoreId] = 0;

$usrLogin = trim((string)[usr_login]);
if ($usrLogin === '') {
    sc_error_message('Sessione non valida.');
    sc_redir('app_menu');
    exit;
}

$usrSql = str_replace("'", "''", $usrLogin);

sc_lookup(rsSubForVec, "
    SELECT COALESCE(
        (SELECT su.subvettore_id
         FROM sec_users su
         INNER JOIN sec_users_groups sug ON sug.login = su.login
         WHERE su.login = '$usrSql'
           AND su.active = 'Y'
           AND sug.group_id = 2
           AND su.subvettore_id > 0
         LIMIT 1),
        (SELECT s.id
         FROM subvettori s
         WHERE TRIM(s.login_subvettore) = '$usrSql'
         LIMIT 1)
    ) AS sub_id
", 'pigliacelli');

$subId = !empty({rsSubForVec[0][0]}) ? (int){rsSubForVec[0][0]} : 0;

if ($subId <= 0) {
    sc_error_message('Subvettore non associato al tuo account. Contattare Pigliacelli.');
    sc_redir('app_menu');
    exit;
}

[subvettoreId] = $subId;
