/**
 * Webhook EasyGN / Yousign (callback POST).
 *
 * Flusso atteso (tipo 1, firma ordinata) — 3 chiamate HTTP:
 *   1) type=member, status=done  → vettore firmato → firmato_il, email committente, In attesa firma committente
 *   2) type=member, status=done  → committente firmato → nessuna email (in attesa chiusura procedura)
 *   3) type=procedure, status=done → Completato, data_inizio_contratto, attiva utente
 *      + mail completamento al subvettore (credenziali se active=N, link area riservata se active=Y)
 *      + mail completamento al committente (notifica, senza credenziali)
 *   Rifiuti member/procedure → Rifiutato dal subvettore / Rifiutato dal committente (+ motivo in contratti.notes da body.comments)
 *
 * File: web_hook_firma/api_logs/GG-MM-AAAA.txt | Log: sc_log_add('WEBHOOK_FIRMA', …)
 */
$GLOBALS['webhook_last_log_file'] = '';
if (!ob_get_level()) {
    ob_start();
}
register_shutdown_function(function () {
    $err = error_get_last();
    if ($err === null || !in_array($err['type'], [E_ERROR, E_PARSE, E_CORE_ERROR, E_COMPILE_ERROR], true)) {
        return;
    }
    if (function_exists('sc_log_add')) {
        sc_log_add('WEBHOOK_FIRMA', 'FATAL: ' . $err['message'] . ' in ' . $err['file'] . ':' . $err['line']);
    }
    webhook_file_log('FATAL: ' . $err['message'] . ' in ' . $err['file'] . ':' . $err['line']);
});
$json = webhook_read_raw_body();
$callback = json_decode($json, true);
$isValid = is_array($callback);
if (!$isValid) {
    $callback = webhook_callback_from_request_params();
    $isValid = is_array($callback);
    if ($isValid) {
        $json = json_encode($callback, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    }
}
$status = $isValid && isset($callback['status']) ? (string)$callback['status'] : '';
$tipo = $isValid && isset($callback['type']) ? (string)$callback['type'] : '';
$idEsterno = '';
if ($isValid) {
    $idEsterno = webhook_extract_workflow_id($callback);
    if ($idEsterno === '' && !empty($callback['id'])) {
        $idEsterno = trim((string)$callback['id']);
    }
}
$len = strlen((string)$json);
webhook_file_log('--- HIT type=' . $tipo . ' status=' . $status . ' id_esterno=' . $idEsterno . ' json_len=' . $len . ' valid=' . ($isValid ? '1' : '0'));
webhook_file_log($json === '' ? '(body empty)' : $json);
webhook_sc_log('type=' . $tipo . ' status=' . $status . ' id_esterno=' . $idEsterno . ' json_len=' . $len . ' valid=' . ($isValid ? '1' : '0') . ' log_file=' . (string)$GLOBALS['webhook_last_log_file']);
if (!$isValid) {
    header('Content-Type: application/json; charset=utf-8');
    http_response_code(200);
    echo json_encode(array(
        'ok' => true,
        'logged' => true,
        'note' => 'invalid_json',
        'log_file' => (string)$GLOBALS['webhook_last_log_file'],
    ), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    exit;
}
$workflowId = webhook_extract_workflow_id($callback);
if ($workflowId === '' && $idEsterno !== '') {
    $workflowId = $idEsterno;
}
$memberId = ($tipo === 'member' && !empty($callback['id'])) ? trim((string)$callback['id']) : '';
$contrattoId = webhook_find_contratto_id($workflowId, $memberId);
$documentoId = 0;
if ($contrattoId <= 0) {
    $documentoId = webhook_find_documento_id($workflowId, $memberId);
}
$statoNome = webhook_resolve_stato_nome($tipo, $status);

if ($documentoId > 0) {
    try {
        if ($tipo === 'member') {
            webhook_handle_documento_member_callback($documentoId, $memberId, $status, $statoNome, $callback);
        } elseif ($tipo === 'procedure' || $tipo === 'workflow') {
            webhook_handle_documento_procedure_callback($documentoId, $status, $statoNome, $tipo, $callback);
        } else {
            webhook_sc_log('documentoId=' . $documentoId . ' type=' . $tipo . ' ignorato');
        }
    } catch (Throwable $e) {
        webhook_sc_log('documento handler EXCEPTION: ' . $e->getMessage());
    }
} elseif ($contrattoId <= 0 && ($tipo === 'member' || $tipo === 'procedure' || $tipo === 'workflow')) {
    webhook_sc_log(
        'contratto/documento non trovato workflowId=[' . $workflowId . '] id_esterno=[' . $idEsterno
        . '] memberId=[' . $memberId . '] stato=' . ($statoNome !== null ? $statoNome : '-')
        . ' — verificare easygn_workflow_id su contratti o documenti'
    );
} elseif ($tipo === 'member') {
    try {
        webhook_handle_member_callback($contrattoId, $memberId, $status, $statoNome, $callback);
    } catch (Throwable $e) {
        webhook_sc_log('member handler EXCEPTION: ' . $e->getMessage());
    }
} elseif ($tipo === 'procedure' || $tipo === 'workflow') {
    try {
        webhook_handle_procedure_callback($contrattoId, $status, $statoNome, $tipo, $callback);
    } catch (Throwable $e) {
        webhook_sc_log('procedure handler EXCEPTION: ' . $e->getMessage());
    }
}
while (ob_get_level() > 0) {
    ob_end_clean();
}
header('Content-Type: application/json; charset=utf-8');
http_response_code(200);
echo json_encode(array(
    'ok' => true,
    'contratto_id' => (int)$contrattoId,
    'documento_id' => (int)$documentoId,
    'workflow_id' => (string)$workflowId,
    'id_esterno' => (string)$idEsterno,
    'stato' => $statoNome,
    'log_file' => (string)$GLOBALS['webhook_last_log_file'],
), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
exit;

/** Body POST reale EasyGN (php input) + fallback per test ScriptCase / Postman */
function webhook_read_raw_body()
{
    $raw = @file_get_contents('php:' . chr(47) . chr(47) . 'input');
    if ($raw !== false && trim((string)$raw) !== '') {
        return (string)$raw;
    }
    foreach (['webhook_body', 'body', 'json', 'payload', 'callback'] as $key) {
        if (!empty($_POST[$key]) && is_string($_POST[$key])) {
            return trim((string)$_POST[$key]);
        }
        if (!empty($_GET[$key]) && is_string($_GET[$key])) {
            return trim((string)$_GET[$key]);
        }
    }
    return '';
}

/** Se il JSON non arriva in input (test blank SC), prova campi type/status/id in POST/GET */
function webhook_callback_from_request_params()
{
    $src = array_merge($_GET, $_POST);
    if (empty($src['type']) || empty($src['status'])) {
        return null;
    }
    $cb = array(
        'type' => trim((string)$src['type']),
        'status' => trim((string)$src['status']),
    );
    if (!empty($src['id'])) {
        $cb['id'] = trim((string)$src['id']);
    }
    return $cb;
}

function webhook_resolve_log_dir()
{
    static $resolved = null;
    if ($resolved !== null) {
        return $resolved;
    }
    # Cartella accanto a index.php: .../web_hook_firma/api_logs/ (come il blank del collega)
    $candidates = array();
    if (defined('__DIR__')) {
        $candidates[] = __DIR__ . DIRECTORY_SEPARATOR . 'api_logs';
    }
    $candidates[] = 'api_logs';
    sc_lookup(rsLogDir, "SELECT set_value FROM sec_settings WHERE set_name = 'webhook_log_dir' LIMIT 1");
    if (!empty({rsLogDir[0][0]})) {
        array_unshift($candidates, rtrim((string){rsLogDir[0][0]}, "/\\"));
    }
    foreach ($candidates as $dir) {
        $dir = trim((string)$dir);
        if ($dir === '') {
            continue;
        }
        if (!is_dir($dir)) {
            @mkdir($dir, 0755, true);
        }
        if (is_dir($dir) && is_writable($dir)) {
            $resolved = $dir;
            return $resolved;
        }
    }
    $resolved = sys_get_temp_dir();
    return $resolved;
}

function webhook_file_log($line)
{
    $dir = webhook_resolve_log_dir();
    $file = $dir . DIRECTORY_SEPARATOR . date('d-m-Y') . '.txt';
    @file_put_contents($file, date('H:i:s') . ' ' . (string)$line . "\n", FILE_APPEND | LOCK_EX);
    $GLOBALS['webhook_last_log_file'] = $file;
    return $file;
}

function webhook_sc_log($msg)
{
    $msg = (string)$msg;
    webhook_file_log('SC ' . $msg);
    if (function_exists('sc_log_add')) {
        sc_log_add('WEBHOOK_FIRMA', $msg);
    }
}

function webhook_sql_quote($s)
{
    return str_replace("'", "''", (string)$s);
}

function webhook_is_http_url($url)
{
    $url = trim((string)$url);
    if ($url === '') {
        return false;
    }
    $sl = chr(47);
    $pfx1 = 'http:' . $sl . $sl;
    $pfx2 = 'https:' . $sl . $sl;
    return stripos($url, $pfx1) === 0 || stripos($url, $pfx2) === 0;
}

function webhook_extract_workflow_id(array $callback)
{
    foreach (['workflowId', 'workflow_id', 'procedureId', 'procedure_id'] as $k) {
        if (!empty($callback[$k])) {
            return trim((string)$callback[$k]);
        }
    }
    foreach (['workflow', 'procedure'] as $nest) {
        if (!isset($callback[$nest]) || !is_array($callback[$nest])) {
            continue;
        }
        $obj = $callback[$nest];
        foreach (['id', 'workflowId', 'workflow_id', 'procedureId', 'procedure_id'] as $k) {
            if (!empty($obj[$k])) {
                return trim((string)$obj[$k]);
            }
        }
    }
    $tipoCb = strtolower(trim((string)($callback['type'] ?? '')));
    if (!empty($callback['id']) && ($tipoCb === 'procedure' || $tipoCb === 'workflow')) {
        return trim((string)$callback['id']);
    }
    return '';
}

function webhook_find_contratto_id($workflowId, $memberId = '')
{
    $workflowId = trim((string)$workflowId);
    $memberId = trim((string)$memberId);
    if ($workflowId !== '') {
        $wf = webhook_sql_quote($workflowId);
        sc_lookup(rsWf, "SELECT id FROM contratti WHERE easygn_workflow_id = '$wf' LIMIT 1");
        if (!empty({rsWf[0][0]})) {
            return (int){rsWf[0][0]};
        }
    }
    if ($memberId !== '') {
        $mid = webhook_sql_quote($memberId);
        # JSON oggetto signer_id_firmatario / signer_id_committente o legacy array
        sc_lookup(rsMem, "SELECT id FROM contratti WHERE easygn_signer_ids LIKE '%$mid%' LIMIT 1");
        if (!empty({rsMem[0][0]})) {
            return (int){rsMem[0][0]};
        }
    }
    return 0;
}

function webhook_find_documento_id($workflowId, $memberId = '')
{
    $workflowId = trim((string)$workflowId);
    $memberId = trim((string)$memberId);
    if ($workflowId !== '') {
        $wf = webhook_sql_quote($workflowId);
        sc_lookup(rsDocWf, "SELECT id FROM documenti WHERE easygn_workflow_id = '$wf' LIMIT 1");
        if (!empty({rsDocWf[0][0]})) {
            return (int){rsDocWf[0][0]};
        }
    }
    if ($memberId !== '') {
        $mid = webhook_sql_quote($memberId);
        sc_lookup(rsDocMem, "SELECT id FROM documenti WHERE easygn_signer_ids LIKE '%$mid%' LIMIT 1");
        if (!empty({rsDocMem[0][0]})) {
            return (int){rsDocMem[0][0]};
        }
    }
    return 0;
}

function webhook_stato_id_by_nome($nome)
{
    static $cache = [];
    $nome = trim((string)$nome);
    if ($nome === '') {
        return 0;
    }
    if (isset($cache[$nome])) {
        return $cache[$nome];
    }
    $n = webhook_sql_quote($nome);
    sc_lookup(rsSt, "SELECT id FROM stati_contratti WHERE nome = '$n' LIMIT 1");
    $cache[$nome] = !empty({rsSt[0][0]}) ? (int){rsSt[0][0]} : 0;
    return $cache[$nome];
}
/**
 * @return string|null Nome stato in stati_contratti, o null se non va aggiornato il contratto
 */

function webhook_refusal_status_list()
{
    return [
        'refused', 'rejected', 'declined', 'canceled', 'cancelled',
        'failed', 'failure', 'expired', 'aborted', 'error',
    ];
}

function webhook_is_refusal_status($status)
{
    $status = strtolower(trim((string)$status));
    return in_array($status, webhook_refusal_status_list(), true);
}

function webhook_resolve_stato_nome($tipo, $status)
{
    $tipo = strtolower(trim((string)$tipo));
    $status = strtolower(trim((string)$status));
    if ($tipo === 'procedure' || $tipo === 'workflow') {
        if (in_array($status, ['finished', 'completed', 'done', 'complete'], true)) {
            return 'Completato';
        }
        if (webhook_is_refusal_status($status)) {
            return 'Rifiutato';
        }
        return null;
    }
    if ($tipo === 'member') {
        if ($status === 'done') {
            return null;
        }
        if (webhook_is_refusal_status($status)) {
            return 'Rifiutato';
        }
        $inProgress = [
            '', 'pending', 'waiting', 'opened', 'started', 'in_progress', 'processing',
            'sent', 'notified', 'active', 'created', 'initiated',
        ];
        if (in_array($status, $inProgress, true)) {
            return null;
        }
        return null;
    }
    return null;
}

/** Timestamp server al momento della chiamata webhook (EasyGN non invia date nel body). */
function webhook_now_sql_literal()
{
    return "'" . webhook_sql_quote(date('Y-m-d H:i:s')) . "'";
}

function webhook_update_contratto_firmato_il($contrattoId)
{
    $contrattoId = (int)$contrattoId;
    if ($contrattoId <= 0) {
        return false;
    }
    $dtSql = webhook_now_sql_literal();
    $statoId = webhook_stato_id_by_nome('In attesa della firma committente');
    $statoSql = $statoId > 0 ? ', stato_contratto_id = ' . (int)$statoId : '';
    sc_exec_sql("UPDATE contratti SET firmato_il = $dtSql$statoSql WHERE id = $contrattoId");
    webhook_sc_log(
        'UPDATE contratto_id=' . $contrattoId
        . ' firmato_il=' . trim($dtSql, "'")
        . ($statoId > 0 ? ' stato_contratto_id=' . $statoId . ' (In attesa della firma committente)' : '')
    );
    return true;
}

function webhook_set_stato_contratto($contrattoId, $statoNome, $tipo, $status)
{
    $contrattoId = (int)$contrattoId;
    if ($contrattoId <= 0) {
        return false;
    }
    $statoId = webhook_stato_id_by_nome($statoNome);
    if ($statoId <= 0) {
        webhook_sc_log('stato "' . $statoNome . '" assente in stati_contratti');
        return false;
    }
    $isCompletato = (strtolower(trim((string)$statoNome)) === 'completato');

    if ($isCompletato) {
        $dtSql = webhook_now_sql_literal();
        sc_exec_sql("
            UPDATE contratti
            SET stato_contratto_id = $statoId,
                data_inizio_contratto = IF(
                    data_inizio_contratto IS NULL OR data_inizio_contratto = '0000-00-00 00:00:00',
                    $dtSql,
                    data_inizio_contratto
                )
            WHERE id = $contrattoId
              AND stato_contratto_id <> $statoId
        ");
        sc_lookup(rsWhStUp, "SELECT ROW_COUNT()");
        $rowsUp = empty({rsWhStUp[0][0]}) ? 0 : (int){rsWhStUp[0][0]};
        webhook_sc_log(
            'UPDATE contratto_id=' . $contrattoId
            . ' stato_contratto_id=' . $statoId . ' (Completato) type=' . $tipo
            . ' status=' . $status . ' rows=' . $rowsUp
        );
        if ($rowsUp > 0) {
            webhook_activate_subvettore_after_completato($contrattoId);
        } else {
            webhook_sc_log('completato: stato già Completato — skip attivazione/mail (duplicato procedure/workflow?)');
        }
        return true;
    }

    sc_exec_sql("UPDATE contratti SET stato_contratto_id = $statoId WHERE id = $contrattoId");
    webhook_sc_log('UPDATE contratto_id=' . $contrattoId . ' stato_contratto_id=' . $statoId . ' (' . $statoNome . ') type=' . $tipo . ' status=' . $status);
    return true;
}

function webhook_setting($name, $default = '')
{
    $safeName = webhook_sql_quote(trim((string)$name));
    sc_lookup(rsSet, "SELECT set_value FROM sec_settings WHERE set_name = '$safeName' LIMIT 1");
    if (isset({rsSet[0][0]})) {
        return trim((string){rsSet[0][0]});
    }
    return (string)$default;
}

if (!function_exists('pigliacelli_mail_logo_read_embed')) {
    function pigliacelli_mail_logo_read_embed($anchorFile = null)
    {
        $rel = '_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png';
        $dir = realpath(dirname($anchorFile ?: __FILE__));
        for ($i = 0; $i < 12 && $dir; $i++) {
            $try = $dir . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $rel);
            if (is_readable($try)) {
                $bin = @file_get_contents($try);
                if ($bin !== false && $bin !== '' && strlen($bin) < 500000) {
                    return 'data:image/png;base64,' . base64_encode($bin);
                }
            }
            $p = dirname($dir);
            if ($p === $dir) {
                break;
            }
            $dir = $p;
        }
        return '';
    }
}

if (!function_exists('pigliacelli_mail_logo_src')) {
    function pigliacelli_mail_logo_src($getSetting, $anchorFile = null)
    {
        $embed = pigliacelli_mail_logo_read_embed($anchorFile);
        if ($embed !== '') {
            return $embed;
        }
        $base = rtrim(trim((string)$getSetting('mail_base_url', '')), '/');
        if ($base !== '' && preg_match('#^https?://#i', $base) === 1) {
            return htmlspecialchars(
                $base . '/_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png',
                ENT_QUOTES,
                'UTF-8'
            );
        }
        return '';
    }
}

