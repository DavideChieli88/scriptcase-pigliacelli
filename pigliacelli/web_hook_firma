/**
 * Riconosce quale firmatario ha generato l'evento member (confronto con easygn_signer_ids).
 * @return string firmatario|committente|unknown
 */
function webhook_signer_role($contrattoId, $memberId)
{
    $memberId = strtolower(trim((string)$memberId));
    if ($memberId === '') {
        return 'unknown';
    }
    $map = webhook_load_signer_ids_map($contrattoId);
    $idFirm = isset($map['signer_id_firmatario']) ? strtolower(trim((string)$map['signer_id_firmatario'])) : '';
    $idComm = isset($map['signer_id_committente']) ? strtolower(trim((string)$map['signer_id_committente'])) : '';
    if ($idFirm !== '' && $memberId === $idFirm) {
        return 'firmatario';
    }
    if ($idComm !== '' && $memberId === $idComm) {
        return 'committente';
    }
    return 'unknown';
}

function webhook_rifiuto_stato_nome($contrattoId, $memberId = '')
{
    if ($memberId !== '') {
        $role = webhook_signer_role($contrattoId, $memberId);
        if ($role === 'committente') {
            return 'Rifiutato dal committente';
        }
        if ($role === 'firmatario') {
            return 'Rifiutato dal subvettore';
        }
    }
    $contrattoId = (int)$contrattoId;
    if ($contrattoId > 0) {
        sc_lookup(rsWhFirm, "
            SELECT firmato_il
            FROM contratti
            WHERE id = " . $contrattoId . "
            LIMIT 1
        ");
        $firmatoIl = !empty({rsWhFirm[0][0]}) ? trim((string){rsWhFirm[0][0]}) : '';
        if ($firmatoIl !== '' && $firmatoIl !== '0000-00-00 00:00:00') {
            return 'Rifiutato dal committente';
        }
    }
    return 'Rifiutato dal subvettore';
}

function webhook_extract_member_id_from_callback(array $callback)
{
    foreach (['memberId', 'member_id', 'signerId', 'signer_id'] as $key) {
        if (!empty($callback[$key])) {
            return trim((string)$callback[$key]);
        }
    }
    if (isset($callback['member']) && is_array($callback['member'])) {
        if (!empty($callback['member']['id'])) {
            return trim((string)$callback['member']['id']);
        }
    }
    $tipoCb = strtolower(trim((string)($callback['type'] ?? '')));
    if ($tipoCb === 'member' && !empty($callback['id'])) {
        return trim((string)$callback['id']);
    }
    return '';
}

function webhook_extract_comments_from_callback(array $callback)
{
    $candidates = [];
    if (isset($callback['comments'])) {
        $candidates[] = $callback['comments'];
    }
    if (isset($callback['comment'])) {
        $candidates[] = $callback['comment'];
    }
    if (isset($callback['data']) && is_array($callback['data'])) {
        if (isset($callback['data']['comments'])) {
            $candidates[] = $callback['data']['comments'];
        }
        if (isset($callback['data']['comment'])) {
            $candidates[] = $callback['data']['comment'];
        }
    }
    if (isset($callback['member']) && is_array($callback['member'])) {
        if (isset($callback['member']['comments'])) {
            $candidates[] = $callback['member']['comments'];
        }
        if (isset($callback['member']['comment'])) {
            $candidates[] = $callback['member']['comment'];
        }
    }
    foreach ($candidates as $value) {
        if (is_array($value)) {
            $value = json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
        }
        $text = trim((string)$value);
        if ($text !== '') {
            return $text;
        }
    }
    return '';
}

function webhook_update_contratto_notes($contrattoId, $notes)
{
    $contrattoId = (int)$contrattoId;
    $notes = trim((string)$notes);
    if ($contrattoId <= 0 || $notes === '') {
        return false;
    }
    $notesSql = webhook_sql_quote($notes);
    sc_exec_sql("UPDATE contratti SET notes = '$notesSql' WHERE id = $contrattoId");
    webhook_sc_log('UPDATE contratto_id=' . $contrattoId . ' notes salvate len=' . strlen($notes));
    return true;
}

function webhook_handle_rifiuto_contratto($contrattoId, $memberId, $tipo, $status, array $callback)
{
    $contrattoId = (int)$contrattoId;
    if ($contrattoId <= 0) {
        return;
    }
    $memberId = trim((string)$memberId);
    if ($memberId === '') {
        $memberId = webhook_extract_member_id_from_callback($callback);
    }
    $rifiutoNome = webhook_rifiuto_stato_nome($contrattoId, $memberId);
    $comments = webhook_extract_comments_from_callback($callback);
    webhook_sc_log(
        'rifiuto → ' . $rifiutoNome
        . ' contratto_id=' . $contrattoId
        . ' memberId=' . $memberId
        . ' type=' . $tipo
        . ' status=' . $status
        . ($comments !== '' ? ' comments_len=' . strlen($comments) : '')
    );
    webhook_set_stato_contratto($contrattoId, $rifiutoNome, $tipo, $status);
    if ($comments !== '') {
        webhook_update_contratto_notes($contrattoId, $comments);
    }
}

/** Chiamata 1 o 2: member done / refused */
function webhook_handle_member_callback($contrattoId, $memberId, $status, $statoNome, array $callback)
{
    $status = strtolower(trim((string)$status));
    if ($statoNome === 'Rifiutato') {
        webhook_handle_rifiuto_contratto($contrattoId, $memberId, 'member', $status, $callback);
        return;
    }
    if ($status !== 'done') {
        webhook_sc_log('member status=' . $status . ' (nessun cambio stato) contratto_id=' . $contrattoId);
        return;
    }
    $role = webhook_signer_role($contrattoId, $memberId);
    if ($role === 'committente') {
        webhook_sc_log('evento 2/3: committente firmato contratto_id=' . $contrattoId . ' (in attesa chiusura procedura)');
        return;
    }
    webhook_sc_log('evento 1/3: vettore firmato contratto_id=' . $contrattoId . ' role=' . $role);
    webhook_update_contratto_firmato_il($contrattoId);
    webhook_set_stato_contratto($contrattoId, 'In attesa della firma committente', 'member', $status);
    try {
        webhook_maybe_send_committente_mail($contrattoId, $memberId);
    } catch (Throwable $e) {
        webhook_sc_log('maybe_send_committente EXCEPTION: ' . $e->getMessage());
    }
}

/** Chiamata 3: procedure done / finished */
function webhook_handle_procedure_callback($contrattoId, $status, $statoNome, $tipo, array $callback)
{
    if ($statoNome === null) {
        webhook_sc_log('procedure status=' . $status . ' ignorato contratto_id=' . $contrattoId);
        return;
    }
    if ($statoNome === 'Rifiutato') {
        webhook_handle_rifiuto_contratto($contrattoId, '', $tipo, $status, $callback);
        return;
    }
    webhook_sc_log('evento 3/3: procedura ' . $status . ' → ' . $statoNome . ' contratto_id=' . $contrattoId);
    webhook_set_stato_contratto($contrattoId, $statoNome, $tipo, $status);
}

function webhook_maybe_send_committente_mail($contrattoId, $memberId)
{
    $contrattoId = (int)$contrattoId;
    $memberId = trim((string)$memberId);
    if ($contrattoId <= 0 || $memberId === '') {
        return false;
    }
    $signerMap = webhook_load_signer_ids_map($contrattoId);
    $idFirm = isset($signerMap['signer_id_firmatario']) ? trim((string)$signerMap['signer_id_firmatario']) : '';
    $idComm = isset($signerMap['signer_id_committente']) ? trim((string)$signerMap['signer_id_committente']) : '';
    if ($idComm !== '' && strcasecmp($memberId, $idComm) === 0) {
        return false;
    }
    if ($idFirm !== '' && strcasecmp($memberId, $idFirm) !== 0) {
        webhook_sc_log('member id diverso da signer_id_firmatario, invio mail committente se non già inviata');
    }
    $meta = webhook_load_easygn_sign_link_json($contrattoId);
    if (!empty($meta['mail_committente_inviata'])) {
        webhook_sc_log('mail committente già inviata contratto_id=' . $contrattoId);
        return false;
    }
    $to = isset($meta['committente_email']) ? trim((string)$meta['committente_email']) : '';
    $nome = isset($meta['committente_nome']) ? trim((string)$meta['committente_nome']) : '';
    $link = isset($meta['link_committente']) ? trim((string)$meta['link_committente']) : '';
    if ($to === '') {
        webhook_sc_log('mail committente SKIP: committente_email assente');
        return false;
    }
    if (!webhook_send_sign_link_email($contrattoId, $to, $nome, $link, 'committente')) {
        return false;
    }
    $meta['mail_committente_inviata'] = 1;
    webhook_save_easygn_sign_link_json($contrattoId, $meta);
    return true;
}

/** --- Documenti verdi (wizard step 5) --- */

function webhook_update_documento_firmato_il($documentoId)
{
    $documentoId = (int)$documentoId;
    if ($documentoId <= 0) {
        return false;
    }
    $dtSql = webhook_now_sql_literal();
    sc_exec_sql("
        UPDATE documenti
        SET firmato_il = $dtSql,
            stato_documento_id = 2,
            updated_at = NOW()
        WHERE id = $documentoId
          AND (firmato_il IS NULL OR firmato_il = '0000-00-00 00:00:00')
    ");
    webhook_sc_log('UPDATE documento_id=' . $documentoId . ' firmato_il=' . trim($dtSql, "'") . ' stato=2');
    // Se firmato_il era gia' valorizzato, aggiorna comunque lo stato a caricato
    sc_exec_sql("
        UPDATE documenti
        SET stato_documento_id = 2,
            updated_at = NOW()
        WHERE id = $documentoId
          AND COALESCE(stato_documento_id, 0) <> 2
          AND firmato_il IS NOT NULL
          AND firmato_il <> '0000-00-00 00:00:00'
    ");
    return true;
}

function webhook_documento_subvettore_id($documentoId)
{
    $documentoId = (int)$documentoId;
    if ($documentoId <= 0) {
        return 0;
    }
    sc_lookup(rsDocSubWh, "SELECT subvettore_id FROM documenti WHERE id = $documentoId LIMIT 1");
    return !empty({rsDocSubWh[0][0]}) ? (int){rsDocSubWh[0][0]} : 0;
}

function webhook_handle_documento_member_callback($documentoId, $memberId, $status, $statoNome, array $callback)
{
    $documentoId = (int)$documentoId;
    $status = strtolower(trim((string)$status));
    if ($statoNome === 'Rifiutato' || webhook_is_refusal_status($status)) {
        webhook_sc_log('documento rifiutato documento_id=' . $documentoId . ' status=' . $status);
        return;
    }
    if ($status !== 'done' && !in_array($status, array('signed', 'finished', 'completed', 'complete'), true)) {
        webhook_sc_log('documento member status=' . $status . ' (nessun cambio) documento_id=' . $documentoId);
        return;
    }
    webhook_sc_log('documento firmato (member done) documento_id=' . $documentoId . ' memberId=' . $memberId);
    webhook_update_documento_firmato_il($documentoId);
    $subId = webhook_documento_subvettore_id($documentoId);
    if ($subId > 0) {
        webhook_maybe_complete_wizard_after_verdi($subId);
    }
}

function webhook_handle_documento_procedure_callback($documentoId, $status, $statoNome, $tipo, array $callback)
{
    $documentoId = (int)$documentoId;
    $status = strtolower(trim((string)$status));
    if ($statoNome === 'Rifiutato' || webhook_is_refusal_status($status)) {
        webhook_sc_log('documento procedure rifiutata documento_id=' . $documentoId);
        return;
    }
    if ($statoNome === 'Completato' || in_array($status, array('finished', 'completed', 'done', 'complete'), true)) {
        webhook_sc_log('documento procedure completata documento_id=' . $documentoId);
        webhook_update_documento_firmato_il($documentoId);
        $subId = webhook_documento_subvettore_id($documentoId);
        if ($subId > 0) {
            webhook_maybe_complete_wizard_after_verdi($subId);
        }
        return;
    }
    webhook_sc_log('documento procedure status=' . $status . ' ignorato documento_id=' . $documentoId);
}

function webhook_verdi_tutti_firmati($subvettore_id)
{
    $subvettore_id = (int)$subvettore_id;
    if ($subvettore_id <= 0) {
        return false;
    }
    sc_lookup(rsWhVerdiCnt, "
        SELECT
            COUNT(*) AS tot,
            SUM(CASE WHEN d.firmato_il IS NOT NULL AND d.firmato_il <> '0000-00-00 00:00:00' THEN 1 ELSE 0 END) AS firmati
        FROM documenti d
        INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
        WHERE d.subvettore_id = $subvettore_id
          AND COALESCE(td.is_readonly, 0) = 1
          AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
          AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
    ");
    $tot = !empty({rsWhVerdiCnt[0][0]}) ? (int){rsWhVerdiCnt[0][0]} : 0;
    $firmati = !empty({rsWhVerdiCnt[0][1]}) ? (int){rsWhVerdiCnt[0][1]} : 0;
    return $tot > 0 && $firmati >= $tot;
}

function webhook_maybe_complete_wizard_after_verdi($subvettore_id)
{
    $subvettore_id = (int)$subvettore_id;
    if ($subvettore_id <= 0) {
        return false;
    }
    if (!webhook_verdi_tutti_firmati($subvettore_id)) {
        webhook_sc_log('wizard verdi: ancora documenti da firmare subvettore_id=' . $subvettore_id);
        return false;
    }

    // Non chiudere qui: lo fa il pulsante "Invia per attivazione" sulla grid step 5.
    webhook_sc_log(
        'wizard verdi: tutti firmati subvettore_id=' . $subvettore_id
        . ' — in attesa di Invia per attivazione'
    );
    return true;
}

function webhook_notify_ops_wizard_complete($subId, $ragioneSociale, $loginSub)
{
    $subId = (int)$subId;
    $ragioneSociale = trim((string)$ragioneSociale);
    $loginSub = trim((string)$loginSub);

    sc_lookup(rsWhWizOps, "
        SELECT DISTINCT su.login, su.email
        FROM sec_users su
        INNER JOIN sec_users_groups sug ON sug.login = su.login
        WHERE su.active = 'Y'
          AND su.login IS NOT NULL AND TRIM(su.login) <> ''
          AND su.email IS NOT NULL AND TRIM(su.email) <> ''
          AND sug.group_id IN (1, 3)
    ");

    $emailPlaceholder = array('admin@admin.com', 'admin@localhost', 'admin@example.com');
    $destinatari = array();
    $operatorLogins = array();
    if (isset({rsWhWizOps[0][0]})) {
        foreach ({rsWhWizOps} as $row) {
            $loginOp = trim((string)$row[0]);
            $email = strtolower(trim((string)$row[1]));
            if ($loginOp === '' || strcasecmp($loginOp, 'Guest') === 0) {
                continue;
            }
            if ($email === '' || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
                continue;
            }
            if (in_array($email, $emailPlaceholder, true)) {
                continue;
            }
            $destinatari[] = $email;
            $operatorLogins[] = $loginOp;
        }
    }
    $destinatari = array_values(array_unique($destinatari));
    $operatorLogins = array_values(array_unique($operatorLogins));

    $loginUrl = rtrim(trim(webhook_setting('login_url', '')), '/');
    $labelSub = $ragioneSociale !== '' ? $ragioneSociale : ('ID ' . $subId);

    if (!empty($destinatari) && function_exists('sc_send_mail_api')) {
        webhook_init_smtp_config();
        $smtpCfg = webhook_get_smtp_config();
        $safeRagione = htmlspecialchars($labelSub, ENT_QUOTES, 'UTF-8');
        $safeLogin = htmlspecialchars($loginSub, ENT_QUOTES, 'UTF-8');
        $safeLoginUrl = htmlspecialchars($loginUrl, ENT_QUOTES, 'UTF-8');
        $soggetto = 'Wizard completato — abilitare subvettore ' . $labelSub;
        $testoPlain = "Gentile operatore,\n\n"
            . "il subvettore $labelSub ha completato il wizard di onboarding.\n\n"
            . "Subvettore: $labelSub\n"
            . ($loginSub !== '' ? "Login: $loginSub\n" : '')
            . "ID: $subId\n\n"
            . "Verificare i documenti e abilitare il subvettore se tutto e' corretto.\n\n"
            . ($loginUrl !== '' ? "Accesso: $loginUrl\n\n" : '')
            . "Messaggio automatico — non rispondere.";

        $btnHtml = '';
        if ($loginUrl !== '') {
            $btnHtml = '<p style="margin:24px 0 8px;text-align:center;">'
                . '<a href="' . $safeLoginUrl . '" style="display:inline-block;padding:12px 26px;'
                . 'background:#1a3a5c;color:#ffffff;text-decoration:none;border-radius:8px;'
                . 'font-weight:bold;font-size:15px;">Accedi al portale</a></p>';
        }
        $infoBox = '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" '
            . 'style="margin:16px 0;background:#f7f9fb;border:1px solid #e2e8f0;border-radius:8px;">'
            . '<tr><td style="padding:14px 18px;font-size:14px;line-height:1.6;">'
            . '<strong style="color:#1a3a5c;">Subvettore:</strong> ' . $safeRagione . '<br>'
            . ($loginSub !== '' ? '<strong style="color:#1a3a5c;">Login:</strong> ' . $safeLogin . '<br>' : '')
            . '<strong style="color:#1a3a5c;">ID:</strong> ' . (int)$subId
            . '</td></tr></table>';
        $innerHtml = '<p style="margin:0 0 12px;">Gentile operatore,</p>'
            . '<p style="margin:0 0 12px;">il subvettore <strong>' . $safeRagione . '</strong> ha completato '
            . 'il wizard di onboarding.</p>'
            . $infoBox
            . '<p style="margin:0 0 12px;">Verificare i documenti e <strong>abilitare il subvettore</strong> '
            . 'se tutto e\' corretto.</p>'
            . $btnHtml;
        $mailLogoUrl = webhook_mail_logo_src();
        $testoHtml = pigliacelli_mail_layout('Wizard completato — abilitazione subvettore', $innerHtml, $mailLogoUrl);

        foreach ($destinatari as $dest) {
            try {
                sc_send_mail_api(array_merge($smtpCfg, array(
                    'message' => array(
                        'to'      => $dest,
                        'subject' => $soggetto,
                        'html'    => $testoHtml,
                        'text'    => $testoPlain,
                    ),
                )));
                webhook_sc_log('wizard mail ops inviata to=' . $dest . ' sub=' . $subId);
            } catch (Throwable $e) {
                webhook_sc_log('wizard mail ops FAIL to=' . $dest . ' ' . $e->getMessage());
            }
        }
    }

    $notifyProfile = trim(webhook_setting('notification_profile', 'Pigliacelli_Notifications'));
    if ($notifyProfile === '') {
        $notifyProfile = 'Pigliacelli_Notifications';
    }
    if (!empty($operatorLogins) && function_exists('sc_send_notification')) {
        $notifyTitle = 'Wizard completato — abilitare ' . $labelSub;
        $notifyMessage = 'Il subvettore ' . $labelSub
            . ' ha completato il wizard (firme verdi incluse). Verificare documenti e abilitare l\'account.';
        $notifyExpire = date('Y-m-d H:i:s', strtotime('+30 days'));
        try {
            sc_send_notification(array(
                'title'        => $notifyTitle,
                'message'      => $notifyMessage,
                'destiny_type' => 'user',
                'to'           => implode(';', $operatorLogins),
                'from'         => '',
                'link'         => '',
                'dtexpire'     => $notifyExpire,
                'profile'      => $notifyProfile,
            ));
            webhook_sc_log('wizard notification ops inviata sub=' . $subId);
        } catch (Throwable $e) {
            webhook_sc_log('wizard notification FAIL ' . $e->getMessage());
        }
    }
}

