function webhook_contratto_gia_completato($contrattoId)
{
    $idCompletato = webhook_stato_id_by_nome('Completato');
    if ($idCompletato <= 0) {
        return false;
    }
    sc_lookup(rsSt, "SELECT stato_contratto_id FROM contratti WHERE id = " . (int)$contrattoId . " LIMIT 1");
    return !empty({rsSt[0][0]}) && (int){rsSt[0][0]} === $idCompletato;
}

function webhook_generate_temp_password()
{
    $chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=';
    $len = strlen($chars);
    $out = '';
    for ($i = 0; $i < 12; $i++) {
        $out .= $chars[random_int(0, $len - 1)];
    }
    return $out;
}

function webhook_user_active_is_yes($active)
{
    $a = strtoupper(trim((string)$active));
    return ($a === 'Y' || $a === '1' || $a === 'S' || $a === 'SI' || $a === 'YES');
}

function webhook_email_valida($email)
{
    $email = trim((string)$email);
    if ($email === '') {
        return false;
    }
    if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
        return false;
    }
    return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
}

/** Dopo stato Completato: attiva subvettore; mail completamento a subvettore e committente. */
function webhook_activate_subvettore_after_completato($contrattoId)
{
    $contrattoId = (int)$contrattoId;
    if ($contrattoId <= 0) {
        return;
    }
    $metaCompletato = webhook_load_easygn_sign_link_json($contrattoId);
    $subMailDone = !empty($metaCompletato['mail_completato_sub_inviata'])
        || !empty($metaCompletato['mail_completato_inviata']);
    $commMailDone = !empty($metaCompletato['mail_completato_comm_inviata']);
    if ($subMailDone && $commMailDone) {
        webhook_sc_log('completato: mail subvettore e committente già inviate contratto_id=' . $contrattoId);
        return;
    }
    sc_lookup(rsSub, "
        SELECT
            sc.subvettore_id,
            s.login_subvettore,
            s.ragione_sociale,
            COALESCE(NULLIF(TRIM(s.phone), ''), NULLIF(TRIM(s.cellphone), ''), '') AS phone_sub,
            sc.email_rappresentante,
            TRIM(CONCAT(COALESCE(sc.nome_rappresentante, ''), ' ', COALESCE(sc.cognome_rappresentante, ''))) AS nome_firm
        FROM subvettori_contratti sc
        INNER JOIN subvettori s ON s.id = sc.subvettore_id
        WHERE sc.contratto_id = $contrattoId
        ORDER BY sc.id ASC
        LIMIT 1
    ");
    if (empty({rsSub[0][0]})) {
        webhook_sc_log('completato: nessun subvettore per contratto_id=' . $contrattoId);
        if (!$commMailDone) {
            $commEmail = isset($metaCompletato['committente_email']) ? trim((string)$metaCompletato['committente_email']) : '';
            $commNome = isset($metaCompletato['committente_nome']) ? trim((string)$metaCompletato['committente_nome']) : '';
            if (webhook_email_valida($commEmail) && webhook_send_completato_committente_email($contrattoId, $commEmail, $commNome)) {
                $metaCompletato['mail_completato_comm_inviata'] = 1;
                webhook_save_easygn_sign_link_json($contrattoId, $metaCompletato);
            }
        }
        return;
    }
    $subvettoreId = (int){rsSub[0][0]};
    $loginSubv = trim((string){rsSub[0][1]});
    $ragioneSociale = trim((string){rsSub[0][2]});
    $phoneSub = trim((string){rsSub[0][3]});
    $emailRapp = trim((string){rsSub[0][4]});
    $nomeFirm = trim((string){rsSub[0][5]});
    $login = $loginSubv;
    $userLogin = '';
    $userActive = '';
    $userEmail = '';
    if ($login !== '') {
        $lq = webhook_sql_quote($login);
        sc_lookup(rsU, "SELECT login, active, email FROM sec_users WHERE login = '$lq' LIMIT 1");
    }
    if (empty({rsU[0][0]})) {
        sc_lookup(rsU2, "SELECT login, active, email FROM sec_users WHERE subvettore_id = $subvettoreId LIMIT 1");
        if (!empty({rsU2[0][0]})) {
            $userLogin = trim((string){rsU2[0][0]});
            $userActive = trim((string){rsU2[0][1]});
            $userEmail = trim((string){rsU2[0][2]});
            $login = $userLogin;
        }
    } else {
        $userLogin = trim((string){rsU[0][0]});
        $userActive = trim((string){rsU[0][1]});
        $userEmail = trim((string){rsU[0][2]});
    }

    $toEmail = '';
    if (webhook_email_valida($userEmail)) {
        $toEmail = $userEmail;
    } elseif (webhook_email_valida($loginSubv)) {
        $toEmail = $loginSubv;
    } elseif (webhook_email_valida($emailRapp)) {
        $toEmail = $emailRapp;
    }
    if ($toEmail === '') {
        webhook_sc_log(
            'completato: email subvettore assente contratto_id=' . $contrattoId
            . ' login_sub=[' . $loginSubv . '] email_rapp=[' . $emailRapp
            . '] user_email=[' . $userEmail . '] — skip mail subvettore'
        );
    }

    $plainPassword = '';
    $mustSendCredentials = false;
    $mustSendLoginLink = false;
    $displayName = $ragioneSociale !== '' ? $ragioneSociale : $nomeFirm;

    if ($toEmail !== '' && !$subMailDone) {
        if ($userLogin === '') {
            $login = $toEmail;
            $plainPassword = webhook_generate_temp_password();
            $pswHash = md5($plainPassword);
            $lq = webhook_sql_quote($login);
            $le = webhook_sql_quote($toEmail);
            $ln = webhook_sql_quote($displayName);
            $lp = webhook_sql_quote($phoneSub);
            sc_exec_sql("
                INSERT INTO sec_users (login, pswd, name, email, phone, active, subvettore_id)
                VALUES ('$lq', '" . webhook_sql_quote($pswHash) . "', '$ln', '$le', '$lp', 'Y', $subvettoreId)
            ");
            sc_lookup(rsGrp, "SELECT login FROM sec_users_groups WHERE login = '$lq' AND group_id = 2 LIMIT 1");
            if (empty({rsGrp[0][0]})) {
                sc_exec_sql("INSERT INTO sec_users_groups (login, group_id) VALUES ('$lq', 2)");
            }
            if ($loginSubv === '') {
                sc_exec_sql("UPDATE subvettori SET login_subvettore = '$lq' WHERE id = $subvettoreId");
            }
            $mustSendCredentials = true;
            webhook_sc_log('completato: creato sec_users login=' . $login . ' subvettore_id=' . $subvettoreId);
        } elseif (webhook_user_active_is_yes($userActive)) {
            $mustSendLoginLink = true;
            webhook_sc_log('completato: account già attivo login=' . $login . ' — mail link area riservata');
        } else {
            $plainPassword = webhook_generate_temp_password();
            $pswHash = webhook_sql_quote(md5($plainPassword));
            $lq = webhook_sql_quote($login);
            sc_exec_sql("UPDATE sec_users SET active = 'Y', pswd = '$pswHash' WHERE login = '$lq'");
            $mustSendCredentials = true;
            webhook_sc_log('completato: attivato sec_users login=' . $login . ' (era inactive)');
        }
    }

    $mailSubOk = false;
    if (!$subMailDone && $toEmail !== '') {
        if ($mustSendCredentials && $plainPassword !== '') {
            if (webhook_send_credenziali_subvettore_email($contrattoId, $toEmail, $login, $plainPassword, $displayName)) {
                $mailSubOk = true;
            } else {
                webhook_sc_log('completato: invio credenziali FALLITO to=' . $toEmail . ' login=' . $login);
            }
        } elseif ($mustSendLoginLink) {
            if (webhook_send_area_riservata_login_email($contrattoId, $toEmail, $displayName)) {
                $mailSubOk = true;
            } else {
                webhook_sc_log('completato: invio link login FALLITO to=' . $toEmail . ' login=' . $login);
            }
        } else {
            webhook_sc_log(
                'completato: nessuna mail subvettore (cred=' . ($mustSendCredentials ? '1' : '0')
                . ' link=' . ($mustSendLoginLink ? '1' : '0') . ')'
            );
        }
    }

    $mailCommOk = false;
    if (!$commMailDone) {
        $commEmail = isset($metaCompletato['committente_email']) ? trim((string)$metaCompletato['committente_email']) : '';
        $commNome = isset($metaCompletato['committente_nome']) ? trim((string)$metaCompletato['committente_nome']) : '';
        if (webhook_email_valida($commEmail)) {
            if (webhook_send_completato_committente_email($contrattoId, $commEmail, $commNome)) {
                $mailCommOk = true;
            } else {
                webhook_sc_log('completato: invio mail committente FALLITO to=' . $commEmail);
            }
        } else {
            webhook_sc_log('completato: mail committente SKIP email assente/non valida contratto_id=' . $contrattoId);
        }
    }

    if ($mailSubOk) {
        $metaCompletato['mail_completato_sub_inviata'] = 1;
        $metaCompletato['mail_completato_inviata'] = 1;
    }
    if ($mailCommOk) {
        $metaCompletato['mail_completato_comm_inviata'] = 1;
    }
    if ($mailSubOk || $mailCommOk) {
        webhook_save_easygn_sign_link_json($contrattoId, $metaCompletato);
    }
}

