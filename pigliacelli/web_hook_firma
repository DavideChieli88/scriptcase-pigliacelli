function webhook_load_easygn_sign_link_json($contrattoId)
{
    $contrattoId = (int)$contrattoId;
    if ($contrattoId <= 0) {
        return [];
    }
    sc_lookup(rsLnk, "SELECT easygn_sign_link FROM contratti WHERE id = $contrattoId LIMIT 1");
    if (empty({rsLnk[0][0]})) {
        return [];
    }
    $raw = trim((string){rsLnk[0][0]});
    if ($raw === '') {
        return [];
    }
    $data = json_decode($raw, true);
    return is_array($data) ? $data : [];
}

function webhook_save_easygn_sign_link_json($contrattoId, array $data)
{
    $contrattoId = (int)$contrattoId;
    if ($contrattoId <= 0) {
        return false;
    }
    $j = json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    if ($j === false) {
        return false;
    }
    $jSql = str_replace("'", "''", $j);
    sc_exec_sql("UPDATE contratti SET easygn_sign_link = '$jSql' WHERE id = $contrattoId");
    return true;
}

