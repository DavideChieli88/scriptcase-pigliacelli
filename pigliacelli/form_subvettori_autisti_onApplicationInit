sc_apl_conf("form_subvettori_autisti", "start", "edit");

/**
 * form_subvettori_autisti → onApplicationInit
 *
 * Usata da grid_subvettori_autisti_for_subvectors (Nuovo/modifica).
 * Doc SC: prima della SQL. Globali OK; niente sc_lookup.
 *
 * Popup "Parametri mancanti: subvettoreContrattoId=0 subvettoreId=222":
 * SC elenca TUTTE le globali IN; quella vuota è contratto=0 (0 = mancante).
 *
 * IDE — Application → Global variables:
 *   subvettoreId          → tipo OUT (non IN), Integer, default 0, Request = NO
 *   subvettoreContrattoId → tipo OUT (non IN), Integer, default 0, Request = NO
 *   Se restano IN, il chiamante DEVE passarle e 0/'null' fanno fallire il check.
 *
 * IDE — SQL della form: NON usare [subvettoreContrattoId] nel WHERE
 *   (un WHERE su quella globale la forza a IN obbligatoria).
 *   Filtro: solo PK, oppure WHERE subvettore_id = [subvettoreId]
 *
 * IDE — grid link:
 *   solo subvettoreId = [subvettoreId]
 *   togliere subvettoreContrattoId dalla mappa parametri
 *
 * Non assegnare [subvettoreContrattoId] = 0 né 'null' (diventa parametro "mancante").
 * NULL sul campo DB: onBeforeInsert {subvettore_contratto_id} = 'null'
 *
 * Firma/magic link: usa [subvettore_contratto_id] (snake_case), non questa globale.
 */

if (!isset([subvettoreId]) || (string)[subvettoreId] === '' || (int)[subvettoreId] < 0) {
    [subvettoreId] = 0;
}

$subId = 0;
if (isset($_GET['subvettoreId']) && (int)$_GET['subvettoreId'] > 0) {
    $subId = (int)$_GET['subvettoreId'];
} elseif (isset($_REQUEST['subvettoreId']) && (int)$_REQUEST['subvettoreId'] > 0) {
    $subId = (int)$_REQUEST['subvettoreId'];
} elseif ((int)[subvettoreId] > 0) {
    $subId = (int)[subvettoreId];
}
if ($subId > 0) {
    [subvettoreId] = $subId;
}

$ctrId = 0;
if (isset($_GET['subvettoreContrattoId']) && (int)$_GET['subvettoreContrattoId'] > 0) {
    $ctrId = (int)$_GET['subvettoreContrattoId'];
} elseif (isset($_REQUEST['subvettoreContrattoId']) && (int)$_REQUEST['subvettoreContrattoId'] > 0) {
    $ctrId = (int)$_REQUEST['subvettoreContrattoId'];
} elseif (isset([subvettoreContrattoId])
    && (string)[subvettoreContrattoId] !== ''
    && (string)[subvettoreContrattoId] !== 'null'
    && (int)[subvettoreContrattoId] > 0
) {
    $ctrId = (int)[subvettoreContrattoId];
}
if ($ctrId > 0) {
    [subvettoreContrattoId] = $ctrId;
}
