/**
 * form_subvettori_autisti_wizard → onAfterInsert
 *
 * NON usare qui il codice mezzi (MEZ_DOCS / carta / ANGA):
 * questa app salva documenti su subvettore_autista_id, tipi 18–21 e 30.
 *
 * Tipi:
 *   18 idoneità, 19 patente (1ª riga) + cqc (2ª), 20 formazione, 21 DPI,
 *   30 permesso_soggiorno (+ in_possesso da permesso_soggiorno_flag)
 *
 * IDE: Events → onAfterInsert → incolla questo file. Generate.
 * Log atteso: AUT_DOCS (non MEZ_DOCS).
 */

$autistaId = (int){id};
$subId     = (int){subvettore_id};
if ($subId <= 0 && isset([subvettoreId])) {
    $subId = (int)[subvettoreId];
}

sc_log_add('AUT_DOCS', "onAfterInsert START autista=$autistaId sub=$subId");

if ($autistaId <= 0 || $subId <= 0) {
    sc_error_message('AUT_DOCS: id autista o subvettore mancante.');
    return;
}

$login = trim((string)[usr_login]);
sc_lookup(rsLoginAnyI, "
    SELECT login FROM sec_users
    WHERE subvettore_id = $subId
    ORDER BY login LIMIT 1
", 'pigliacelli');
if (!empty({rsLoginAnyI[0][0]})) {
    $login = trim((string){rsLoginAnyI[0][0]});
}
$loginSql = str_replace("'", "''", $login);

$tipoCqc = 0;
sc_lookup(rsTipoCqcNI, "
    SELECT id FROM tipi_documento
    WHERE LOWER(TRIM(nome)) = LOWER(TRIM('CQC autisti (fronte/retro)'))
    LIMIT 1
", 'pigliacelli');
$tipoCqc = !empty({rsTipoCqcNI[0][0]}) ? (int){rsTipoCqcNI[0][0]} : 0;

if (!function_exists('aut_wiz_file_val')) {
    function aut_wiz_file_val($fieldVal, $hint)
    {
        $fieldVal = trim((string)$fieldVal);
        if ($fieldVal !== '') {
            return basename($fieldVal);
        }
        if (empty($_FILES) || !is_array($_FILES)) {
            return '';
        }
        $hint = strtolower((string)$hint);
        foreach ($_FILES as $k => $up) {
            if (!is_array($up)) {
                continue;
            }
            if ($hint !== '' && strpos(strtolower((string)$k), $hint) === false) {
                continue;
            }
            $nm = isset($up['name']) ? $up['name'] : '';
            if (is_array($nm)) {
                $nm = reset($nm);
            }
            $err = isset($up['error']) ? $up['error'] : 4;
            if (is_array($err)) {
                $err = reset($err);
            }
            if (trim((string)$nm) !== '' && (int)$err === 0) {
                return basename(trim((string)$nm));
            }
        }
        return '';
    }
}

$fPatente  = aut_wiz_file_val(isset({patente}) ? {patente} : '', 'patente');
$fCqc      = aut_wiz_file_val(isset({cqc}) ? {cqc} : '', 'cqc');
$fFormaz   = aut_wiz_file_val(isset({formazione_sicurezza}) ? {formazione_sicurezza} : '', 'formazione');
$fIdoneita = aut_wiz_file_val(isset({idoneita_sanitaria}) ? {idoneita_sanitaria} : '', 'idoneita');
$fDpi      = aut_wiz_file_val(isset({dpi_iii_categoria}) ? {dpi_iii_categoria} : '', 'dpi');
$fPermesso = aut_wiz_file_val(isset({permesso_soggiorno}) ? {permesso_soggiorno} : '', 'permesso');

$flagPoss30 = 0;
$rawFlag30 = {permesso_soggiorno_flag};
if ($rawFlag30 !== '' && $rawFlag30 !== null && $rawFlag30 !== 'undefined' && $rawFlag30 !== 'null') {
    $flagPoss30 = ((int)$rawFlag30 === 1) ? 1 : 0;
}
if ($fPermesso !== '') {
    $flagPoss30 = 1;
}

$scadPerm = '';
if (isset({scadenza_permesso_soggiorno})
    && {scadenza_permesso_soggiorno} !== ''
    && {scadenza_permesso_soggiorno} !== 'null'
) {
    $scadPerm = trim((string){scadenza_permesso_soggiorno});
}

sc_log_add(
    'AUT_DOCS',
    "FILES patente=[$fPatente] cqc=[$fCqc] form=[$fFormaz] idoneita=[$fIdoneita]"
    . " dpi=[$fDpi] perm=[$fPermesso] flag30=$flagPoss30 scad30=[$scadPerm] login=$login"
);

// --- 18 idoneità ---
if ($fIdoneita !== '') {
    $fileSql = str_replace("'", "''", $fIdoneita);
    sc_exec_sql("
        INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
        VALUES (18, $subId, $autistaId, '$loginSql', 2, '$fileSql')
    ", 'pigliacelli');
    sc_log_add('AUT_DOCS', "INSERT 18 $fileSql");
}

// --- 19 patente ---
if ($fPatente !== '') {
    $fileSql = str_replace("'", "''", $fPatente);
    $scadSql = 'NULL';
    if (isset({scadenza_patente}) && {scadenza_patente} !== '' && {scadenza_patente} !== 'null') {
        $scadSql = "'" . str_replace("'", "''", (string){scadenza_patente}) . "'";
    }
    sc_exec_sql("
        INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
        VALUES (19, $subId, $autistaId, '$loginSql', 2, '$fileSql', $scadSql)
    ", 'pigliacelli');
    sc_log_add('AUT_DOCS', "INSERT 19 patente $fileSql");
}

// --- CQC (tipo dedicato) ---
if ($fCqc !== '' && $tipoCqc > 0) {
    $fileSql = str_replace("'", "''", $fCqc);
    $scadSql = 'NULL';
    if (isset({scadenza_cqc}) && {scadenza_cqc} !== '' && {scadenza_cqc} !== 'null') {
        $scadSql = "'" . str_replace("'", "''", (string){scadenza_cqc}) . "'";
    }
    sc_exec_sql("
        INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
        VALUES ($tipoCqc, $subId, $autistaId, '$loginSql', 2, '$fileSql', $scadSql)
    ", 'pigliacelli');
    sc_log_add('AUT_DOCS', "INSERT CQC tipo=$tipoCqc $fileSql");
}

// --- 20 formazione ---
if ($fFormaz !== '') {
    $fileSql = str_replace("'", "''", $fFormaz);
    sc_exec_sql("
        INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
        VALUES (20, $subId, $autistaId, '$loginSql', 2, '$fileSql')
    ", 'pigliacelli');
    sc_log_add('AUT_DOCS', "INSERT 20 $fileSql");
}

// --- 21 DPI ---
if ($fDpi !== '') {
    $fileSql = str_replace("'", "''", $fDpi);
    sc_exec_sql("
        INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
        VALUES (21, $subId, $autistaId, '$loginSql', 2, '$fileSql')
    ", 'pigliacelli');
    sc_log_add('AUT_DOCS', "INSERT 21 $fileSql");
}

// --- 30 permesso ---
$scad30Sql = 'NULL';
if ($scadPerm !== '') {
    $scad30Sql = "'" . str_replace("'", "''", $scadPerm) . "'";
}

if ($fPermesso !== '') {
    $fileSql = str_replace("'", "''", $fPermesso);
    sc_exec_sql("
        INSERT INTO documenti (
            tipo_documento_id, subvettore_id, subvettore_autista_id,
            login, stato_documento_id, file, in_possesso, data_scadenza
        ) VALUES (
            30, $subId, $autistaId, '$loginSql', 2, '$fileSql', $flagPoss30, $scad30Sql
        )
    ", 'pigliacelli');
    sc_log_add('AUT_DOCS', "INSERT 30 file=$fileSql flag=$flagPoss30");
} elseif ($flagPoss30 === 1) {
    sc_exec_sql("
        INSERT INTO documenti (
            tipo_documento_id, subvettore_id, subvettore_autista_id,
            login, stato_documento_id, in_possesso, data_scadenza
        ) VALUES (
            30, $subId, $autistaId, '$loginSql', 1, 1, $scad30Sql
        )
    ", 'pigliacelli');
    sc_log_add('AUT_DOCS', "INSERT 30 flag=1 (senza file)");
} else {
    sc_exec_sql("
        INSERT INTO documenti (
            tipo_documento_id, subvettore_id, subvettore_autista_id,
            login, stato_documento_id, in_possesso
        ) VALUES (
            30, $subId, $autistaId, '$loginSql', 1, 0
        )
    ", 'pigliacelli');
    sc_log_add('AUT_DOCS', "INSERT 30 flag=0");
}

sc_lookup(rsCntDocsI, "
    SELECT COUNT(*) FROM documenti WHERE subvettore_autista_id = $autistaId
", 'pigliacelli');
$n = !empty({rsCntDocsI[0][0]}) ? (int){rsCntDocsI[0][0]} : 0;
sc_log_add('AUT_DOCS', "FINE onAfterInsert docs_count=$n");
