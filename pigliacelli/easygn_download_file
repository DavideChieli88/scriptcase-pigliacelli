/**
 * Blank ScriptCase: scarica PDF firmato da EasyGN e lo invia al browser.
 * API: GET {easygn_base_url}/files/download/{id}
 *
 * Contratti (gia in uso da grid_contratti, tasto show_contract_signed):
 *   [contrattoId] oppure ?contrattoId= — legge contratti.easygn_file_id
 * Documenti firmati (grid verdi e dichiarazioni, tasto show_signed_doc_btn):
 *   ?documentoId= oppure [documentoId] — legge documenti.easygn_file_id
 * sec_settings: easygn_bearer, easygn_base_url
 */
$documentoId = 0;
$contrattoId = 0;

if (isset($_GET['documentoId']) && (int)$_GET['documentoId'] > 0) {
    $documentoId = (int)$_GET['documentoId'];
} elseif (isset($_GET['contrattoId']) && (int)$_GET['contrattoId'] > 0) {
    $contrattoId = (int)$_GET['contrattoId'];
} elseif ((int)[contrattoId] > 0) {
    $contrattoId = (int)[contrattoId];
} elseif (isset($_REQUEST['documentoId']) && (int)$_REQUEST['documentoId'] > 0) {
    $documentoId = (int)$_REQUEST['documentoId'];
} elseif (isset([documentoId]) && (int)[documentoId] > 0) {
    $documentoId = (int)[documentoId];
}

if ($documentoId <= 0 && $contrattoId <= 0) {
    sc_error_message('contrattoId o documentoId mancante o non valido.');
    return;
}

$log = function ($msg) use ($contrattoId, $documentoId) {
    sc_log_add('EASYGN_DL', '[contrattoId=' . $contrattoId . '][documentoId=' . $documentoId . '] ' . (string)$msg);
};

$fail = function ($msg) use ($log) {
    $log('FAIL: ' . (string)$msg);
    if (function_exists('sc_error_message')) {
        sc_error_message((string)$msg);
    }
    die((string)$msg);
};

$sc_setting = function ($name, $default = '') {
    $safeName = str_replace("'", "''", trim((string)$name));
    sc_lookup(rsSet, "SELECT set_value FROM sec_settings WHERE set_name = '" . $safeName . "' LIMIT 1");
    if (isset({rsSet[0][0]})) {
        return trim((string){rsSet[0][0]});
    }
    return (string)$default;
};

$bearer = trim($sc_setting('easygn_bearer', ''));
if ($bearer === '') {
    $fail('Bearer EasyGN mancante in sec_settings (easygn_bearer).');
}

$easygnBaseUrl = rtrim(trim($sc_setting('easygn_base_url', 'https://easygn.digiwebuno.it/api')), '/');
$log('start download stream baseUrl=' . $easygnBaseUrl);

$wfId = '';
if ($documentoId > 0) {
    sc_lookup(rsF, "
        SELECT COALESCE(easygn_file_id, ''), COALESCE(easygn_workflow_id, '')
        FROM documenti
        WHERE id = $documentoId
        LIMIT 1
    ", 'pigliacelli');
    $wfId = isset({rsF[0][1]}) ? trim((string){rsF[0][1]}) : '';
} else {
    sc_lookup(rsF, "SELECT easygn_file_id FROM contratti WHERE id = $contrattoId LIMIT 1");
}
$fileId = !empty({rsF[0][0]}) ? trim((string){rsF[0][0]}) : '';
if (strcasecmp($fileId, 'null') === 0) {
    $fileId = '';
}

if ($fileId === '' && $documentoId > 0 && $wfId !== '' && function_exists('curl_init')) {
    $wfUrl = $easygnBaseUrl . '/workflows/' . rawurlencode($wfId);
    $log('file id assente, GET ' . $wfUrl);
    $chWf = curl_init();
    curl_setopt($chWf, CURLOPT_URL, $wfUrl);
    curl_setopt($chWf, CURLOPT_HTTPGET, true);
    curl_setopt($chWf, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($chWf, CURLOPT_CONNECTTIMEOUT, 15);
    curl_setopt($chWf, CURLOPT_TIMEOUT, 30);
    curl_setopt($chWf, CURLOPT_HTTPHEADER, array(
        'Authorization: Bearer ' . $bearer,
        'Accept: application/json',
    ));
    $wfBody = curl_exec($chWf);
    $wfHttp = (int)curl_getinfo($chWf, CURLINFO_HTTP_CODE);
    curl_close($chWf);
    $wfJson = is_string($wfBody) ? json_decode($wfBody, true) : null;
    if ($wfHttp >= 200 && $wfHttp < 300 && is_array($wfJson) && !empty($wfJson['files'][0]['id'])) {
        $fileId = trim((string)$wfJson['files'][0]['id']);
        $fileSql = str_replace("'", "''", $fileId);
        sc_exec_sql("
            UPDATE documenti
            SET easygn_file_id = '$fileSql'
            WHERE id = $documentoId
              AND (easygn_file_id IS NULL OR TRIM(easygn_file_id) = '')
        ", 'pigliacelli');
        $log('easygn_file_id recuperato dal workflow e salvato: ' . $fileId);
    }
}

if ($fileId === '') {
    if ($documentoId > 0) {
        $fail('easygn_file_id assente sul documento ' . $documentoId . ' (workflow ' . ($wfId !== '' ? $wfId : 'vuoto') . ').');
    }
    $fail('easygn_file_id assente su contratti per contratto_id=' . $contrattoId . ' (inviare prima la firma EasyGN).');
}

$easygn_get_download = function ($url, $bearerKy) {
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $url);
    curl_setopt($ch, CURLOPT_HTTPGET, true);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 15);
    curl_setopt($ch, CURLOPT_TIMEOUT, 120);
    curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
    curl_setopt($ch, CURLOPT_HTTPHEADER, [
        'Authorization: Bearer ' . $bearerKy,
        'Accept: application/pdf, application/octet-stream, application/json, */*',
    ]);

    $body = curl_exec($ch);
    $errno = curl_errno($ch);
    $err = curl_error($ch);
    $http = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $ctype = (string)curl_getinfo($ch, CURLINFO_CONTENT_TYPE);
    curl_close($ch);

    if ($errno) {
        return [false, "cURL error $errno: $err", $http, '', $ctype];
    }
    if ($http < 200 || $http >= 300) {
        return [false, "HTTP $http", $http, (string)$body, $ctype];
    }
    return [true, '', $http, (string)$body, $ctype];
};

$extract_pdf_binary = function ($body) {
    $body = (string)$body;
    if ($body === '') {
        return ['', 'body vuoto'];
    }
    if (strncmp($body, '%PDF', 4) === 0) {
        return [$body, 'binary'];
    }

    $json = json_decode($body, true);
    if (!is_array($json)) {
        return ['', 'risposta non PDF e non JSON'];
    }

    $candidates = [];
    $walker = function ($node) use (&$walker, &$candidates) {
        if (!is_array($node)) {
            return;
        }
        foreach (['content', 'file', 'data', 'document', 'body', 'pdf'] as $k) {
            if (isset($node[$k]) && is_string($node[$k]) && $node[$k] !== '') {
                $candidates[] = $node[$k];
            }
        }
        foreach ($node as $v) {
            if (is_array($v)) {
                $walker($v);
            }
        }
    };
    $walker($json);

    foreach ($candidates as $c) {
        $c = trim((string)$c);
        if ($c === '') {
            continue;
        }
        $bin = base64_decode($c, true);
        if ($bin !== false && strncmp($bin, '%PDF', 4) === 0) {
            return [$bin, 'json_base64'];
        }
    }

    return ['', 'JSON senza PDF decodificabile'];
};

$downloadUrl = $easygnBaseUrl . '/files/download/' . rawurlencode($fileId);
$log('GET ' . $downloadUrl);

[$ok, $err, $http, $respBody, $contentType] = $easygn_get_download($downloadUrl, $bearer);
if (!$ok) {
    $preview = preg_replace('/\s+/u', ' ', (string)$respBody);
    if ($preview !== null && strlen($preview) > 500) {
        $preview = substr($preview, 0, 500) . '...';
    }
    $fail('Download EasyGN fallito: ' . $err . "\nHTTP: $http\nRisposta: " . (string)$preview);
}

[$pdfBin, $source] = $extract_pdf_binary($respBody);
if ($pdfBin === '') {
    $fail('File scaricato ma non riconosciuto come PDF (' . $source . '). len=' . strlen((string)$respBody));
}

$pdfLen = strlen($pdfBin);
if ($documentoId > 0) {
    $filename = 'documento_' . $documentoId . '_firmato.pdf';
} else {
    $filename = 'contratto_' . $contrattoId . '_firmato.pdf';
}
$log("download ok http=$http source=$source pdf_len=$pdfLen → browser");

if (headers_sent()) {
    $fail('Headers già inviati: impossibile inviare il PDF al browser.');
}

header('Content-Type: application/pdf');
//header('Content-Disposition: attachment; filename="' . $filename . '"');
header('Content-Disposition: inline; filename="' . $filename . '"');
header('Content-Length: ' . (string)$pdfLen);
header('Cache-Control: no-store, no-cache, must-revalidate');
echo $pdfBin;
exit;
