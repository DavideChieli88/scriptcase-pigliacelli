if (!function_exists('form_subvettori_invia_mail_credenziali')) {
    function form_subvettori_invia_mail_credenziali($subvettore_id, $toEmail, $login, $plainPassword, $displayName)
    {
        $subvettore_id = (int)$subvettore_id;
        $toEmail = form_subvettori_email_pulisci($toEmail);
        $login = trim((string)$login);
        $plainPassword = trim((string)$plainPassword);
        $displayName = trim((string)$displayName);

        if ($subvettore_id <= 0 || !form_subvettori_email_valida($toEmail) || $login === '' || $plainPassword === '') {
            sc_log_add('SUBVETTORI_USER', 'mail credenziali skip: parametri non validi sub=' . $subvettore_id);
            return false;
        }

        if (!function_exists('sc_send_mail_api')) {
            sc_log_add('SUBVETTORI_USER', 'mail credenziali skip: sc_send_mail_api assente sub=' . $subvettore_id);
            return false;
        }

        sc_exec_sql("
            UPDATE sec_users
            SET active = 'Y'
            WHERE login = " . form_subvettori_sql_quote($login) . "
        ", 'pigliacelli');

        $portalUrl = rtrim(trim(form_subvettori_get_setting('login_url', '')), '/');
        if ($portalUrl === '') {
            $portalUrl = rtrim(trim(form_subvettori_get_setting('portal_url', '')), '/');
        }

        $nome = $displayName !== '' ? $displayName : 'Gentile utente';
        $titolo = 'Credenziali area riservata';
        $testo = $nome . ",\n\n"
            . "E' stata creata una nuova utenza per l'area riservata.\n"
            . "Puoi accedere con le credenziali seguenti (password temporanea).\n\n"
            . "Login: " . $login . "\n"
            . "Password: " . $plainPassword . "\n";
        if ($portalUrl !== '') {
            $testo .= "\nArea riservata: " . $portalUrl . "\n";
        }
        $testo .= "\nMessaggio automatico — non rispondere.";

        $safeLogin = htmlspecialchars($login, ENT_QUOTES, 'UTF-8');
        $safePwd = htmlspecialchars($plainPassword, ENT_QUOTES, 'UTF-8');
        $safeNome = htmlspecialchars($nome, ENT_QUOTES, 'UTF-8');
        $inner = '<p style="margin:0 0 16px;">' . $safeNome . ',</p>'
            . '<p style="margin:0 0 20px;">E\' stata creata una nuova utenza per l\'<strong>area riservata</strong>. '
            . 'Ecco le credenziali di accesso (password temporanea).</p>'
            . '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" '
            . 'style="margin:0 0 20px;background:#f8f9fb;border:1px solid #e2e6ea;border-radius:8px;">'
            . '<tr><td style="padding:16px 18px;font-size:14px;line-height:1.6;">'
            . '<strong>Login:</strong> ' . $safeLogin . '<br><strong>Password:</strong> ' . $safePwd
            . '</td></tr></table>';
        if ($portalUrl !== '') {
            $safePortal = htmlspecialchars($portalUrl, ENT_QUOTES, 'UTF-8');
            $inner .= '<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px;"><tr>'
                . '<td align="center" bgcolor="#1a3a5c" style="border-radius:8px;background-color:#1a3a5c;">'
                . '<a href="' . $safePortal . '" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;'
                . 'color:#ffffff;text-decoration:none;">Accedi all\'area riservata</a>'
                . '</td></tr></table>';
        }
        $html = form_subvettori_mail_layout($titolo, $inner, form_subvettori_mail_logo_src());

        try {
            $mailOk = sc_send_mail_api(array_merge(form_subvettori_get_smtp_config(), array(
                'message' => array(
                    'html'    => $html,
                    'text'    => $testo,
                    'to'      => $toEmail,
                    'subject' => $titolo,
                ),
            )));
            if ($mailOk === false || $mailOk === null) {
                sc_log_add('SUBVETTORI_USER', 'mail credenziali FAIL invio sub=' . $subvettore_id . ' to=' . $toEmail);
                return false;
            }
        } catch (Throwable $e) {
            sc_log_add('SUBVETTORI_USER', 'mail credenziali EXCEPTION sub=' . $subvettore_id . ' msg=' . $e->getMessage());
            return false;
        }

        sc_log_add(
            'SUBVETTORI_USER',
            'mail credenziali inviata sub=' . $subvettore_id . ' to=' . $toEmail . ' login=' . $login
        );
        return true;
    }
}

if (!function_exists('form_subvettori_genera_password_temp')) {
    function form_subvettori_genera_password_temp()
    {
        $chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_!+-*';
        $len = strlen($chars);
        $pwd = '';

        for ($i = 0; $i < 12; $i++) {
            $pwd .= $chars[random_int(0, $len - 1)];
        }

        return $pwd;
    }
}

if (!function_exists('form_subvettori_login_collegato_a_sub')) {
    function form_subvettori_login_collegato_a_sub($login, $subvettore_id)
    {
        sc_lookup(rsLoginSub, "
            SELECT login
            FROM sec_users
            WHERE login = " . form_subvettori_sql_quote($login) . "
              AND subvettore_id = " . form_subvettori_sql_num($subvettore_id) . "
            LIMIT 1
        ", "pigliacelli");

        return !empty({rsLoginSub});
    }
}

if (!function_exists('form_subvettori_crea_utenza')) {
    function form_subvettori_crea_utenza($subvettore_id, $login, $email, $ragione_sociale, $phone)
    {
        $plainPassword = form_subvettori_genera_password_temp();
        $password_hash = md5($plainPassword);

        sc_exec_sql("
            INSERT INTO sec_users (
                login,
                pswd,
                name,
                email,
                phone,
                active,
                subvettore_id
            ) VALUES (
                " . form_subvettori_sql_quote($login) . ",
                " . form_subvettori_sql_quote($password_hash) . ",
                " . form_subvettori_sql_quote($ragione_sociale) . ",
                " . form_subvettori_sql_quote($email) . ",
                " . form_subvettori_sql_quote($phone) . ",
                'Y',
                " . form_subvettori_sql_num($subvettore_id) . "
            )
        ", "pigliacelli");

        sc_exec_sql("
            INSERT INTO sec_users_groups (login, group_id)
            VALUES (" . form_subvettori_sql_quote($login) . ", 2)
        ", "pigliacelli");

        return array(
            'login'    => trim((string)$login),
            'password' => $plainPassword,
            'email'    => form_subvettori_email_pulisci($email),
        );
    }
}

if (!function_exists('form_subvettori_aggiorna_anagrafica_utenza')) {
    function form_subvettori_aggiorna_anagrafica_utenza($subvettore_id, $login, $email, $ragione_sociale, $phone)
    {
        sc_exec_sql("
            UPDATE sec_users
            SET email = " . form_subvettori_sql_quote($email) . ",
                name = " . form_subvettori_sql_quote($ragione_sociale) . ",
                phone = " . form_subvettori_sql_quote($phone) . "
            WHERE subvettore_id = " . form_subvettori_sql_num($subvettore_id) . "
              AND login = " . form_subvettori_sql_quote($login) . "
        ", "pigliacelli");
    }
}

if (!function_exists('form_subvettori_disabilita_utenza_precedente')) {
    function form_subvettori_disabilita_utenza_precedente($subvettore_id, $nuovo_login)
    {
        $subvettore_id = (int)$subvettore_id;
        $nuovo_login = trim((string)$nuovo_login);
        $vecchio_login = '';

        if (isset([glo_sub_login_subvettore_old])) {
            $vecchio_login = trim((string)[glo_sub_login_subvettore_old]);
        }

        if ($subvettore_id <= 0 || $vecchio_login === '') {
            return;
        }
        if ($nuovo_login !== '' && strcasecmp($vecchio_login, $nuovo_login) === 0) {
            return;
        }

        sc_exec_sql("
            UPDATE sec_users
            SET active = 'N'
            WHERE login = " . form_subvettori_sql_quote($vecchio_login) . "
              AND subvettore_id = " . form_subvettori_sql_num($subvettore_id) . "
        ", 'pigliacelli');

        sc_log_add(
            'SUBVETTORI_USER',
            'disabilitata utenza precedente subvettore_id=' . $subvettore_id .
            ' login=' . $vecchio_login
        );
    }
}

if (!function_exists('form_subvettori_sync_sec_user')) {
    function form_subvettori_sync_sec_user($subvettore_id, $login_subvettore, $ragione_sociale, $phone)
    {
        $subvettore_id = (int)$subvettore_id;
        if ($subvettore_id <= 0) {
            sc_log_add('SUBVETTORI_USER', 'skip: subvettore_id non valido');
            return;
        }

        $login_subvettore = trim((string)$login_subvettore);
        $ragione_sociale = trim((string)$ragione_sociale);
        $phone = trim((string)$phone);

        if (form_subvettori_login_collegato_a_sub($login_subvettore, $subvettore_id)) {
            form_subvettori_aggiorna_anagrafica_utenza(
                $subvettore_id,
                $login_subvettore,
                $login_subvettore,
                $ragione_sociale,
                $phone
            );
            sc_log_add(
                'SUBVETTORI_USER',
                'aggiornata anagrafica utenza esistente subvettore_id=' . $subvettore_id .
                ' login=' . $login_subvettore
            );
        }

        if (!form_subvettori_mail_cambiata()) {
            return;
        }

        if (form_subvettori_login_collegato_a_sub($login_subvettore, $subvettore_id)) {
            return;
        }

        $created = form_subvettori_crea_utenza(
            $subvettore_id,
            $login_subvettore,
            $login_subvettore,
            $ragione_sociale,
            $phone
        );
        sc_log_add(
            'SUBVETTORI_USER',
            'creata nuova utenza subvettore_id=' . $subvettore_id .
            ' login=' . $login_subvettore . ' active=Y'
        );
        if (is_array($created)) {
            form_subvettori_disabilita_utenza_precedente($subvettore_id, $login_subvettore);
            form_subvettori_invia_mail_credenziali(
                $subvettore_id,
                $created['email'],
                $created['login'],
                $created['password'],
                $ragione_sociale
            );
        }
    }
}

