if (!function_exists('form_subvettori_email_pulisci')) {
    function form_subvettori_email_pulisci($email)
    {
        $email = trim((string)$email);
        if ($email === '') {
            return '';
        }

        $original = $email;
        // Solo sequenze UTF-8 esplicite (no regex con range: rischia di matchare lettere ASCII)
        static $utf8_invisibili = array(
            "\xEF\xBB\xBF", // U+FEFF BOM
            "\xE2\x80\x8B", // U+200B zero-width space
            "\xE2\x80\x8C", // U+200C
            "\xE2\x80\x8D", // U+200D
            "\xE2\x81\xA0", // U+2060 word joiner
            "\xC2\xAD",     // U+00AD soft hyphen
        );

        do {
            $prev = $email;
            foreach ($utf8_invisibili as $seq) {
                if ($seq !== '' && strpos($email, $seq) === 0) {
                    $email = substr($email, strlen($seq));
                }
            }
            $email = trim($email);
            foreach ($utf8_invisibili as $seq) {
                $len = strlen($seq);
                if ($len > 0 && strlen($email) >= $len && substr($email, -$len) === $seq) {
                    $email = substr($email, 0, -$len);
                }
            }
            $email = trim($email);
        } while ($email !== $prev && $email !== '');

        if ($email !== $original
            && filter_var($original, FILTER_VALIDATE_EMAIL)
            && !filter_var($email, FILTER_VALIDATE_EMAIL)
        ) {
            return trim($original);
        }

        return $email;
    }
}

if (!function_exists('form_subvettori_email_valida')) {
    function form_subvettori_email_valida($email)
    {
        $email = form_subvettori_email_pulisci($email);
        if ($email === '') {
            return false;
        }
        if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
            return false;
        }
        return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
    }
}

if (!function_exists('form_subvettori_get_setting')) {
    function form_subvettori_get_setting($name, $default = '')
    {
        $key = 'sett_' . $name;
        if (isset($_SESSION[$key])) {
            return (string)$_SESSION[$key];
        }
        $safeName = str_replace("'", "''", trim((string)$name));
        sc_lookup(rsSubSet, "SELECT set_value FROM sec_settings WHERE set_name = '$safeName' LIMIT 1", 'pigliacelli');
        if (isset({rsSubSet[0][0]})) {
            return (string){rsSubSet[0][0]};
        }
        return $default;
    }
}

if (!function_exists('form_subvettori_get_smtp_config')) {
    function form_subvettori_get_smtp_config()
    {
        sc_lookup(rsSubSmtp, 'SELECT set_name, set_value FROM sec_settings', 'pigliacelli');
        if (!empty({rsSubSmtp})) {
            foreach ({rsSubSmtp} as $f) {
                $_SESSION['sett_' . $f[0]] = $f[1];
            }
        }
        $smtpApi = isset($_SESSION['sett_smtp_api']) ? (string)$_SESSION['sett_smtp_api'] : '';
        if ($smtpApi === 'custom') {
            return array(
                'settings' => array(
                    'gateway'       => 'smtp',
                    'smtp_server'   => (string)($_SESSION['sett_smtp_server'] ?? ''),
                    'smtp_protocol' => (string)($_SESSION['sett_smtp_security'] ?? ''),
                    'smtp_port'     => (string)($_SESSION['sett_smtp_port'] ?? ''),
                    'smtp_user'     => (string)($_SESSION['sett_smtp_user'] ?? ''),
                    'smtp_password' => (string)($_SESSION['sett_smtp_pass'] ?? ''),
                    'from_email'    => (string)($_SESSION['sett_smtp_from_email'] ?? ''),
                    'from_name'     => (string)($_SESSION['sett_smtp_from_name'] ?? ''),
                ),
            );
        }
        return array('profile' => $smtpApi);
    }
}

if (!function_exists('form_subvettori_mail_logo_src')) {
    function form_subvettori_mail_logo_src()
    {
        $rel = '_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png';
        $dir = realpath(dirname(__FILE__));
        for ($i = 0; $i < 12 && $dir; $i++) {
            $try = $dir . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $rel);
            if (is_readable($try)) {
                $bin = @file_get_contents($try);
                if ($bin !== false && $bin !== '' && strlen($bin) < 500000) {
                    return 'data:image/png;base64,' . base64_encode($bin);
                }
            }
            $p = dirname($dir);
            if ($p === $dir) {
                break;
            }
            $dir = $p;
        }
        $base = rtrim(trim(form_subvettori_get_setting('mail_base_url', '')), '/');
        if ($base !== '' && preg_match('#^https?://#i', $base) === 1) {
            return htmlspecialchars(
                $base . '/_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png',
                ENT_QUOTES,
                'UTF-8'
            );
        }
        return '';
    }
}

