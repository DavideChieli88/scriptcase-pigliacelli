// Scriptcase blank: upsert_subvectors_basevettori
// Job schedulato (senza UI): solo log UPSERT_SUB_T0 / EXPORT_DATA.
// Upsert subvettori da SGA (T2BaseVettori + BaCliFor) verso pigliacelli.
// Su INSERT nuovo subvettore + utenza: CALL bootstrap_documenti_from_preset(sub_id, login).
// Mail credenziali: coda mail_credenziali_inviata_at IS NULL → send_credenziali_subvettori_batch.
//
// Parametro URL: ?dry_run=1
// Multi-utenza: email SGA diversa → disabilita vecchia utenza, crea nuova, rimette mail in coda.

function upsert_sub_t0_log($msg)
{
    sc_log_add('UPSERT_SUB_T0', (string)$msg);
}

function upsert_sub_t0_sql_quote($v)
{
    if ($v === null) {
        return "NULL";
    }
    return "'" . str_replace("'", "''", (string)$v) . "'";
}

function upsert_sub_t0_valore_o_null($v)
{
    if ($v === null) {
        return null;
    }
    $v = trim((string)$v);
    if ($v === '') {
        return null;
    }
    return $v;
}

function upsert_sub_t0_email_valida($email)
{
    $email = trim((string)$email);
    if ($email === '') {
        return false;
    }
    if (strpos($email, ';') !== false) {
        return false;
    }
    if (strpos($email, ',') !== false) {
        return false;
    }
    if (strpos($email, ' ') !== false) {
        return false;
    }
    return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
}

function upsert_sub_t0_connetti_sga($settings)
{
    $set_names = array('sgam_user', 'sgam_pswd', 'sgam_db', 'sgam_server');

    foreach ($set_names as $set_name) {
        if (!array_key_exists($set_name, $settings)) {
            upsert_sub_t0_log("ERRORE sec_settings mancante: $set_name");
            return null;
        }
        if (trim((string)$settings[$set_name]) === '') {
            upsert_sub_t0_log("ERRORE sec_settings vuoto: $set_name");
            return null;
        }
    }

    try {
        $dsn = "sqlsrv:Server=" . $settings['sgam_server']
            . ";Database=" . $settings['sgam_db']
            . ";Encrypt=1"
            . ";TrustServerCertificate=1";

        upsert_sub_t0_log(
            'Connessione PDO SGA server=' . $settings['sgam_server']
            . ' db=' . $settings['sgam_db']
        );

        $pdo_opts = array(
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_NUM,
        );

        return new PDO(
            $dsn,
            $settings['sgam_user'],
            $settings['sgam_pswd'],
            $pdo_opts
        );
    } catch (PDOException $e) {
        upsert_sub_t0_log('ERRORE connessione SGA: ' . $e->getMessage());
        return null;
    }
}

function upsert_sub_t0_sql_num($v)
{
    if ($v === null || $v === '') {
        return "NULL";
    }
    return (string)(0 + $v);
}

function upsert_sub_t0_generate_temp_password()
{
    $characters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_!+-*';
    $charactersLength = strlen($characters);
    $temporaryPassword = '';

    for ($i = 0; $i < 12; $i++) {
        $temporaryPassword .= $characters[random_int(0, $charactersLength - 1)];
    }

    return $temporaryPassword;
}

function upsert_sub_t0_login_collegato_a_sub($login, $subvettore_id)
{
    $login = trim((string)$login);
    $subvettore_id = (int)$subvettore_id;
    if ($login === '' || $subvettore_id <= 0) {
        return false;
    }

    sc_lookup(rsUpsertLoginSub, "
        SELECT login
        FROM sec_users
        WHERE login = " . upsert_sub_t0_sql_quote($login) . "
          AND subvettore_id = " . upsert_sub_t0_sql_num($subvettore_id) . "
        LIMIT 1
    ", 'pigliacelli');

    return !empty({rsUpsertLoginSub});
}

function upsert_sub_t0_login_usato_da_altro_sub($login, $subvettore_id)
{
    $login = trim((string)$login);
    $subvettore_id = (int)$subvettore_id;
    if ($login === '') {
        return false;
    }

    sc_lookup(rsUpsertLoginAlt, "
        SELECT subvettore_id
        FROM sec_users
        WHERE login = " . upsert_sub_t0_sql_quote($login) . "
        LIMIT 1
    ", 'pigliacelli');

    if (empty({rsUpsertLoginAlt})) {
        return false;
    }

    $sub_alt = {rsUpsertLoginAlt[0][0]};
    if ($sub_alt === null || $sub_alt === '') {
        return true;
    }

    return (int)$sub_alt !== $subvettore_id;
}

function upsert_sub_t0_disabilita_utenza($subvettore_id, $vecchio_login)
{
    $subvettore_id = (int)$subvettore_id;
    $vecchio_login = trim((string)$vecchio_login);
    if ($subvettore_id <= 0 || $vecchio_login === '') {
        return;
    }

    sc_exec_sql("
        UPDATE sec_users
        SET active = 'N'
        WHERE login = " . upsert_sub_t0_sql_quote($vecchio_login) . "
          AND subvettore_id = " . upsert_sub_t0_sql_num($subvettore_id) . "
    ", 'pigliacelli');

    upsert_sub_t0_log(
        'UTENZA disabilitata subvettore_id=' . $subvettore_id . ' login=' . $vecchio_login
    );
}

function upsert_sub_t0_aggiorna_anagrafica_utenza($subvettore_id, $login, $email, $ragione_sociale, $phone)
{
