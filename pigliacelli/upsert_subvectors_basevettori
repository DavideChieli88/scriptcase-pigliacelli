            phone = " . upsert_sub_t0_sql_quote($phone) . "
        WHERE subvettore_id = " . upsert_sub_t0_sql_num($subvettore_id) . "
          AND login = " . upsert_sub_t0_sql_quote($login) . "
    ", 'pigliacelli');
}

function upsert_sub_t0_crea_utenza($subvettore_id, $email, $ragione_sociale, $phone)
{
    $group_id = 2;
    $email = trim((string)$email);

    if (!upsert_sub_t0_email_valida($email)) {
        return null;
    }

    if (upsert_sub_t0_login_collegato_a_sub($email, $subvettore_id)) {
        return array('login' => $email, 'gia_esistente' => true);
    }

    if (upsert_sub_t0_login_usato_da_altro_sub($email, $subvettore_id)) {
        upsert_sub_t0_log(
            'UTENZA skip email=' . $email . ' gia login di altro subvettore'
        );
        return null;
    }

    // Password placeholder: il batch mail la rigenera all'invio
    $password_hash = md5(upsert_sub_t0_generate_temp_password());

    sc_exec_sql("
        INSERT INTO sec_users (
            login, pswd, name, email, phone, active, subvettore_id
        ) VALUES (
            " . upsert_sub_t0_sql_quote($email) . ",
            " . upsert_sub_t0_sql_quote($password_hash) . ",
            " . upsert_sub_t0_sql_quote($ragione_sociale) . ",
            " . upsert_sub_t0_sql_quote($email) . ",
            " . upsert_sub_t0_sql_quote($phone) . ",
            'Y',
            " . upsert_sub_t0_sql_num($subvettore_id) . "
        )
    ", 'pigliacelli');

    sc_exec_sql("
        INSERT INTO sec_users_groups (login, group_id)
        VALUES (
            " . upsert_sub_t0_sql_quote($email) . ",
            " . upsert_sub_t0_sql_num($group_id) . "
        )
    ", 'pigliacelli');

    upsert_sub_t0_log(
        'UTENZA creata subvettore_id=' . (int)$subvettore_id . ' login=' . $email
    );

    return array('login' => $email, 'gia_esistente' => false);
}

function upsert_sub_t0_aggiorna_login_subvettore($subvettore_id, $email)
{
    sc_exec_sql("
        UPDATE subvettori
        SET login_subvettore = " . upsert_sub_t0_sql_quote($email) . "
        WHERE id = " . upsert_sub_t0_sql_num($subvettore_id) . "
    ", 'pigliacelli');
}

/** Dopo create utenza: documenti preset (tipi_documento.from_preset = 1). Idempotente. */
function upsert_sub_t0_bootstrap_documenti_from_preset($subvettore_id, $login, $dry_run = false)
{
    $subvettore_id = (int)$subvettore_id;
    $login = trim((string)$login);

    if ($subvettore_id <= 0 || $login === '') {
        return false;
    }

    if ($dry_run) {
        upsert_sub_t0_log(
            'DRY_RUN CALL bootstrap_documenti_from_preset sub=' . $subvettore_id
            . ' login=' . $login
        );
        return true;
    }

    try {
        sc_exec_sql("
            CALL bootstrap_documenti_from_preset(
                " . upsert_sub_t0_sql_num($subvettore_id) . ",
                " . upsert_sub_t0_sql_quote($login) . "
            )
        ", 'pigliacelli');
        upsert_sub_t0_log(
            'CALL bootstrap_documenti_from_preset ok sub=' . $subvettore_id
            . ' login=' . $login
        );
        return true;
    } catch (Exception $e) {
        upsert_sub_t0_log(
            'CALL bootstrap_documenti_from_preset ERRORE sub=' . $subvettore_id
            . ' — ' . $e->getMessage()
        );
        return false;
    } catch (Throwable $e) {
        upsert_sub_t0_log(
            'CALL bootstrap_documenti_from_preset ERRORE sub=' . $subvettore_id
            . ' — ' . $e->getMessage()
        );
        return false;
    }
}

function upsert_sub_t0_sincronizza_utenza($subvettore_id, $email, $ragione_sociale, $phone, $dry_run)
{
    $subvettore_id = (int)$subvettore_id;
    $email = trim((string)$email);
    $phone = trim((string)$phone);
    $vuoto = array('esito' => 'skip_email', 'login' => '', 'vecchio_login' => '');

    if ($subvettore_id <= 0 || !upsert_sub_t0_email_valida($email)) {
        return $vuoto;
    }

    sc_lookup(rsUpsertSubLogin, "
        SELECT COALESCE(login_subvettore, '')
        FROM subvettori
        WHERE id = " . upsert_sub_t0_sql_num($subvettore_id) . "
        LIMIT 1
    ", 'pigliacelli');

    $login_db = '';
    if (!empty({rsUpsertSubLogin})) {
        $login_db = trim((string){rsUpsertSubLogin[0][0]});
    }

    if (upsert_sub_t0_login_collegato_a_sub($email, $subvettore_id)) {
        if (!$dry_run) {
            upsert_sub_t0_aggiorna_anagrafica_utenza($subvettore_id, $email, $email, $ragione_sociale, $phone);
            if ($login_db !== '' && strcasecmp($login_db, $email) !== 0) {
                upsert_sub_t0_aggiorna_login_subvettore($subvettore_id, $email);
            }
        } else {
            upsert_sub_t0_log(
                'DRY_RUN UTENZA aggiorna anagrafica sub=' . $subvettore_id . ' login=' . $email
            );
        }
        return array('esito' => 'ok_esistente', 'login' => $email, 'vecchio_login' => '');
    }

    if (upsert_sub_t0_login_usato_da_altro_sub($email, $subvettore_id)) {
        return array('esito' => 'skip_occupato', 'login' => '', 'vecchio_login' => '');
    }

    if ($login_db !== '' && strcasecmp($login_db, $email) !== 0 && upsert_sub_t0_login_collegato_a_sub($login_db, $subvettore_id)) {
        if ($dry_run) {
            upsert_sub_t0_log(
                'DRY_RUN UTENZA multi sub=' . $subvettore_id .
                ' da=' . $login_db . ' a=' . $email
            );
            return array('esito' => 'multi_utenza', 'login' => $email, 'vecchio_login' => $login_db);
        }

        upsert_sub_t0_disabilita_utenza($subvettore_id, $login_db);
        $creata = upsert_sub_t0_crea_utenza($subvettore_id, $email, $ragione_sociale, $phone);
        if ($creata === null || !empty($creata['gia_esistente'])) {
            return array('esito' => 'errore_crea', 'login' => '', 'vecchio_login' => $login_db);
        }

        upsert_sub_t0_aggiorna_login_subvettore($subvettore_id, $email);
        return array('esito' => 'multi_utenza', 'login' => $creata['login'], 'vecchio_login' => $login_db);
    }

    if ($dry_run) {
        upsert_sub_t0_log(
            'DRY_RUN UTENZA crea sub=' . $subvettore_id . ' login=' . $email
        );
        return array('esito' => 'creata', 'login' => $email, 'vecchio_login' => '');
    }

    $creata = upsert_sub_t0_crea_utenza($subvettore_id, $email, $ragione_sociale, $phone);
    if ($creata === null || !empty($creata['gia_esistente'])) {
        return array('esito' => 'errore_crea', 'login' => '', 'vecchio_login' => '');
    }

    upsert_sub_t0_aggiorna_login_subvettore($subvettore_id, $email);
    return array('esito' => 'creata', 'login' => $creata['login'], 'vecchio_login' => '');
}

function upsert_sub_t0_accoda_mail_credenziali($subvettore_id, $login, $esito_u, $dry_run = false)
{
    $subvettore_id = (int)$subvettore_id;
    $login = trim((string)$login);
    $esito = isset($esito_u['esito']) ? (string)$esito_u['esito'] : '';

    if ($subvettore_id <= 0 || $login === '') {
        return 'skip';
    }
    if ($esito !== 'creata' && $esito !== 'multi_utenza') {
        return 'skip';
    }

    if ($dry_run) {
        upsert_sub_t0_log(
            'DRY_RUN MAIL_CRED in coda sub=' . $subvettore_id . ' login=' . $login
            . ' esito=' . $esito
        );
        return 'dry_run';
    }

    try {
        sc_exec_sql("
            UPDATE subvettori
            SET mail_credenziali_inviata_at = NULL
            WHERE id = " . upsert_sub_t0_sql_num($subvettore_id) . "
        ", 'pigliacelli');
        upsert_sub_t0_log(
            'MAIL_CRED in coda sub=' . $subvettore_id . ' login=' . $login
            . ' esito=' . $esito
        );
        return 'coda';
    } catch (Throwable $e) {
        upsert_sub_t0_log(
            'MAIL_CRED coda ERRORE sub=' . $subvettore_id . ' — ' . $e->getMessage()
        );
        return 'errore';
    }
}

