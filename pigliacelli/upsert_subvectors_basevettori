                if ($esito_u['esito'] === 'creata') {
                    $utenze_create++;
                } elseif ($esito_u['esito'] === 'multi_utenza') {
                    $utenze_multi++;
                } elseif ($esito_u['esito'] === 'skip_occupato') {
                    $utenze_skip_occupato++;
                }
                $esito_mail = upsert_sub_t0_accoda_mail_credenziali(
                    $sub_id,
                    $login_ins,
                    $esito_u,
                    true
                );
                if ($esito_mail === 'dry_run' || $esito_mail === 'coda') {
                    $mail_in_coda++;
                }
            }
            continue;
        }

        try {
            sc_exec_sql($upd, 'pigliacelli');
            $aggiornati++;
            if ($login_ins !== '') {
                $esito_u = upsert_sub_t0_sincronizza_utenza(
                    $sub_id,
                    $login_ins,
                    $ragione_sociale,
                    $phone_utenza,
                    false
                );
                if ($esito_u['esito'] === 'creata') {
                    $utenze_create++;
                    if ($login_attuale === '') {
                        $login_riempiti++;
                    }
                    $sub_esistenti[$codice_key]['login_subvettore'] = $login_ins;
                } elseif ($esito_u['esito'] === 'multi_utenza') {
                    $utenze_multi++;
                    $sub_esistenti[$codice_key]['login_subvettore'] = $login_ins;
                } elseif ($esito_u['esito'] === 'skip_occupato') {
                    $utenze_skip_occupato++;
                }
                $esito_mail = upsert_sub_t0_accoda_mail_credenziali(
                    $sub_id,
                    isset($esito_u['login']) && $esito_u['login'] !== '' ? $esito_u['login'] : $login_ins,
                    $esito_u,
                    false
                );
                if ($esito_mail === 'coda') {
                    $mail_in_coda++;
                } elseif ($esito_mail === 'errore') {
                    $mail_coda_errore++;
                }
            }
        } catch (Exception $e) {
            $errori++;
            upsert_sub_t0_log("ERRORE UPDATE id=$sub_id codice_sga=$codice_key — " . $e->getMessage());
        } catch (Throwable $e) {
            $errori++;
            upsert_sub_t0_log("ERRORE UPDATE id=$sub_id codice_sga=$codice_key — " . $e->getMessage());
        }
        continue;
    }

    $login_val = null;
    if ($login_ins !== '') {
        $login_val = $login_ins;
    }

    $ins = "
        INSERT INTO subvettori
            (login_subvettore, ragione_sociale, cod_fiscale, piva, phone, cellphone,
             indirizzo, sede_citta, sede_prov, codice_sga, pec)
        VALUES
            (" . upsert_sub_t0_sql_quote($login_val) . ",
             " . upsert_sub_t0_sql_quote($ragione_sociale) . ",
             " . upsert_sub_t0_sql_quote($cod_fiscale) . ",
             " . upsert_sub_t0_sql_quote($piva) . ",
             " . upsert_sub_t0_sql_quote($phone) . ",
             " . upsert_sub_t0_sql_quote($cellphone) . ",
             " . upsert_sub_t0_sql_quote($indirizzo) . ",
             " . upsert_sub_t0_sql_quote($sede_citta) . ",
             " . upsert_sub_t0_sql_quote($sede_prov) . ",
             " . upsert_sub_t0_sql_quote($codice_key) . ",
             " . $pec_sql . ")
    ";

    if ($upsert_sub_dry_run) {
        $inseriti++;
        upsert_sub_t0_log("DRY_RUN INSERT codice_sga=$codice_key login=$login_ins");
        if ($login_ins !== '') {
            upsert_sub_t0_log(
                'DRY_RUN UTENZA crea codice_sga=' . $codice_key . ' login=' . $login_ins
            );
            $utenze_create++;
            upsert_sub_t0_log('DRY_RUN MAIL_CRED in coda login=' . $login_ins);
            $mail_in_coda++;
            upsert_sub_t0_log(
                'DRY_RUN CALL bootstrap_documenti_from_preset codice_sga=' . $codice_key
                . ' login=' . $login_ins
            );
        }
        $sub_esistenti[$codice_key] = array(
            'id' => 0,
            'login_subvettore' => $login_ins,
        );
        continue;
    }

    try {
        sc_exec_sql($ins, 'pigliacelli');
        $inseriti++;

        sc_lookup(rsUpsertLastSubId, "SELECT LAST_INSERT_ID()", 'pigliacelli');
        $new_sub_id = 0;
        if (!empty({rsUpsertLastSubId})) {
            $new_sub_id = (int){rsUpsertLastSubId[0][0]};
        }

        if ($new_sub_id > 0 && $login_ins !== '') {
            $esito_u = upsert_sub_t0_sincronizza_utenza(
                $new_sub_id,
                $login_ins,
                $ragione_sociale,
                $phone_utenza,
                false
            );
            if ($esito_u['esito'] === 'creata') {
                $utenze_create++;
                $login_riempiti++;
            } elseif ($esito_u['esito'] === 'skip_occupato') {
                $utenze_skip_occupato++;
            }
            $esito_mail = upsert_sub_t0_accoda_mail_credenziali(
                $new_sub_id,
                isset($esito_u['login']) && $esito_u['login'] !== '' ? $esito_u['login'] : $login_ins,
                $esito_u,
                false
            );
            if ($esito_mail === 'coda') {
                $mail_in_coda++;
            } elseif ($esito_mail === 'errore') {
                $mail_coda_errore++;
            }

            // Preset documenti: dopo utenza (serve login in sec_users)
            if ($esito_u['login'] !== ''
                && ($esito_u['esito'] === 'creata'
                    || $esito_u['esito'] === 'ok_esistente'
                    || $esito_u['esito'] === 'multi_utenza')
            ) {
                upsert_sub_t0_bootstrap_documenti_from_preset(
                    $new_sub_id,
                    $esito_u['login'],
                    false
                );
            }
        }

        $sub_esistenti[$codice_key] = array(
            'id' => $new_sub_id,
            'login_subvettore' => $login_ins,
        );
    } catch (Exception $e) {
        $errori++;
        upsert_sub_t0_log("ERRORE INSERT codice_sga=$codice_key login=$login_ins — " . $e->getMessage());
    } catch (Throwable $e) {
        $errori++;
        upsert_sub_t0_log("ERRORE INSERT codice_sga=$codice_key login=$login_ins — " . $e->getMessage());
    }
}

$stmt->closeCursor();

$riepilogo = 'END letti_sga=' . $letti_sga
    . ' inseriti=' . $inseriti
    . ' aggiornati=' . $aggiornati
    . ' errori=' . $errori
    . ' login_riempiti=' . $login_riempiti
    . ' utenze_create=' . $utenze_create
    . ' utenze_multi=' . $utenze_multi
    . ' utenze_skip_occupato=' . $utenze_skip_occupato
    . ' mail_in_coda=' . $mail_in_coda
    . ' mail_coda_errore=' . $mail_coda_errore
    . ' senza_email=' . $senza_email
    . ' senza_pec=' . $senza_pec
    . ' senza_piva_cf=' . $senza_piva
    . $upsert_sub_dry_suffix;

upsert_sub_t0_log($riepilogo);
sc_log_add('EXPORT_DATA', 'Upsert subvettori T0: ' . $riepilogo);

