/**
 * form_subvettori_starting_wizard → onBeforeUpdate
 *
 * COMMIT prima che Scriptcase apra la transazione del salvataggio.
 * Senza, il Prossimo verso gli autisti va in
 * "There is already an active transaction".
 * Niente altre query qui.
 */


$wizComplete = isset({wizard_complete}) ? (int){wizard_complete} : 0;
$wizStep     = isset({wizard_step}) ? (int){wizard_step} : 1;

if ($wizComplete === 0 && $wizStep === 1) {
    {wizard_step} = 2;
}

sc_exec_sql('COMMIT');