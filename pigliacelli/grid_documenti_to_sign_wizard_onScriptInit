/**
 * grid_documenti_to_sign_wizard → onScriptInit
 *
 * Wizard step 5: elenco documenti verdi (tipi_documento.is_readonly=1)
 * del subvettore loggato. Crea gli slot mancanti, blocca accesso se non in step 5.
 *
 * SETUP GRID (ScriptCase IDE):
 * - SQL esempio:
 *     SELECT d.id, d.subvettore_id, d.tipo_documento_id, d.file, d.firmato_il,
 *            td.nome AS td_nome
 *     FROM documenti d
 *     INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
 *     WHERE td.is_readonly = 1 AND d.subvettore_id = [subvettoreId]
 * - Campi SC: {d.id}, {d.tipo_documento_id}, {d.file}, {d.firmato_il},
 *   {d.subvettore_id}, {td_nome}  (punto sull'alias; td_nome perché ha AS)
 * - Action Bar Ajax: open_pdf_btn, sign_doc_btn
 * - Toolbar: send_for_activation
 * - Security: group 2
 *
 * onScriptInit: auth step 5, crea slot documenti, sync firmato_il da EasyGN.
 * Mail operatori: solo nel pulsante "Invia per attivazione".
 */

if (!function_exists('wiz_verdi_sql_quote')) {
    function wiz_verdi_sql_quote($s)
    {
        return str_replace("'", "''", (string)$s);
    }
}
if (!function_exists('wiz_verdi_setting')) {
    function wiz_verdi_setting($name, $default = '')
    {
        $safe = wiz_verdi_sql_quote(trim((string)$name));
        sc_lookup(rsWizVerdiSet, "SELECT set_value FROM sec_settings WHERE set_name = '" . $safe . "' LIMIT 1", 'pigliacelli');
        if (isset({rsWizVerdiSet[0][0]})) {
            return trim((string){rsWizVerdiSet[0][0]});
        }
        return (string)$default;
    }
}
if (!function_exists('wiz_verdi_ensure_documenti')) {
    function wiz_verdi_ensure_documenti($subvettore_id, $login = '')
    {
        $subvettore_id = (int)$subvettore_id;
        if ($subvettore_id <= 0) {
            return 0;
        }
        $login = trim((string)$login);
        if ($login === '') {
            sc_lookup(rsWizVerdiLogin, "
                SELECT COALESCE(login_subvettore, '') FROM subvettori WHERE id = $subvettore_id LIMIT 1
            ", 'pigliacelli');
            $login = !empty({rsWizVerdiLogin[0][0]}) ? trim((string){rsWizVerdiLogin[0][0]}) : '';
        }
        $loginSql = wiz_verdi_sql_quote($login);
        $placeholder = wiz_verdi_setting('documento_verde_placeholder', 'placeholder_documento_verde.pdf');
        if ($placeholder === '') {
            $placeholder = 'placeholder_documento_verde.pdf';
        }
        $phSql = wiz_verdi_sql_quote($placeholder);
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, login, stato_documento_id, file)
            SELECT td.id, $subvettore_id, '$loginSql', 1,
                CASE WHEN LOWER(COALESCE(td.nome, '')) LIKE '%dichiaraz%' THEN NULL ELSE '$phSql' END
            FROM tipi_documento td
            WHERE COALESCE(td.is_readonly, 0) = 1
              AND NOT EXISTS (
                  SELECT 1 FROM documenti d
                  WHERE d.subvettore_id = $subvettore_id
                    AND d.tipo_documento_id = td.id
                    AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
                    AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
              )
        ", 'pigliacelli');
        sc_exec_sql("
            UPDATE documenti d
            INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
            SET d.file = '$phSql'
            WHERE d.subvettore_id = $subvettore_id
              AND COALESCE(td.is_readonly, 0) = 1
              AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
              AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
              AND (d.file IS NULL OR TRIM(d.file) = '')
              AND LOWER(COALESCE(td.nome, '')) NOT LIKE '%dichiaraz%'
        ", 'pigliacelli');
        return 1;
    }
}

$usrLogin = trim((string)[usr_login]);
if ($usrLogin === '' || strcasecmp($usrLogin, 'Guest') === 0) {
    sc_redir('app_Login');
}
$loginSql = str_replace("'", "''", $usrLogin);

sc_lookup(rsGridFirmAuth, "
    SELECT
        sug.group_id,
        COALESCE(s.wizard_complete, 0),
        COALESCE(s.wizard_step, 1),
        COALESCE(s.id, 0),
        COALESCE(s.login_subvettore, '')
    FROM sec_users su
    INNER JOIN sec_users_groups sug
        ON sug.login = su.login
       AND sug.group_id = 2
    LEFT JOIN subvettori s ON s.id = su.subvettore_id
    WHERE su.login = '$loginSql'
    LIMIT 1
", 'pigliacelli');

$groupId = !empty({rsGridFirmAuth[0][0]}) ? (int){rsGridFirmAuth[0][0]} : 0;
$wizComplete = isset({rsGridFirmAuth[0][1]}) ? (int){rsGridFirmAuth[0][1]} : 0;
$wizStep = isset({rsGridFirmAuth[0][2]}) ? (int){rsGridFirmAuth[0][2]} : 1;
$subId = !empty({rsGridFirmAuth[0][3]}) ? (int){rsGridFirmAuth[0][3]} : 0;
$loginSub = !empty({rsGridFirmAuth[0][4]}) ? trim((string){rsGridFirmAuth[0][4]}) : '';

if ($groupId !== 2) {
    sc_redir('app_menu');
}
if ($wizComplete === 1) {
    sc_redir('app_menu');
}
if ($subId <= 0) {
    sc_error_message('Subvettore non associato.');
    sc_redir('app_menu');
}
if ($wizStep < 5) {
    sc_redir('blank_wizard_landing');
}

[subvettoreId] = $subId;
if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}
$_SESSION['wizard_subvettore_id'] = $subId;

// Primo atterraggio da step 4: [documentoId] / SESSION restano dello step documenti
// (gialli) → Firma apre EasyGN sul doc sbagliato. Refresh "sistema" perché
// la sessione e' gia' pulita. Pulisci sempre tranne ritorno da EasyGN.
$fromFirma = (
    isset($_GET['from'])
    && strtolower(trim((string)$_GET['from'])) === 'firma'
);
if (!$fromFirma) {
    [documentoId] = 0;
    if (isset($_SESSION['documentoId'])) {
        unset($_SESSION['documentoId']);
    }
    if (isset($_SESSION['pdf_next'])) {
        unset($_SESSION['pdf_next']);
    }
}

wiz_verdi_ensure_documenti($subId, $loginSub !== '' ? $loginSub : $usrLogin);

// Ritorno da EasyGN (redirect_url): marca firmato_il sul documento firmato
if (isset($_GET['from']) && strtolower(trim((string)$_GET['from'])) === 'firma') {
    $didRet = 0;
    if (isset($_GET['documentoId']) && (int)$_GET['documentoId'] > 0) {
        $didRet = (int)$_GET['documentoId'];
    } elseif (isset($_REQUEST['documentoId']) && (int)$_REQUEST['documentoId'] > 0) {
        $didRet = (int)$_REQUEST['documentoId'];
    }
    if ($didRet > 0) {
        sc_exec_sql("
            UPDATE documenti
            SET firmato_il = NOW(),
                stato_documento_id = 2,
                updated_at = NOW()
            WHERE id = $didRet
              AND subvettore_id = $subId
              AND (firmato_il IS NULL OR firmato_il = '0000-00-00 00:00:00')
        ", 'pigliacelli');
        if (function_exists('sc_log_add')) {
            sc_log_add('WIZ_FIRMA', "from=firma → firmato_il+stato=2 documentoId=$didRet sub=$subId");
        }
    }
}

// Sync: documenti con workflow EasyGN ma senza firmato_il → interroga API
if (!function_exists('wiz_verdi_sync_firmato_easygn')) {
    function wiz_verdi_sync_firmato_easygn($subvettore_id)
    {
        $subvettore_id = (int)$subvettore_id;
        if ($subvettore_id <= 0 || !function_exists('curl_init')) {
            return 0;
        }
        sc_lookup(rsWizEgBear, "
            SELECT set_value FROM sec_settings WHERE set_name = 'easygn_bearer' LIMIT 1
        ", 'pigliacelli');
        $bearer = !empty({rsWizEgBear[0][0]}) ? trim((string){rsWizEgBear[0][0]}) : '';
        if ($bearer === '') {
            return 0;
        }
        sc_lookup(rsWizEgBase, "
            SELECT set_value FROM sec_settings WHERE set_name = 'easygn_base_url' LIMIT 1
        ", 'pigliacelli');
        $base = !empty({rsWizEgBase[0][0]})
            ? rtrim(trim((string){rsWizEgBase[0][0]}), '/')
            : 'https://easygn.digiwebuno.it/api';
        if ($base === '') {
            return 0;
        }

        sc_lookup(rsWizEgPend, "
            SELECT d.id, COALESCE(d.easygn_workflow_id, '')
            FROM documenti d
            INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
            WHERE d.subvettore_id = $subvettore_id
              AND COALESCE(td.is_readonly, 0) = 1
              AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
              AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
              AND (d.firmato_il IS NULL OR d.firmato_il = '0000-00-00 00:00:00')
              AND d.easygn_workflow_id IS NOT NULL
              AND TRIM(d.easygn_workflow_id) <> ''
            LIMIT 20
        ", 'pigliacelli');
        if (empty({rsWizEgPend[0][0]})) {
            return 0;
        }

        $doneStatuses = array(
            'done', 'signed', 'finished', 'completed', 'complete',
            'closed', 'archived', 'success',
        );
        $updated = 0;
        $rows = {rsWizEgPend};
        foreach ($rows as $row) {
            $docId = (int)$row[0];
            $wfId = trim((string)$row[1]);
            if ($docId <= 0 || $wfId === '') {
                continue;
            }
            $url = $base . '/workflows/' . rawurlencode($wfId);
            $ch = curl_init();
            curl_setopt($ch, CURLOPT_URL, $url);
            curl_setopt($ch, CURLOPT_HTTPGET, true);
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 8);
            curl_setopt($ch, CURLOPT_TIMEOUT, 15);
            curl_setopt($ch, CURLOPT_HTTPHEADER, array(
                'Accept: application/json',
                'Authorization: Bearer ' . $bearer,
            ));
            $body = curl_exec($ch);
            $http = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
            curl_close($ch);
            if ($http < 200 || $http >= 300 || !is_string($body) || $body === '') {
                continue;
            }
            $data = json_decode($body, true);
            if (!is_array($data)) {
                continue;
            }
            $st = '';
            foreach (array('status', 'state', 'workflow_status', 'workflowStatus') as $k) {
                if (!empty($data[$k]) && is_string($data[$k])) {
                    $st = strtolower(trim($data[$k]));
                    break;
                }
            }
            // fallback: tutti i signer done
            $allSignersDone = false;
            $signers = null;
            if (isset($data['files'][0]['signers']) && is_array($data['files'][0]['signers'])) {
                $signers = $data['files'][0]['signers'];
            } elseif (isset($data['signers']) && is_array($data['signers'])) {
                $signers = $data['signers'];
            }
            if (is_array($signers) && count($signers) > 0) {
                $allSignersDone = true;
                foreach ($signers as $sg) {
                    if (!is_array($sg)) {
                        $allSignersDone = false;
                        break;
                    }
                    $sst = '';
                    foreach (array('status', 'state') as $sk) {
                        if (!empty($sg[$sk])) {
                            $sst = strtolower(trim((string)$sg[$sk]));
                            break;
                        }
                    }
                    if (!in_array($sst, $doneStatuses, true)) {
                        $allSignersDone = false;
                        break;
                    }
                }
            }
            if (in_array($st, $doneStatuses, true) || $allSignersDone) {
                sc_exec_sql("
                    UPDATE documenti
                    SET firmato_il = NOW(),
                        stato_documento_id = 2,
                        updated_at = NOW()
                    WHERE id = $docId
                      AND subvettore_id = $subvettore_id
                      AND (firmato_il IS NULL OR firmato_il = '0000-00-00 00:00:00')
                ", 'pigliacelli');
                $updated++;
                if (function_exists('sc_log_add')) {
                    sc_log_add('WIZ_FIRMA', "sync EasyGN firmato_il+stato=2 doc=$docId wf=$wfId status=$st");
                }
            }
        }
        return $updated;
    }
}

$synced = wiz_verdi_sync_firmato_easygn($subId);
if ($synced > 0 && function_exists('sc_ajax_message')) {
    sc_ajax_message(
        'Aggiornato stato firma da EasyGN: ' . (int)$synced . ' documento/i.',
        'Firma documenti',
        'Ok'
    );
}

// Non chiudere il wizard qui: lo fa il pulsante "Invia per attivazione".

if (!empty($_SESSION['wizard_flash_msg'])) {
    $flash = trim((string)$_SESSION['wizard_flash_msg']);
    unset($_SESSION['wizard_flash_msg']);
    if ($flash !== '' && function_exists('sc_ajax_message')) {
        sc_ajax_message($flash, 'Firma documenti', 'Ok');
    }
}
if (isset($_GET['generated']) && (int)$_GET['generated'] === 1 && function_exists('sc_ajax_message')) {
    sc_ajax_message('PDF Dichiarazioni generato. Aprilo e firmalo.', 'Dichiarazioni', 'Ok');
}
if (isset($_GET['from']) && (string)$_GET['from'] === 'firma' && function_exists('sc_ajax_message')) {
    sc_ajax_message('Firma registrata. Controlla lo stato in griglia.', 'Firma', 'Ok');
}
