/**
 * Scriptcase blank: easygn_start_wf_docs
 *
 * Avvia EasyGN su un documento verde (tipi_documento.is_readonly=1).
 * Firmatario unico = legale rappresentante del subvettore.
 * Parametri: documentoId, subvettoreId (GET o globali SC).
 *
 * Coordinate firma MVP: box fisso pagina 1 (basso-destra).
 */

@ini_set('memory_limit', '512M');
@set_time_limit(180);

$documentoId = 0;
if (isset($_GET['documentoId']) && (int)$_GET['documentoId'] > 0) {
    $documentoId = (int)$_GET['documentoId'];
} elseif (isset($_REQUEST['documentoId']) && (int)$_REQUEST['documentoId'] > 0) {
    $documentoId = (int)$_REQUEST['documentoId'];
} elseif (isset([documentoId]) && (int)[documentoId] > 0) {
    $documentoId = (int)[documentoId];
} elseif (!empty($_SESSION['documentoId']) && (int)$_SESSION['documentoId'] > 0) {
    $documentoId = (int)$_SESSION['documentoId'];
}

$subvettoreId = 0;
if (isset($_GET['subvettoreId']) && (int)$_GET['subvettoreId'] > 0) {
    $subvettoreId = (int)$_GET['subvettoreId'];
} elseif (isset($_REQUEST['subvettoreId']) && (int)$_REQUEST['subvettoreId'] > 0) {
    $subvettoreId = (int)$_REQUEST['subvettoreId'];
} elseif (isset([subvettoreId]) && (int)[subvettoreId] > 0) {
    $subvettoreId = (int)[subvettoreId];
}

if ($documentoId <= 0) {
    sc_error_message("Impossibile avviare la firma del documento.\n\ndocumentoId mancante o non valido");
    sc_error_exit();
}
if ($subvettoreId <= 0) {
    sc_lookup(rsDocSub, "
        SELECT subvettore_id FROM documenti WHERE id = $documentoId LIMIT 1
    ", 'pigliacelli');
    $subvettoreId = !empty({rsDocSub[0][0]}) ? (int){rsDocSub[0][0]} : 0;
}
if ($subvettoreId <= 0) {
    sc_error_message("Impossibile avviare la firma del documento.\n\nsubvettoreId mancante");
    sc_error_exit();
}

// Stesso schema di easygn_start_wf: solo sc_log_add
$log = function ($msg) use ($documentoId, $subvettoreId) {
    sc_log_add('EASYGN_DOC', "[documentoId=$documentoId][subvettoreId=$subvettoreId] " . (string)$msg);
};

$fail = function ($msg) use ($log) {
    $log('FAIL: ' . $msg);
    sc_error_message("Impossibile avviare la firma del documento.\n\n" . (string)$msg);
    sc_error_exit();
};

$sc_setting = function ($name, $default = '') {
    $safe = str_replace("'", "''", trim((string)$name));
    sc_lookup(rsEgDocSet, "SELECT set_value FROM sec_settings WHERE set_name = '$safe' LIMIT 1", 'pigliacelli');
    if (isset({rsEgDocSet[0][0]})) {
        return trim((string){rsEgDocSet[0][0]});
    }
    return (string)$default;
};

if (!function_exists('curl_init')) {
    $fail('Estensione PHP cURL non disponibile sul server (richiesta per EasyGN).');
}

$bearer = trim($sc_setting('easygn_bearer', ''));
if ($bearer === '') {
    $fail('Bearer Easygn mancante in sec_settings (easygn_bearer)');
}
$easygnBaseUrl = rtrim(trim($sc_setting('easygn_base_url', 'https://easygn.digiwebuno.it/api')), '/');

$log('start blank');
$log('config ok baseUrl=' . $easygnBaseUrl . ' memory_limit=' . (string)ini_get('memory_limit'));

if (!ob_get_level()) {
    ob_start();
}

register_shutdown_function(function () use ($documentoId, $subvettoreId) {
    $err = error_get_last();
    if ($err === null || !in_array($err['type'], array(E_ERROR, E_PARSE, E_CORE_ERROR, E_COMPILE_ERROR), true)) {
        return;
    }
    if (function_exists('sc_log_add')) {
        sc_log_add(
            'EASYGN_DOC',
            "[documentoId=$documentoId][subvettoreId=$subvettoreId] FATAL: "
            . $err['message'] . ' in ' . $err['file'] . ':' . $err['line']
        );
    }
});

// Documento verde + già firmato?
sc_lookup(rsEgDoc, "
    SELECT
        d.id,
        d.subvettore_id,
        COALESCE(d.file, ''),
        COALESCE(d.firmato_il, ''),
        COALESCE(td.nome, 'Documento'),
        COALESCE(td.is_readonly, 0),
        COALESCE(d.easygn_sign_link, '')
    FROM documenti d
    INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
    WHERE d.id = $documentoId
    LIMIT 1
", 'pigliacelli');

if (empty({rsEgDoc[0][0]})) {
    $fail('Documento non trovato');
}

// Fonte di verità = documenti.subvettore_id (GET/global possono essere sporchi da altre app SC)
$docSubId = (int){rsEgDoc[0][1]};
if ($docSubId <= 0) {
    $fail('Documento senza subvettore_id in anagrafica');
}
if ($subvettoreId > 0 && $docSubId !== $subvettoreId) {
    $log("WARN param subvettoreId=$subvettoreId != doc.subvettore_id=$docSubId → uso documento");
}
$subvettoreId = $docSubId;
[subvettoreId] = $subvettoreId;

// Il login corrente deve essere del subvettore del documento
$usrLoginEg = trim((string)[usr_login]);
if ($usrLoginEg !== '' && strcasecmp($usrLoginEg, 'Guest') !== 0) {
    $loginEgSql = str_replace("'", "''", $usrLoginEg);
    sc_lookup(rsEgAuthSub, "
        SELECT COALESCE(su.subvettore_id, 0)
        FROM sec_users su
        INNER JOIN sec_users_groups sug
            ON sug.login = su.login
           AND sug.group_id = 2
        WHERE su.login = '$loginEgSql'
        LIMIT 1
    ", 'pigliacelli');
    $authSub = !empty({rsEgAuthSub[0][0]}) ? (int){rsEgAuthSub[0][0]} : 0;
    if ($authSub > 0 && $authSub !== $docSubId) {
        $fail(
            'Documento non appartenente al subvettore'
            . " (doc=$documentoId doc.sub=$docSubId login.sub=$authSub)"
        );
    }
}

if ((int){rsEgDoc[0][5]} !== 1) {
    $fail('Documento non configurato come verde (is_readonly)');
}
$docFile = trim((string){rsEgDoc[0][2]});
$firmatoIl = trim((string){rsEgDoc[0][3]});
$docNome = trim((string){rsEgDoc[0][4]});
$existingLinkJson = trim((string){rsEgDoc[0][6]});

if ($firmatoIl !== '' && $firmatoIl !== '0000-00-00 00:00:00') {
    $log('già firmato → grid_documenti_to_sign_wizard');
    sc_redir('grid_documenti_to_sign_wizard', subvettoreId=[subvettoreId]);
}

// Dichiarazioni: il PDF cambia dopo la compilazione. Un link EasyGN già salvato
// riaprirebbe il file della prima firma (spesso il template vuoto).
$isDichiarazioni = (stripos($docNome, 'dichiaraz') !== false);

// Se esiste già un link di firma salvato, riapri quello (come easygn_start_wf_auto)
if ($existingLinkJson !== '' && !$isDichiarazioni) {
    $meta = json_decode($existingLinkJson, true);
    if (is_array($meta)) {
        $linkReuse = '';
        if (!empty($meta['link_subvettore'])) {
            $linkReuse = trim((string)$meta['link_subvettore']);
        } elseif (!empty($meta['link'])) {
            $linkReuse = trim((string)$meta['link']);
        }
        if ($linkReuse !== '' && preg_match('#^https?://#i', $linkReuse) === 1) {
            $log('reuse existing sign link');
            while (ob_get_level() > 0) {
                ob_end_clean();
            }
            if (!headers_sent()) {
                header('Location: ' . $linkReuse);
                exit;
            }
            $safe = htmlspecialchars($linkReuse, ENT_QUOTES, 'UTF-8');
            echo '<!doctype html><html><head><meta charset="utf-8">'
                . '<meta http-equiv="refresh" content="0;url=' . $safe . '">'
                . '<script>window.location.replace(' . json_encode($linkReuse) . ');</script>'
                . '</head><body>Reindirizzamento alla firma...</body></html>';
            exit;
        }
    }
}

// --- Resolve PDF (stesso schema di easygn_start_wf.php) ---
$pdfFilename = 'documento_' . $documentoId . '.pdf';
$pdfB64 = '';
$pdfPathUsed = '';

if (!function_exists('docs_detect_workspace_root')) {
    function docs_detect_workspace_root($anchorFile = null)
    {
        if ($anchorFile === null || $anchorFile === '') {
            $anchorFile = __FILE__;
        }
        if (is_dir($anchorFile)) {
            $dir = realpath($anchorFile);
        } else {
            $dir = dirname($anchorFile);
            $resolved = realpath($dir);
            if ($resolved !== false) {
                $dir = $resolved;
            }
        }
        if ($dir === false || $dir === '') {
            return '';
        }
        $current = $dir;
        for ($i = 0; $i < 12; $i++) {
            if (is_file($current . DIRECTORY_SEPARATOR . 'index.php')
                && (is_dir($current . DIRECTORY_SEPARATOR . '_lib')
                    || is_dir($current . DIRECTORY_SEPARATOR . 'grid_contratti')
                    || is_dir($current . DIRECTORY_SEPARATOR . 'grid_documenti_to_sign_wizard'))) {
                return $current;
            }
            $parent = dirname($current);
            if ($parent === $current) {
                break;
            }
            $current = $parent;
        }
        $parent = dirname($dir);
        return ($parent !== '' && $parent !== $dir) ? $parent : $dir;
    }
}
if (!function_exists('resolve_docs_base_dir')) {
    function resolve_docs_base_dir($configuredPath, $anchorFile = null, $useDocumentRoot = false)
    {
        $configuredPath = trim((string)$configuredPath);
        if ($configuredPath === '') {
            return '';
        }
        $normalized = str_replace('\\', '/', $configuredPath);
        if ($normalized !== '' && $normalized[0] === '/') {
            $resolved = realpath($configuredPath);
            return $resolved !== false ? $resolved : rtrim($configuredPath, "/\\");
        }
        if (preg_match('#^[A-Za-z]:/#', $normalized) || preg_match('#^[A-Za-z]:\\\\#', $configuredPath)) {
            $resolved = realpath($configuredPath);
            return $resolved !== false ? $resolved : rtrim($configuredPath, "/\\");
        }
        if ($useDocumentRoot && !empty($_SERVER['DOCUMENT_ROOT'])) {
            $docRoot = @realpath((string)$_SERVER['DOCUMENT_ROOT']);
            if ($docRoot !== false && $docRoot !== '') {
                $docCand = $docRoot . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, trim($normalized, '/'));
                if (is_dir($docCand)) {
                    $resolved = realpath($docCand);
                    return $resolved !== false ? $resolved : $docCand;
                }
            }
        }
        $root = docs_detect_workspace_root($anchorFile);
        if ($root === '') {
            return '';
        }
        $full = $root . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, trim($normalized, '/'));
        $resolved = realpath($full);
        return $resolved !== false ? $resolved : $full;
    }
}

// Priorità come contratti: contratti_base_dir, poi templates_path
$baseDirRaw = trim((string)$sc_setting('contratti_base_dir', ''));
if ($baseDirRaw === '') {
    $baseDirRaw = trim((string)$sc_setting('templates_path', ''));
    if (preg_match('#/templates$#', str_replace('\\', '/', $baseDirRaw))) {
        $baseDirRaw = preg_replace('#/templates$#', '', str_replace('\\', '/', $baseDirRaw));
    }
}

$useDocumentRootForPdf = (
    str_replace('\\', '/', trim($baseDirRaw)) === 'scriptcase/app/pigliacelli_workspace/_lib/file/doc'
);

$baseDir = '';
if ($baseDirRaw !== '') {
    $baseDir = resolve_docs_base_dir($baseDirRaw, __FILE__, $useDocumentRootForPdf);
}
if ($baseDir === '') {
    $fail('Imposta sec_settings.contratti_base_dir (es. _lib/file/doc) oppure templates_path.');
}
$log('pdf baseDir=' . $baseDir);

$goGenerate = function () use ($documentoId, $subvettoreId, $log, $docNome, $fail, $baseDir, $docFile) {
    $fromGenerate = (
        (isset($_GET['from_generate']) && (int)$_GET['from_generate'] === 1)
    );
    // Anti-loop: dopo generate+save il file deve esistere. Se manca, un solo force regen.
    if ($fromGenerate) {
        $alreadyForced = !empty($_SESSION['docs_pdf_force_regen'][$documentoId]);
        if (!$alreadyForced) {
            if (!isset($_SESSION['docs_pdf_force_regen']) || !is_array($_SESSION['docs_pdf_force_regen'])) {
                $_SESSION['docs_pdf_force_regen'] = array();
            }
            $_SESSION['docs_pdf_force_regen'][$documentoId] = time();
            if (!empty($_SESSION['docs_pdf_generated'][$documentoId])) {
                unset($_SESSION['docs_pdf_generated'][$documentoId]);
            }
            $log('from_generate ma PDF assente → force regen generate_doc_to_sign');
            while (ob_get_level() > 0) {
                ob_end_clean();
            }
            header(
                'Location: ../generate_doc_to_sign/'
                . '?documentoId=' . (int)$documentoId
                . '&subvettoreId=' . (int)$subvettoreId
                . '&next=sign'
                . '&force=1'
                . '&return_to=' . rawurlencode('grid_documenti_to_sign_wizard')
            );
            exit;
        }
        if (!empty($_SESSION['docs_pdf_generated'][$documentoId])) {
            unset($_SESSION['docs_pdf_generated'][$documentoId]);
        }
        if (!empty($_SESSION['docs_pdf_force_regen'][$documentoId])) {
            unset($_SESSION['docs_pdf_force_regen'][$documentoId]);
        }
        $fail(
            "PDF Dichiarazioni generato ma non leggibile da EasyGN.\n\n"
            . "file in DB: " . (string)$docFile . "\n"
            . "baseDir EasyGN: " . (string)$baseDir . "\n"
            . "atteso: " . rtrim((string)$baseDir, "/\\") . '/' . ltrim((string)$docFile, '/') . "\n\n"
            . "Controllare log ScriptCase tag PDF_SAVE (path=) su app dichiarazioni_pdf."
        );
    }
    [documentoId] = $documentoId;
    [subvettoreId] = $subvettoreId;
    $_SESSION['documentoId'] = $documentoId;
    $_SESSION['pdf_next'] = 'sign';
    $log('PDF mancante/illeggibile → generate_doc_to_sign (tipo=' . $docNome . ')');
    while (ob_get_level() > 0) {
        ob_end_clean();
    }
    header(
        'Location: ../generate_doc_to_sign/'
        . '?documentoId=' . (int)$documentoId
        . '&subvettoreId=' . (int)$subvettoreId
        . '&next=sign'
        . '&force=1'
        . '&return_to=' . rawurlencode('grid_documenti_to_sign_wizard')
    );
    exit;
};

// Handoff da dichiarazioni_pdf (stessa sessione) — non dipende dal disco
if ($pdfB64 === '' && !empty($_SESSION['docs_pdf_bin'][$documentoId])) {
    $b64Sess = (string)$_SESSION['docs_pdf_bin'][$documentoId];
    $rawSess = base64_decode($b64Sess, true);
    if (is_string($rawSess) && strncmp($rawSess, '%PDF', 4) === 0) {
        $pdfB64 = $b64Sess;
        $pdfFilename = 'dichiarazioni_' . $documentoId . '.pdf';
        $pdfPathUsed = 'session:docs_pdf_bin';
        $log('pdf from SESSION bin b64_len=' . strlen($pdfB64));
        unset($_SESSION['docs_pdf_bin'][$documentoId]);
        if (!empty($_SESSION['docs_pdf_force_regen'][$documentoId])) {
            unset($_SESSION['docs_pdf_force_regen'][$documentoId]);
        }
    }
}

if ($pdfB64 === '' && $docFile !== '') {
    if (strncmp($docFile, '%PDF', 4) === 0) {
        $pdfB64 = base64_encode($docFile);
        $pdfFilename = 'documento_' . $documentoId . '.pdf';
        $log('pdf from BLOB in documenti.file');
    } else {
        $maybeFilename = trim((string)$docFile);
        if ($maybeFilename !== '' && stripos($maybeFilename, '.pdf') !== false) {
            $pdfFilename = $maybeFilename;
            $pdfPath = '';

            // Hint assoluto: GET (affidabile tra app SC) poi sessione
            $hintAbs = '';
            if (!empty($_GET['pdf_abs'])) {
                $hintAbs = (string)$_GET['pdf_abs'];
            } elseif (!empty($_REQUEST['pdf_abs'])) {
                $hintAbs = (string)$_REQUEST['pdf_abs'];
            } elseif (!empty($_SESSION['docs_pdf_abs'][$documentoId])) {
                $hintAbs = (string)$_SESSION['docs_pdf_abs'][$documentoId];
            }
            if ($hintAbs !== '') {
                clearstatcache(true, $hintAbs);
                if (is_readable($hintAbs)) {
                    $pdfPath = $hintAbs;
                    $pdfPathUsed = $hintAbs;
                    $log('pdf from abs hint=' . $hintAbs);
                } else {
                    $log('pdf abs hint NOT readable=' . $hintAbs);
                }
            }

            $maybePath = str_replace('\\', '/', $pdfFilename);
            if ($pdfPath === '' && (strpos($maybePath, '/') === 0 || preg_match('#^[A-Za-z]:/#', $maybePath))) {
                if (is_readable($maybePath)) {
                    $pdfPath = $maybePath;
                    $pdfPathUsed = $maybePath;
                }
            }

            if ($pdfPath === '') {
                $pdfRelBase = ltrim(str_replace('\\', '/', $pdfFilename), '/');
                $bn = basename($pdfRelBase);
                $tryPaths = array(
                    rtrim((string)$baseDir, "/\\") . '/' . $pdfRelBase,
                    rtrim((string)$baseDir, "/\\") . '/documenti/' . $bn,
                    rtrim((string)$baseDir, "/\\") . '/' . $bn,
                    rtrim((string)$baseDir, "/\\") . '/contratti/' . $bn,
                );
                // Fallback tipici ScriptCase workspace
                $ws = docs_detect_workspace_root(__FILE__);
                if ($ws !== '') {
                    $tryPaths[] = $ws . '/_lib/file/doc/' . $pdfRelBase;
                    $tryPaths[] = $ws . '/_lib/file/doc/documenti/' . $bn;
                    $tryPaths[] = $ws . '/_lib/file/doc/' . $bn;
                }
                $maxAttempts = 8;
                for ($attempt = 1; $attempt <= $maxAttempts; $attempt++) {
                    foreach ($tryPaths as $try) {
                        if (is_readable($try)) {
                            $pdfPath = $try;
                            $pdfPathUsed = $try;
                            break 2;
                        }
                    }
                    if ($attempt < $maxAttempts) {
                        $log('pdf wait attempt ' . $attempt . ' paths=' . implode(' | ', $tryPaths));
                        sleep(1);
                    }
                }
                if ($pdfPath === '') {
                    $log('pdf NOT readable tried=' . implode(' | ', $tryPaths));
                    if (stripos($docNome, 'dichiaraz') !== false) {
                        $goGenerate();
                    }
                    $fail("PDF non leggibile su disco.\nAtteso: " . $tryPaths[0]
                        . "\n(baseDir=" . $baseDir . ", file=" . $pdfFilename . ')');
                }
            }

            $bin = file_get_contents($pdfPath);
            if ($bin === false || $bin === '') {
                $fail('Lettura PDF fallita: ' . $pdfPath);
            }
            if (strncmp($bin, '%PDF', 4) !== 0) {
                $fail('File non sembra un PDF valido: ' . $pdfPath);
            }
            $pdfB64 = base64_encode($bin);
            $pdfFilename = basename($pdfFilename);
            // consuma hint
            if (!empty($_SESSION['docs_pdf_abs'][$documentoId])) {
                unset($_SESSION['docs_pdf_abs'][$documentoId]);
            }
        }
    }
}

if ($pdfB64 === '') {
    $log('pdf vuoto in documenti.file');
    if (stripos($docNome, 'dichiaraz') !== false) {
        $goGenerate();
    }
    $fail('PDF non presente in documenti.file per documento ' . $documentoId
        . '. Per Dichiarazioni: Firma genera automaticamente; per altri tipi serve placeholder su disco.');
}
$log('pdf ok filename=' . $pdfFilename . ' b64_len=' . strlen($pdfB64) . ' path=' . (string)$pdfPathUsed);
if (!empty($_SESSION['docs_pdf_force_regen'][$documentoId])) {
    unset($_SESSION['docs_pdf_force_regen'][$documentoId]);
}


// Firmatario = legale rappresentante
sc_lookup(rsEgSub, "
    SELECT
        COALESCE(login_subvettore, ''),
        COALESCE(email_rappresentante, ''),
        COALESCE(telefono_rappresentante, ''),
        COALESCE(nome_rappresentante, ''),
        COALESCE(cognome_rappresentante, ''),
        COALESCE(phone, ''),
        COALESCE(ragione_sociale, '')
    FROM subvettori
    WHERE id = $subvettoreId
    LIMIT 1
", 'pigliacelli');

$loginSub = !empty({rsEgSub[0][0]}) ? trim((string){rsEgSub[0][0]}) : '';
$signerEmail = !empty({rsEgSub[0][1]}) ? trim((string){rsEgSub[0][1]}) : '';
$signerPhone = !empty({rsEgSub[0][2]}) ? trim((string){rsEgSub[0][2]}) : '';
$signerName = !empty({rsEgSub[0][3]}) ? trim((string){rsEgSub[0][3]}) : '';
$signerSurname = !empty({rsEgSub[0][4]}) ? trim((string){rsEgSub[0][4]}) : '';
$phoneFallback = !empty({rsEgSub[0][5]}) ? trim((string){rsEgSub[0][5]}) : '';

if ($signerEmail === '' && $loginSub !== '' && filter_var($loginSub, FILTER_VALIDATE_EMAIL)) {
    $signerEmail = $loginSub;
}
if ($signerPhone === '') {
    $signerPhone = $phoneFallback;
}
if ($signerName === '') {
    $signerName = 'Legale';
}
if ($signerSurname === '') {
    $signerSurname = 'Rappresentante';
}
if ($signerEmail === '' || !filter_var($signerEmail, FILTER_VALIDATE_EMAIL)) {
    $fail('Email legale rappresentante / login mancante o non valida');
}
if ($signerPhone !== '' && isset($signerPhone[0]) && $signerPhone[0] !== '+') {
    $digits = preg_replace('/\D+/', '', $signerPhone);
    if ($digits !== '') {
        $signerPhone = '+39' . $digits;
    }
}
$signerSurnameClean = trim(preg_replace('/\s+/u', ' ', preg_replace("/[^A-Za-zÀ-ÿ'\\-\\s]/u", ' ', $signerSurname)));
if ($signerSurnameClean === '') {
    $signerSurnameClean = 'NA';
}

// Visual firma: stesso schema di easygn_start_wf (position = "x1,y1,x2,y2", h min 37pt)
$mm_to_pt = function ($mmVal) {
    return $mmVal * 72 / 25.4;
};
$easygn_position_from_mm = function ($pageMm) use ($mm_to_pt) {
    $pageHeightPt = 841.89; // A4
    $xPt = $mm_to_pt($pageMm['x']);
    $yTopPt = $mm_to_pt($pageMm['y']);
    $wPt = $mm_to_pt($pageMm['w']);
    $hPt = $mm_to_pt($pageMm['h']);
    $x1 = $xPt;
    $x2 = $xPt + $wPt;
    $y1 = $pageHeightPt - $yTopPt - $hPt;
    $y2 = $y1 + $hPt;
    return implode(',', array_map(function ($v) {
        return (string)round($v);
    }, array($x1, $y1, $x2, $y2)));
};
$easygn_visual_from_mm = function ($pageMm) use ($mm_to_pt, $easygn_position_from_mm) {
    $xPt = (int)round($mm_to_pt($pageMm['x']));
    $yTopPt = (int)round($mm_to_pt($pageMm['y']));
    $wPt = (int)round($mm_to_pt($pageMm['w']));
    $hPt = (int)round($mm_to_pt($pageMm['h']));
    if ($hPt < 37) {
        $hPt = 37; // vincolo API EasyGN
    }
    return array(
        'page' => (int)$pageMm['page'],
        'width' => $wPt,
        'height' => $hPt,
        'x' => $xPt,
        'y' => $yTopPt,
        'position' => $easygn_position_from_mm($pageMm),
    );
};

// Coordinate: prima la sessione scritta da dichiarazioni_pdf, poi il Subject del PDF.
// Se non ce n'è nessuna, resta il box unico in basso a destra sulla pagina 1.
$visualsMm = array();
