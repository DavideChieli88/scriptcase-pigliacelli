                if ($rawTail[$i] !== "\x00") {
                    break;
                }
                $c = $rawTail[$i + 1];
                if (strpos('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=', $c) === false) {
                    break;
                }
                $b64Chars .= $c;
