/**
 * Blank blank_sign_subvettore → onExecute
 *
 * Aperto da grid_contratti_subvectors_btn_firma (sc_redir _blank).
 * Redirect EasyGN link_subvettore. Niente mail / notifica qui:
 * la campanella ops parte da web_hook_firma a firma EasyGN effettuata.
 */

$contrattoId = 0;
if (isset($_GET['contrattoId']) && (int)$_GET['contrattoId'] > 0) {
    $contrattoId = (int)$_GET['contrattoId'];
} elseif (isset([contrattoId]) && (int)[contrattoId] > 0) {
    $contrattoId = (int)[contrattoId];
}

if ($contrattoId <= 0) {
    sc_log_add('FIRMA_SUB', 'FAIL: contratto non indicato');
    echo '<!doctype html><html lang="it"><head><meta charset="utf-8"><title>Errore</title></head><body>';
    echo '<p>Contratto non indicato.</p></body></html>';
    exit;
}

sc_lookup(rsBlankFirmaSub, "
    SELECT stato_contratto_id, easygn_sign_link
    FROM contratti
    WHERE id = " . (int)$contrattoId . "
    LIMIT 1
", 'pigliacelli');

if (empty({rsBlankFirmaSub[0][0]})) {
    sc_log_add('FIRMA_SUB', 'FAIL: contratto non trovato id=' . (int)$contrattoId);
    echo '<!doctype html><html lang="it"><head><meta charset="utf-8"><title>Errore</title></head><body>';
    echo '<p>Contratto non trovato.</p></body></html>';
    exit;
}

if ((int){rsBlankFirmaSub[0][0]} !== 4) {
    sc_log_add('FIRMA_SUB', 'FAIL: stato non 4 contratto=' . (int)$contrattoId);
    echo '<!doctype html><html lang="it"><head><meta charset="utf-8"><title>Errore</title></head><body>';
    echo '<p>Firma disponibile solo con stato In attesa della firma subvettore.</p></body></html>';
    exit;
}

$rawLinkJson = trim((string){rsBlankFirmaSub[0][1]});
$meta = ($rawLinkJson !== '') ? json_decode($rawLinkJson, true) : null;
$link = '';
if (is_array($meta) && isset($meta['link_subvettore'])) {
    $link = trim((string)$meta['link_subvettore']);
}
if ($link === '' || preg_match('#^https?://#i', $link) !== 1) {
    sc_log_add('FIRMA_SUB', 'FAIL: link_subvettore assente contratto=' . (int)$contrattoId);
    echo '<!doctype html><html lang="it"><head><meta charset="utf-8"><title>Errore</title></head><body>';
    echo '<p>Link EasyGN del subvettore assente. Riavviare il workflow di firma (easygn_start_wf) '
        . 'dopo aver cancellato i dati EasyGN: non basta rimettere lo stato a 4.</p></body></html>';
    exit;
}

sc_log_add('FIRMA_SUB', 'redirect EasyGN contratto=' . $contrattoId . ' link_len=' . strlen($link));
$safeSignUrl = htmlspecialchars($link, ENT_QUOTES, 'UTF-8');
if (!headers_sent()) {
    header('Location: ' . $link);
    exit;
}
echo '<!doctype html><html lang="it"><head><meta charset="utf-8">'
    . '<meta http-equiv="refresh" content="0;url=' . $safeSignUrl . '">'
    . '<title>Reindirizzamento firma</title></head><body>'
    . '<script>window.location.replace(' . json_encode($link) . ');</script>'
    . '</body></html>';
exit;
