/**
 * grid_documenti_to_sign_wizard → Action Bar sign_doc_btn (Ajax)
 *
 * Macro SC: niente spazi dentro le graffe. { d.id } NON viene sostituito
 * e genera Parse error unexpected "{" .
 */

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}

$subId = 0;
$usrLogin = trim((string)[usr_login]);
if ($usrLogin !== '' && strcasecmp($usrLogin, 'Guest') !== 0) {
    $loginSql = str_replace("'", "''", $usrLogin);
    sc_lookup(rsSignSubAuth, "
        SELECT COALESCE(su.subvettore_id, 0)
        FROM sec_users su
        INNER JOIN sec_users_groups sug
            ON sug.login = su.login
           AND sug.group_id = 2
        WHERE su.login = '$loginSql'
        LIMIT 1
    ", 'pigliacelli');
    $subId = !empty({rsSignSubAuth[0][0]}) ? (int){rsSignSubAuth[0][0]} : 0;
}
if ($subId <= 0 && !empty($_SESSION['wizard_subvettore_id'])) {
    $subId = (int)$_SESSION['wizard_subvettore_id'];
}
if ($subId <= 0 && isset({d.subvettore_id}) && (int){d.subvettore_id} > 0) {
    $subId = (int){d.subvettore_id};
}

$documentoId = 0;
if (isset({d.id}) && (int){d.id} > 0) {
    $documentoId = (int){d.id};
}

$tipoDocumentoId = 0;
if (isset({d.tipo_documento_id}) && (int){d.tipo_documento_id} > 0) {
    $tipoDocumentoId = (int){d.tipo_documento_id};
}

if ($documentoId > 0 && $subId > 0) {
    sc_lookup(rsSignChk, "
        SELECT d.id
        FROM documenti d
        INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
        WHERE d.id = $documentoId
          AND d.subvettore_id = $subId
          AND COALESCE(td.is_readonly, 0) = 1
          AND (d.firmato_il IS NULL OR d.firmato_il = '0000-00-00 00:00:00')
        LIMIT 1
    ", 'pigliacelli');
    if (empty({rsSignChk[0][0]})) {
        $documentoId = 0;
    }
} elseif ($documentoId > 0) {
    sc_lookup(rsSignChk2, "
        SELECT d.id, d.subvettore_id
        FROM documenti d
        INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
        WHERE d.id = $documentoId
          AND COALESCE(td.is_readonly, 0) = 1
          AND (d.firmato_il IS NULL OR d.firmato_il = '0000-00-00 00:00:00')
        LIMIT 1
    ", 'pigliacelli');
    if (empty({rsSignChk2[0][0]})) {
        $documentoId = 0;
    } else {
        $documentoId = (int){rsSignChk2[0][0]};
        if ($subId <= 0) {
            $subId = (int){rsSignChk2[0][1]};
        }
    }
}

if ($documentoId <= 0 && $subId > 0 && $tipoDocumentoId > 0) {
    sc_lookup(rsSignByTipo, "
        SELECT d.id
        FROM documenti d
        INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
        WHERE d.subvettore_id = $subId
          AND d.tipo_documento_id = $tipoDocumentoId
          AND COALESCE(td.is_readonly, 0) = 1
          AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
          AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
          AND (d.firmato_il IS NULL OR d.firmato_il = '0000-00-00 00:00:00')
        ORDER BY d.id
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsSignByTipo[0][0]})) {
        $documentoId = (int){rsSignByTipo[0][0]};
    }
}

if ($documentoId <= 0) {
    sc_ajax_message('Documento non identificato. Controllare il campo id sulla griglia.');
    sc_error_exit();
}
if ($subId <= 0) {
    sc_ajax_message('Subvettore non identificato. Ricaricare lo step 5 e riprovare.');
    sc_error_exit();
}

sc_lookup(rsSignOk, "
    SELECT
        d.id,
        d.subvettore_id,
        COALESCE(d.file, ''),
        COALESCE(td.nome, '')
    FROM documenti d
    INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
    WHERE d.id = $documentoId
      AND d.subvettore_id = $subId
      AND COALESCE(td.is_readonly, 0) = 1
      AND (d.firmato_il IS NULL OR d.firmato_il = '0000-00-00 00:00:00')
    LIMIT 1
", 'pigliacelli');

if (empty({rsSignOk[0][0]})) {
    sc_ajax_message('Documento non firmabile (gia firmato, non verde, o non del subvettore corrente).');
    sc_error_exit();
}

$docSub = (int){rsSignOk[0][1]};
$tipoNome = trim((string){rsSignOk[0][3]});
$subId = $docSub > 0 ? $docSub : $subId;

[documentoId] = $documentoId;
[subvettoreId] = $subId;
$_SESSION['documentoId'] = $documentoId;
$_SESSION['wizard_subvettore_id'] = $subId;
$_SESSION['pdf_next'] = 'sign';
if (!isset($_SESSION['docs_pdf_force_regen']) || !is_array($_SESSION['docs_pdf_force_regen'])) {
    $_SESSION['docs_pdf_force_regen'] = array();
}
$_SESSION['docs_pdf_force_regen'][$documentoId] = time();

if (function_exists('sc_log_add')) {
    sc_log_add(
        'WIZ_FIRMA',
        "btn_firma doc=$documentoId sub=$subId tipo=[$tipoNome] open generate_doc_to_sign"
    );
}

$genUrl = '../generate_doc_to_sign/'
    . '?documentoId=' . (int)$documentoId
    . '&subvettoreId=' . (int)$subId
    . '&next=sign'
    . '&force=1'
    . '&return_to=' . rawurlencode('grid_documenti_to_sign_wizard');

if (function_exists('sc_ajax_javascript')) {
    sc_ajax_javascript('console.log("wizVerdi BTN open easygn");window.open(' . json_encode($genUrl) . ',"_blank")');
} else {
    sc_redir('generate_doc_to_sign', documentoId=[documentoId];subvettoreId=[subvettoreId];return_to=grid_documenti_to_sign_wizard, "_blank");
}
