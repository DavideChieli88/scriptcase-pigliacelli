/**
 * form_subvettori_contratti_for_subvectors_magic_link_review
 * → onLoad
 *
 * Su Scriptcase l'app e' form_subvettori_contratti_for_subvectors_magic_link.
 * Review Erik 13/10: niente anagrafica e niente tratte.
 * Testo, pulsanti Accetta e invia per la firma / Rifiuta, anteprima PDF gia aperta.
 * Accetta apre la modale dei 4 dati del rappresentante (anagrafica) e poi salva.
 * Rifiuta chiede una nota e blocca il contratto (blank_magic_link_review_rifiuta).
 * 1) Modale errore EasyGN
 * 2) Blocco autisti sempre nascosto
 * 3) Precaricamento anagrafica da subvettori (visibile, sola lettura)
 * 4) Campi su subvettori_contratti (rappresentante, albo, nascita):
 *    se vuoti sul contratto, si copiano dalle colonne omonime di subvettori
 * 5) Campi *_firmatario, albo e nascita nascosti. Anagrafica in sola lettura.
 * 6) Stato 7 (rifiutato) → blank_magic_link_review_rifiuta.
 *    Stato >= 3 (già accettato) → blank_magic_link_review_inviato.
 * 7) Popup conferma invio revisione (Scriptcase JavaScript Methods):
 *    a) Programming → JavaScript Methods → mlReviewConfirmInit
 *       incollare form_subvettori_contratti_magic_link_review_confirm.js
 *    b) Evento onScriptInit: form_subvettori_contratti_magic_link_review_onScriptInit
 *       (senza onScriptInit il metodo JS non viene mai eseguito)
 *    onValidate richiede review_confirm=1 (hidden field impostato dal popup).
 */

if (session_status() !== PHP_SESSION_ACTIVE) {@session_start();}

if (!empty($_SESSION['ml_review_appinit_log'])) {
    sc_log_add('MAGIC_LINK_REVIEW', (string)$_SESSION['ml_review_appinit_log']);
    unset($_SESSION['ml_review_appinit_log']);
}

$getSc = isset($_GET['subvettore_contratto_id']) ? (int)$_GET['subvettore_contratto_id'] : 0;
$getId = isset($_GET['id']) ? (int)$_GET['id'] : 0;
$gloSc = (isset([subvettore_contratto_id]) && (int)[subvettore_contratto_id] > 0) ? (int)[subvettore_contratto_id] : 0;
$sessSc = isset($_SESSION['ml_review_open_sc']) ? (int)$_SESSION['ml_review_open_sc'] : 0;

$linkScId = 0;
if ($getSc > 0) {
    $linkScId = $getSc;
} elseif ($gloSc > 0) {
    $linkScId = $gloSc;
}

$formScId = (isset({id}) && (int){id} > 0) ? (int){id} : 0;

sc_log_add(
    'MAGIC_LINK_REVIEW',
    'onLoad GET sc=' . $getSc . ' id=' . $getId
    . ' gloSc=' . $gloSc . ' formId=' . $formScId
    . ' link=' . $linkScId . ' sess=' . $sessSc
);

if ($linkScId > 0 && $formScId !== $linkScId) {
    [subvettore_contratto_id] = $linkScId;
    [id] = $linkScId;
    $alreadyForced = isset($_SESSION['ml_review_open_sc']) ? (int)$_SESSION['ml_review_open_sc'] : 0;
    if ($alreadyForced !== $linkScId) {
        $_SESSION['ml_review_open_sc'] = $linkScId;
        sc_log_add(
            'MAGIC_LINK_REVIEW',
            'onLoad riapre riga link scId=' . $linkScId . ' formScId=' . $formScId
        );
        sc_redir('form_subvettori_contratti_for_subvectors_magic_link', subvettore_contratto_id=[subvettore_contratto_id]);
        exit;
    }
}

$scIdEarly = $linkScId > 0 ? $linkScId : $formScId;

$magicLinkReviewContrattoId = 0;
$statoContrattoIdReview = 0;

if ($scIdEarly > 0) {
    sc_lookup(rsReviewStatoContr, "
        SELECT c.id, c.stato_contratto_id
        FROM subvettori_contratti sc
        INNER JOIN contratti c ON c.id = sc.contratto_id
        WHERE sc.id = " . (int)$scIdEarly . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({rsReviewStatoContr})) {
        $magicLinkReviewContrattoId = (int){rsReviewStatoContr[0][0]};
        $statoContrattoIdReview = (int){rsReviewStatoContr[0][1]};
    }
}

if ((int)$statoContrattoIdReview === 7) {
    [contrattoId] = $magicLinkReviewContrattoId;
    [id] = $scIdEarly;
    sc_log_add(
        'MAGIC_LINK_REVIEW',
        'onLoad redirect rifiuto stato=7'
        . ' scId=' . (int)$scIdEarly
        . ' contratto=' . (int)$magicLinkReviewContrattoId
    );
    sc_redir('blank_magic_link_review_rifiuta', contrattoId=[contrattoId];scId=[id]);
    exit;
}

if ($statoContrattoIdReview >= 3) {
    $redirReviewDone = '';
    if ($magicLinkReviewContrattoId > 0) {$redirReviewDone = 'contrattoId='. (int)$magicLinkReviewContrattoId;}
    if ($scIdEarly > 0) {$redirReviewDone.= ($redirReviewDone !== '' ? '&' : ''). 'scId='. (int)$scIdEarly;}
    sc_log_add(
        'MAGIC_LINK_REVIEW',
        'onLoad redirect blank stato='. (int)$statoContrattoIdReview
        . ' scId='. (int)$scIdEarly
        . ' contratto='. (int)$magicLinkReviewContrattoId
    );
    sc_redir('blank_magic_link_review_inviato', $redirReviewDone);
    exit;
}

if (!empty($_SESSION['easygn_error_modal'])) {
    $msg = $_SESSION['easygn_error_modal'];
    unset($_SESSION['easygn_error_modal']);

    sc_ajax_message(
        $msg,
        "Dati mancanti per la firma",
        "error",
        "Y",
        0,
        "OK",
        "Y",
        "350",
        "auto"
    );
}

if (!function_exists('magic_link_review_form_apply_tipo_contratto_visibility')) {
    function magic_link_review_form_apply_tipo_contratto_visibility() {sc_block_display(subvettori_autisti, 'off');}
}

$subvettoreId = 0;
if (isset({subvettore_id}) && (int){subvettore_id} > 0) {
    $subvettoreId = (int){subvettore_id};
}

$scId = $scIdEarly;

magic_link_review_form_apply_tipo_contratto_visibility();

if ($subvettoreId <= 0 && $scId > 0) {
    sc_lookup(rsReviewSubId, "
        SELECT subvettore_id
        FROM subvettori_contratti
        WHERE id = " . (int)$scId . "
        LIMIT 1
    ", "pigliacelli");
    if (!empty({rsReviewSubId[0][0]})) {
        $subvettoreId = (int){rsReviewSubId[0][0]};
    }
}

if ($subvettoreId > 0) {
    sc_lookup(rsReviewSub, "
        SELECT
            ragione_sociale,
        sede_citta,
        sede_prov,
        indirizzo,
        civico,
        cod_fiscale,
        piva,
        num_iscrizione_reg_imprese,
        locazione_iscrizione_reg_imprese,
            rea,
        COALESCE(NULLIF(TRIM(phone), ''), NULLIF(TRIM(cellphone), ''))
        FROM subvettori
        WHERE id = " . (int)$subvettoreId . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({rsReviewSub})) {
        {ragione_sociale}                  = (string){rsReviewSub[0][0]};
        {sede_citta}                       = (string){rsReviewSub[0][1]};
        {sede_prov}                        = (string){rsReviewSub[0][2]};
        {indirizzo}                        = (string){rsReviewSub[0][3]};
        {civico}                           = (string){rsReviewSub[0][4]};
        {cod_fiscale}                      = (string){rsReviewSub[0][5]};
        {piva}                             = (string){rsReviewSub[0][6]};
        {num_iscrizione_reg_imprese}       = (string){rsReviewSub[0][7]};
        {locazione_iscrizione_reg_imprese} = (string){rsReviewSub[0][8]};
        {rea}                              = (string){rsReviewSub[0][9]};
        {phone}                            = (string){rsReviewSub[0][10]};
    }
}

if ($subvettoreId > 0) {
    sc_lookup(rsReviewScLegal, "
        SELECT
            COALESCE(NULLIF(TRIM(sc.num_iscrizione_albo), ''), NULLIF(TRIM(s.num_iscrizione_albo), '')),
            NULLIF(TRIM(s.nome_rappresentante), ''),
            NULLIF(TRIM(s.cognome_rappresentante), ''),
            NULLIF(TRIM(s.email_rappresentante), ''),
            NULLIF(TRIM(s.telefono_rappresentante), ''),
            COALESCE(NULLIF(TRIM(sc.luogo_nascita_rappresentante), ''), NULLIF(TRIM(s.luogo_nascita_rappresentante), '')),
            COALESCE(NULLIF(TRIM(sc.prov_luogo_nascita_rappresentante), ''), NULLIF(TRIM(s.prov_luogo_nascita_rappresentante), '')),
            COALESCE(
                IF(sc.data_nascita_rappresentante IS NULL OR sc.data_nascita_rappresentante < '1900-01-01', NULL, sc.data_nascita_rappresentante),
                IF(s.data_nascita_rappresentante IS NULL OR s.data_nascita_rappresentante < '1900-01-01', NULL, s.data_nascita_rappresentante)
            )
        FROM subvettori s
        LEFT JOIN subvettori_contratti sc
          ON sc.subvettore_id = s.id
         AND sc.id = " . (int)$scId . "
        WHERE s.id = " . (int)$subvettoreId . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({rsReviewScLegal})) {
        {num_iscrizione_albo}               = (string){rsReviewScLegal[0][0]};
        {nome_rappresentante}               = (string){rsReviewScLegal[0][1]};
        {cognome_rappresentante}            = (string){rsReviewScLegal[0][2]};
        {email_rappresentante}              = (string){rsReviewScLegal[0][3]};
        {telefono_rappresentante}           = (string){rsReviewScLegal[0][4]};
        {luogo_nascita_rappresentante}      = (string){rsReviewScLegal[0][5]};
        {prov_luogo_nascita_rappresentante} = (string){rsReviewScLegal[0][6]};
        {data_nascita_rappresentante}       = {rsReviewScLegal[0][7]};
    }
}

if (!function_exists('pigliacelli_hide_campi_firmatario_form')) {
    function pigliacelli_hide_campi_firmatario_form() {
        foreach(array('nome_firmatario', 'cognome_firmatario', 'email_firmatario', 'telefono_firmatario') as $campo) {sc_field_display($campo, 'off');}
    }
}
pigliacelli_hide_campi_firmatario_form();

if (!function_exists('pigliacelli_anagrafica_review_sola_lettura')) {
    function pigliacelli_anagrafica_review_sola_lettura() {
        foreach (array(
            'ragione_sociale',
            'sede_citta',
            'sede_prov',
            'indirizzo',
            'civico',
            'cod_fiscale',
            'piva',
            'num_iscrizione_reg_imprese',
            'locazione_iscrizione_reg_imprese',
            'rea',
            'phone',
        ) as $campo) {
            sc_field_display($campo, 'off');
        }
        foreach (array(
            'num_iscrizione_albo',
            'luogo_nascita_rappresentante',
            'prov_luogo_nascita_rappresentante',
            'data_nascita_rappresentante',
        ) as $campo) {sc_field_display($campo, 'off');}
    }
}
pigliacelli_anagrafica_review_sola_lettura();

$tipoReview = 1;
if ($magicLinkReviewContrattoId > 0) {
    sc_lookup(rsReviewTipoPdf, "
        SELECT COALESCE(tipo_contratto_id, 1)
        FROM contratti
        WHERE id = " . (int)$magicLinkReviewContrattoId . "
        LIMIT 1
    ", "pigliacelli");
    if (!empty({rsReviewTipoPdf[0][0]})) {
        $tipoReview = (int){rsReviewTipoPdf[0][0]};
    }
}
$pdfApp = ($tipoReview === 2 || $tipoReview === 3) ? 'variazione_contratto' : 'nuovo_contratto_vettore';
$parms = 'subvector*sc*' . (int)$subvettoreId . '*sc*contratto*sc*' . (int)$magicLinkReviewContrattoId;
$pdfUrl = '../' . $pdfApp . '/index.php?nmgp_parms=' . rawurlencode($parms)
    . '&subvector=' . (int)$subvettoreId
    . '&contratto=' . (int)$magicLinkReviewContrattoId;
$reviewPayload = json_encode(array(
    'pdf' => $pdfUrl,
    'nome' => isset({nome_rappresentante}) ? (string){nome_rappresentante} : '',
    'cognome' => isset({cognome_rappresentante}) ? (string){cognome_rappresentante} : '',
    'email' => isset({email_rappresentante}) ? (string){email_rappresentante} : '',
    'telefono' => isset({telefono_rappresentante}) ? (string){telefono_rappresentante} : '',
    'scId' => (int)$scId,
    'contrattoId' => (int)$magicLinkReviewContrattoId,
    'rifiutaUrl' => '../blank_magic_link_review_rifiuta/',
), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP);
$pdfHref = htmlspecialchars($pdfUrl, ENT_QUOTES, 'UTF-8');
echo '<div id="ml-review-cfg" style="display:none">'
    . htmlspecialchars($reviewPayload, ENT_QUOTES, 'UTF-8')
    . '</div>';
echo '<div id="ml-review-shell" style="position:fixed;inset:0;z-index:99990;overflow:auto;background:#eef1f4;'
    . 'font-family:Arial,Helvetica,sans-serif;color:#2d3748;">'
    . '<div style="max-width:980px;margin:16px auto;padding:0 16px 32px;">'
    . '<p style="margin:0 0 16px;font-size:15px;line-height:1.5;">Questo è il contratto da firmare. '
    . 'Di seguito trovi l\'anteprima. Se è corretto, accetta e invia per la firma. '
    . 'Se non lo accetti, rifiuta e indica il motivo.</p>'
    . '<div class="ml-review-bar" style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin:0 0 16px;">'
    . '<button type="button" class="ml-review-accetta" style="padding:12px 18px;border:0;border-radius:8px;background:#5b2d8e;color:#fff;font-weight:bold;cursor:pointer;"><i class="fas fa-check" style="margin-right:8px;" aria-hidden="true"></i>Accetta e invia per la firma</button>'
    . '<button type="button" class="ml-review-rifiuta" onclick="if (typeof mlReviewRefuseInit===\'function\') mlReviewRefuseInit(); return false;" style="padding:12px 18px;border:0;border-radius:8px;background:#c62828;color:#fff;font-weight:bold;cursor:pointer;"><i class="fas fa-times" style="margin-right:8px;" aria-hidden="true"></i>Rifiuta</button>'
    . '</div>'
    . '<iframe class="ml-review-pdf" title="Anteprima contratto" src="' . $pdfHref . '" '
    . 'style="width:100%;height:78vh;border:1px solid #dde1e6;border-radius:8px;background:#fff;"></iframe>'
    . '<p style="margin:8px 0 0;font-size:13px;"><a href="' . $pdfHref . '" target="_blank" rel="noopener" style="color:#5b2d8e;">Apri l\'anteprima in un\'altra scheda</a></p>'
    . '<div class="ml-review-bar" style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin:16px 0 0;">'
    . '<button type="button" class="ml-review-accetta" style="padding:12px 18px;border:0;border-radius:8px;background:#5b2d8e;color:#fff;font-weight:bold;cursor:pointer;"><i class="fas fa-check" style="margin-right:8px;" aria-hidden="true"></i>Accetta e invia per la firma</button>'
    . '<button type="button" class="ml-review-rifiuta" onclick="if (typeof mlReviewRefuseInit===\'function\') mlReviewRefuseInit(); return false;" style="padding:12px 18px;border:0;border-radius:8px;background:#c62828;color:#fff;font-weight:bold;cursor:pointer;"><i class="fas fa-times" style="margin-right:8px;" aria-hidden="true"></i>Rifiuta</button>'
    . '</div></div></div>';
sc_ajax_javascript('mlReviewConfirmInit');


