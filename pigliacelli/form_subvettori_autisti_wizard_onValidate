/**
 * form_subvettori_autisti_wizard → onValidate
 * Wizard step 2 — validazione singolo autista (+ documenti virtuali).
 * Tipi: 18 idoneità, 19 patente, CQC tipo 'CQC autisti (fronte/retro)',
 *       20 formazione, 21 DPI.
 * permesso_soggiorno (30): obbligatorio solo se permesso_soggiorno_flag=1.
 *
 * IDE: Events → onValidate → incolla questo file. Generate.
 * Non usare sc_error_exit (AJAX / modale).
 */

$errors = array();
$autistaId = isset({id}) ? (int){id} : 0;

sc_log_add('AUT_VAL', "onValidate START autista=$autistaId flag=[" . (string){permesso_soggiorno_flag} . "]");

$vNominativo = isset({nominativo}) ? trim((string){nominativo}) : '';
$vScadPat    = isset({scadenza_patente}) ? trim((string){scadenza_patente}) : '';
$vScadCqc    = isset({scadenza_cqc}) ? trim((string){scadenza_cqc}) : '';
$vIdoneita   = isset({idoneita_sanitaria}) ? trim((string){idoneita_sanitaria}) : '';
$vPatente    = isset({patente}) ? trim((string){patente}) : '';
$vCqc        = isset({cqc}) ? trim((string){cqc}) : '';
$vFormaz     = isset({formazione_sicurezza}) ? trim((string){formazione_sicurezza}) : '';
$vDpi        = isset({dpi_iii_categoria}) ? trim((string){dpi_iii_categoria}) : '';
$vPermesso   = isset({permesso_soggiorno}) ? trim((string){permesso_soggiorno}) : '';

$flagPossesso30 = 0;
$rawFlag30 = {permesso_soggiorno_flag};
if ($rawFlag30 !== '' && $rawFlag30 !== null && $rawFlag30 !== 'undefined' && $rawFlag30 !== 'null') {
    $flagPossesso30 = ((int)$rawFlag30 === 1) ? 1 : 0;
}

if ($vNominativo === '') {
    $errors[] = 'Nominativo';
}
if ($vScadPat === '' || $vScadPat === 'null') {
    $errors[] = 'Scadenza patente';
}
if ($vScadCqc === '' || $vScadCqc === 'null') {
    $errors[] = 'Scadenza CQC';
}

// --- 18 idoneità ---
$hasIdoneitaSanitaria = ($vIdoneita !== '');
if (!$hasIdoneitaSanitaria && $autistaId > 0) {
    sc_lookup(rsAutVal18, "
        SELECT id FROM documenti
        WHERE subvettore_autista_id = $autistaId
          AND tipo_documento_id = 18
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    $hasIdoneitaSanitaria = !empty({rsAutVal18[0][0]});
}
if (!$hasIdoneitaSanitaria) {
    $errors[] = 'Documento idoneità sanitaria';
}

// --- 19 patente ---
$hasPatente = ($vPatente !== '');
if (!$hasPatente && $autistaId > 0) {
    sc_lookup(rsAutVal19a, "
        SELECT id FROM documenti
        WHERE subvettore_autista_id = $autistaId
          AND tipo_documento_id = 19
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    $hasPatente = !empty({rsAutVal19a[0][0]});
}
if (!$hasPatente) {
    $errors[] = 'Documento patente';
}

// --- CQC (tipo dedicato, non più seconda riga del 19) ---
$hasCqc = ($vCqc !== '');
if (!$hasCqc && $autistaId > 0) {
    $tipoCqc = 0;
    sc_lookup(rsTipoCqcV, "
        SELECT id FROM tipi_documento
        WHERE LOWER(TRIM(nome)) = LOWER(TRIM('CQC autisti (fronte/retro)'))
        LIMIT 1
    ", 'pigliacelli');
    $tipoCqc = !empty({rsTipoCqcV[0][0]}) ? (int){rsTipoCqcV[0][0]} : 0;
    if ($tipoCqc > 0) {
        sc_lookup(rsAutValCqc, "
            SELECT id FROM documenti
            WHERE subvettore_autista_id = $autistaId
              AND tipo_documento_id = $tipoCqc
              AND file IS NOT NULL AND TRIM(file) <> ''
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        $hasCqc = !empty({rsAutValCqc[0][0]});
    }
}
if (!$hasCqc) {
    $errors[] = 'Documento CQC';
}

// --- 20 formazione ---
$hasFormazioneSicurezza = ($vFormaz !== '');
if (!$hasFormazioneSicurezza && $autistaId > 0) {
    sc_lookup(rsAutVal20, "
        SELECT id FROM documenti
        WHERE subvettore_autista_id = $autistaId
          AND tipo_documento_id = 20
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    $hasFormazioneSicurezza = !empty({rsAutVal20[0][0]});
}
if (!$hasFormazioneSicurezza) {
    $errors[] = 'Documento formazione sicurezza';
}

// --- 21 DPI ---
$hasDpiIiiCategoria = ($vDpi !== '');
if (!$hasDpiIiiCategoria && $autistaId > 0) {
    sc_lookup(rsAutVal21, "
        SELECT id FROM documenti
        WHERE subvettore_autista_id = $autistaId
          AND tipo_documento_id = 21
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    $hasDpiIiiCategoria = !empty({rsAutVal21[0][0]});
}
if (!$hasDpiIiiCategoria) {
    $errors[] = 'Documento DPI III categoria';
}

// --- 30 permesso soggiorno (obbligatorio solo se flag=1) ---
if ($flagPossesso30 === 1) {
    $hasPermesso = ($vPermesso !== '');
    if (!$hasPermesso && $autistaId > 0) {
        sc_lookup(rsAutVal30, "
            SELECT id FROM documenti
            WHERE subvettore_autista_id = $autistaId
              AND tipo_documento_id = 30
              AND file IS NOT NULL AND TRIM(file) <> ''
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        $hasPermesso = !empty({rsAutVal30[0][0]});
    }
    if (!$hasPermesso) {
        $errors[] = 'Permesso di soggiorno (dichiarato in possesso ma file mancante)';
    }
}

sc_log_add('AUT_VAL', "onValidate END errors=" . count($errors) . " flag30=$flagPossesso30");

if (!empty($errors)) {
    sc_error_message(
        "Compilare tutti i dati e documenti obbligatori dell'autista:\n- "
        . implode("\n- ", $errors)
    );
}
