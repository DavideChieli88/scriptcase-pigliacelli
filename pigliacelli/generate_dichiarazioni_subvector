/**
 * Scriptcase blank: generate_dichiarazioni_subvector → onExecute
 *
 * Avvia il Report PDF dichiarazioni_subvettore (auto_save) per il subvettore
 * corrente / documento verde Dichiarazioni, poi torna allo step 5.
 *
 * Come finalize_contract_subvector: NON usare solo sc_redir (i Report SC
 * spesso perdono i query param). Redirect HTTP con ?subvector=...
 *
 * GET: subvettoreId|subvector, documentoId (opz.), return_to (opz.)
 */

$subId = 0;
if (isset($_GET['subvettoreId']) && (int)$_GET['subvettoreId'] > 0) {
    $subId = (int)$_GET['subvettoreId'];
} elseif (isset($_GET['subvector']) && (int)$_GET['subvector'] > 0) {
    $subId = (int)$_GET['subvector'];
} elseif ((int)[subvettoreId] > 0) {
    $subId = (int)[subvettoreId];
} elseif ((int)[subvector] > 0) {
    $subId = (int)[subvector];
}

$documentoId = 0;
if (isset($_GET['documentoId']) && (int)$_GET['documentoId'] > 0) {
    $documentoId = (int)$_GET['documentoId'];
} elseif ((int)[documentoId] > 0) {
    $documentoId = (int)[documentoId];
}

$returnTo = 'grid_documenti_to_sign_wizard';
if (isset($_GET['return_to']) && trim((string)$_GET['return_to']) !== '') {
    $cand = preg_replace('/[^a-zA-Z0-9_\\-]/', '', (string)$_GET['return_to']);
    if ($cand !== '') {
        $returnTo = $cand;
    }
}

if ($subId <= 0) {
    sc_error_message('subvettoreId mancante');
    sc_error_exit();
}

if ($documentoId <= 0) {
    sc_lookup(rsGenDichDoc, "
        SELECT d.id
        FROM documenti d
        INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
        WHERE d.subvettore_id = $subId
          AND LOWER(td.nome) LIKE '%dichiaraz%'
          AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
          AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
        ORDER BY d.id
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsGenDichDoc[0][0]})) {
        $documentoId = (int){rsGenDichDoc[0][0]};
    }
}

[subvector] = $subId;
[subvettoreId] = $subId;
if ($documentoId > 0) {
    [documentoId] = $documentoId;
}
[auto_save_pdf] = 'S';
$_SESSION['pdf_auto_save'] = 'S';
$_SESSION['dichiarazioni_return_to'] = $returnTo;

// Stesso schema URL di finalize_contract → iframe report (?subvector=)
$reportUrl = '../dichiarazioni_subvettore/?subvector=' . (int)$subId
    . '&subvettoreId=' . (int)$subId
    . '&auto_save_pdf=S'
    . '&return_to=' . rawurlencode($returnTo);
if ($documentoId > 0) {
    $reportUrl .= '&documentoId=' . (int)$documentoId;
}

header('Location: ' . $reportUrl);
exit;
