/**
 * form_documenti_wizard → onLoadRecord
 *
 * Campo virtuale {required}: "Si" / "No" da tipi_documento.mandatory.
 * Wizard = flusso subvettore: scadenze fisse readonly
 * (ANGA/RENTRI 30/04, Albo conto terzi 31/01).
 */

{required} = 'No';

$tipoId = {tipo_documento_id};
if ($tipoId === '' || $tipoId === null || $tipoId === 'undefined') {
    $tipoId = 0;
}
$tipoId = (int)$tipoId;

$nomeTipo = '';
if ($tipoId > 0) {
    sc_lookup(rsDocReqMand, "
        SELECT COALESCE(mandatory, 0), COALESCE(nome, '')
        FROM tipi_documento
        WHERE id = $tipoId
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsDocReqMand[0][0]}) && (int){rsDocReqMand[0][0]} === 1) {
        {required} = 'Si';
    }
    $nomeTipo = !empty({rsDocReqMand[0][1]}) ? trim((string){rsDocReqMand[0][1]}) : '';
}

$n = strtolower($nomeTipo);
$md = '';
if ($n !== '') {
    if (strpos($n, 'ricevuta pagamento anga') === 0 || strpos($n, 'ricevuta pagamento rentri') === 0) {
        $md = '04-30';
    } elseif (
        strpos($n, 'ricevuta') !== false
        && strpos($n, 'albo') !== false
        && strpos($n, 'conto terzi') !== false
    ) {
        $md = '01-31';
    }
}
if ($md !== '') {
    $y = (int)date('Y');
    $scad = sprintf('%04d-%s', $y, $md);
    if (date('Y-m-d') >= $scad) {
        $scad = sprintf('%04d-%s', $y + 1, $md);
    }
    {data_scadenza} = $scad;
    sc_field_readonly({data_scadenza}, 'on');
} else {
    sc_field_readonly({data_scadenza}, 'off');
}
