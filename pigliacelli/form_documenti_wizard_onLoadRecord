/**
 * form_documenti_wizard → onLoadRecord
 *
 * Campo virtuale {required}: "Si" / "No" da tipi_documento.mandatory
 * del tipo_documento_id della riga.
 *
 * Setup SC: campo virtuale text (o label), Name = required, solo lettura.
 */

{required} = 'No';

$tipoId = {tipo_documento_id};
if ($tipoId === '' || $tipoId === null || $tipoId === 'undefined') {
    $tipoId = 0;
}
$tipoId = (int)$tipoId;

if ($tipoId > 0) {
    sc_lookup(rsDocReqMand, "
        SELECT COALESCE(mandatory, 0)
        FROM tipi_documento
        WHERE id = $tipoId
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsDocReqMand[0][0]}) && (int){rsDocReqMand[0][0]} === 1) {
        {required} = 'Si';
    }
}

$scadRaw = isset({data_scadenza}) ? trim((string){data_scadenza}) : '';
$scadVuota = (
    $scadRaw === ''
    || strcasecmp($scadRaw, 'null') === 0
    || strpos($scadRaw, '0000-00-00') === 0
);
if ($tipoId > 0 && $scadVuota) {
    sc_lookup(rsDocAngaNome, "
        SELECT nome FROM tipi_documento WHERE id = $tipoId LIMIT 1
    ", 'pigliacelli');
    $nomeTipo = !empty({rsDocAngaNome[0][0]}) ? trim((string){rsDocAngaNome[0][0]}) : '';
    if (stripos($nomeTipo, 'Ricevuta pagamento ANGA') === 0) {
        $yRicAnga = (int)date('Y');
        $scadRicAnga = sprintf('%04d-04-30', $yRicAnga);
        if (date('Y-m-d') >= $scadRicAnga) {
            $scadRicAnga = sprintf('%04d-04-30', $yRicAnga + 1);
        }
        {data_scadenza} = $scadRicAnga;
    }
}
