/**
 * form_subvettori_mezzi → onValidate
 *
 * Obblighi base: targa, carta + scadenza.
 * Radio has_cat_trasp_rifiuti_X (1=Si, 0=No), mail 17/09:
 *   has_cat_X=1 → Autorizzazione ANGA Cat.X (file+scadenza) + Ricevuta ANGA Cat.X (file+scadenza 30/04)
 *   almeno una cat → Iscrizione RENTRI (solo file) + Ricevuta RENTRI (file+scadenza 30/04), unici
 *   tutte 0 → nessun doc ANGA/RENTRI obbligatorio
 * Autista (autista_id): facoltativo (SAL 16/09). Non aggiungere errori se vuoto.
 * IDE: campo autista_id → Required = No.
 */

$errors = array();
$mezzoId = isset({id}) ? (int){id} : 0;

$vTarga = isset({targa}) ? trim((string){targa}) : '';
$vScadCarta = isset({scadenza_carta_circolazione}) ? trim((string){scadenza_carta_circolazione}) : '';

$autistaId = 0;
$rawAut = isset({autista_id}) ? {autista_id} : '';
if (is_array($rawAut)) {
    $rawAut = reset($rawAut);
}
$rawAut = trim((string)$rawAut);
// Select vuoto / "-" / "0" = nessun autista (non ripescare dal ponte DB).
if ($rawAut !== '' && $rawAut !== '-' && $rawAut !== 'null' && $rawAut !== 'undefined' && (int)$rawAut > 0) {
    $autistaId = (int)$rawAut;
}
{autista_id} = ($autistaId > 0) ? $autistaId : '';

$vCarta = isset({carta_circolazione}) ? trim((string){carta_circolazione}) : '';
$hasUpload = false;
if (!empty($_FILES) && is_array($_FILES)) {
    foreach ($_FILES as $fileKey => $up) {
        if (!is_array($up)) {
            continue;
        }
        if (strpos(strtolower((string)$fileKey), 'carta_circolazione') === false) {
            continue;
        }
        $nm = isset($up['name']) ? $up['name'] : '';
        if (is_array($nm)) {
            $nm = reset($nm);
        }
        $err = isset($up['error']) ? $up['error'] : 4;
        if (is_array($err)) {
            $err = reset($err);
        }
        if (trim((string)$nm) !== '' && (int)$err === 0) {
            $hasUpload = true;
            break;
        }
    }
}

if ($vTarga === '') {
    $errors[] = 'Targa';
}
if ($vScadCarta === '' || $vScadCarta === 'null') {
    $errors[] = 'Scadenza carta di circolazione';
}

$hasCartaCircolazione = ($vCarta !== '' || $hasUpload);
if (!$hasCartaCircolazione && $mezzoId > 0) {
    sc_lookup(rsMezVal22, "
        SELECT id FROM documenti
        WHERE subvettore_mezzo_id = $mezzoId
          AND tipo_documento_id = 22
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    $hasCartaCircolazione = !empty({rsMezVal22[0][0]});
}
if (!$hasCartaCircolazione) {
    $errors[] = 'Documento carta di circolazione';
}

if (!function_exists('mez_val_tipo_id')) {
    function mez_val_tipo_id($nome, $fallbackId = 0)
    {
        $nomeSql = str_replace("'", "''", $nome);
        sc_lookup(rsMezValTipo, "
            SELECT id FROM tipi_documento
            WHERE LOWER(TRIM(nome)) = LOWER(TRIM('$nomeSql'))
            LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsMezValTipo[0][0]})) {
            return (int){rsMezValTipo[0][0]};
        }
        return (int)$fallbackId;
    }
}

/**
 * Upload in corso per il campo Document $fieldName (fallback quando {campo} è ancora vuoto in onValidate).
 */
if (!function_exists('mez_val_has_upload')) {
    function mez_val_has_upload($fieldName)
    {
        if (empty($_FILES) || !is_array($_FILES)) {
            return false;
        }
        foreach ($_FILES as $k => $up) {
            if (!is_array($up)) {
                continue;
            }
            if (strpos(strtolower((string)$k), strtolower($fieldName)) === false) {
                continue;
            }
            $nm = isset($up['name']) ? $up['name'] : '';
            if (is_array($nm)) {
                $nm = reset($nm);
            }
            $err = isset($up['error']) ? $up['error'] : 4;
            if (is_array($err)) {
                $err = reset($err);
            }
            if (trim((string)$nm) !== '' && (int)$err === 0) {
                return true;
            }
        }
        return false;
    }
}

/**
 * Radio has_cat_trasp_rifiuti_X: 1/Si → 1, altro ('', 0, No, undefined) → 0.
 */
if (!function_exists('mez_val_flag')) {
    function mez_val_flag($raw)
    {
        if ($raw === null || $raw === '' || $raw === 'undefined' || $raw === 'null') {
            return 0;
        }
        if (is_array($raw)) {
            $raw = reset($raw);
        }
        $s = strtoupper(trim((string)$raw));
        if ($s === '1' || $s === 'S' || $s === 'SI' || $s === 'SÌ' || $s === 'Y' || $s === 'YES' || $s === 'TRUE') {
            return 1;
        }
        return 0;
    }
}

if (!function_exists('mez_val_require_auth')) {
    function mez_val_require_auth($mezzoId, $tipoId, $label, $fileVal, $scadVal, &$errors, $fieldName = '')
    {
        if ($tipoId <= 0) {
            $errors[] = $label . ' (tipo mancante in tipi_documento: eseguire migration_tipi_anga_rentri_2026_09_17.sql)';
            return;
        }
        $fileVal = trim((string)$fileVal);
        $scadVal = trim((string)$scadVal);
        $hasFile = ($fileVal !== '') || ($fieldName !== '' && mez_val_has_upload($fieldName));
        $hasScad = ($scadVal !== '' && strcasecmp($scadVal, 'null') !== 0);

        if ((!$hasFile || !$hasScad) && $mezzoId > 0) {
            sc_lookup(rsMezDocReqA, "
                SELECT
                    CASE WHEN file IS NOT NULL AND TRIM(file) <> '' THEN 1 ELSE 0 END,
                    CASE WHEN data_scadenza IS NOT NULL THEN 1 ELSE 0 END
                FROM documenti
                WHERE subvettore_mezzo_id = $mezzoId
                  AND tipo_documento_id = $tipoId
                ORDER BY id ASC LIMIT 1
            ", 'pigliacelli');
            if (!empty({rsMezDocReqA[0][0]}) && (int){rsMezDocReqA[0][0]} === 1) {
                $hasFile = true;
            }
            if (!empty({rsMezDocReqA[0][1]}) && (int){rsMezDocReqA[0][1]} === 1) {
                $hasScad = true;
            }
        }
        if (!$hasFile) {
            $errors[] = $label . ' (file)';
        }
        if (!$hasScad) {
            $errors[] = $label . ' (scadenza)';
        }
    }
}

if (!function_exists('mez_val_require_file')) {
    function mez_val_require_file($mezzoId, $tipoId, $label, $fileVal, &$errors, $fieldName = '')
    {
        if ($tipoId <= 0) {
            $errors[] = $label . ' (tipo mancante in tipi_documento: eseguire migration_tipi_anga_rentri_2026_09_17.sql)';
            return;
        }
        $hasFile = (trim((string)$fileVal) !== '') || ($fieldName !== '' && mez_val_has_upload($fieldName));
        if (!$hasFile && $mezzoId > 0) {
            sc_lookup(rsMezDocReqF, "
                SELECT id FROM documenti
                WHERE subvettore_mezzo_id = $mezzoId
                  AND tipo_documento_id = $tipoId
                  AND file IS NOT NULL AND TRIM(file) <> ''
                ORDER BY id ASC LIMIT 1
            ", 'pigliacelli');
            $hasFile = !empty({rsMezDocReqF[0][0]});
        }
        if (!$hasFile) {
            $errors[] = $label . ' (file)';
        }
    }
}

// Radio 1=Si / 0=No. Con tutti a 0 (o vuoti) nessun doc ANGA/RENTRI è obbligatorio.
$cat1 = mez_val_flag(isset({has_cat_trasp_rifiuti_1}) ? {has_cat_trasp_rifiuti_1} : '');
$cat4 = mez_val_flag(isset({has_cat_trasp_rifiuti_4}) ? {has_cat_trasp_rifiuti_4} : '');
$cat5 = mez_val_flag(isset({has_cat_trasp_rifiuti_5}) ? {has_cat_trasp_rifiuti_5} : '');

sc_log_add('MEZ_VAL', 'onValidate id=' . $mezzoId . ' flag=' . $cat1 . $cat4 . $cat5);

if ($cat1 === 1) {
    mez_val_require_auth(
        $mezzoId,
        mez_val_tipo_id('Autorizzazione ANGA Cat.1', 11),
        'Autorizzazione ANGA Cat.1',
        isset({anga_cat_1}) ? {anga_cat_1} : '',
        isset({scadenza_anga_cat_1}) ? {scadenza_anga_cat_1} : '',
        $errors,
        'anga_cat_1'
    );
    mez_val_require_auth(
        $mezzoId,
        mez_val_tipo_id('Ricevuta pagamento ANGA Cat.1', 12),
        'Ricevuta pagamento ANGA Cat.1',
        isset({ricevuta_anga_cat_1}) ? {ricevuta_anga_cat_1} : '',
        isset({scadenza_ricevuta_anga_cat_1}) ? {scadenza_ricevuta_anga_cat_1} : '',
        $errors,
        'ricevuta_anga_cat_1'
    );
}
if ($cat4 === 1) {
    mez_val_require_auth(
        $mezzoId,
        mez_val_tipo_id('Autorizzazione ANGA Cat.4', 0),
        'Autorizzazione ANGA Cat.4',
        isset({anga_cat_4}) ? {anga_cat_4} : '',
        isset({scadenza_anga_cat_4}) ? {scadenza_anga_cat_4} : '',
        $errors,
        'anga_cat_4'
    );
    mez_val_require_auth(
        $mezzoId,
        mez_val_tipo_id('Ricevuta pagamento ANGA Cat.4', 0),
        'Ricevuta pagamento ANGA Cat.4',
        isset({ricevuta_anga_cat_4}) ? {ricevuta_anga_cat_4} : '',
        isset({scadenza_ricevuta_anga_cat_4}) ? {scadenza_ricevuta_anga_cat_4} : '',
        $errors,
        'ricevuta_anga_cat_4'
    );
}
if ($cat5 === 1) {
    mez_val_require_auth(
        $mezzoId,
        mez_val_tipo_id('Autorizzazione ANGA Cat.5', 0),
        'Autorizzazione ANGA Cat.5',
        isset({anga_cat_5}) ? {anga_cat_5} : '',
        isset({scadenza_anga_cat_5}) ? {scadenza_anga_cat_5} : '',
        $errors,
        'anga_cat_5'
    );
    mez_val_require_auth(
        $mezzoId,
        mez_val_tipo_id('Ricevuta pagamento ANGA Cat.5', 0),
        'Ricevuta pagamento ANGA Cat.5',
        isset({ricevuta_anga_cat_5}) ? {ricevuta_anga_cat_5} : '',
        isset({scadenza_ricevuta_anga_cat_5}) ? {scadenza_ricevuta_anga_cat_5} : '',
        $errors,
        'ricevuta_anga_cat_5'
    );
}

// RENTRI: unico per mezzo (mail 17/09), richiesto se almeno una cat. flaggata.
// Iscrizione: solo file (nessuna scadenza). Ricevuta: file + scadenza (30/04).
if ($cat1 === 1 || $cat4 === 1 || $cat5 === 1) {
    $tidRentri = mez_val_tipo_id('Iscrizione RENTRI', 0);
    if ($tidRentri <= 0) {
        $tidRentri = mez_val_tipo_id('Iscrizione RENTRI Cat.1', 13);
    }
    mez_val_require_file(
        $mezzoId,
        $tidRentri,
        'Iscrizione RENTRI',
        isset({rentri_iscrizione}) ? {rentri_iscrizione} : '',
        $errors,
        'rentri_iscrizione'
    );

    $tidRicRen = mez_val_tipo_id('Ricevuta pagamento RENTRI', 0);
    if ($tidRicRen <= 0) {
        $tidRicRen = mez_val_tipo_id('Ricevuta pagamento RENTRI Cat.1', 14);
    }
    mez_val_require_auth(
        $mezzoId,
        $tidRicRen,
        'Ricevuta pagamento RENTRI',
        isset({ricevuta_rentri}) ? {ricevuta_rentri} : '',
        isset({scadenza_ricevuta_rentri}) ? {scadenza_ricevuta_rentri} : '',
        $errors,
        'ricevuta_rentri'
    );
}

if (!empty($errors)) {
    sc_error_message(
        "Compilare tutti i dati e documenti obbligatori del mezzo:\n- "
        . implode("\n- ", $errors)
    );
}
