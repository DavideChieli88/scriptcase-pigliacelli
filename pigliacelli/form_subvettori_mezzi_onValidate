/**
 * form_subvettori_mezzi -> onValidate
 *
 * Editable grid: {autista_id} in onValidate e' spesso vuoto anche se
 * il dropdown e' compilato. Si legge POST in modo ampio.
 * Se l'autista e' visibile ma non arrivato al PHP, non si blocca il save:
 * il pulsante Prossimo controlla il ponte in DB.
 */

$errors = array();
$mezzoId = isset({id}) ? (int){id} : 0;

$vTarga = isset({targa}) ? trim((string){targa}) : '';
$vScadCarta = isset({scadenza_carta_circolazione}) ? trim((string){scadenza_carta_circolazione}) : '';

$autistaId = 0;
if (isset({autista_id}) && trim((string){autista_id}) !== '' && (int){autista_id} > 0) {
    $autistaId = (int){autista_id};
}

if ($autistaId <= 0 && !empty($_POST) && is_array($_POST)) {
    foreach ($_POST as $k => $v) {
        $ks = strtolower((string)$k);
        if (strpos($ks, 'autista') === false) {
            continue;
        }
        if (is_array($v)) {
            $v = reset($v);
        }
        if ((int)$v > 0) {
            $autistaId = (int)$v;
            break;
        }
    }
}

if ($autistaId <= 0 && !empty($_REQUEST) && is_array($_REQUEST)) {
    foreach ($_REQUEST as $k => $v) {
        $ks = strtolower((string)$k);
        if (strpos($ks, 'autista') === false) {
            continue;
        }
        if (is_array($v)) {
            $v = reset($v);
        }
        if ((int)$v > 0) {
            $autistaId = (int)$v;
            break;
        }
    }
}

if ($autistaId <= 0 && $mezzoId > 0) {
    sc_lookup(rsMezValAut, "
        SELECT autista_id
        FROM subvettori_autisti_mezzi
        WHERE mezzo_id = $mezzoId
          AND autista_id > 0
        ORDER BY id ASC
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsMezValAut[0][0]})) {
        $autistaId = (int){rsMezValAut[0][0]};
    }
}

$vCarta = isset({carta_circolazione}) ? trim((string){carta_circolazione}) : '';
$hasUpload = false;
if (!empty($_FILES) && is_array($_FILES)) {
    foreach ($_FILES as $up) {
        if (!is_array($up)) {
            continue;
        }
        $nm = isset($up['name']) ? $up['name'] : '';
        if (is_array($nm)) {
            $nm = reset($nm);
        }
        $err = isset($up['error']) ? $up['error'] : 4;
        if (is_array($err)) {
            $err = reset($err);
        }
        if (trim((string)$nm) !== '' && (int)$err === 0) {
            $hasUpload = true;
            break;
        }
    }
}

if ($vTarga === '') {
    $errors[] = 'Targa';
}
if ($vScadCarta === '' || $vScadCarta === 'null') {
    $errors[] = 'Scadenza carta di circolazione';
}

$hasCartaCircolazione = ($vCarta !== '' || $hasUpload);
if (!$hasCartaCircolazione && $mezzoId > 0) {
    sc_lookup(rsMezVal22, "
        SELECT id FROM documenti
        WHERE subvettore_mezzo_id = $mezzoId
          AND tipo_documento_id = 22
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    $hasCartaCircolazione = !empty({rsMezVal22[0][0]});
}
if (!$hasCartaCircolazione) {
    $errors[] = 'Documento carta di circolazione';
}

if (!empty($errors)) {
    sc_error_message(
        "Compilare tutti i dati e documenti obbligatori del mezzo:\n- "
        . implode("\n- ", $errors)
    );
}

if ($autistaId > 0) {
    {autista_id} = $autistaId;
}
