function partenza_data_ora_valida($value) {
    $value = trim((string)$value);
    if ($value === '') {
        return false;
    }
    if ($value === '1900-01-01 00:00:00' || strpos($value, '1900-01-01') === 0) {
        return false;
    }
    return strtotime($value) !== false;
}

function importo_unitario_valido($value) {
    if ($value === null) {
        return false;
    }
    if (is_string($value) && trim($value) === '') {
        return false;
    }
    return is_numeric($value);
}

function viaggio_ammesso_per_contratto($partenza_data_ora, $importo_unitario, &$motivo_skip) {
    $motivo_skip = '';

    if (!partenza_data_ora_valida($partenza_data_ora)) {
        $motivo_skip = 'partenza_data_ora_mancante';
        return false;
    }

    if (!importo_unitario_valido($importo_unitario)) {
        $motivo_skip = 'importo_unitario_mancante';
        return false;
    }

    return true;
}

