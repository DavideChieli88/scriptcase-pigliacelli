/** Tipo 1: primo contratto quadro per subvettore appena creato (una tantum). */
function recupera_contratto_quadro(&$contratti_batch, $intestatario, $subvettore_id) {
    $key = (string)$subvettore_id . '|1';
    if (isset($contratti_batch[$key])) {
        return $contratti_batch[$key];
    }

    sc_lookup(contrattoEsistente, "
        SELECT c.id
        FROM contratti c
        INNER JOIN subvettori_contratti sc ON sc.contratto_id = c.id
        WHERE c.tipo_contratto_id = 1
          AND c.intestatario = " . sql_quote($intestatario) . "
          AND sc.subvettore_id = " . sql_num($subvettore_id) . "
        ORDER BY c.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (!empty({contrattoEsistente})) {
        $contratti_batch[$key] = {contrattoEsistente[0][0]};
        return $contratti_batch[$key];
    }

    $contratto_id = crea_contratto_subvettore(1, $intestatario, $subvettore_id);
    $contratti_batch[$key] = $contratto_id;
    return $contratto_id;
}

