        $titolo = '(UAT) ' . $titolo;
    }
    $testo = $nome . ",\n\n"
        . "E' stato registrato un nuovo contratto #" . (int)$contratto_id . ".\n"
        . "Puoi accedere all'area riservata con le credenziali seguenti (password temporanea).\n\n"
