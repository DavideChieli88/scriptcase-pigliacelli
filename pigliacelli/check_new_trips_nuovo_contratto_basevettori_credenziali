function crea_contratto_tratta($tratta_id, $contratto_id, $version, $carico, $scarico, $tipo_tariffa_id, $tariffa, $extra, $totale, $hash) {
    if ($contratto_id === null) {
        log_export_tratte("WARNING", "Contratto nullo: salto collegamento tratta " . $tratta_id);
        return;
    }

    [$merce, $caricatore, $proprietario_merce] = recupera_campi_tratta_allegato($tratta_id);
    $tipo_tariffa_sql = $tipo_tariffa_id === null ? "NULL" : sql_num($tipo_tariffa_id);

    sc_exec_sql("
        INSERT INTO contratti_tratte
          (tratta_id, contratto_id, version, carico, scarico, merce, caricatore, proprietario_merce, tipo_tariffa_id, tariffa, extra, totale, hash)
        VALUES
          (" . sql_num($tratta_id) . ",
           " . sql_num($contratto_id) . ",
           " . sql_num($version) . ",
           " . sql_quote($carico) . ",
           " . sql_quote($scarico) . ",
           " . sql_quote($merce) . ",
           " . sql_quote($caricatore) . ",
           " . sql_quote($proprietario_merce) . ",
           " . $tipo_tariffa_sql . ",
           " . sql_num($tariffa) . ",
           " . sql_num($extra) . ",
           " . sql_num($totale) . ",
           " . sql_quote($hash) . ")
    ", "pigliacelli");
}

function assicura_contratto_tratta($tratta_id, $contratto_id, $version, $carico, $scarico, $tipo_tariffa_id, $tariffa, $extra, $totale, $hash) {
    if ($contratto_id === null) {
        log_export_tratte("WARNING", "Contratto nullo: salto collegamento tratta " . $tratta_id);
        return;
    }

    sc_lookup(contrattoTrattaEsistente, "
        SELECT id
        FROM contratti_tratte
        WHERE contratto_id = " . sql_num($contratto_id) . "
          AND tratta_id = " . sql_num($tratta_id) . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({contrattoTrattaEsistente})) {
        return;
    }

    crea_contratto_tratta(
        $tratta_id,
        $contratto_id,
        $version,
        $carico,
        $scarico,
        $tipo_tariffa_id,
        $tariffa,
        $extra,
        $totale,
        $hash
    );
}

function generateTempPassword() {
    $characters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=';
    $charactersLength = strlen($characters);
    $temporaryPassword = '';

    for ($i = 0; $i < 12; $i++) {
        $temporaryPassword .= $characters[random_int(0, $charactersLength - 1)];
    }

    return $temporaryPassword;
}

function emailValidaSingola($email) {
    $email = trim((string)$email);

    if ($email === '') {
        return false;
    }

    if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
        return false;
    }

    return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
}

$IMPORT_CRED_MAIL_OVERRIDE_DEFAULT = 'davide.chieli@digiwebuno.it';

function import_cred_req_param($name) {
    $name = (string)$name;
    if ($name === '') {
        return '';
    }
    if (isset($_GET[$name])) {
        return trim((string)$_GET[$name]);
    }
    if (isset($_REQUEST[$name])) {
        return trim((string)$_REQUEST[$name]);
    }
    if (!empty($_SERVER['QUERY_STRING'])) {
        $qs = array();
        parse_str((string)$_SERVER['QUERY_STRING'], $qs);
        if (isset($qs[$name])) {
            return trim((string)$qs[$name]);
        }
    }
    if (!empty($_SERVER['REQUEST_URI'])) {
        $q = parse_url((string)$_SERVER['REQUEST_URI'], PHP_URL_QUERY);
        if (is_string($q) && $q !== '') {
            $qs = array();
            parse_str($q, $qs);
            if (isset($qs[$name])) {
                return trim((string)$qs[$name]);
            }
        }
    }
    if (isset($_GET['nmgp_arg']) && is_string($_GET['nmgp_arg'])) {
        $nmgp = array();
        parse_str((string)$_GET['nmgp_arg'], $nmgp);
        if (isset($nmgp[$name])) {
            return trim((string)$nmgp[$name]);
        }
    }
    return '';
}

function import_cred_risolvi_mail_override() {
    if (isset($GLOBALS['import_cred_mail_override_to'])) {
        return (string)$GLOBALS['import_cred_mail_override_to'];
    }

    $cache = '';
    $raw = import_cred_req_param('mail_override');
    if ($raw === '' && isset([mail_override])) {
        $raw = trim((string)[mail_override]);
    }
    if ($raw === '' || $raw === '0' || strcasecmp($raw, 'false') === 0) {
        $GLOBALS['import_cred_mail_override_to'] = '';
        return '';
    }

    if (strpos($raw, '@') !== false) {
        $cache = $raw;
    } else {
        $mailTo = import_cred_req_param('mail_to');
        if ($mailTo === '' && isset([mail_to])) {
            $mailTo = trim((string)[mail_to]);
        }
        if ($mailTo !== '') {
            $cache = $mailTo;
        } elseif ($raw === '1' || strcasecmp($raw, 'true') === 0 || strcasecmp($raw, 'yes') === 0) {
            global $IMPORT_CRED_MAIL_OVERRIDE_DEFAULT;
            $cache = trim((string)$IMPORT_CRED_MAIL_OVERRIDE_DEFAULT);
        }
    }

    if ($cache !== '' && !emailValidaSingola($cache)) {
        log_export_tratte('MAIL_OVERRIDE', 'parametro non valido ignorato: ' . $cache);
        $cache = '';
    }

    $GLOBALS['import_cred_mail_override_to'] = $cache;
    return $cache;
}

function import_cred_applica_mail_override($to) {
    $override = import_cred_risolvi_mail_override();
    if ($override !== '') {
        return $override;
    }
    return trim((string)$to);
}

