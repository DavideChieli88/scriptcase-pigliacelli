    }
    $toOrig = trim((string)$to);
    $to = ($mailOverrideAttivo !== '') ? $mailOverrideAttivo : $toOrig;
    if ($mailOverrideAttivo !== '' && strcasecmp($to, $mailOverrideAttivo) !== 0) {
        log_export_tratte('MAIL_CRED', 'BLOCCO sicurezza to!=override contratto=' . (int)$contratto_id);
        return false;
    }
    $login = trim((string)$login);
    if (!emailValidaSingola($to) || $login === '' || $plainPassword === '') {
        return false;
    }
    if (!function_exists('sc_send_mail_api')) {
        log_export_tratte('MAIL_CRED', 'SKIP sc_send_mail_api assente contratto=' . (int)$contratto_id);
