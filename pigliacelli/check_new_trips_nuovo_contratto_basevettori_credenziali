/**
 * Solo per assicurare un legame gia esistente (nessuna variazione): riusa il contratto
 * gia collegato alla tratta, senza crearne uno nuovo.
 */
function tipo_contratto_nuove_tratte($subvettore_id, $subvettori_nuovi_run) {
    return isset($subvettori_nuovi_run[(int)$subvettore_id]) ? 1 : 2;
}

function aggiungi_tratta_pending_run(
    $subvettore_id,
    $tratta_id,
    $subvettori_nuovi_run,
    &$pending_tratte_tipo1,
    &$pending_tratte_tipo2
) {
    $subvettore_id = (int)$subvettore_id;
    $tratta_id = (int)$tratta_id;
    if ($tratta_id <= 0) {
        return;
    }
    if (isset($subvettori_nuovi_run[$subvettore_id])) {
        $pending_tratte_tipo1[$subvettore_id][$tratta_id] = true;
    } else {
        $pending_tratte_tipo2[$subvettore_id][$tratta_id] = true;
    }
}

function aggiungi_modifica_tariffa_pending(
    $subvettore_id,
    $tratta_id,
    $subvettori_nuovi_run,
    $tratte_inserite_run,
    &$pending_tratte_tipo1,
    &$pending_tratte_tipo2,
    &$pending_modifiche_tariffa
) {
    $subvettore_id = (int)$subvettore_id;
    $tratta_id = (int)$tratta_id;
    if ($tratta_id <= 0) {
        return;
    }
    if (isset($subvettori_nuovi_run[$subvettore_id]) || isset($tratte_inserite_run[$tratta_id])) {
        aggiungi_tratta_pending_run(
            $subvettore_id,
            $tratta_id,
            $subvettori_nuovi_run,
            $pending_tratte_tipo1,
            $pending_tratte_tipo2
        );
    } else {
        $pending_modifiche_tariffa[$subvettore_id][$tratta_id] = true;
    }
}

function contratto_per_assicura($tratta_id, $tipo_contratto_id, $intestatario, $subvettore_id) {
    sc_lookup(contrattoTratta, "
        SELECT ct.contratto_id
        FROM contratti_tratte ct
        INNER JOIN contratti c ON c.id = ct.contratto_id
        WHERE ct.tratta_id = " . sql_num($tratta_id) . "
          AND c.tipo_contratto_id = " . sql_num($tipo_contratto_id) . "
        ORDER BY ct.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (!empty({contrattoTratta})) {
        return {contrattoTratta[0][0]};
    }

    sc_lookup(ultimoContratto, "
        SELECT c.id
        FROM contratti c
        INNER JOIN subvettori_contratti sc ON sc.contratto_id = c.id
