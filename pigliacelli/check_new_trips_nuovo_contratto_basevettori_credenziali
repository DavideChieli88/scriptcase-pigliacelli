function login_sub_gia_usato_da_altro_sub($login, $subvettore_id) {
    $login = trim((string)$login);
    $subvettore_id = (int)$subvettore_id;
    if ($login === '') {
        return false;
    }

    sc_lookup(rsLoginAlt, "
        SELECT subvettore_id
        FROM sec_users
        WHERE login = " . sql_quote($login) . "
        LIMIT 1
    ", "pigliacelli");

    if (empty({rsLoginAlt})) {
        return false;
    }

    $sub_alt = {rsLoginAlt[0][0]};
    if ($sub_alt === null || $sub_alt === '') {
        return true;
    }

    return (int)$sub_alt !== $subvettore_id;
}

function aggiorna_anagrafica_utenza_sub($subvettore_id, $login, $email, $ragione_sociale, $phone) {
    sc_exec_sql("
        UPDATE sec_users
        SET email = " . sql_quote($email) . ",
            name = " . sql_quote($ragione_sociale) . ",
            phone = " . sql_quote($phone) . "
        WHERE subvettore_id = " . sql_num($subvettore_id) . "
          AND login = " . sql_quote($login) . "
    ", "pigliacelli");
}

function disabilita_utenza_subvettore($subvettore_id, $vecchio_login) {
    $subvettore_id = (int)$subvettore_id;
    $vecchio_login = trim((string)$vecchio_login);
    if ($subvettore_id <= 0 || $vecchio_login === '') {
        return;
    }

    sc_exec_sql("
        UPDATE sec_users
        SET active = 'N'
        WHERE login = " . sql_quote($vecchio_login) . "
          AND subvettore_id = " . sql_num($subvettore_id) . "
    ", "pigliacelli");

    log_export_tratte(
        'SUB_UTENZA',
        'disabilitata utenza precedente subvettore_id=' . $subvettore_id . ' login=' . $vecchio_login
    );
}

function intestatario_primo_utente_sub($subvettore_id) {
    sc_lookup(rsPrimoUser, "
        SELECT login
        FROM sec_users
        WHERE subvettore_id = " . sql_num($subvettore_id) . "
        ORDER BY login
        LIMIT 1
    ", "pigliacelli");

    if (!empty({rsPrimoUser[0][0]})) {
        return trim((string){rsPrimoUser[0][0]});
    }

    return null;
}

function utenza_ha_mai_acceduto($login, $subvettore_id) {
    $login = trim((string)$login);
    $subvettore_id = (int)$subvettore_id;
    if ($login === '' || $subvettore_id <= 0) {
        return false;
    }

    sc_lookup(rsUtenzaUsata, "
        SELECT COALESCE(hasLoggedFirst, 0)
        FROM sec_users
        WHERE login = " . sql_quote($login) . "
          AND subvettore_id = " . sql_num($subvettore_id) . "
        LIMIT 1
    ", "pigliacelli");

    if (empty({rsUtenzaUsata})) {
        return false;
    }

    return (int){rsUtenzaUsata[0][0]} === 1;
}

function crea_utenza_subvettore($subvettore_id, $email, $ragione_sociale, $phone) {
    $group_id = 2;
    $email = trim((string)$email);

    if (!emailValidaSingola($email)) {
        return null;
    }

    if (login_collegato_a_sub($email, $subvettore_id)) {
        return $email;
    }

    if (login_sub_gia_usato_da_altro_sub($email, $subvettore_id)) {
        log_export_tratte(
            'SUB_UTENZA',
            'skip crea utenza: email=' . $email . ' gia login di altro subvettore_id'
        );
        return null;
    }

    $tempPassword = generateTempPassword();
    $password_hash = md5($tempPassword);

    sc_exec_sql("
        INSERT INTO sec_users (
            login,
            pswd,
            name,
            email,
            phone,
            active,
            subvettore_id
        ) VALUES (
            " . sql_quote($email) . ",
            " . sql_quote($password_hash) . ",
            " . sql_quote($ragione_sociale) . ",
            " . sql_quote($email) . ",
            " . sql_quote($phone) . ",
            'N',
            " . sql_num($subvettore_id) . "
        )
    ", "pigliacelli");

    sc_exec_sql("
        INSERT INTO sec_users_groups (
            login,
            group_id
        ) VALUES (
            " . sql_quote($email) . ",
            " . sql_num($group_id) . "
        )
    ", "pigliacelli");

    log_export_tratte(
        'SUB_UTENZA',
        'creata nuova utenza subvettore_id=' . (int)$subvettore_id . ' login=' . $email
    );

    return $email;
}

