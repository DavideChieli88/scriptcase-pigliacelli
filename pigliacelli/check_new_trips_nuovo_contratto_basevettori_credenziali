$notifica_subvettore_area_riservata_tipo23 = function (
    $subvettore_id,
    $contratto_id,
    $subvettori_nuovi_run
) use ($import_cred_send_mail_credenziali, $import_cred_send_mail_area_riservata) {
    $subvettore_id = (int)$subvettore_id;
    $contratto_id = (int)$contratto_id;
    if ($subvettore_id <= 0 || $contratto_id <= 0) {
        return 'skip';
    }
    if (isset($subvettori_nuovi_run[$subvettore_id])) {
        return 'skip';
    }

    sc_lookup(rsSubCred, "
        SELECT
            login_subvettore,
            ragione_sociale,
            COALESCE(NULLIF(TRIM(phone), ''), NULLIF(TRIM(cellphone), ''), '') AS phone_sub
        FROM subvettori
        WHERE id = " . sql_num($subvettore_id) . "
        LIMIT 1
    ", "pigliacelli");
    if (empty({rsSubCred[0][0]})) {
        log_export_tratte('MAIL_SUB', 'skip subvettore=' . $subvettore_id . ' anagrafica assente');
        return 'skip';
    }

    $loginSub = trim((string){rsSubCred[0][0]});
    $ragioneSociale = trim((string){rsSubCred[0][1]});
    $phoneSub = trim((string){rsSubCred[0][2]});
    if (!emailValidaSingola($loginSub)) {
        log_export_tratte('MAIL_SUB', 'skip subvettore=' . $subvettore_id . ' email non valida');
        return 'skip';
    }

    sc_lookup(rsUserCred, "
        SELECT login, active, email
        FROM sec_users
        WHERE subvettore_id = " . sql_num($subvettore_id) . "
          AND login = " . sql_quote($loginSub) . "
        LIMIT 1
    ", "pigliacelli");

    $userLogin = '';
    $userActive = '';
    $userEmail = '';
    if (!empty({rsUserCred[0][0]})) {
        $userLogin = trim((string){rsUserCred[0][0]});
        $userActive = trim((string){rsUserCred[0][1]});
        $userEmail = trim((string){rsUserCred[0][2]});
    }

    if ($userLogin !== '' && import_cred_login_is_tecnico($userLogin)) {
        log_export_tratte('MAIL_SUB', 'skip subvettore=' . $subvettore_id . ' utenza tecnica login=' . $userLogin);
        return 'skip';
    }

    $toEmail = emailValidaSingola($userEmail) ? $userEmail : $loginSub;
    $displayName = $ragioneSociale !== '' ? $ragioneSociale : 'Gentile subvettore';

    if ($userLogin === '') {
        $plainPassword = generateTempPassword();
        $pswHash = md5($plainPassword);
        sc_exec_sql("
            INSERT INTO sec_users (login, pswd, name, email, phone, active, subvettore_id)
            VALUES (
                " . sql_quote($loginSub) . ",
                " . sql_quote($pswHash) . ",
                " . sql_quote($ragioneSociale) . ",
                " . sql_quote($loginSub) . ",
                " . sql_quote($phoneSub) . ",
                'Y',
                " . sql_num($subvettore_id) . "
            )
        ", "pigliacelli");
        sc_lookup(rsGrpCred, "
            SELECT login
            FROM sec_users_groups
            WHERE login = " . sql_quote($loginSub) . "
              AND group_id = 2
            LIMIT 1
        ", "pigliacelli");
        if (empty({rsGrpCred[0][0]})) {
            sc_exec_sql("
                INSERT INTO sec_users_groups (login, group_id)
                VALUES (" . sql_quote($loginSub) . ", 2)
            ", "pigliacelli");
        }
        if ($import_cred_send_mail_credenziali($contratto_id, $toEmail, $loginSub, $plainPassword, $displayName)) {
            return 'credenziali';
        }
        return 'errore';
    }

    if (import_cred_user_active_is_yes($userActive)) {
        if ($import_cred_send_mail_area_riservata($contratto_id, $toEmail, $displayName)) {
            return 'area_riservata';
        }
        return 'errore';
    }

    $plainPassword = generateTempPassword();
    $pswHash = md5($plainPassword);
    sc_exec_sql("
        UPDATE sec_users
        SET active = 'Y',
            pswd = " . sql_quote($pswHash) . ",
            email = " . sql_quote($loginSub) . ",
            name = " . sql_quote($ragioneSociale) . ",
            phone = " . sql_quote($phoneSub) . "
        WHERE subvettore_id = " . sql_num($subvettore_id) . "
          AND login = " . sql_quote($userLogin) . "
    ", "pigliacelli");
    $loginInvio = $loginSub;
    if ($import_cred_send_mail_credenziali($contratto_id, $toEmail, $loginInvio, $plainPassword, $displayName)) {
        return 'credenziali';
    }
    return 'errore';
};

