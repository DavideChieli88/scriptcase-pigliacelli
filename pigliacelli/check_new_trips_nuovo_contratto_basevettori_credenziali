// Scriptcase app: check_new_trips_nuovo_contratto_basevettori_credenziali
// Clone di check_new_trips_nuovo_contratto_basevettori con notifica area riservata.
// Versione T2BaseVettori: JOIN T2BaseVettori al posto di BaCliFor per anagrafica vettore.
// A fine job: un contratto per run con SOLO le tratte rilevate in quel ciclo.
// Subvettore NUOVO (creato nel run): un solo contratto tipo 1 — come la versione base (no mail).
// Subvettore ESISTENTE + contratto tipo 2 o 3 nel run:
//   - email valida + utenza inactive → active=Y, nuova password, mail credenziali
//   - email valida + utenza già active=Y → mail link area riservata (no rigenerazione password)
//   - email non valida → utenza tecnica (come base), nessuna mail
//
// Mail tipo 2/3: closure subito prima del loop (Scriptcase non espone function nominata).
// Test UAT — redirect mail (blank Scriptcase: usare QUERY_STRING, non solo $_GET):
//   ?mail_override=1  → solo davide.chieli@digiwebuno.it (mai al subvettore reale)
//   ?mail_override=tua@email.it
//   ?mail_override=1&mail_to=altra@email.it
// Se ?mail_override è in URL ma non si risolve: BLOCCO totale (zero mail).
function sql_quote($v) {
    if ($v === null) return "NULL";
    return "'" . str_replace("'", "''", (string)$v) . "'";
}
function sql_num($v) {
    if ($v === null || $v === '') return "NULL";
    return (string)(0 + $v);
}
function split_localita($s) {
    $s = trim((string)$s);
    if ($s === '') return [];

    // Split su "+" con o senza spazi, preservando l'ordine.
    $parts = preg_split('/\s*\+\s*/', $s);

    return array_values(array_filter($parts, fn($x) => $x !== ''));
}

function normalizza_stringa($s) {
    $s = trim((string)$s);
    $s = strtoupper($s);
    $s = preg_replace('/\s+/', ' ', $s);
    return $s;
}

function crea_hash_tratta($carico_str, $scarico_str, $codice_vettore, $importo_unitario) {
    $carichi = [];
    foreach (split_localita($carico_str) as $loc) {
        $carichi[] = normalizza_stringa($loc);
    }

    $scarichi = [];
    foreach (split_localita($scarico_str) as $loc) {
        $scarichi[] = normalizza_stringa($loc);
    }

    $carico_norm  = implode('|', $carichi);
    $scarico_norm = implode('|', $scarichi);
    $vettore      = normalizza_stringa($codice_vettore);
    $importo      = number_format((float)$importo_unitario, 2, '.', '');

    return hash('sha256', $carico_norm . '#' . $scarico_norm . '#' . $vettore . '#' . $importo);
}

function crea_contratto($tipo_contratto_id, $intestatario) {
    sc_exec_sql("
        INSERT INTO contratti
          (tipo_contratto_id, intestatario, stato_contratto_id)
        VALUES
          (" . sql_num($tipo_contratto_id) . ", " . sql_quote($intestatario) . ",
           (SELECT id FROM stati_contratti WHERE nome = 'Da inviare al subvettore' LIMIT 1))
    ", "pigliacelli");

    sc_lookup(lastContrattoId, "SELECT LAST_INSERT_ID()", "pigliacelli");
    if (empty({lastContrattoId})) {
        return null;
    }

    return {lastContrattoId[0][0]};
}

function crea_contratto_subvettore($tipo_contratto_id, $intestatario, $subvettore_id) {
    $contratto_id = crea_contratto($tipo_contratto_id, $intestatario);

    if ($contratto_id === null) {
        return null;
    }

    sc_exec_sql("
        INSERT INTO subvettori_contratti
          (subvettore_id, contratto_id)
        VALUES
          (" . sql_num($subvettore_id) . ", " . sql_num($contratto_id) . ")
    ", "pigliacelli");

    return $contratto_id;
}

function ultimo_contratto_tipo($subvettore_id, $tipo_contratto_id) {
    sc_lookup(rsUlt, "
        SELECT c.id
        FROM contratti c
        INNER JOIN subvettori_contratti sc ON sc.contratto_id = c.id
        WHERE sc.subvettore_id = " . sql_num($subvettore_id) . "
          AND c.tipo_contratto_id = " . sql_num($tipo_contratto_id) . "
        ORDER BY c.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (empty({rsUlt})) {
        return null;
    }
    return (int){rsUlt[0][0]};
}

function tratte_ids_del_contratto($contratto_id) {
    sc_lookup(rsTr, "
        SELECT DISTINCT tratta_id
        FROM contratti_tratte
        WHERE contratto_id = " . sql_num($contratto_id) . "
        ORDER BY tratta_id
    ", "pigliacelli");

    $ids = array();
    if (!empty({rsTr})) {
        foreach ({rsTr} as $row) {
            $ids[] = (int)$row[0];
        }
    }
    return $ids;
}

function carica_carico_scarico_tratta($tratta_id) {
    sc_lookup(rsC, "
        SELECT GROUP_CONCAT(localita ORDER BY progressivo SEPARATOR ' + ')
        FROM tratte_localita
        WHERE tratta_id = " . sql_num($tratta_id) . "
          AND tipo_tratta = 'C'
    ", "pigliacelli");
    sc_lookup(rsS, "
        SELECT GROUP_CONCAT(localita ORDER BY progressivo SEPARATOR ' + ')
        FROM tratte_localita
        WHERE tratta_id = " . sql_num($tratta_id) . "
          AND tipo_tratta = 'S'
    ", "pigliacelli");

    $carico = empty({rsC[0][0]}) ? '' : (string){rsC[0][0]};
    $scarico = empty({rsS[0][0]}) ? '' : (string){rsS[0][0]};
    return array($carico, $scarico);
}

function allega_tratta_a_contratto($contratto_id, $tratta_id) {
    sc_lookup(rsT, "
        SELECT tipo_tariffa_id, tariffa, extra, totale, hash, version
        FROM tratte
        WHERE id = " . sql_num($tratta_id) . "
        LIMIT 1
    ", "pigliacelli");

    if (empty({rsT})) {
        return;
    }

    [$carico, $scarico] = carica_carico_scarico_tratta($tratta_id);
    $version = ({rsT[0][5]} === null || {rsT[0][5]} === '') ? 1 : (int){rsT[0][5]};

    crea_contratto_tratta(
        $tratta_id,
        $contratto_id,
        $version,
        $carico,
        $scarico,
        {rsT[0][0]},
        {rsT[0][1]},
        {rsT[0][2]},
        {rsT[0][3]},
        {rsT[0][4]}
    );
}

/**
 * Fine run: contratto tipo 1 per subvettore appena censito, con tutte le tratte del run.
 */
function consolida_contratto_tipo1_run(&$contratti_batch, $subvettore_id, $intestatario, $nuove_tratte_ids) {
    $nuove_tratte_ids = array_values(array_unique(array_filter(array_map('intval', $nuove_tratte_ids))));
    if (empty($nuove_tratte_ids)) {
        return;
    }

    $contratto_id = recupera_contratto_quadro($contratti_batch, $intestatario, $subvettore_id);
    if ($contratto_id === null) {
        return;
    }

    log_export_tratte(
        'NUOVO_CONTRATTO',
        'tipo=1 subvettore=' . (int)$subvettore_id .
        ' contratto=' . (int)$contratto_id .
        ' tratte_run=' . count($nuove_tratte_ids)
    );

    foreach ($nuove_tratte_ids as $tratta_id) {
        allega_tratta_a_contratto($contratto_id, $tratta_id);
    }
}

