/**
 * form_subvettori_autisti_wizard → onAfterUpdate
 *
 * NON usare qui il codice mezzi (MEZ_DOCS / carta / ANGA):
 * questa app salva documenti su subvettore_autista_id, tipi 18–21 e 30.
 *
 * Tipi:
 *   18 idoneità, 19 patente, CQC tipo dedicato, 20 formazione, 21 DPI,
 *   30 permesso_soggiorno (+ in_possesso da permesso_soggiorno_flag)
 *
 * IDE: Events → onAfterUpdate → incolla questo file. Generate.
 * Log atteso al Salva: AUT_DOCS (non MEZ_DOCS).
 */

$autistaId = (int){id};
$subId     = (int){subvettore_id};
if ($subId <= 0 && isset([subvettoreId])) {
    $subId = (int)[subvettoreId];
}

sc_log_add('AUT_DOCS', "onAfterUpdate START autista=$autistaId sub=$subId");

if ($autistaId <= 0 || $subId <= 0) {
    sc_error_message('AUT_DOCS: id autista o subvettore mancante.');
    return;
}

$login = trim((string)[usr_login]);
sc_lookup(rsLoginAnyU, "
    SELECT login FROM sec_users
    WHERE subvettore_id = $subId
    ORDER BY login LIMIT 1
", 'pigliacelli');
if (!empty({rsLoginAnyU[0][0]})) {
    $login = trim((string){rsLoginAnyU[0][0]});
}
$loginSql = str_replace("'", "''", $login);

$tipoCqc = 0;
sc_lookup(rsTipoCqcU, "
    SELECT id FROM tipi_documento
    WHERE LOWER(TRIM(nome)) = LOWER(TRIM('CQC autisti (fronte/retro)'))
    LIMIT 1
", 'pigliacelli');
$tipoCqc = !empty({rsTipoCqcU[0][0]}) ? (int){rsTipoCqcU[0][0]} : 0;

/**
 * Nome file da campo virtuale Document; se vuoto, prova $_FILES con chiave che contiene $hint.
 */
if (!function_exists('aut_wiz_file_val')) {
    function aut_wiz_file_val($fieldVal, $hint)
    {
        $fieldVal = trim((string)$fieldVal);
        if ($fieldVal !== '') {
            return basename($fieldVal);
        }
        if (empty($_FILES) || !is_array($_FILES)) {
            return '';
        }
        $hint = strtolower((string)$hint);
        foreach ($_FILES as $k => $up) {
            if (!is_array($up)) {
                continue;
            }
            if ($hint !== '' && strpos(strtolower((string)$k), $hint) === false) {
                continue;
            }
            $nm = isset($up['name']) ? $up['name'] : '';
            if (is_array($nm)) {
                $nm = reset($nm);
            }
            $err = isset($up['error']) ? $up['error'] : 4;
            if (is_array($err)) {
                $err = reset($err);
            }
            if (trim((string)$nm) !== '' && (int)$err === 0) {
                return basename(trim((string)$nm));
            }
        }
        return '';
    }
}

$fPatente  = aut_wiz_file_val(isset({patente}) ? {patente} : '', 'patente');
$fCqc      = aut_wiz_file_val(isset({cqc}) ? {cqc} : '', 'cqc');
$fFormaz   = aut_wiz_file_val(isset({formazione_sicurezza}) ? {formazione_sicurezza} : '', 'formazione');
$fIdoneita = aut_wiz_file_val(isset({idoneita_sanitaria}) ? {idoneita_sanitaria} : '', 'idoneita');
$fDpi      = aut_wiz_file_val(isset({dpi_iii_categoria}) ? {dpi_iii_categoria} : '', 'dpi');
$fPermesso = aut_wiz_file_val(isset({permesso_soggiorno}) ? {permesso_soggiorno} : '', 'permesso');

$flagPoss30 = 0;
$rawFlag30 = {permesso_soggiorno_flag};
if ($rawFlag30 !== '' && $rawFlag30 !== null && $rawFlag30 !== 'undefined' && $rawFlag30 !== 'null') {
    $flagPoss30 = ((int)$rawFlag30 === 1) ? 1 : 0;
}
// Se c'è file permesso, forza in_possesso=1 (coerente con onLoadRecord)
if ($fPermesso !== '') {
    $flagPoss30 = 1;
}

$scadPerm = '';
if (isset({scadenza_permesso_soggiorno})
    && {scadenza_permesso_soggiorno} !== ''
    && {scadenza_permesso_soggiorno} !== 'null'
) {
    $scadPerm = trim((string){scadenza_permesso_soggiorno});
}

sc_log_add(
    'AUT_DOCS',
    "FILES patente=[$fPatente] cqc=[$fCqc] form=[$fFormaz] idoneita=[$fIdoneita]"
    . " dpi=[$fDpi] perm=[$fPermesso] flag30=$flagPoss30 scad30=[$scadPerm]"
);

// --- 18 idoneità ---
$scad18Sql = 'NULL';
if (isset({scadenza_idoneita_sanitaria}) && {scadenza_idoneita_sanitaria} !== '' && {scadenza_idoneita_sanitaria} !== 'null') {
    $scad18Sql = "'" . str_replace("'", "''", (string){scadenza_idoneita_sanitaria}) . "'";
}
if ($fIdoneita !== '') {
    $fileSql = str_replace("'", "''", $fIdoneita);
    sc_lookup(rsU18, "
        SELECT id FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 18
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsU18[0][0]})) {
        sc_exec_sql(
            "UPDATE documenti SET file='$fileSql', data_scadenza=$scad18Sql, stato_documento_id=2, updated_at=NOW() WHERE id=" . (int){rsU18[0][0]},
            'pigliacelli'
        );
    } else {
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
            VALUES (18, $subId, $autistaId, '$loginSql', 2, '$fileSql', $scad18Sql)
        ", 'pigliacelli');
    }
    sc_log_add('AUT_DOCS', "UPSERT 18 $fileSql scad=$scad18Sql");
} elseif ($scad18Sql !== 'NULL') {
    sc_exec_sql("
        UPDATE documenti
        SET data_scadenza = $scad18Sql, updated_at = NOW()
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 18
    ", 'pigliacelli');
}

// --- 19 patente ---
if ($fPatente !== '') {
    $fileSql = str_replace("'", "''", $fPatente);
    $scadSql = 'NULL';
    if (isset({scadenza_patente}) && {scadenza_patente} !== '' && {scadenza_patente} !== 'null') {
        $scadSql = "'" . str_replace("'", "''", (string){scadenza_patente}) . "'";
    }
    sc_lookup(rsU19a, "
        SELECT id FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 19
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsU19a[0][0]})) {
        sc_exec_sql(
            "UPDATE documenti SET file='$fileSql', data_scadenza=$scadSql, stato_documento_id=2, updated_at=NOW() WHERE id=" . (int){rsU19a[0][0]},
            'pigliacelli'
        );
    } else {
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
            VALUES (19, $subId, $autistaId, '$loginSql', 2, '$fileSql', $scadSql)
        ", 'pigliacelli');
    }
    sc_log_add('AUT_DOCS', "UPSERT 19 patente $fileSql");
}

// --- CQC (tipo dedicato) ---
if ($fCqc !== '' && $tipoCqc > 0) {
    $fileSql = str_replace("'", "''", $fCqc);
    $scadSql = 'NULL';
    if (isset({scadenza_cqc}) && {scadenza_cqc} !== '' && {scadenza_cqc} !== 'null') {
        $scadSql = "'" . str_replace("'", "''", (string){scadenza_cqc}) . "'";
    }
    sc_lookup(rsUCqc, "
        SELECT id FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = $tipoCqc
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsUCqc[0][0]})) {
        sc_exec_sql(
            "UPDATE documenti SET file='$fileSql', data_scadenza=$scadSql, stato_documento_id=2, updated_at=NOW() WHERE id=" . (int){rsUCqc[0][0]},
            'pigliacelli'
        );
    } else {
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
            VALUES ($tipoCqc, $subId, $autistaId, '$loginSql', 2, '$fileSql', $scadSql)
        ", 'pigliacelli');
    }
    sc_log_add('AUT_DOCS', "UPSERT CQC tipo=$tipoCqc $fileSql");
}

// --- 20 formazione ---
$scad20Sql = 'NULL';
if (isset({scadenza_formazione_sicurezza}) && {scadenza_formazione_sicurezza} !== '' && {scadenza_formazione_sicurezza} !== 'null') {
    $scad20Sql = "'" . str_replace("'", "''", (string){scadenza_formazione_sicurezza}) . "'";
}
if ($fFormaz !== '') {
    $fileSql = str_replace("'", "''", $fFormaz);
    sc_lookup(rsU20, "
        SELECT id FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 20
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsU20[0][0]})) {
        sc_exec_sql(
            "UPDATE documenti SET file='$fileSql', data_scadenza=$scad20Sql, stato_documento_id=2, updated_at=NOW() WHERE id=" . (int){rsU20[0][0]},
            'pigliacelli'
        );
    } else {
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
            VALUES (20, $subId, $autistaId, '$loginSql', 2, '$fileSql', $scad20Sql)
        ", 'pigliacelli');
    }
    sc_log_add('AUT_DOCS', "UPSERT 20 $fileSql scad=$scad20Sql");
} elseif ($scad20Sql !== 'NULL') {
    sc_exec_sql("
        UPDATE documenti
        SET data_scadenza = $scad20Sql, updated_at = NOW()
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 20
    ", 'pigliacelli');
}

// --- 21 DPI ---
$scad21Sql = 'NULL';
if (isset({scadenza_dpi_iii_categoria}) && {scadenza_dpi_iii_categoria} !== '' && {scadenza_dpi_iii_categoria} !== 'null') {
    $scad21Sql = "'" . str_replace("'", "''", (string){scadenza_dpi_iii_categoria}) . "'";
}
if ($fDpi !== '') {
    $fileSql = str_replace("'", "''", $fDpi);
    sc_lookup(rsU21, "
        SELECT id FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 21
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsU21[0][0]})) {
        sc_exec_sql(
            "UPDATE documenti SET file='$fileSql', data_scadenza=$scad21Sql, stato_documento_id=2, updated_at=NOW() WHERE id=" . (int){rsU21[0][0]},
            'pigliacelli'
        );
    } else {
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
            VALUES (21, $subId, $autistaId, '$loginSql', 2, '$fileSql', $scad21Sql)
        ", 'pigliacelli');
    }
    sc_log_add('AUT_DOCS', "UPSERT 21 $fileSql scad=$scad21Sql");
} elseif ($scad21Sql !== 'NULL') {
    sc_exec_sql("
        UPDATE documenti
        SET data_scadenza = $scad21Sql, updated_at = NOW()
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 21
    ", 'pigliacelli');
}

// --- 30 permesso: file + flag → in_possesso (+ data_scadenza se presente) ---
sc_lookup(rsU30, "
    SELECT id FROM documenti
    WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 30
    ORDER BY id ASC LIMIT 1
", 'pigliacelli');
$idDoc30 = !empty({rsU30[0][0]}) ? (int){rsU30[0][0]} : 0;

$scad30Sql = 'NULL';
if ($scadPerm !== '') {
    $scad30Sql = "'" . str_replace("'", "''", $scadPerm) . "'";
}

if ($fPermesso !== '') {
    $fileSql = str_replace("'", "''", $fPermesso);
    if ($idDoc30 > 0) {
        sc_exec_sql("
            UPDATE documenti
            SET file='$fileSql',
                in_possesso=$flagPoss30,
                data_scadenza=$scad30Sql,
                stato_documento_id=2,
                updated_at=NOW()
            WHERE id=$idDoc30
        ", 'pigliacelli');
    } else {
        sc_exec_sql("
            INSERT INTO documenti (
                tipo_documento_id, subvettore_id, subvettore_autista_id,
                login, stato_documento_id, file, in_possesso, data_scadenza
            ) VALUES (
                30, $subId, $autistaId, '$loginSql', 2, '$fileSql', $flagPoss30, $scad30Sql
            )
        ", 'pigliacelli');
    }
    sc_log_add('AUT_DOCS', "UPSERT 30 file=$fileSql flag=$flagPoss30");
} elseif ($flagPoss30 === 1) {
    if ($idDoc30 > 0) {
        sc_exec_sql("
            UPDATE documenti
            SET in_possesso=1,
                data_scadenza=$scad30Sql,
                updated_at=NOW()
            WHERE id=$idDoc30
        ", 'pigliacelli');
    } else {
        sc_exec_sql("
            INSERT INTO documenti (
                tipo_documento_id, subvettore_id, subvettore_autista_id,
                login, stato_documento_id, in_possesso, data_scadenza
            ) VALUES (
                30, $subId, $autistaId, '$loginSql', 1, 1, $scad30Sql
            )
        ", 'pigliacelli');
    }
    sc_log_add('AUT_DOCS', "UPSERT 30 flag=1 (senza file)");
} else {
    if ($idDoc30 > 0) {
        sc_exec_sql("
            UPDATE documenti
            SET in_possesso=0, updated_at=NOW()
            WHERE id=$idDoc30
        ", 'pigliacelli');
    } else {
        sc_exec_sql("
            INSERT INTO documenti (
                tipo_documento_id, subvettore_id, subvettore_autista_id,
                login, stato_documento_id, in_possesso
            ) VALUES (
                30, $subId, $autistaId, '$loginSql', 1, 0
            )
        ", 'pigliacelli');
    }
    sc_log_add('AUT_DOCS', "UPSERT 30 flag=0");
}

sc_log_add('AUT_DOCS', "FINE onAfterUpdate");
