if (!function_exists('mez_wiz_tipo_id_lr')) {
    function mez_wiz_tipo_id_lr($nome, $fallbackId = 0)
    {
        $nomeSql = str_replace("'", "''", $nome);
        sc_lookup(rsMezTipoLr, "
            SELECT id FROM tipi_documento
            WHERE LOWER(TRIM(nome)) = LOWER(TRIM('$nomeSql'))
            LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsMezTipoLr[0][0]})) {
            return (int){rsMezTipoLr[0][0]};
        }
        return (int)$fallbackId;
    }
}

if (!function_exists('mez_wiz_fill_from_doc')) {
    function mez_wiz_fill_from_doc($mezzoId, $tipoId, &$fileOut, &$scadOut, $wantScad)
    {
        $tipoId = (int)$tipoId;
        $mezzoId = (int)$mezzoId;
        if ($tipoId <= 0 || $mezzoId <= 0) {
            return;
        }
        sc_lookup(rsMezFillDoc, "
            SELECT file, data_scadenza
            FROM documenti
            WHERE subvettore_mezzo_id = $mezzoId
              AND tipo_documento_id = $tipoId
              AND file IS NOT NULL AND TRIM(file) <> ''
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsMezFillDoc[0][0]})) {
            $fileOut = basename(trim((string){rsMezFillDoc[0][0]}));
            if ($wantScad && !empty({rsMezFillDoc[0][1]})) {
                $scadOut = (string){rsMezFillDoc[0][1]};
            }
        }
    }
}

