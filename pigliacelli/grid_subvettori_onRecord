/**
 * grid_subvettori → onRecord
 *
 * 1) Label stato attivo (active_label)
 * 2) Show/hide Action Bar send_credentials_btn
 *
 * IMPORTANTE: per Action Bar NON usare sc_btn_display.
 * Usare sc_actionbar_show / sc_actionbar_hide (come in grid_contratti).
 * Chiamare SEMPRE show o hide su ogni riga (altrimenti resta lo stato della riga prima).
 *
 * Pulsante visibile SOLO se:
 *  - mail_credenziali_inviata_at IS NULL
 *  - E utenza sec_users attiva (group 2) con stesso login
 *
 * Name Action Bar: send_credentials_btn (Ajax)
 */

// --- Label stato ---
if ({su.active} == 'Y') {
    {active_label} = "<p style='margin:0'>Attivo</p>";
} else if ({active} == 'N') {
    {active_label} = "<p style='margin:0'>Contratto non firmato</p>";
} else {
    {active_label} = "<p style='margin:0'>Non attivo</p>";
}

// --- Invia credenziali (Action Bar) ---
$showCredBtn = 0;
$subId = isset({id}) ? (int){id} : 0;
$loginRow = trim((string){login_subvettore});

if ($subId > 0 && $loginRow !== '') {
    $mailVuota = true;

    sc_lookup(rsCredFlag, "
        SELECT mail_credenziali_inviata_at
        FROM subvettori
        WHERE id = $subId
        LIMIT 1
    ", 'pigliacelli');
    if (isset({rsCredFlag[0][0]})
        && {rsCredFlag[0][0]} !== ''
        && {rsCredFlag[0][0]} !== null
        && (string){rsCredFlag[0][0]} !== 'null'
    ) {
        $mailVuota = false;
    }

    $hasActiveUser = false;
    if ($mailVuota) {
        $loginSql = str_replace("'", "''", $loginRow);
        sc_lookup(rsCredUser, "
            SELECT su.login
            FROM sec_users su
            INNER JOIN sec_users_groups sug
                ON sug.login = su.login
               AND sug.group_id = 2
            WHERE su.subvettore_id = $subId
              AND su.login = '$loginSql'
              AND su.active = 'Y'
            LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsCredUser[0][0]})) {
            $hasActiveUser = true;
        }
    }

    if ($mailVuota && $hasActiveUser) {
        $showCredBtn = 1;
    }
}

if ($showCredBtn === 1) {
    sc_actionbar_show('send_credentials_btn');
} else {
    sc_actionbar_hide('send_credentials_btn');
}
