function t0_indice_tratte() {
    $route_map = array();
    $hash_map = array();
    $loc_carico = array();
    $loc_scarico = array();
    sc_lookup(rsT0Loc, "
        SELECT tratta_id, tipo_tratta, localita, progressivo
        FROM tratte_localita
        ORDER BY tratta_id, tipo_tratta, progressivo
    ", "pigliacelli");
    if (!empty({rsT0Loc})) {
        foreach ({rsT0Loc} as $locRow) {
            $tratta_id_loc = (int)$locRow[0];
            $tipo_loc = (string)$locRow[1];
            if ($tipo_loc === 'C') {
                if (!isset($loc_carico[$tratta_id_loc])) $loc_carico[$tratta_id_loc] = array();
                $loc_carico[$tratta_id_loc][] = (string)$locRow[2];
            } else if ($tipo_loc === 'S') {
                if (!isset($loc_scarico[$tratta_id_loc])) $loc_scarico[$tratta_id_loc] = array();
                $loc_scarico[$tratta_id_loc][] = (string)$locRow[2];
            }
        }
    }
    sc_lookup(rsT0Tratte, "
        SELECT id, subvettore_id, tariffa, extra, totale, version, hash
        FROM tratte
    ", "pigliacelli");
    if (!empty({rsT0Tratte})) {
        foreach ({rsT0Tratte} as $trattaRow) {
            $tratta_id = (int)$trattaRow[0];
            $subvettore_id = (int)$trattaRow[1];
            if ($subvettore_id <= 0) continue;
            $carico_str = isset($loc_carico[$tratta_id]) ? implode(' + ', $loc_carico[$tratta_id]) : '';
            $scarico_str = isset($loc_scarico[$tratta_id]) ? implode(' + ', $loc_scarico[$tratta_id]) : '';
            if ($carico_str === '' || $scarico_str === '') continue;
            $hash_val = trim((string)$trattaRow[6]);
            $route_map[$subvettore_id . '|' . $carico_str . '|' . $scarico_str] = array(
                'id' => $tratta_id,
                'tariffa' => $trattaRow[2],
                'extra' => $trattaRow[3],
                'totale' => $trattaRow[4],
                'version' => $trattaRow[5],
                'hash' => $hash_val,
            );
            if ($hash_val !== '') {
                $hash_map[$subvettore_id . '|' . $hash_val] = $tratta_id;
            }
        }
    }
    return array($route_map, $hash_map);
}
function t0_stmt_errore($stmt) {
    $info = $stmt->errorInfo();
    if (!is_array($info) || !isset($info[0]) || $info[0] === '00000' || $info[0] === null || $info[0] === '') {
        return '';
    }
    return trim(isset($info[2]) ? (string)$info[2] : (string)$info[0]);
}
function t0_errore_connessione($msg) {
    $m = strtolower((string)$msg);
    return strpos($m, 'connection') !== false
        || strpos($m, 'communication link') !== false
        || strpos($m, 'login') !== false
        || strpos($m, 'server is not') !== false;
}
function t0_estremi_numeri($pdo, $societa, $anno) {
    $stmt = $pdo->prepare("
        SELECT MIN(NUMERO), MAX(NUMERO)
        FROM T2ViaggiVettori
        WHERE SOCIETA = :societa
          AND ANNO = :anno
    ");
    $stmt->execute(array('societa' => $societa, 'anno' => $anno));
    $row = $stmt->fetch(PDO::FETCH_NUM);
    $stmt->closeCursor();
    if (!$row || $row[0] === null || $row[1] === null) return null;
    return array((int)$row[0], (int)$row[1]);
}
function t0_accumula_localita(&$carichi, &$scarichi, $row) {
    $key = (int)$row[0] . '|' . (int)$row[1];
    $op = trim((string)$row[2]);
    $loc = trim((string)$row[3]);
    if ($loc === '') return;
    if ($op === 'C') {
        if (!isset($carichi[$key])) $carichi[$key] = array();
        $carichi[$key][] = $loc;
    } else if ($op === 'S') {
        if (!isset($scarichi[$key])) $scarichi[$key] = array();
        $scarichi[$key][] = $loc;
    }
}
function t0_leggi_localita_intervallo($pdo, $societa, $anno, $da, $a, &$carichi, &$scarichi, &$skip) {
    if ($da > $a) return;
    if (($a - $da) > 1000) {
        for ($cursor = $da; $cursor <= $a; $cursor += 1001) {
            $fine = $a < ($cursor + 1000) ? $a : ($cursor + 1000);
            t0_leggi_localita_intervallo($pdo, $societa, $anno, $cursor, $fine, $carichi, $scarichi, $skip);
        }
        return;
    }
    $sql = "
        SELECT ANNO, NUMERO, OPERAZIONE, LOCALITA
        FROM T2ViaggiVettoriClienti
        WHERE SOCIETA = :societa
          AND ANNO = :anno
          AND NUMERO >= :da
          AND NUMERO <= :a
          AND OPERAZIONE IN ('C', 'S')
        ORDER BY ANNO, NUMERO, OPERAZIONE, PROGRESSIVO
    ";
    $stmt = null;
    $buffer_carichi = array();
    $buffer_scarichi = array();
    try {
        $stmt = $pdo->prepare($sql);
        $stmt->execute(array('societa' => $societa, 'anno' => $anno, 'da' => $da, 'a' => $a));
        while (($row = $stmt->fetch(PDO::FETCH_NUM)) !== false) {
            t0_accumula_localita($buffer_carichi, $buffer_scarichi, $row);
        }
        $err = t0_stmt_errore($stmt);
        $stmt->closeCursor();
        $stmt = null;
        if ($err !== '') throw new RuntimeException($err);
        foreach ($buffer_carichi as $key => $locs) {
            if (!isset($carichi[$key])) $carichi[$key] = array();
            foreach ($locs as $loc) $carichi[$key][] = $loc;
        }
        foreach ($buffer_scarichi as $key => $locs) {
            if (!isset($scarichi[$key])) $scarichi[$key] = array();
            foreach ($locs as $loc) $scarichi[$key][] = $loc;
        }
    } catch (Throwable $e) {
        if ($stmt instanceof PDOStatement) $stmt->closeCursor();
        if (t0_errore_connessione($e->getMessage())) throw $e;
        if ($da >= $a) {
            $skip[] = $da;
            if (count($skip) <= 8) t0_log('SKIP', 'localita anno=' . $anno . ' numero=' . $da . ' — ' . $e->getMessage());
            return;
        }
        $mid = (int)(($da + $a) / 2);
        t0_leggi_localita_intervallo($pdo, $societa, $anno, $da, $mid, $carichi, $scarichi, $skip);
        t0_leggi_localita_intervallo($pdo, $societa, $anno, $mid + 1, $a, $carichi, $scarichi, $skip);
    }
}
function t0_localita_bulk($pdo, $societa, $anno) {
    $carichi = array();
    $scarichi = array();
    $skip = array();
    $estremi = t0_estremi_numeri($pdo, $societa, $anno);
    if ($estremi !== null) {
        t0_leggi_localita_intervallo($pdo, $societa, $anno, $estremi[0], $estremi[1], $carichi, $scarichi, $skip);
    }
    t0_log('ANNO', $anno . ' localita carichi=' . count($carichi) . ' scarichi=' . count($scarichi) . ' skip=' . count($skip));
    return array($carichi, $scarichi);
}
function t0_extra_bulk($pdo, $societa, $anno) {
    $stmt = $pdo->prepare("
        SELECT ANNO, NUMERO, COALESCE(SUM(IMPORTO_TOTALE), 0)
        FROM T2ViaggiVettoriAddebiti
        WHERE SOCIETA = :societa
          AND ANNO = :anno
        GROUP BY ANNO, NUMERO
    ");
    $stmt->execute(array('societa' => $societa, 'anno' => $anno));
    $map = array();
    while (($row = $stmt->fetch(PDO::FETCH_NUM)) !== false) {
        $map[(int)$row[0] . '|' . (int)$row[1]] = $row[2];
    }
    $stmt->closeCursor();
    return $map;
}
function t0_accumula_allegato(&$map, $row) {
    $key = (int)$row[0] . '|' . (int)$row[1];
    if (!isset($map[$key])) {
        $map[$key] = array(
            'caricatore' => null,
            'proprietario' => null,
            'merce_parts' => array(),
        );
    }
    $c = trim((string)$row[2]);
    if ($map[$key]['caricatore'] === null && $c !== '') $map[$key]['caricatore'] = $c;
    $p = trim((string)$row[3]);
    if ($map[$key]['proprietario'] === null && $p !== '') $map[$key]['proprietario'] = $p;
    $label = t0_merce_label($row[4], $row[5]);
    if ($label !== '' && !in_array($label, $map[$key]['merce_parts'], true)) {
        $map[$key]['merce_parts'][] = $label;
    }
}
function t0_leggi_allegato_intervallo($pdo, $societa, $anno, $da, $a, &$map, &$skip) {
    if ($da > $a) return;
    if (($a - $da) > 1000) {
        for ($cursor = $da; $cursor <= $a; $cursor += 1001) {
            $fine = $a < ($cursor + 1000) ? $a : ($cursor + 1000);
            t0_leggi_allegato_intervallo($pdo, $societa, $anno, $cursor, $fine, $map, $skip);
        }
        return;
    }
    $sql = "
        SELECT
            vc.ANNO,
            vc.NUMERO,
            RTRIM(t.CARICO_RAGIONE_SOCIALE),
            RTRIM(b.RAGIONE_SOCIALE),
            RTRIM(m.MERCE_CODICE),
            RTRIM(m.MERCE_DESCRIZIONE)
        FROM T2ViaggiVettoriClienti vc
        INNER JOIN T2ViaggiClientiCarichiScarichi t
            ON t.SOCIETA = vc.SOCIETA
           AND t.ANNO = vc.CLIENTE_ANNO
           AND t.FILIALE = vc.CLIENTE_FILIALE
           AND t.NUMERO = vc.CLIENTE_NUMERO
           AND t.NUMERO_CARICO_SCARICO = vc.CLIENTE_NUMERO_CARICO_SCARICO
        LEFT JOIN T2ViaggiClienti vcl
            ON vcl.SOCIETA = t.SOCIETA
           AND vcl.ANNO = t.ANNO
           AND vcl.FILIALE = t.FILIALE
           AND vcl.NUMERO = t.NUMERO
        LEFT JOIN BaCliFor b
            ON b.SOCIETA = vcl.SOCIETA
           AND b.CLIENTE_FORNITORE = 'C'
           AND b.CODICE = vcl.CLIENTE
        LEFT JOIN T2ViaggiClientiCarichiScarichiMerci m
            ON m.SOCIETA = t.SOCIETA
           AND m.ANNO = t.ANNO
           AND m.FILIALE = t.FILIALE
           AND m.NUMERO = t.NUMERO
           AND m.NUMERO_CARICO_SCARICO = t.NUMERO_CARICO_SCARICO
        WHERE vc.SOCIETA = :societa
          AND vc.ANNO = :anno
          AND vc.NUMERO >= :da
          AND vc.NUMERO <= :a
          AND vc.OPERAZIONE = 'C'
        ORDER BY vc.ANNO, vc.NUMERO, vc.PROGRESSIVO, m.MERCE_CODICE
    ";
    $stmt = null;
    $buffer = array();
    try {
        $stmt = $pdo->prepare($sql);
        $stmt->execute(array('societa' => $societa, 'anno' => $anno, 'da' => $da, 'a' => $a));
        while (($row = $stmt->fetch(PDO::FETCH_NUM)) !== false) {
            t0_accumula_allegato($buffer, $row);
        }
        $err = t0_stmt_errore($stmt);
        $stmt->closeCursor();
        $stmt = null;
        if ($err !== '') throw new RuntimeException($err);
        foreach ($buffer as $key => $entry) {
            if (!isset($map[$key])) {
                $map[$key] = $entry;
                continue;
            }
            if ($map[$key]['caricatore'] === null && $entry['caricatore'] !== null) $map[$key]['caricatore'] = $entry['caricatore'];
            if ($map[$key]['proprietario'] === null && $entry['proprietario'] !== null) $map[$key]['proprietario'] = $entry['proprietario'];
            foreach ($entry['merce_parts'] as $label) {
                if (!in_array($label, $map[$key]['merce_parts'], true)) $map[$key]['merce_parts'][] = $label;
            }
        }
    } catch (Throwable $e) {
        if ($stmt instanceof PDOStatement) $stmt->closeCursor();
        if (t0_errore_connessione($e->getMessage())) throw $e;
        if ($da >= $a) {
            $skip[] = $da;
            if (count($skip) <= 8) t0_log('SKIP', 'allegato anno=' . $anno . ' numero=' . $da . ' — ' . $e->getMessage());
            return;
        }
        $mid = (int)(($da + $a) / 2);
        t0_leggi_allegato_intervallo($pdo, $societa, $anno, $da, $mid, $map, $skip);
        t0_leggi_allegato_intervallo($pdo, $societa, $anno, $mid + 1, $a, $map, $skip);
    }
}
function t0_allegato_bulk($pdo, $societa, $anno) {
    $map = array();
    $skip = array();
    $estremi = t0_estremi_numeri($pdo, $societa, $anno);
    if ($estremi !== null) {
        t0_leggi_allegato_intervallo($pdo, $societa, $anno, $estremi[0], $estremi[1], $map, $skip);
    }
    $out = array();
    foreach ($map as $key => $entry) {
        $out[$key] = array(
            'caricatore' => $entry['caricatore'],
            'proprietario' => $entry['proprietario'],
            'merce' => count($entry['merce_parts']) > 0 ? implode('; ', $entry['merce_parts']) : null,
        );
    }
    t0_log('ANNO', $anno . ' allegato viaggi=' . count($out) . ' skip=' . count($skip));
    return $out;
}

