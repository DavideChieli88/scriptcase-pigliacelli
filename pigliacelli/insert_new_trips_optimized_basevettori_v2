function t0_log($azione, $messaggio) {
    sc_log_add('EXPORT_TRATTE_T0_' . $azione, (string)$messaggio);
}
function t0_sql_quote($v) {
    if ($v === null) return "NULL";
    return "'" . str_replace("'", "''", (string)$v) . "'";
}
function t0_sql_num($v) {
    if ($v === null || $v === '') return "NULL";
    return (string)(0 + $v);
}
function t0_testo_sql($v) {
    $v = trim((string)$v);
    if ($v === '') return "NULL";
    return t0_sql_quote($v);
}
function t0_split_localita($s) {
    $s = trim((string)$s);
    if ($s === '') return array();
    $parts = preg_split('/\s*\+\s*/', $s);
    $out = array();
    foreach ($parts as $part) {
        $part = trim($part);
        if ($part !== '') $out[] = $part;
    }
    return $out;
}
function t0_norm($s) {
    $s = strtoupper(trim((string)$s));
    return preg_replace('/\s+/', ' ', $s);
}
function t0_hash($carico_str, $scarico_str, $codice_vettore, $importo_unitario) {
    $carichi = array();
    foreach (t0_split_localita($carico_str) as $loc) {
        $carichi[] = t0_norm($loc);
    }
    $scarichi = array();
    foreach (t0_split_localita($scarico_str) as $loc) {
        $scarichi[] = t0_norm($loc);
    }
    $importo = number_format((float)$importo_unitario, 2, '.', '');
    return hash('sha256', implode('|', $carichi) . '#' . implode('|', $scarichi) . '#' . t0_norm($codice_vettore) . '#' . $importo);
}
function t0_importo_valido($value) {
    if ($value === null || (is_string($value) && trim($value) === '') || !is_numeric($value)) {
        return false;
    }
    return round((float)$value, 2) > 0;
}
function t0_merce_label($codice, $descrizione) {
    $codice = trim((string)$codice);
    $descrizione = trim((string)$descrizione);
    if ($codice !== '' && $descrizione !== '') return $codice . ' - ' . $descrizione;
    if ($codice !== '') return $codice;
    if ($descrizione !== '') return $descrizione;
    return '';
}
function t0_ts($value) {
    if ($value === null || $value === '') return PHP_INT_MIN;
    $ts = strtotime((string)$value);
    return $ts === false ? PHP_INT_MIN : $ts;
}
function t0_viaggio_piu_recente($nuovo, $corrente) {
    $nuovo_partenza = t0_ts($nuovo['partenza_data_ora']);
    $corrente_partenza = t0_ts($corrente['partenza_data_ora']);
    if ($nuovo_partenza !== $corrente_partenza) {
        return $nuovo_partenza > $corrente_partenza;
    }
    $nuovo_sync = t0_ts(isset($nuovo['sync_data_ora']) ? $nuovo['sync_data_ora'] : '');
    $corrente_sync = t0_ts(isset($corrente['sync_data_ora']) ? $corrente['sync_data_ora'] : '');
    if ($nuovo_sync !== $corrente_sync) {
        return $nuovo_sync > $corrente_sync;
    }
    if ((int)$nuovo['anno'] !== (int)$corrente['anno']) {
        return (int)$nuovo['anno'] > (int)$corrente['anno'];
    }
    return (int)$nuovo['numero'] > (int)$corrente['numero'];
}
function t0_campo_vuoto($v) {
    return trim((string)$v) === '';
}
function t0_confronto_viaggio($viaggio) {
    return array(
        'partenza_data_ora' => $viaggio['partenza_data_ora'],
        'sync_data_ora' => isset($viaggio['sync_data_ora']) ? $viaggio['sync_data_ora'] : '',
        'anno' => $viaggio['anno'],
        'numero' => $viaggio['numero'],
    );
}
function t0_tieni_allegato(&$dest, $src) {
    $confronto = t0_confronto_viaggio($src);
    foreach (array('caricatore', 'proprietario', 'merce') as $campo) {
        if (t0_campo_vuoto($src[$campo])) continue;
        $src_key = $campo . '_src';
        if (!isset($dest[$src_key]) || t0_viaggio_piu_recente($confronto, $dest[$src_key])) {
            $dest[$campo] = $src[$campo];
            $dest[$src_key] = $confronto;
        }
    }
}
function t0_aggiorna_allegato($tratta_id, $viaggio) {
    $set = array();
    if (!t0_campo_vuoto($viaggio['merce'])) $set[] = "merce = " . t0_testo_sql($viaggio['merce']);
    if (!t0_campo_vuoto($viaggio['caricatore'])) $set[] = "caricatore = " . t0_testo_sql($viaggio['caricatore']);
    if (!t0_campo_vuoto($viaggio['proprietario'])) $set[] = "proprietario_merce = " . t0_testo_sql($viaggio['proprietario']);
    if (count($set) === 0) return false;
    sc_exec_sql("
        UPDATE tratte
        SET " . implode(', ', $set) . "
        WHERE id = " . t0_sql_num($tratta_id) . "
    ", "pigliacelli");
    return true;
}
