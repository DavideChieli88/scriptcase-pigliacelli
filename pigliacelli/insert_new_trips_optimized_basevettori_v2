$nInserite = 0;
$nAggiornate = 0;
$nGiaPresenti = 0;
$nInvariate = 0;
$nSkipImporto = 0;
$nSkipLocalita = 0;
$nSkipSub = 0;
$nAllegato = 0;

try {
for ($anno = $anno_da; $anno <= $anno_a; $anno++) {
    t0_log('ANNO', $anno . ' lettura viaggi');
    $stmt_viaggi->execute(array('societa' => $societa, 'anno' => $anno, 'fine' => $now_data_ora));
    $righe = $stmt_viaggi->fetchAll(PDO::FETCH_NUM);
    $stmt_viaggi->closeCursor();
    $nAnno = count($righe);
    $nLette += $nAnno;
    t0_log('ANNO', $anno . ' viaggi=' . $nAnno);
    if ($nAnno === 0) {
        unset($righe);
        continue;
    }

    t0_log('ANNO', $anno . ' bulk localita');
    $loc_bulk = t0_localita_bulk($pdo, $societa, $anno);
    $carichi_map = $loc_bulk[0];
    $scarichi_map = $loc_bulk[1];
    t0_log('ANNO', $anno . ' bulk extra');
    $extra_map = t0_extra_bulk($pdo, $societa, $anno);
    t0_log('ANNO', $anno . ' bulk allegato');
    $allegato_map = t0_allegato_bulk($pdo, $societa, $anno);

    $unici = array();
    foreach ($righe as $row) {
        $numero = $row[1];
        $codice = trim((string)$row[2]);
        $importo = $row[4];
        $key_viaggio = (int)$row[0] . '|' . (int)$numero;
        $carico = isset($carichi_map[$key_viaggio]) ? implode(' + ', $carichi_map[$key_viaggio]) : '';
        $scarico = isset($scarichi_map[$key_viaggio]) ? implode(' + ', $scarichi_map[$key_viaggio]) : '';
        if ($carico === '' || $scarico === '') {
            $nSkipLocalita++;
            continue;
        }
        if (!t0_importo_valido($importo)) {
            $nSkipImporto++;
            continue;
        }
        $caricatore = null;
        $proprietario = null;
        $merce = null;
        if (isset($allegato_map[$key_viaggio])) {
            $caricatore = $allegato_map[$key_viaggio]['caricatore'];
            $proprietario = $allegato_map[$key_viaggio]['proprietario'];
            $merce = $allegato_map[$key_viaggio]['merce'];
        }
        $viaggio = array(
            'anno' => $row[0],
            'numero' => $numero,
            'codice' => $codice,
            'sigla' => trim((string)$row[3]),
            'importo' => $importo,
            'extra' => isset($extra_map[$key_viaggio]) ? $extra_map[$key_viaggio] : 0,
            'carico' => $carico,
            'scarico' => $scarico,
            'caricatore' => $caricatore,
            'proprietario' => $proprietario,
            'merce' => $merce,
            'partenza_data_ora' => $row[5],
            'sync_data_ora' => $row[6],
        );
        $route_dedup = $codice . '|' . $carico . '|' . $scarico;
        if (!isset($unici[$route_dedup])) {
            $unici[$route_dedup] = $viaggio;
            t0_tieni_allegato($unici[$route_dedup], $viaggio);
        } else if (t0_viaggio_piu_recente($viaggio, $unici[$route_dedup])) {
            $precedente = $unici[$route_dedup];
            $unici[$route_dedup] = $viaggio;
            foreach (array('caricatore', 'proprietario', 'merce') as $campo) {
                $unici[$route_dedup][$campo] = $precedente[$campo];
                $src_key = $campo . '_src';
                if (isset($precedente[$src_key])) $unici[$route_dedup][$src_key] = $precedente[$src_key];
            }
            t0_tieni_allegato($unici[$route_dedup], $viaggio);
        } else {
            t0_tieni_allegato($unici[$route_dedup], $viaggio);
        }
    }
    unset($righe, $loc_bulk, $carichi_map, $scarichi_map, $extra_map, $allegato_map);

    $nCandidati = count($unici);
    t0_log('ANNO', $anno . ' candidati=' . $nCandidati);
    $fatti = 0;
    foreach ($unici as $viaggio) {
        $fatti++;
        if ($fatti === 1 || $fatti % 500 === 0) {
            t0_log('ANNO', $anno . ' upsert ' . $fatti . '/' . $nCandidati . ' inserite=' . $nInserite);
        }
        $codice = $viaggio['codice'];
        if ($codice === '' || !isset($sub_map[$codice])) {
            $nSkipSub++;
            continue;
        }
        $subId = (int)$sub_map[$codice];
        $importo = $viaggio['importo'];
        $extra = $viaggio['extra'];
        if ($extra === null || $extra === false) $extra = 0;
        $totale = (0 + $importo) + (0 + $extra);
        $hash = t0_hash($viaggio['carico'], $viaggio['scarico'], $codice, $importo);
        $hash_key = $subId . '|' . $hash;
        if (isset($hash_map[$hash_key])) {
            $nGiaPresenti++;
            if (t0_aggiorna_allegato((int)$hash_map[$hash_key], $viaggio)) $nAllegato++;
            continue;
        }

        $sigla = strtoupper(trim((string)$viaggio['sigla']));
        $tipoTarSql = "NULL";
        if ($sigla !== '' && isset($tariffe_map[$sigla])) {
            $tipoTarSql = t0_sql_num($tariffe_map[$sigla]);
        }

        $route_key = $subId . '|' . $viaggio['carico'] . '|' . $viaggio['scarico'];
        if (isset($route_map[$route_key])) {
            $exist = $route_map[$route_key];
            $diversa = (
                abs((float)$exist['tariffa'] - (float)$importo) > 0.0001 ||
                abs((float)$exist['extra'] - (float)$extra) > 0.0001 ||
                abs((float)$exist['totale'] - (float)$totale) > 0.0001
            );
            if (!$diversa) {
                $nInvariate++;
                if ($exist['hash'] !== '') $hash_map[$subId . '|' . $exist['hash']] = (int)$exist['id'];
                if (t0_aggiorna_allegato((int)$exist['id'], $viaggio)) $nAllegato++;
                continue;
            }
            $set_allegato = '';
            if (!t0_campo_vuoto($viaggio['merce'])) $set_allegato .= ", merce = " . t0_testo_sql($viaggio['merce']);
            if (!t0_campo_vuoto($viaggio['caricatore'])) $set_allegato .= ", caricatore = " . t0_testo_sql($viaggio['caricatore']);
            if (!t0_campo_vuoto($viaggio['proprietario'])) $set_allegato .= ", proprietario_merce = " . t0_testo_sql($viaggio['proprietario']);
            if ($set_allegato !== '') $nAllegato++;
            sc_exec_sql("
                UPDATE tratte
                SET tipo_tariffa_id = " . $tipoTarSql . ",
                    tariffa = " . t0_sql_num($importo) . ",
                    extra = " . t0_sql_num($extra) . ",
                    totale = " . t0_sql_num($totale) . ",
                    hash = " . t0_sql_quote($hash) . $set_allegato . "
                WHERE id = " . t0_sql_num($exist['id']) . "
            ", "pigliacelli");
            if ($exist['hash'] !== '' && $exist['hash'] !== $hash) {
                unset($hash_map[$subId . '|' . $exist['hash']]);
            }
            $hash_map[$hash_key] = (int)$exist['id'];
            $route_map[$route_key] = array(
                'id' => $exist['id'],
                'tariffa' => $importo,
                'extra' => $extra,
                'totale' => $totale,
                'version' => $exist['version'],
                'hash' => $hash,
            );
            $nAggiornate++;
            continue;
        }

        sc_exec_sql("
            INSERT INTO tratte
              (subvettore_id, merce, caricatore, proprietario_merce, tipo_tariffa_id, tariffa, extra, totale, hash, version, legacy)
            VALUES
              (" . t0_sql_num($subId) . ",
               " . t0_testo_sql($viaggio['merce']) . ",
               " . t0_testo_sql($viaggio['caricatore']) . ",
               " . t0_testo_sql($viaggio['proprietario']) . ",
               " . $tipoTarSql . ",
               " . t0_sql_num($importo) . ",
               " . t0_sql_num($extra) . ",
               " . t0_sql_num($totale) . ",
               " . t0_sql_quote($hash) . ",
               1, 1)
        ", "pigliacelli");
        sc_lookup(rsT0Ins, "SELECT LAST_INSERT_ID()", "pigliacelli");
        if (empty({rsT0Ins}) || (int){rsT0Ins[0][0]} <= 0) {
            t0_log('ERROR', 'LAST_INSERT_ID vuoto sub=' . $subId . ' hash=' . $hash);
            continue;
        }
        $trattaId = (int){rsT0Ins[0][0]};
        $hash_map[$hash_key] = $trattaId;
        $route_map[$route_key] = array(
            'id' => $trattaId,
            'tariffa' => $importo,
            'extra' => $extra,
            'totale' => $totale,
            'version' => 1,
            'hash' => $hash,
        );
        $i = 1;
        foreach (t0_split_localita($viaggio['carico']) as $loc) {
            sc_exec_sql("
                INSERT INTO tratte_localita (tratta_id, tipo_tratta, localita, progressivo)
                VALUES (" . t0_sql_num($trattaId) . ", 'C', " . t0_sql_quote($loc) . ", " . t0_sql_num($i) . ")
            ", "pigliacelli");
            $i++;
        }
        $i = 1;
        foreach (t0_split_localita($viaggio['scarico']) as $loc) {
            sc_exec_sql("
                INSERT INTO tratte_localita (tratta_id, tipo_tratta, localita, progressivo)
                VALUES (" . t0_sql_num($trattaId) . ", 'S', " . t0_sql_quote($loc) . ", " . t0_sql_num($i) . ")
            ", "pigliacelli");
            $i++;
        }
        $nInserite++;
    }
    unset($unici);
    t0_log(
        'ANNO',
        $anno . ' fine inserite=' . $nInserite . ' aggiornate=' . $nAggiornate . ' hash=' . $nGiaPresenti
    );
}

sc_exec_sql("
    UPDATE sec_settings
    SET set_value = " . t0_sql_quote($now_data_ora) . "
    WHERE set_name = 'sync_date'
", "pigliacelli");

$riepilogo = 'lette=' . $nLette
    . ' inserite=' . $nInserite
    . ' aggiornate=' . $nAggiornate
    . ' gia_presenti=' . $nGiaPresenti
    . ' invariate=' . $nInvariate
    . ' skip_importo=' . $nSkipImporto
    . ' skip_localita=' . $nSkipLocalita
    . ' skip_sub_assente=' . $nSkipSub
    . ' allegato=' . $nAllegato
    . ' sync_date=' . $now_data_ora;
t0_log('RIEPILOGO', $riepilogo);

$syncManuale = isset([syncManuale]) ? (int)[syncManuale] : 0;
if ($syncManuale === 1) {
    sc_alert(
        "Import storico T0\n"
        . "Viaggi letti: " . $nLette . "\n"
        . "Tratte legacy inserite: " . $nInserite . "\n"
        . "Tariffe aggiornate: " . $nAggiornate . "\n"
        . "Gia presenti: " . $nGiaPresenti . "\n"
        . "Invariate: " . $nInvariate . "\n"
        . "Scartate (importo): " . $nSkipImporto . "\n"
        . "Scartate (localita): " . $nSkipLocalita . "\n"
        . "Subvettore assente: " . $nSkipSub . "\n"
        . "Allegato aggiornato: " . $nAllegato . "\n"
        . "sync_date: " . $now_data_ora
    );
}

} catch (Throwable $e) {
    t0_log('ERROR', $e->getMessage());
    t0_unlock();
    sc_error_message("Import storico T0 interrotto: " . $e->getMessage());
    return;
}

t0_unlock();
