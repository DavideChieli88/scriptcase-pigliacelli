/**
 * form_documenti_wizard → onAfterUpdate
 *
 * - Forza in DB file (+ scadenza) dopo il Salva SC.
 * - Se onBeforeUpdate ha sostituito il file, usa il nome in sessione.
 *
 * Niente mail/notifica operatori qui: partono solo a fine step 6
 * (Invia per attivazione).
 */

$docId = 0;
if (isset({id}) && (int){id} > 0) {
    $docId = (int){id};
}
$replHint = (!empty($_SESSION['wizard_doc_file_replaced']) ? '1' : '0');
sc_log_add(
    'WIZARD',
    'DOCS onAfterUpdate ENTER doc=' . $docId
    . ' file=[' . trim((string){file}) . ']'
    . ' scad=[' . (isset({data_scadenza}) ? trim((string){data_scadenza}) : '') . ']'
    . ' replaced_sess=' . $replHint
);

if ($docId <= 0) {
    return;
}

$usrLogin = trim((string)[usr_login]);
if ($usrLogin === '' || strcasecmp($usrLogin, 'Guest') === 0) {
    return;
}

$loginSql = str_replace("'", "''", $usrLogin);
sc_lookup(rsWizDocGrp, "
    SELECT sug.group_id
    FROM sec_users_groups sug
    WHERE sug.login = '$loginSql'
      AND sug.group_id = 2
    LIMIT 1
", 'pigliacelli');
if (empty({rsWizDocGrp[0][0]})) {
    return;
}

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}

$replaced = null;
if (!empty($_SESSION['wizard_doc_file_replaced']) && is_array($_SESSION['wizard_doc_file_replaced'])) {
    $replaced = $_SESSION['wizard_doc_file_replaced'];
    unset($_SESSION['wizard_doc_file_replaced']);
    if ((int)$replaced['id'] !== $docId) {
        $replaced = null;
    }
}

$fileNow = trim((string){file});
if ($replaced !== null && !empty($replaced['file'])) {
    $fileNow = basename(str_replace('\\', '/', (string)$replaced['file']));
} elseif ($fileNow !== '') {
    $fileNow = basename(str_replace('\\', '/', $fileNow));
}

if ($fileNow === '') {
    sc_lookup(rsWizDocSt, "
        SELECT COALESCE(file, '')
        FROM documenti
        WHERE id = $docId
        LIMIT 1
    ", 'pigliacelli');
    $fileNow = !empty({rsWizDocSt[0][0]})
        ? basename(str_replace('\\', '/', trim((string){rsWizDocSt[0][0]})))
        : '';
}

// Normalizza data_scadenza → Y-m-d per SQL
$scadRaw = isset({data_scadenza}) ? trim((string){data_scadenza}) : '';
if (strpos($scadRaw, ' ') !== false) {
    $scadRaw = trim(substr($scadRaw, 0, 10));
}
$scadSql = '';
if (preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $scadRaw, $m)) {
    $scadSql = $m[1] . '-' . $m[2] . '-' . $m[3];
} elseif (preg_match('/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/', $scadRaw, $m)) {
    $scadSql = sprintf('%04d-%02d-%02d', (int)$m[3], (int)$m[2], (int)$m[1]);
}

$sets = array(
    'stato_documento_id = 2',
    'is_not_ok = 0',
    'updated_at = NOW()',
);
if ($fileNow !== '') {
    $fileSql = str_replace("'", "''", $fileNow);
    $sets[] = "file = '$fileSql'";
    {file} = $fileNow;
}
if ($scadSql !== '') {
    $sets[] = "data_scadenza = '$scadSql'";
}

// sc_exec_sql("...") in SC: concat/implode PRIMA su variabile PHP.
// Niente COMMIT qui: siamo DENTRO la tx SC (BeginTrans → AfterUpdate → NM_commit_db).
// Un COMMIT/CommitTrans qui → Fatal "There is no active transaction" al commit SC.
$wizSqlForce = 'UPDATE documenti SET ' . implode(', ', $sets) . ' WHERE id = ' . $docId;
sc_exec_sql($wizSqlForce, 'pigliacelli');

$how = $replaced !== null ? 'replace' : 'update';
sc_log_add(
    'WIZARD',
    "DOCS onAfterUpdate done doc=$docId → file=[$fileNow] scad=[$scadSql] ($how)"
);

// Editable grid inline: dopo Salva la griglia padre non si aggiorna da sola
// (persist+COMMIT bypassa parte del refresh SC). Refresh parent + chiudi modale.
$wizApl = isset($this->Ini->nm_cod_apl) ? strtolower((string)$this->Ini->nm_cod_apl) : '';
$wizInline = (
    substr($wizApl, -7) === '_inline'
    || strpos(str_replace('\\', '/', strtolower((string)__FILE__)), '_inline') !== false
);
if ($wizInline) {
    sc_ajax_javascript("
        (function () {
            try {
                var p = window.parent;
                if (p) {
                    if (typeof p.nm_gp_submit === 'function') {
                        try { p.nm_gp_submit('', '', '', false); } catch (e0) {}
                    } else if (typeof p.nm_atualiza === 'function') {
                        try { p.nm_atualiza('igual'); } catch (e1) {}
                    } else if (p.location && typeof p.location.reload === 'function') {
                        try { p.location.reload(); } catch (e2) {}
                    }
                    if (typeof p.tb_remove === 'function') {
                        p.tb_remove();
                        return;
                    }
                }
                if (typeof nm_move === 'function') {
                    nm_move('sai');
                }
            } catch (e) {}
        })();
    ");
}
