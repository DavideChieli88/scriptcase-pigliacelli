$letti_sga   = 0;
$inseriti    = 0;
$saltati     = 0;
$errori      = 0;
$senza_email = 0;
$senza_pec = 0;
$senza_piva  = 0;
$utenze_create = 0;
$utenze_skip_occupato = 0;
$utenze_skip_email = 0;
$bootstrap_ok = 0;

while (($row = $stmt->fetch(PDO::FETCH_NUM)) !== false) {
    $letti_sga++;
    $codice_sga      = $row[0];
    $ragione_sociale = $row[1];
    $indirizzo       = $row[2];
    $sede_citta      = $row[3];
    $sede_prov       = $row[4];
    $phone           = $row[5];
    $cellphone       = $row[6];
    $email_raw       = trim((string)$row[7]);
    $pec             = trim((string)$row[8]);
    $piva            = $row[9];
    $cod_fiscale     = $row[10];

    $email = insert_sub_email_valida($email_raw) ? $email_raw : '';
    if ($email === '') {
        $senza_email++;
    }
    if ($pec === '') {
        $senza_pec++;
    }
    if (trim((string)$piva) === '' && trim((string)$cod_fiscale) === '') {
        $senza_piva++;
    }

    if (isset($codici_esistenti[(string)$codice_sga])) {
        $saltati++;
        continue;
    }

    $login_val = ($email !== '') ? $email : null;
    $phone_utenza = trim((string)$phone);
    if ($phone_utenza === '') {
        $phone_utenza = trim((string)$cellphone);
    }

    $ins = "
      INSERT INTO subvettori
        (login_subvettore, ragione_sociale, cod_fiscale, piva, phone, cellphone,
         indirizzo, sede_citta, sede_prov, codice_sga, pec)
      VALUES
        (" . insert_sub_sql_quote($login_val) . ",
         " . insert_sub_sql_quote($ragione_sociale) . ",
         " . insert_sub_sql_quote($cod_fiscale) . ",
         " . insert_sub_sql_quote($piva) . ",
         " . insert_sub_sql_quote($phone) . ",
         " . insert_sub_sql_quote($cellphone) . ",
         " . insert_sub_sql_quote($indirizzo) . ",
         " . insert_sub_sql_quote($sede_citta) . ",
         " . insert_sub_sql_quote($sede_prov) . ",
         " . insert_sub_sql_quote($codice_sga) . ",
         " . insert_sub_sql_quote($pec !== '' ? $pec : null) . ")
    ";

    try {
        sc_exec_sql($ins, "pigliacelli");
        $codici_esistenti[(string)$codice_sga] = true;
        $inseriti++;

        sc_lookup(rsInsLastSubId, "SELECT LAST_INSERT_ID()", 'pigliacelli');
        $new_sub_id = 0;
        if (!empty({rsInsLastSubId})) {
            $new_sub_id = (int){rsInsLastSubId[0][0]};
        }

        if ($new_sub_id <= 0) {
            log_insert_subvettori('WARN LAST_INSERT_ID assente codice_sga=' . $codice_sga);
            continue;
        }

        if ($email === '') {
            $utenze_skip_email++;
            continue;
        }

        $creata = insert_sub_crea_utenza($new_sub_id, $email, $ragione_sociale, $phone_utenza);
        if ($creata === null) {
            $utenze_skip_occupato++;
            continue;
        }

        if (!empty($creata['gia_esistente'])) {
            insert_sub_aggiorna_login_subvettore($new_sub_id, $email);
        } else {
            $utenze_create++;
            insert_sub_aggiorna_login_subvettore($new_sub_id, $email);
        }
        // Nessuna mail/coda: fuori da send_credenziali_subvettori_batch
        insert_sub_segna_no_coda_mail($new_sub_id);

        if (insert_sub_bootstrap_documenti_from_preset($new_sub_id, $email)) {
            $bootstrap_ok++;
        }
    } catch (Exception $e) {
        $errori++;
        log_insert_subvettori(
            "ERRORE INSERT codice_sga=$codice_sga login=$email — " . $e->getMessage()
        );
    } catch (Throwable $e) {
        $errori++;
        log_insert_subvettori(
            "ERRORE INSERT codice_sga=$codice_sga login=$email — " . $e->getMessage()
        );
    }
}

