// Scriptcase blank: insert_new_subvectors_basevettori
// IMPIANTO INIZIALE (T0) — una tantum, NON il pulsante sync quotidiano.
// Query: SOCIETA=1, ATTIVO='S', almeno 1 viaggio T2ViaggiVettori ANNO>=2024,
// blacklist codici, OR forza 4152/5911/5967. P.IVA/CF da BaCliFor via FORNITORE_*.
// Come upsert: crea sec_users (group 2) + bootstrap documenti.
// NON invia e NON accoda mail credenziali (niente coda / batch automatico).
// A fine run scrive sync_date_subvettori = GETDATE() Sgam (non ora PHP; evita UTC vs Rome).
// Sync continua: upsert_subvectors_basevettori (INSERT_DATA_ORA / UPDATE_DATA_ORA).

function log_insert_subvettori($msg)
{
    sc_log_add('INSERT_SUBVETTORI', (string)$msg);
}

function insert_sub_sql_quote($v)
{
    if ($v === null) {
        return "NULL";
    }
    return "'" . str_replace("'", "''", (string)$v) . "'";
}

function insert_sub_sql_num($v)
{
    if ($v === null || $v === '') {
        return "NULL";
    }
    return (string)(0 + $v);
}

function insert_sub_email_valida($email)
{
    $email = trim((string)$email);
    if ($email === '') {
        return false;
    }
    if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
        return false;
    }
    return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
}

function insert_sub_generate_temp_password()
{
    $characters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_!+-*';
    $charactersLength = strlen($characters);
    $temporaryPassword = '';
    for ($i = 0; $i < 12; $i++) {
        $temporaryPassword .= $characters[random_int(0, $charactersLength - 1)];
    }
    return $temporaryPassword;
}

function insert_sub_login_collegato_a_sub($login, $subvettore_id)
{
    $login = trim((string)$login);
    $subvettore_id = (int)$subvettore_id;
    if ($login === '' || $subvettore_id <= 0) {
        return false;
    }
    sc_lookup(rsInsLoginSub, "
        SELECT login
        FROM sec_users
        WHERE login = " . insert_sub_sql_quote($login) . "
          AND subvettore_id = " . insert_sub_sql_num($subvettore_id) . "
        LIMIT 1
    ", 'pigliacelli');
    return !empty({rsInsLoginSub});
}

function insert_sub_login_usato_da_altro_sub($login, $subvettore_id)
{
    $login = trim((string)$login);
    $subvettore_id = (int)$subvettore_id;
    if ($login === '') {
        return false;
    }
    sc_lookup(rsInsLoginAlt, "
        SELECT subvettore_id
        FROM sec_users
        WHERE login = " . insert_sub_sql_quote($login) . "
        LIMIT 1
    ", 'pigliacelli');
    if (empty({rsInsLoginAlt})) {
        return false;
    }
    $sub_alt = {rsInsLoginAlt[0][0]};
    if ($sub_alt === null || $sub_alt === '') {
        return true;
    }
    return (int)$sub_alt !== $subvettore_id;
}

function insert_sub_crea_utenza($subvettore_id, $email, $ragione_sociale, $phone)
{
    $group_id = 2;
    $email = trim((string)$email);

    if (!insert_sub_email_valida($email)) {
        return null;
    }
    if (insert_sub_login_collegato_a_sub($email, $subvettore_id)) {
        return array('login' => $email, 'gia_esistente' => true);
    }
    if (insert_sub_login_usato_da_altro_sub($email, $subvettore_id)) {
        log_insert_subvettori('UTENZA skip email=' . $email . ' gia login di altro subvettore');
        return null;
    }

    $password_hash = md5(insert_sub_generate_temp_password());

    sc_exec_sql("
        INSERT INTO sec_users (
            login, pswd, name, email, phone, active, subvettore_id
        ) VALUES (
            " . insert_sub_sql_quote($email) . ",
            " . insert_sub_sql_quote($password_hash) . ",
            " . insert_sub_sql_quote($ragione_sociale) . ",
            " . insert_sub_sql_quote($email) . ",
            " . insert_sub_sql_quote($phone) . ",
            'Y',
            " . insert_sub_sql_num($subvettore_id) . "
        )
    ", 'pigliacelli');

    sc_exec_sql("
        INSERT INTO sec_users_groups (login, group_id)
        VALUES (
            " . insert_sub_sql_quote($email) . ",
            " . insert_sub_sql_num($group_id) . "
        )
    ", 'pigliacelli');

    log_insert_subvettori(
        'UTENZA creata subvettore_id=' . (int)$subvettore_id . ' login=' . $email
    );

    return array('login' => $email, 'gia_esistente' => false);
}

function insert_sub_aggiorna_login_subvettore($subvettore_id, $email)
{
    sc_exec_sql("
        UPDATE subvettori
        SET login_subvettore = " . insert_sub_sql_quote($email) . "
        WHERE id = " . insert_sub_sql_num($subvettore_id) . "
    ", 'pigliacelli');
}

function insert_sub_bootstrap_documenti_from_preset($subvettore_id, $login)
{
    $subvettore_id = (int)$subvettore_id;
    $login = trim((string)$login);
    if ($subvettore_id <= 0 || $login === '') {
        return false;
    }
    try {
        sc_exec_sql("
            CALL bootstrap_documenti_from_preset(
                " . insert_sub_sql_num($subvettore_id) . ",
                " . insert_sub_sql_quote($login) . "
            )
        ", 'pigliacelli');
        log_insert_subvettori(
            'CALL bootstrap_documenti_from_preset ok sub=' . $subvettore_id . ' login=' . $login
        );
        return true;
    } catch (Exception $e) {
        log_insert_subvettori(
            'CALL bootstrap_documenti_from_preset ERRORE sub=' . $subvettore_id . ' — ' . $e->getMessage()
        );
        return false;
    } catch (Throwable $e) {
        log_insert_subvettori(
            'CALL bootstrap_documenti_from_preset ERRORE sub=' . $subvettore_id . ' — ' . $e->getMessage()
        );
        return false;
    }
}

/** Evita che send_credenziali_subvettori_batch li prenda (coda = IS NULL). */
function insert_sub_segna_no_coda_mail($subvettore_id)
{
    $subvettore_id = (int)$subvettore_id;
    if ($subvettore_id <= 0) {
        return;
    }
    sc_exec_sql("
        UPDATE subvettori
        SET mail_credenziali_inviata_at = NOW()
        WHERE id = " . insert_sub_sql_num($subvettore_id) . "
    ", 'pigliacelli');
}

/** Ora Sgam (GETDATE), stessa scala di INSERT/UPDATE_DATA_ORA. Formato Y-m-d H:i:s. */
function insert_sub_sga_now($pdo_sga)
{
    try {
        $stmtNow = $pdo_sga->query("SELECT CONVERT(varchar(19), GETDATE(), 120)");
        $rowNow = $stmtNow ? $stmtNow->fetch(PDO::FETCH_NUM) : false;
        if ($stmtNow) {
            $stmtNow->closeCursor();
        }
        if (!empty($rowNow[0])) {
            return trim((string)$rowNow[0]);
        }
    } catch (Throwable $e) {
        log_insert_subvettori('WARN GETDATE SGA fallita: ' . $e->getMessage());
    }
    return date('Y-m-d H:i:s');
}

function connetti_pdo_sga($settings)
{
    $set_names = ['sgam_user', 'sgam_pswd', 'sgam_db', 'sgam_server'];

    foreach ($set_names as $set_name) {
        if (!array_key_exists($set_name, $settings) || trim((string)$settings[$set_name]) === '') {
            log_insert_subvettori("ERRORE parametro sec_settings mancante o vuoto: $set_name");
            sc_error_message("Parametro '" . $set_name . "' non trovato o vuoto in sec_settings.");
            return null;
        }
    }

    try {
        $dsn_sga = "sqlsrv:Server=" . $settings['sgam_server'] .
                   ";Database=" . $settings['sgam_db'] .
                   ";Encrypt=1" .
                   ";TrustServerCertificate=1";

        log_insert_subvettori(
            "Connessione PDO SGA server=" . $settings['sgam_server'] .
            " db=" . $settings['sgam_db'] .
            " user=" . $settings['sgam_user']
        );

        return new PDO(
            $dsn_sga,
            $settings['sgam_user'],
            $settings['sgam_pswd'],
            [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_NUM,
            ]
        );
    } catch (PDOException $e) {
        log_insert_subvettori("ERRORE connessione PDO SGA: " . $e->getMessage());
        sc_error_message("Errore connessione PDO SGA: " . $e->getMessage());
        return null;
    }
}

