/**
 * form_subvettori_contratti
 * → onBeforeUpdate
 *
 * save_and_send_magic_link: flag da cookie (Ajax SC non invia hidden creati via JS).
 * Stato > 2: blocca solo invio magic link, non il salva normale (rappresentante editabile).
 */

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}

$scId = 0;
if (isset({id}) && (int){id} > 0) {
    $scId = (int){id};
} elseif (isset([subvettore_contratto_id]) && (int)[subvettore_contratto_id] > 0) {
    $scId = (int)[subvettore_contratto_id];
}

$statoContrattoBeforeUpd = 0;
if ($scId > 0) {
    sc_lookup(rsStatoContrBeforeUpd, "
        SELECT c.stato_contratto_id
        FROM subvettori_contratti sc
        INNER JOIN contratti c ON c.id = sc.contratto_id
        WHERE sc.id = " . (int)$scId . "
        LIMIT 1
    ", "pigliacelli");
    if (!empty({rsStatoContrBeforeUpd[0][0]})) {
        $statoContrattoBeforeUpd = (int){rsStatoContrBeforeUpd[0][0]};
    }
}

$sendMagicLinkAfter = false;

if (isset($_COOKIE['pigliacelli_send_ml']) && trim((string)$_COOKIE['pigliacelli_send_ml']) === '1') {
    $sendMagicLinkAfter = true;
    setcookie('pigliacelli_send_ml', '', time() - 3600, '/');
}

if (!$sendMagicLinkAfter && isset({send_magic_link_after}) && trim((string){send_magic_link_after}) === '1') {
    $sendMagicLinkAfter = true;
}

if (!$sendMagicLinkAfter && isset($_POST['send_magic_link_after']) && trim((string)$_POST['send_magic_link_after']) === '1') {
    $sendMagicLinkAfter = true;
}

if (!$sendMagicLinkAfter && isset($_REQUEST['send_magic_link_after']) && trim((string)$_REQUEST['send_magic_link_after']) === '1') {
    $sendMagicLinkAfter = true;
}

if ($sendMagicLinkAfter && $scId > 0 && $statoContrattoBeforeUpd > 2) {
    sc_error_message('Il magic link non puo essere inviato: il contratto e gia compilato o oltre.');
    unset($_SESSION['pigliacelli_send_magic_link_after']);
    return;
}

if ($sendMagicLinkAfter) {
    $_SESSION['pigliacelli_send_magic_link_after'] = 1;
    sc_log_add('SAVE_SEND_ML', 'flag catturato onBeforeUpdate scId=' . (int)$scId . ' stato=' . (int)$statoContrattoBeforeUpd);
} else {
    unset($_SESSION['pigliacelli_send_magic_link_after']);
}
