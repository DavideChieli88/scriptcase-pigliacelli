// Scriptcase blank app: web_hook_simulate_check_new_trips
//
// Simula check_new_trips_nuovo_contratto_basevettori_v2 SENZA SGA.
// Non crea il subvettore e non crea utenze: codice_sga deve gia essere in anagrafica.
// Non aggiorna sync_date. Nessuna mail. Stato "Da inviare al subvettore".
// Wizard non completo: le tratte del payload non si importano.
// Alla chiamata successiva, se wizard_complete = 1 e il subvettore non ha nessuna tratta,
// le tratte valide del payload vanno su un solo tipo 1.
// Se ha gia tratte (anche legacy): tipo 2 tratta nuova, tipo 3 tariffa cambiata. Mai un tipo 1.
//
// POST JSON: subvettore.codice_sga + tratte[] (carico, scarico, importo_unitario,
// partenza_data_ora, tariffa_sigla, extra_totale, merce, caricatore, proprietario_merce).
// tipo_contratto_id nel JSON viene ignorato: lo decide la stessa regola del job.
//
// NB: helper definiti come CLOSURE (le function nominate non sono affidabili
// nell evento ScriptCase).

@set_time_limit(0);
@ini_set('memory_limit', '256M');

if (!headers_sent()) {
    header('Content-Type: application/json; charset=UTF-8');
    header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
}

// --- Helper (closure) ---
$wh_sql_quote = function ($v) {
    if ($v === null) {
        return "NULL";
    }
    return "'" . str_replace("'", "''", (string)$v) . "'";
};

$wh_sql_num = function ($v) {
    if ($v === null || $v === '') {
        return "NULL";
    }
    return (string)(0 + $v);
};

$wh_split_localita = function ($s) {
    $s = trim((string)$s);
    if ($s === '') {
        return array();
    }
    $parts = preg_split('/\s*\+\s*/', $s);
    $out = array();
    foreach ($parts as $p) {
        if ($p !== '') {
            $out[] = $p;
        }
    }
    return $out;
};

$wh_normalizza_stringa = function ($s) {
    $s = trim((string)$s);
    $s = strtoupper($s);
    $s = preg_replace('/\s+/', ' ', $s);
    return $s;
};

$wh_crea_hash_tratta = function ($carico_str, $scarico_str, $codice_vettore, $importo_unitario) use ($wh_split_localita, $wh_normalizza_stringa) {
    $carichi = array();
    foreach ($wh_split_localita($carico_str) as $loc) {
        $carichi[] = $wh_normalizza_stringa($loc);
    }
    $scarichi = array();
    foreach ($wh_split_localita($scarico_str) as $loc) {
        $scarichi[] = $wh_normalizza_stringa($loc);
    }
    $carico_norm  = implode('|', $carichi);
    $scarico_norm = implode('|', $scarichi);
    $vettore      = $wh_normalizza_stringa($codice_vettore);
    $importo      = number_format((float)$importo_unitario, 2, '.', '');
    return hash('sha256', $carico_norm . '#' . $scarico_norm . '#' . $vettore . '#' . $importo);
};

$wh_valore = function ($arr, $key, $default = null) {
    if (!is_array($arr) || !array_key_exists($key, $arr)) {
        return $default;
    }
    $v = $arr[$key];
    if (is_string($v)) {
        $v = trim($v);
        if ($v === '') {
            return $default;
        }
    }
    return $v;
};

$wh_respond = function ($httpCode, array $body) {
    if (!headers_sent()) {
        http_response_code($httpCode);
    }
    echo json_encode($body, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT);
    exit;
};

$wh_partenza_data_ora_valida = function ($value) {
    $value = trim((string)$value);
    if ($value === '') {
        return false;
    }
    if ($value === '1900-01-01 00:00:00' || strpos($value, '1900-01-01') === 0) {
        return false;
    }
    return strtotime($value) !== false;
};

$wh_importo_unitario_valido = function ($value) {
    if ($value === null) {
        return false;
    }
    if (is_string($value) && trim($value) === '') {
        return false;
    }
    if (!is_numeric($value)) {
        return false;
    }
    return round((float)$value, 2) > 0;
};

$wh_tratta_ammessa_per_contratto = function ($tr, &$motivo_skip) use ($wh_valore, $wh_partenza_data_ora_valida, $wh_importo_unitario_valido) {
    $motivo_skip = '';
    $partenza = $wh_valore($tr, 'partenza_data_ora');
    $importo = array_key_exists('importo_unitario', $tr) ? $tr['importo_unitario'] : null;

    if (!$wh_partenza_data_ora_valida($partenza)) {
        $motivo_skip = 'partenza_data_ora_mancante';
        return false;
    }
    if (!$wh_importo_unitario_valido($importo)) {
        $motivo_skip = 'importo_unitario_mancante';
        return false;
    }
    return true;
};

$wh_testo_sql = function ($v) use ($wh_sql_quote) {
    $v = trim((string)$v);
    if ($v === '') {
        return 'NULL';
    }
    return $wh_sql_quote($v);
};

$wh_crea_bozza = function ($tipo, $intestatario, $subvettore_id, array $righe) use ($wh_sql_quote, $wh_sql_num) {
    $tipo = (int)$tipo;
    $subvettore_id = (int)$subvettore_id;
    if ($tipo <= 0 || $subvettore_id <= 0 || count($righe) === 0) {
        return 0;
    }

    sc_exec_sql("
        INSERT INTO contratti
          (tipo_contratto_id, intestatario, stato_contratto_id)
        VALUES
          (" . $wh_sql_num($tipo) . ", " . $wh_sql_quote($intestatario) . ",
           (SELECT id FROM stati_contratti WHERE nome = 'Da inviare al subvettore' LIMIT 1))
    ", "pigliacelli");

    sc_lookup(rsWhLastContr, "SELECT LAST_INSERT_ID()", "pigliacelli");
    $contratto_id = empty({rsWhLastContr[0][0]}) ? 0 : (int){rsWhLastContr[0][0]};
    if ($contratto_id <= 0) {
        return 0;
    }

    sc_exec_sql("
        INSERT INTO subvettori_contratti (subvettore_id, contratto_id)
        VALUES (" . $wh_sql_num($subvettore_id) . ", " . $wh_sql_num($contratto_id) . ")
    ", "pigliacelli");

    foreach ($righe as $riga) {
        $tratta_id = (int)$riga['tratta_id'];
        if ($tratta_id <= 0) {
            continue;
        }
        sc_lookup(rsWhCtDup, "
            SELECT id FROM contratti_tratte
            WHERE contratto_id = " . $wh_sql_num($contratto_id) . "
              AND tratta_id = " . $wh_sql_num($tratta_id) . "
            LIMIT 1
        ", "pigliacelli");
        if (!empty({rsWhCtDup})) {
            continue;
        }
        $tipo_tariffa_sql = $riga['tipo_tariffa_id'] === null ? 'NULL' : $wh_sql_num($riga['tipo_tariffa_id']);
        $version = isset($riga['version']) ? (int)$riga['version'] : 1;
        if ($version <= 0) {
            $version = 1;
        }
        sc_exec_sql("
            INSERT INTO contratti_tratte
              (tratta_id, contratto_id, version, carico, scarico, merce, caricatore, proprietario_merce,
               tipo_tariffa_id, tariffa, extra, totale, hash)
            VALUES
              (" . $wh_sql_num($tratta_id) . ", " . $wh_sql_num($contratto_id) . ", " . $wh_sql_num($version) . ",
               " . $wh_sql_quote($riga['carico']) . ", " . $wh_sql_quote($riga['scarico']) . ",
               " . $wh_sql_quote($riga['merce']) . ", " . $wh_sql_quote($riga['caricatore']) . ",
               " . $wh_sql_quote($riga['proprietario_merce']) . ",
               " . $tipo_tariffa_sql . ", " . $wh_sql_num($riga['tariffa']) . ",
               " . $wh_sql_num($riga['extra']) . ", " . $wh_sql_num($riga['totale']) . ",
               " . $wh_sql_quote($riga['hash']) . ")
        ", "pigliacelli");
    }

    return $contratto_id;
};

$wh_righe_tratte = function ($subvettore_id, $solo_ids) use ($wh_sql_num) {
    $subvettore_id = (int)$subvettore_id;
    $filtro_id = '';
    if (is_array($solo_ids)) {
        $ids = array();
        foreach ($solo_ids as $id) {
            $id = (int)$id;
            if ($id > 0) {
                $ids[] = $id;
            }
        }
        if (count($ids) === 0) {
            return array();
        }
        $filtro_id = ' AND t.id IN (' . implode(',', $ids) . ')';
    }

    sc_lookup(rsWhRigheTratte, "
        SELECT
          t.id,
          t.tipo_tariffa_id,
          t.tariffa,
          t.extra,
          t.totale,
          t.hash,
          COALESCE(t.version, 1),
          t.merce,
          t.caricatore,
          t.proprietario_merce,
          (
            SELECT GROUP_CONCAT(tl.localita ORDER BY tl.progressivo SEPARATOR ' + ')
            FROM tratte_localita tl
            WHERE tl.tratta_id = t.id AND tl.tipo_tratta = 'C'
          ),
          (
            SELECT GROUP_CONCAT(tl.localita ORDER BY tl.progressivo SEPARATOR ' + ')
            FROM tratte_localita tl
            WHERE tl.tratta_id = t.id AND tl.tipo_tratta = 'S'
          )
        FROM tratte t
        WHERE t.subvettore_id = " . $wh_sql_num($subvettore_id) . "
          AND t.tariffa IS NOT NULL
          AND t.tariffa > 0
          " . $filtro_id . "
    ", "pigliacelli");

    $righe = array();
    if (!empty({rsWhRigheTratte})) {
        foreach ({rsWhRigheTratte} as $row) {
            $righe[] = array(
                'tratta_id' => (int)$row[0],
                'tipo_tariffa_id' => ($row[1] === null || $row[1] === '') ? null : (int)$row[1],
                'tariffa' => $row[2],
                'extra' => $row[3],
                'totale' => $row[4],
                'hash' => $row[5],
                'version' => (int)$row[6],
                'merce' => $row[7],
                'caricatore' => $row[8],
                'proprietario_merce' => $row[9],
                'carico' => $row[10] === null ? '' : (string)$row[10],
                'scarico' => $row[11] === null ? '' : (string)$row[11],
            );
        }
    }
    return $righe;
};

// --- 1) Lettura payload JSON (più sorgenti per compatibilità ScriptCase/Apache) ---
$rawBody = (string)@file_get_contents('php://input');

if (trim($rawBody) === '' && isset($_POST['payload'])) {
    $rawBody = (string)$_POST['payload'];
}
if (trim($rawBody) === '' && isset($GLOBALS['HTTP_RAW_POST_DATA'])) {
    $rawBody = (string)$GLOBALS['HTTP_RAW_POST_DATA'];
}
if (trim($rawBody) === '' && is_array($_POST) && count($_POST) === 1) {
    $solaChiave = array_keys($_POST)[0];
    $solaValore = $_POST[$solaChiave];
    if (is_string($solaValore) && trim($solaValore) === '' && strpos($solaChiave, '{') === 0) {
        $rawBody = $solaChiave;
    } elseif (is_string($solaValore) && strpos(trim($solaValore), '{') === 0) {
        $rawBody = $solaValore;
    }
}

$rawBody = preg_replace('/^\xEF\xBB\xBF/', '', $rawBody);

$data = json_decode(trim($rawBody), true);
if (!is_array($data)) {
    $diag = array(
        'metodo'        => isset($_SERVER['REQUEST_METHOD']) ? $_SERVER['REQUEST_METHOD'] : '',
        'content_type'  => isset($_SERVER['CONTENT_TYPE']) ? $_SERVER['CONTENT_TYPE'] : '',
        'body_len'      => strlen($rawBody),
        'post_keys'     => is_array($_POST) ? array_keys($_POST) : array(),
        'json_error'    => json_last_error_msg(),
    );
    sc_log_add('WEBHOOK_SIM', 'Payload JSON non valido | ' . json_encode($diag, JSON_UNESCAPED_SLASHES));
    $wh_respond(400, array(
        'ok'    => false,
        'error' => 'Payload JSON mancante o non valido. Inviare un body JSON in POST.',
        'hint'  => 'Se il metodo risulta GET, è un redirect (301) che ha perso il body: usa la URL CON lo slash finale e/o disattiva CURLOPT_FOLLOWLOCATION.',
        'diag'  => $diag,
    ));
}

// --- 2) Sezione subvettore ---
$sub = is_array($wh_valore($data, 'subvettore')) ? $data['subvettore'] : array();

$codice_sga = $wh_valore($sub, 'codice_sga', $wh_valore($sub, 'codice_vettore'));

if ($codice_sga === null) {
    $wh_respond(400, array(
        'ok'    => false,
        'error' => 'subvettore.codice_sga (o codice_vettore) obbligatorio.',
    ));
}

$tratte_in = $wh_valore($data, 'tratte', array());
if (!is_array($tratte_in) || count($tratte_in) === 0) {
    $wh_respond(400, array(
        'ok'    => false,
        'error' => 'Almeno una tratta richiesta in "tratte" (array).',
    ));
}

sc_log_add('WEBHOOK_SIM', 'Avvio simulazione codice_sga=' . $codice_sga . ' tratte=' . count($tratte_in));

sc_lookup(rsSub, "
    SELECT id, COALESCE(wizard_complete, 0), COALESCE(login_subvettore, '')
    FROM subvettori
    WHERE codice_sga = " . $wh_sql_quote($codice_sga) . "
    LIMIT 1
", "pigliacelli");

if (empty({rsSub})) {
    $wh_respond(404, array(
        'ok'         => false,
        'error'      => 'Subvettore non in anagrafica. Lanciare prima upsert_subvectors_basevettori.',
        'codice_sga' => $codice_sga,
    ));
}

$subvettore_id = (int){rsSub[0][0]};
$wizard_complete = (int){rsSub[0][1]};
$login_sub = trim((string){rsSub[0][2]});
$intestatario = $login_sub !== '' ? $login_sub : ('SUBVETTORE_' . $subvettore_id);

sc_lookup(rsHaTratte, "
    SELECT id
    FROM tratte
    WHERE subvettore_id = " . $wh_sql_num($subvettore_id) . "
    LIMIT 1
", "pigliacelli");
$ha_tratte = !empty({rsHaTratte});

if ($wizard_complete !== 1) {
    sc_log_add(
        'WEBHOOK_SIM',
        'wizard_non_completo subvettore=' . $subvettore_id .
        ' codice_sga=' . $codice_sga .
        ' tratte_non_importate=' . count($tratte_in)
    );
    $wh_respond(200, array(
        'ok'                   => true,
        'subvettore_id'        => $subvettore_id,
        'wizard_complete'      => $wizard_complete,
        'contratto_creato'     => false,
        'motivo'               => 'wizard_non_completo',
        'contratto_id'         => null,
        'tipo_contratto_id'    => null,
        'contratti'            => array(),
        'intestatario'         => $intestatario,
        'tratte'               => array(),
        'tratte_skipped'       => array(),
        'tratte_non_importate' => count($tratte_in),
        'test_urls'            => array(),
    ));
}

$tratte_create = array();
$tratte_skipped = array();
$ids_nuove = array();
$ids_modificate = array();

foreach ($tratte_in as $idx => $tr) {
    if (!is_array($tr)) {
        continue;
    }
    $carico_str       = (string)$wh_valore($tr, 'carico', $wh_valore($tr, 'carico_str', ''));
    $scarico_str      = (string)$wh_valore($tr, 'scarico', $wh_valore($tr, 'scarico_str', ''));
    $tariffa_sigla    = $wh_valore($tr, 'tariffa_sigla');
    $importo_raw      = array_key_exists('importo_unitario', $tr) ? $tr['importo_unitario'] : null;
    $extra_totale     = (float)$wh_valore($tr, 'extra_totale', 0);
    $merce            = $wh_valore($tr, 'merce');
    $caricatore       = $wh_valore($tr, 'caricatore');
    $proprietario_merce = $wh_valore($tr, 'proprietario_merce');

    if ($carico_str === '' && $scarico_str === '') {
        continue;
    }

    if (!$wh_importo_unitario_valido($importo_raw)) {
        sc_log_add('WEBHOOK_SIM', 'SKIP importo_non_valido codice_sga=' . $codice_sga);
        $tratte_skipped[] = array(
            'carico' => $carico_str,
            'scarico' => $scarico_str,
            'skip_motivo' => 'importo_unitario_non_valido',
        );
        continue;
    }
    $importo_unitario = round((float)$importo_raw, 2);

    $motivo_skip = '';
    $ammessa_contratto = $wh_tratta_ammessa_per_contratto($tr, $motivo_skip);

    $totale = $importo_unitario + $extra_totale;
    $hash   = $wh_crea_hash_tratta($carico_str, $scarico_str, $codice_sga, $importo_unitario);

    // Mappa sigla tariffa (P/G/F) -> tipo_tariffa_id
    $tipo_tariffa_id = null;
    if ($tariffa_sigla !== null) {
        $tariffa_sigla = strtoupper((string)$tariffa_sigla);
        sc_lookup(rsTipoTar, "SELECT id FROM tipo_tariffe WHERE UPPER(descrizione) = " . $wh_sql_quote($tariffa_sigla) . " LIMIT 1", "pigliacelli");
        if (!empty({rsTipoTar})) {
            $tipo_tariffa_id = (int){rsTipoTar[0][0]};
        }
    }
    $tipo_tariffa_sql = $tipo_tariffa_id === null ? "NULL" : $wh_sql_num($tipo_tariffa_id);

    $tratta_id = 0;
    $tratta_nuova = false;
    $tratta_modificata = false;
    $tratta_version = 1;

    // tratta (riusa se hash gia' presente per il subvettore)
    sc_lookup(rsHash, "
        SELECT id, version FROM tratte
        WHERE hash = " . $wh_sql_quote($hash) . " AND subvettore_id = " . $wh_sql_num($subvettore_id) . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({rsHash})) {
        $tratta_id = (int){rsHash[0][0]};
        $verHash = {rsHash[0][1]};
        $tratta_version = ($verHash === null || $verHash === '') ? 1 : (int)$verHash;
    } else {
        // Stesso carico/scarico ma importo diverso: hash diverso → UPDATE (come check_new_trips).
        sc_lookup(rsExist, "
            SELECT t.id, t.tariffa, t.extra, t.totale, t.version
            FROM tratte t
            WHERE t.subvettore_id = " . $wh_sql_num($subvettore_id) . "
              AND (
                    SELECT GROUP_CONCAT(tl.localita ORDER BY tl.progressivo SEPARATOR ' + ')
                    FROM tratte_localita tl
                    WHERE tl.tratta_id = t.id AND tl.tipo_tratta = 'C'
                  ) = " . $wh_sql_quote($carico_str) . "
              AND (
                    SELECT GROUP_CONCAT(tl.localita ORDER BY tl.progressivo SEPARATOR ' + ')
                    FROM tratte_localita tl
                    WHERE tl.tratta_id = t.id AND tl.tipo_tratta = 'S'
                  ) = " . $wh_sql_quote($scarico_str) . "
            LIMIT 1
        ", "pigliacelli");

        if (!empty({rsExist})) {
            $tratta_id = (int){rsExist[0][0]};
            $importo_esistente = (float){rsExist[0][1]};
            $extra_esistente   = (float){rsExist[0][2]};
            $totale_esistente  = (float){rsExist[0][3]};
            $version_esistente = {rsExist[0][4]};

            $has_modifica_tratta = (
                abs($importo_esistente - (float)$importo_unitario) > 0.0001 ||
                abs($extra_esistente - (float)$extra_totale) > 0.0001 ||
                abs($totale_esistente - (float)$totale) > 0.0001
            );

            if ($has_modifica_tratta) {
                $tratta_modificata = true;
                $tratta_version = ($version_esistente === null || $version_esistente === '')
                    ? 2
                    : ((int)$version_esistente + 1);

                sc_exec_sql("
                    UPDATE tratte
                    SET tipo_tariffa_id = " . $tipo_tariffa_sql . ",
                        tariffa = " . $wh_sql_num($importo_unitario) . ",
                        extra = " . $wh_sql_num($extra_totale) . ",
                        totale = " . $wh_sql_num($totale) . ",
                        hash = " . $wh_sql_quote($hash) . ",
                        version = " . $wh_sql_num($tratta_version) . "
                    WHERE id = " . $wh_sql_num($tratta_id) . "
                ", "pigliacelli");

                sc_log_add(
                    'WEBHOOK_SIM',
                    'tratta_modificata id=' . $tratta_id .
                    ' subvettore=' . $subvettore_id .
                    ' tariffa ' . $importo_esistente . '->' . $importo_unitario .
                    ' version=' . $tratta_version
                );
            } else {
                $tratta_version = ($version_esistente === null || $version_esistente === '')
                    ? 1
                    : (int)$version_esistente;
            }
        } else {
            sc_exec_sql("
                INSERT INTO tratte
                  (subvettore_id, merce, caricatore, proprietario_merce, tipo_tariffa_id, tariffa, extra, totale, hash, version)
                VALUES
                  (" . $wh_sql_num($subvettore_id) . ",
                   " . $wh_testo_sql($merce) . ", " . $wh_testo_sql($caricatore) . ", " . $wh_testo_sql($proprietario_merce) . ",
                   " . $tipo_tariffa_sql . ",
                   " . $wh_sql_num($importo_unitario) . ", " . $wh_sql_num($extra_totale) . ", " . $wh_sql_num($totale) . ",
                   " . $wh_sql_quote($hash) . ", 1)
                ON DUPLICATE KEY UPDATE id = LAST_INSERT_ID(id)
            ", "pigliacelli");

            sc_lookup(rsLastTr, "SELECT LAST_INSERT_ID()", "pigliacelli");
            if (empty({rsLastTr}) || (int){rsLastTr[0][0]} <= 0) {
                continue;
            }
            $tratta_id = (int){rsLastTr[0][0]};
            $tratta_nuova = true;

            $i = 1;
            foreach ($wh_split_localita($carico_str) as $loc) {
                sc_exec_sql("
                    INSERT INTO tratte_localita (tratta_id, tipo_tratta, localita, progressivo)
                    VALUES (" . $wh_sql_num($tratta_id) . ", 'C', " . $wh_sql_quote($loc) . ", " . $wh_sql_num($i) . ")
                ", "pigliacelli");
                $i++;
            }
            $i = 1;
            foreach ($wh_split_localita($scarico_str) as $loc) {
                sc_exec_sql("
                    INSERT INTO tratte_localita (tratta_id, tipo_tratta, localita, progressivo)
                    VALUES (" . $wh_sql_num($tratta_id) . ", 'S', " . $wh_sql_quote($loc) . ", " . $wh_sql_num($i) . ")
                ", "pigliacelli");
                $i++;
            }
        }
    }

    if ($tratta_id <= 0) {
        continue;
    }

    $tratta_info = array(
        'tratta_id' => $tratta_id,
        'carico'    => $carico_str,
        'scarico'   => $scarico_str,
        'totale'    => $totale,
        'modificata'=> $tratta_modificata,
        'version'   => $tratta_version,
        'in_contratto' => $ammessa_contratto,
    );

    if ($ammessa_contratto && $tratta_nuova) {
        $ids_nuove[] = $tratta_id;
    } elseif ($ammessa_contratto && $tratta_modificata) {
        $ids_modificate[] = $tratta_id;
    } elseif (!$ammessa_contratto) {
        sc_log_add(
            'WEBHOOK_SIM',
            'SKIP_CONTR motivo=' . $motivo_skip .
            ' codice_sga=' . $codice_sga .
            ' tratta_id=' . $tratta_id .
            ' partenza=' . (string)$wh_valore($tr, 'partenza_data_ora', '') .
            ' importo_unitario=' . (is_scalar($importo_raw) ? (string)$importo_raw : '')
        );
        $tratta_info['skip_motivo'] = $motivo_skip;
        $tratte_skipped[] = $tratta_info;
    }

    $tratte_create[] = $tratta_info;
}

if (count($tratte_create) === 0) {
    $wh_respond(422, array(
        'ok'             => false,
        'error'          => 'Nessuna tratta salvata. Servono carico o scarico e un importo_unitario maggiore di zero.',
        'subvettore_id'  => $subvettore_id,
        'tratte_skipped' => $tratte_skipped,
    ));
}

$contratti_creati = array();
$motivo = '';

if (!$ha_tratte) {
    $righe_quadro = $wh_righe_tratte($subvettore_id, $ids_nuove);
    $cid = $wh_crea_bozza(1, $intestatario, $subvettore_id, $righe_quadro);
    if ($cid > 0) {
        $contratti_creati[] = array(
            'contratto_id' => $cid,
            'tipo_contratto_id' => 1,
            'tratte' => count($righe_quadro),
        );
        sc_log_add(
            'WEBHOOK_SIM',
            'tipo=1 backfill subvettore=' . $subvettore_id .
            ' contratto=' . $cid .
            ' tratte=' . count($righe_quadro)
        );
    }
    if (count($contratti_creati) === 0) {
        $motivo = 'nessuna_novita_da_firmare';
    }
} else {
    $righe_nuove = $wh_righe_tratte($subvettore_id, $ids_nuove);
    $cid2 = $wh_crea_bozza(2, $intestatario, $subvettore_id, $righe_nuove);
    if ($cid2 > 0) {
        $contratti_creati[] = array(
            'contratto_id' => $cid2,
            'tipo_contratto_id' => 2,
            'tratte' => count($righe_nuove),
        );
    }
    $righe_mod = $wh_righe_tratte($subvettore_id, $ids_modificate);
    $cid3 = $wh_crea_bozza(3, $intestatario, $subvettore_id, $righe_mod);
    if ($cid3 > 0) {
        $contratti_creati[] = array(
            'contratto_id' => $cid3,
            'tipo_contratto_id' => 3,
            'tratte' => count($righe_mod),
        );
    }
    if (count($contratti_creati) === 0) {
        $motivo = 'nessuna_novita_da_firmare';
    }
}

$contratto_id = 0;
$tipo_contratto_id = 0;
if (count($contratti_creati) > 0) {
    $contratto_id = (int)$contratti_creati[0]['contratto_id'];
    $tipo_contratto_id = (int)$contratti_creati[0]['tipo_contratto_id'];
}

sc_lookup(rsBase, "SELECT set_value FROM sec_settings WHERE set_name = 'mail_base_url' LIMIT 1", "pigliacelli");
$baseUrl = empty({rsBase[0][0]}) ? '' : rtrim((string){rsBase[0][0]}, '/');
$test_urls = array();
if ($baseUrl !== '' && $contratto_id > 0) {
    $test_urls = array(
        'finalize' => $baseUrl . '/finalize_contract_subvector/?contrattoId=' . $contratto_id
            . '&subvettoreId=' . $subvettore_id
            . '&tipoContrattoId=' . $tipo_contratto_id,
        'easygn_diretto' => $baseUrl . '/easygn_start_wf_auto/?contrattoId=' . $contratto_id
            . '&subvettoreId=' . $subvettore_id
            . '&tipo_contratto_id=' . $tipo_contratto_id
            . '&tipoContrattoId=' . $tipo_contratto_id
            . '&mode=subvettore&wf_mode=subvettore',
        'send_magic_link_credenziali' => $baseUrl . '/send_magic_link_credenziali/?contrattoId=' . $contratto_id
            . '&subvettoreId=' . $subvettore_id,
    );
}

sc_log_add('WEBHOOK_SIM', 'Completato subvettore=' . $subvettore_id
    . ' wizard=' . $wizard_complete
    . ' ha_tratte=' . ($ha_tratte ? '1' : '0')
    . ' contratti=' . count($contratti_creati)
    . ' motivo=' . $motivo);

$wh_respond(200, array(
    'ok'                => true,
    'subvettore_id'     => $subvettore_id,
    'wizard_complete'   => $wizard_complete,
    'contratto_creato'  => count($contratti_creati) > 0,
    'motivo'            => $motivo,
    'contratto_id'      => $contratto_id > 0 ? $contratto_id : null,
    'tipo_contratto_id' => $tipo_contratto_id > 0 ? $tipo_contratto_id : null,
    'contratti'         => $contratti_creati,
    'intestatario'      => $intestatario,
    'tratte'            => $tratte_create,
    'tratte_skipped'    => $tratte_skipped,
    'test_urls'         => $test_urls,
));
