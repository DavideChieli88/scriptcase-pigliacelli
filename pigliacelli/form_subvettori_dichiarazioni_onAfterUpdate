/**
 * form_subvettori_dichiarazioni → onAfterUpdate
 *
 * Se 5.1, 7.1, 8.1, 9.1 o 9.2 sono Sì, crea lo slot aziendale
 * del tipo già presente in tipi_documento.
 * Risposta No: cancella lo slot solo se non c'è ancora un file.
 *
 * Se la form è stata aperta dalla griglia annuale, torna lì.
 * Il Salva del wizard non imposta dic_return_to: la form resta aperta.
 * Prossimo, dopo una validazione riuscita, apre lo step documenti.
 */

if (!function_exists('dic_wizard_advance_docs')) {
    function dic_wizard_advance_docs($subId)
    {
        $subId = (int)$subId;
        if ($subId <= 0) {
            return;
        }
        sc_exec_sql("
            UPDATE subvettori
            SET wizard_step = 5
            WHERE id = $subId
              AND wizard_complete = 0
              AND wizard_step < 5
        ", 'pigliacelli');
        sc_exec_sql('COMMIT');
        if (session_status() !== PHP_SESSION_ACTIVE) {
            @session_start();
        }
        $_SESSION['wizard_subvettore_id'] = $subId;
        unset($_SESSION['dic_wizard_nav']);
        unset($_SESSION['dic_wizard_go_docs']);
    }
}

if (!function_exists('dic_cert_flag')) {
    function dic_cert_flag($raw)
    {
        $s = trim((string)$raw);
        return ($s === '1') ? 1 : 0;
    }
}

if (!function_exists('dic_cert_sync_slots')) {
    function dic_cert_sync_slots($subId, $login, $slots)
    {
        $subId = (int)$subId;
        if ($subId <= 0 || !is_array($slots)) {
            return;
        }
        $loginSql = str_replace("'", "''", trim((string)$login));

        foreach ($slots as $slot) {
            $nome = isset($slot[0]) ? trim((string)$slot[0]) : '';
            $need = (isset($slot[1]) && (int)$slot[1] === 1) ? 1 : 0;
            if ($nome === '') {
                continue;
            }
            $nomeSql = str_replace("'", "''", $nome);

            sc_lookup(rsDicCertTipo, "
                SELECT id
                FROM tipi_documento
                WHERE LOWER(TRIM(nome)) = LOWER(TRIM('$nomeSql'))
                ORDER BY id ASC
                LIMIT 1
            ", 'pigliacelli');
            $tipoId = (isset({rsDicCertTipo[0][0]}) && (int){rsDicCertTipo[0][0]} > 0)
                ? (int){rsDicCertTipo[0][0]} : 0;
            if ($tipoId <= 0) {
                continue;
            }

            if ($need === 1) {
                sc_lookup(rsDicCertSlot, "
                    SELECT id
                    FROM documenti
                    WHERE subvettore_id = $subId
                      AND tipo_documento_id = $tipoId
                      AND (subvettore_autista_id IS NULL OR subvettore_autista_id = 0)
                      AND (subvettore_mezzo_id IS NULL OR subvettore_mezzo_id = 0)
                    LIMIT 1
                ", 'pigliacelli');
                if (!(isset({rsDicCertSlot[0][0]}) && (int){rsDicCertSlot[0][0]} > 0)) {
                    sc_exec_sql("
                        INSERT INTO documenti (
                            tipo_documento_id, subvettore_id, login, stato_documento_id
                        ) VALUES (
                            $tipoId, $subId, '$loginSql', 1
                        )
                    ", 'pigliacelli');
                }
            } else {
                sc_exec_sql("
                    DELETE FROM documenti
                    WHERE subvettore_id = $subId
                      AND tipo_documento_id = $tipoId
                      AND (subvettore_autista_id IS NULL OR subvettore_autista_id = 0)
                      AND (subvettore_mezzo_id IS NULL OR subvettore_mezzo_id = 0)
                      AND (file IS NULL OR TRIM(file) = '')
                ", 'pigliacelli');
            }
        }
    }
}

$subId = 0;
if (isset({subvettore_id}) && (int){subvettore_id} > 0) {
    $subId = (int){subvettore_id};
} elseif (isset([subvettoreId]) && (int)[subvettoreId] > 0) {
    $subId = (int)[subvettoreId];
} elseif (!empty($_SESSION['wizard_subvettore_id'])) {
    $subId = (int)$_SESSION['wizard_subvettore_id'];
}

$need92 = dic_cert_flag(isset({q_9_2_diagnosi_energetica}) ? {q_9_2_diagnosi_energetica} : '');
dic_cert_sync_slots($subId, [usr_login], array(
    array('Certificato ISO 9001', dic_cert_flag(isset({q_5_1_iso9001}) ? {q_5_1_iso9001} : '')),
    array('Certificato ISO 14001', dic_cert_flag(isset({q_7_1_iso14001}) ? {q_7_1_iso14001} : '')),
    array('Certificato ISO 45001', dic_cert_flag(isset({q_8_1_iso45001}) ? {q_8_1_iso45001} : '')),
    array('Certificato SQAS', dic_cert_flag(isset({q_9_1_sqas}) ? {q_9_1_sqas} : '')),
    array('Diagnosi energetica', $need92),
    array('Attestazione invio ENEA diagnosi energetica', $need92),
));

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}
$goDocs = !empty($_SESSION['dic_wizard_go_docs']);
if (!$goDocs && isset($_COOKIE['dic_go_next']) && (string)$_COOKIE['dic_go_next'] === '1') {
    $goDocs = true;
}
if (!$goDocs && isset($_POST['dic_go_next']) && (string)$_POST['dic_go_next'] === '1') {
    $goDocs = true;
}
if (!$goDocs && isset($_REQUEST['dic_go_next']) && (string)$_REQUEST['dic_go_next'] === '1') {
    $goDocs = true;
}
unset($_SESSION['dic_wizard_go_docs']);
if (isset($_COOKIE['dic_go_next'])) {
    setcookie('dic_go_next', '', time() - 3600, '/');
    unset($_COOKIE['dic_go_next']);
}
if ($goDocs && $subId > 0) {
    dic_wizard_advance_docs($subId);
    [subvettoreId] = $subId;
    sc_redir('form_documenti_wizard', subvettoreId=[subvettoreId]);
}

$back = '';
if (!empty($_SESSION['dic_return_to'])) {
    $back = preg_replace('/[^a-zA-Z0-9_\\-]/', '', (string)$_SESSION['dic_return_to']);
}
if ($back === 'grid_dichiarazioni_subvettore') {
    unset($_SESSION['dic_return_to']);
    if ($subId > 0) {
        [subvettoreId] = $subId;
        sc_redir('grid_dichiarazioni_subvettore', subvettoreId=[subvettoreId]);
    }
}
