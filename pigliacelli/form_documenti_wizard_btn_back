/**
 * form_documenti_wizard → pulsante PHP back_btn_docs (label: Indietro)
 *
 * Torna allo step dichiarazione (pagina intera), non ai mezzi.
 */

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}

$subId = 0;
if (isset([subvettoreId]) && (int)[subvettoreId] > 0) {
    $subId = (int)[subvettoreId];
} elseif (isset($_SESSION['wizard_subvettore_id'])) {
    $subId = (int)$_SESSION['wizard_subvettore_id'];
}
if ($subId <= 0) {
    $_SESSION['wizard_flash_msg'] = 'Subvettore non identificato.';
    sc_redir('blank_wizard_landing');
}

[subvettoreId] = $subId;

$anno = (int)date('Y');
$dicId = 0;
if (!empty($_SESSION['wizard_dichiarazione_id'])) {
    $sessDic = (int)$_SESSION['wizard_dichiarazione_id'];
    if ($sessDic > 0) {
        sc_lookup(rsDocBackSess, "
            SELECT id
            FROM subvettori_dichiarazioni
            WHERE id = $sessDic
              AND subvettore_id = $subId
            LIMIT 1
        ", 'pigliacelli');
        $dicId = !empty({rsDocBackSess[0][0]}) ? (int){rsDocBackSess[0][0]} : 0;
    }
}
if ($dicId <= 0) {
    sc_lookup(rsDocBackDic, "
        SELECT id
        FROM subvettori_dichiarazioni
        WHERE subvettore_id = $subId
          AND anno = $anno
        ORDER BY
            CASE WHEN LOWER(TRIM(COALESCE(stato, ''))) IN ('compilata', 'firmata') THEN 0 ELSE 1 END,
            id DESC
        LIMIT 1
    ", 'pigliacelli');
    $dicId = !empty({rsDocBackDic[0][0]}) ? (int){rsDocBackDic[0][0]} : 0;
}
if ($dicId <= 0) {
    $_SESSION['wizard_flash_msg'] = 'Impossibile riaprire la dichiarazione.';
    sc_redir('form_documenti_wizard', subvettoreId=[subvettoreId]);
}

$_SESSION['wizard_dichiarazione_id'] = $dicId;
$_SESSION['wizard_dichiarazione_anno'] = $anno;
$_SESSION['wizard_subvettore_id'] = $subId;
$_SESSION['dic_wizard_nav'] = 1;
unset($_SESSION['dic_return_to']);

sc_redir('form_subvettori_dichiarazioni', dichiarazioneId=$dicId; subvettoreId=$subId);
