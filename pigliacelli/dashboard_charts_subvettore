<script>
function barColors(count) {
    const colors = [];
    for (let i = 0; i < count; i++) {
        const opacity = 0.18 + ((i / (count - 1)) * 0.82);
        colors.push(`rgba(108, 63, 197, ${opacity.toFixed(2)})`);
    }
    return colors;
}

function creaChart(id, labels, data) {
    new Chart(document.getElementById(id), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                data: data,
                backgroundColor: barColors(data.length),
                borderRadius: 5,
                barThickness: 14
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: {
                        font: { size: 10, family: 'Inter' },
                        color: '#c0b8d8'
                    },
                    border: { display: false }
                },
                y: { display: false }
            },
            responsive: true,
            maintainAspectRatio: false
        }
    });
}

creaChart('chartTratte',    <?= json_encode($mesi_tratte) ?>,    <?= json_encode($valori_tratte) ?>);
