/**
 * Blank blank_magic_link_review_rifiuta → onExecute
 *
 * POST scId + note: rifiuto in review.
 * Imposta stato_contratto_id = 7 e la nota su contratti.notes.
 * Vale solo se il contratto è ancora "Da inviare al subvettore" o "Inviato al subvettore".
 *
 * GET scId / contrattoId, senza nota: pagina di cortesia se il contratto è già rifiutato
 * (riapertura del magic link).
 */

if (!function_exists('ml_review_rifiuta_fail')) {
    function ml_review_rifiuta_fail($msg)
    {
        header('Content-Type: text/html; charset=UTF-8');
        echo '<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8">'
            . '<meta name="viewport" content="width=device-width,initial-scale=1">'
            . '<title>Rifiuto</title>'
            . '<style>'
            . 'body{margin:0;background:#eef1f4;font-family:Arial,Helvetica,sans-serif;color:#2d3748;}'
            . '.wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px 16px;}'
            . '.card{max-width:560px;width:100%;background:#fff;border:1px solid #dde1e6;border-radius:12px;'
            . 'box-shadow:0 8px 24px rgba(26,58,92,.08);padding:28px;font-size:16px;line-height:1.6;}'
            . '</style></head><body><div class="wrap"><div class="card"><p>'
            . htmlspecialchars($msg, ENT_QUOTES, 'UTF-8')
            . '</p></div></div></body></html>';
        exit;
    }
}

if (!function_exists('ml_review_rifiuta_page')) {
    function ml_review_rifiuta_page($contrattoId, $note)
    {
        $safeNote = trim((string)$note);
        header('Content-Type: text/html; charset=UTF-8');
        header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
        echo '<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8">'
            . '<meta name="viewport" content="width=device-width,initial-scale=1">'
            . '<title>Contratto rifiutato</title>'
            . '<style>'
            . 'body{margin:0;padding:0;background:#eef1f4;font-family:Arial,Helvetica,sans-serif;color:#2d3748;}'
            . '.wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px 16px;}'
            . '.card{max-width:560px;width:100%;background:#fff;border:1px solid #dde1e6;border-radius:12px;'
            . 'box-shadow:0 8px 24px rgba(26,58,92,.08);overflow:hidden;}'
            . '.head{padding:22px 28px;background:#fafbfc;border-bottom:1px solid #e8ebef;}'
            . '.head h1{margin:0;font-size:22px;line-height:1.35;color:#1a3a5c;}'
            . '.body{padding:28px;font-size:16px;line-height:1.6;}'
            . '.badge{display:inline-block;margin:0 0 16px;padding:6px 12px;border-radius:999px;'
            . 'background:#fdecea;color:#9b2c2c;font-size:13px;font-weight:bold;}'
            . '.note{margin-top:20px;padding:14px 16px;background:#f7f9fb;border:1px solid #e2e8f0;border-radius:8px;'
            . 'font-size:14px;color:#4a5568;}'
            . '</style></head><body><div class="wrap"><div class="card">'
            . '<div class="head"><h1>Contratto rifiutato</h1></div>'
            . '<div class="body">'
            . '<span class="badge">Rifiutato</span>'
            . '<p>Il contratto è stato rifiutato.</p>'
            . '<p>Non proseguirà con la firma digitale.</p>';
        if ((int)$contrattoId > 0) {
            echo '<p class="note"><strong>Contratto:</strong> #' . (int)$contrattoId . '</p>';
        }
        if ($safeNote !== '') {
            echo '<p class="note"><strong>Motivo:</strong> '
                . htmlspecialchars($safeNote, ENT_QUOTES, 'UTF-8')
                . '</p>';
        }
        echo '<p class="note">Può chiudere questa pagina.</p>'
            . '</div></div></div></body></html>';
        exit;
    }
}

$scId = 0;
if (isset($_POST['scId']) && (int)$_POST['scId'] > 0) {
    $scId = (int)$_POST['scId'];
} elseif (isset($_GET['scId']) && (int)$_GET['scId'] > 0) {
    $scId = (int)$_GET['scId'];
} elseif (isset([scId]) && (int)[scId] > 0) {
    $scId = (int)[scId];
}

$contrattoId = 0;
if (isset($_GET['contrattoId']) && (int)$_GET['contrattoId'] > 0) {
    $contrattoId = (int)$_GET['contrattoId'];
} elseif (isset([contrattoId]) && (int)[contrattoId] > 0) {
    $contrattoId = (int)[contrattoId];
}

$note = '';
if (isset($_POST['note'])) {
    $note = trim((string)$_POST['note']);
}
if (strlen($note) > 2000) {
    $note = substr($note, 0, 2000);
}

if ($scId > 0 && $note !== '') {
    sc_lookup(rsRifiuta, "
        SELECT c.id, COALESCE(st.nome, '')
        FROM subvettori_contratti sc
        INNER JOIN contratti c ON c.id = sc.contratto_id
        LEFT JOIN stati_contratti st ON st.id = c.stato_contratto_id
        WHERE sc.id = " . (int)$scId . "
        LIMIT 1
    ", 'pigliacelli');

    if (empty({rsRifiuta[0][0]})) {
        ml_review_rifiuta_fail('Contratto non trovato.');
    }

    $contrattoId = (int){rsRifiuta[0][0]};
    $statoNome = trim((string){rsRifiuta[0][1]});
    if ($statoNome !== 'Da inviare al subvettore' && $statoNome !== 'Inviato al subvettore') {
        ml_review_rifiuta_fail('Questo contratto non si può più rifiutare da questa pagina.');
    }

    $noteSql = str_replace("'", "''", $note);
    sc_exec_sql("
        UPDATE contratti
        SET stato_contratto_id = 7,
            notes = '" . $noteSql . "'
        WHERE id = " . (int)$contrattoId . "
        LIMIT 1
    ", 'pigliacelli');
    sc_exec_sql('COMMIT');
    sc_log_add('MAGIC_LINK_REVIEW', 'rifiuto review contratto=' . $contrattoId . ' scId=' . $scId);
}

$statoIdNow = 0;
$noteNow = '';
if ($scId > 0) {
    sc_lookup(rsRifiutaNow, "
        SELECT c.id, c.stato_contratto_id, COALESCE(c.notes, '')
        FROM subvettori_contratti sc
        INNER JOIN contratti c ON c.id = sc.contratto_id
        WHERE sc.id = " . (int)$scId . "
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsRifiutaNow[0][0]})) {
        $contrattoId = (int){rsRifiutaNow[0][0]};
        $statoIdNow = (int){rsRifiutaNow[0][1]};
        $noteNow = trim((string){rsRifiutaNow[0][2]});
    }
} elseif ($contrattoId > 0) {
    sc_lookup(rsRifiutaNow, "
        SELECT c.id, c.stato_contratto_id, COALESCE(c.notes, '')
        FROM contratti c
        WHERE c.id = " . (int)$contrattoId . "
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsRifiutaNow[0][0]})) {
        $contrattoId = (int){rsRifiutaNow[0][0]};
        $statoIdNow = (int){rsRifiutaNow[0][1]};
        $noteNow = trim((string){rsRifiutaNow[0][2]});
    }
}

if ((int)$statoIdNow === 7) {
    ml_review_rifiuta_page($contrattoId, $noteNow);
}

if ($note === '') {
    ml_review_rifiuta_fail('Per rifiutare il contratto serve il motivo.');
}

ml_review_rifiuta_fail('Contratto non trovato.');
