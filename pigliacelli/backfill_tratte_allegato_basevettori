    bf_allegato_log('ACCESSO NEGATO user=' . trim((string)[usr_login]));
    sc_error_message('Operazione consentita solo agli amministratori.');
    return;
}

$bf_allegato_run = isset($_GET['run']) && (string)$_GET['run'] === '1';
$bf_allegato_dry_run = isset($_GET['dry_run']) && (string)$_GET['dry_run'] === '1';
$bf_allegato_dry_suffix = $bf_allegato_dry_run ? ' [DRY_RUN]' : '';

