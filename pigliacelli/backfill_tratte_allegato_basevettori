    bf_allegato_mostra_conferma();
    return;
}

bf_allegato_log('START user=' . trim((string)[usr_login]) . $bf_allegato_dry_suffix);

$conn = bf_allegato_connetti_sga();
if ($conn === null) {
    return;
}

$pdo_sga = $conn['pdo'];
$societa = $conn['societa'];
$anno_da = $conn['anno_da'];
$anno_a = (int)date('Y');
if ($anno_da > $anno_a) {
    $anno_a = $anno_da;
}

try {
    $route_map = bf_allegato_costruisci_indice_sga($pdo_sga, $societa, $anno_da, $anno_a);
} catch (PDOException $e) {
    bf_allegato_log('ERRORE indice SGA: ' . $e->getMessage() . $bf_allegato_dry_suffix);
    sc_error_message('Errore lettura SGA: ' . $e->getMessage());
    return;
} catch (Throwable $e) {
    bf_allegato_log('ERRORE indice SGA: ' . $e->getMessage() . $bf_allegato_dry_suffix);
    sc_error_message('Errore lettura SGA: ' . $e->getMessage());
    return;
}

bf_allegato_log(
    'Indice SGA pronto | route_keys=' . count($route_map)
    . ' | anni=' . $anno_da . '..' . $anno_a
    . $bf_allegato_dry_suffix
);

$tratte = bf_allegato_carica_tratte_da_backfill();
bf_allegato_log('Tratte candidate backfill=' . count($tratte) . $bf_allegato_dry_suffix);

$aggiornate = 0;
$senza_match = 0;
$senza_dati_sga = 0;
$errori = 0;

foreach ($tratte as $tratta) {
    $tratta_id = (int)$tratta['id'];
    $route_key = bf_allegato_route_key(
        $tratta['codice_sga'],
        $tratta['carico_str'],
        $tratta['scarico_str']
    );
    $route_label = $tratta['codice_sga'] . '|' . $tratta['carico_str'] . '|' . $tratta['scarico_str'];

    if (!isset($route_map[$route_key])) {
        $senza_match++;
        bf_allegato_log(
            'SKIP no_match tratta=' . $tratta_id
            . ' route=' . $route_label
            . $bf_allegato_dry_suffix
        );
        continue;
    }

    $sga = $route_map[$route_key];
    $nuova_merce = bf_allegato_vuoto($tratta['merce']) ? $sga['merce'] : $tratta['merce'];
    $nuovo_caricatore = bf_allegato_vuoto($tratta['caricatore']) ? $sga['caricatore'] : $tratta['caricatore'];
    $nuovo_proprietario = bf_allegato_vuoto($tratta['proprietario_merce']) ? $sga['proprietario_merce'] : $tratta['proprietario_merce'];

    $ha_nuovo_dato = false;
    if (bf_allegato_vuoto($tratta['merce']) && !bf_allegato_vuoto($nuova_merce)) {
        $ha_nuovo_dato = true;
    }
    if (bf_allegato_vuoto($tratta['caricatore']) && !bf_allegato_vuoto($nuovo_caricatore)) {
        $ha_nuovo_dato = true;
    }
    if (bf_allegato_vuoto($tratta['proprietario_merce']) && !bf_allegato_vuoto($nuovo_proprietario)) {
        $ha_nuovo_dato = true;
    }

    if (!$ha_nuovo_dato) {
        $senza_dati_sga++;
        continue;
    }

    try {
        bf_allegato_aggiorna_tratta(
            $tratta_id,
            $nuova_merce,
            $nuovo_caricatore,
            $nuovo_proprietario,
            $bf_allegato_dry_run
        );
        bf_allegato_aggiorna_contratti_tratte($tratta_id, $bf_allegato_dry_run);
        $aggiornate++;

        bf_allegato_log(
            'OK tratta=' . $tratta_id
            . ' merce=' . (bf_allegato_vuoto($nuova_merce) ? '-' : substr((string)$nuova_merce, 0, 40))
            . ' caric=' . (bf_allegato_vuoto($nuovo_caricatore) ? '-' : substr((string)$nuovo_caricatore, 0, 40))
            . $bf_allegato_dry_suffix
        );
    } catch (Exception $e) {
        $errori++;
        bf_allegato_log('ERRORE tratta=' . $tratta_id . ' — ' . $e->getMessage() . $bf_allegato_dry_suffix);
    } catch (Throwable $e) {
        $errori++;
        bf_allegato_log('ERRORE tratta=' . $tratta_id . ' — ' . $e->getMessage() . $bf_allegato_dry_suffix);
    }
}

$riepilogo = 'END tratte_candidate=' . count($tratte)
    . ' aggiornate=' . $aggiornate
    . ' senza_match_sga=' . $senza_match
    . ' senza_dati_sga=' . $senza_dati_sga
    . ' errori=' . $errori
    . ' route_sga=' . count($route_map)
    . $bf_allegato_dry_suffix;

bf_allegato_log($riepilogo);
sc_log_add('EXPORT_DATA', 'Backfill allegato tratte: ' . $riepilogo);
sc_alert($riepilogo);
