/**
 * form_documenti_wizard → onScriptInit
 *
 * Filtro documenti: in IDE → SQL → Where:
 *   subvettore_id = [subvettoreId]
 *   AND (subvettore_autista_id IS NULL OR subvettore_autista_id = 0)
 *   AND (subvettore_mezzo_id IS NULL OR subvettore_mezzo_id = 0)
 */
sc_btn_display('delete', 'off');

// NON fare COMMIT/reset qui all'ingresso: onScriptInit gira ANCHE nel Salva
// (prima di onValidate) e chiuderebbe la tx di SC → niente onBeforeUpdate.
// COMMIT solo dopo scad-fill griglia (sotto) e in onBeforeUpdate a fine evento.

sc_lookup(rsWizAc, "SELECT @@autocommit, CONNECTION_ID()", 'pigliacelli');
$wizAc = isset({rsWizAc[0][0]}) ? (string){rsWizAc[0][0]} : '?';
$wizCid = isset({rsWizAc[0][1]}) ? (string){rsWizAc[0][1]} : '?';

sc_log_add('WIZARD', 'form_documenti_wizard onScriptInit ENTER');
sc_log_add('WIZARD', 'DOCS build=20261102g noEntryReset ac=' . $wizAc . ' cid=' . $wizCid);

// Modale *_inline: niente UPDATE di massa qui (lascia tx aperta → Salva fallisce
// con "There is already an active transaction" PRIMA di onValidate).
$wizIsInline = false;
$wizPaths = array(
    isset($this->Ini->nm_cod_apl) ? (string)$this->Ini->nm_cod_apl : '',
    (string)__FILE__,
    isset($_SERVER['PHP_SELF']) ? (string)$_SERVER['PHP_SELF'] : '',
    isset($_SERVER['SCRIPT_NAME']) ? (string)$_SERVER['SCRIPT_NAME'] : '',
);
foreach ($wizPaths as $wp) {
    $wp = str_replace('\\', '/', strtolower($wp));
    if ($wp !== '' && (
        substr($wp, -7) === '_inline'
        || strpos($wp, '_inline/') !== false
        || strpos($wp, '_inline.') !== false
        || strpos($wp, '_inline_') !== false
    )) {
        $wizIsInline = true;
        break;
    }
}
sc_log_add('WIZARD', 'DOCS onScriptInit inline=' . ($wizIsInline ? '1' : '0'));

if (!isset([subvettoreId]) || (int)[subvettoreId] <= 0) {
    $usrLogin = trim((string)[usr_login]);
    if ($usrLogin !== '') {
        $usrSql = str_replace("'", "''", $usrLogin);
        sc_lookup(rsWizResolveSub, "
            SELECT COALESCE(
                (SELECT su.subvettore_id
                 FROM sec_users su
                 INNER JOIN sec_users_groups sug ON sug.login = su.login
                 WHERE su.login = '$usrSql'
                   AND su.active = 'Y'
                   AND sug.group_id = 2
                   AND su.subvettore_id > 0
                 LIMIT 1),
                (SELECT s.id
                 FROM subvettori s
                 WHERE TRIM(s.login_subvettore) = '$usrSql'
                 LIMIT 1)
            ) AS sub_id
        ", 'pigliacelli');
        if (!empty({rsWizResolveSub[0][0]})) {
            [subvettoreId] = (int){rsWizResolveSub[0][0]};
        }
    }
}

if ((int)[subvettoreId] > 0) {
    if (session_status() !== PHP_SESSION_ACTIVE) {
        @session_start();
    }
    $_SESSION['wizard_subvettore_id'] = (int)[subvettoreId];
}

$logSubId = (int)[subvettoreId];
sc_log_add('WIZARD', 'form_documenti_wizard subvettoreId=' . $logSubId);

if ((int)[subvettoreId] <= 0) {
    sc_error_message('Subvettore non associato al tuo account. Contattare Pigliacelli.');
    sc_redir('blank_wizard_landing');
}

// Gli slot ANGA/RENTRI li creano onAfterInsert / onAfterUpdate del mezzo.
// Qui si riempiono le scadenze fisse ancora vuote (ANGA/RENTRI 30/04, Albo 31/01).
// Solo griglia (non inline): gli UPDATE con pconnect lasciano tx aperta e il Salva
// della modale muore prima di onValidate (nessun log DOCS onValidate).
if (!$wizIsInline && (int)[subvettoreId] > 0) {
    $yFix = (int)date('Y');
    $scad0430 = sprintf('%04d-04-30', $yFix);
    if (date('Y-m-d') >= $scad0430) {
        $scad0430 = sprintf('%04d-04-30', $yFix + 1);
    }
    $scad0131 = sprintf('%04d-01-31', $yFix);
    if (date('Y-m-d') >= $scad0131) {
        $scad0131 = sprintf('%04d-01-31', $yFix + 1);
    }
    $subFix = (int)[subvettoreId];
    $whereVuota = "
          AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
          AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
          AND (
              d.data_scadenza IS NULL
              OR d.data_scadenza = '0000-00-00'
              OR d.data_scadenza = '0000-00-00 00:00:00'
          )
    ";
    sc_exec_sql("
        UPDATE documenti d
        INNER JOIN tipi_documento t ON t.id = d.tipo_documento_id
        SET d.data_scadenza = '$scad0430'
        WHERE d.subvettore_id = $subFix
          AND (
                LOWER(TRIM(t.nome)) LIKE 'ricevuta pagamento anga%'
             OR LOWER(TRIM(t.nome)) LIKE 'ricevuta pagamento rentri%'
          )
          $whereVuota
    ", 'pigliacelli');
    sc_exec_sql("
        UPDATE documenti d
        INNER JOIN tipi_documento t ON t.id = d.tipo_documento_id
        SET d.data_scadenza = '$scad0131'
        WHERE d.subvettore_id = $subFix
          AND LOWER(TRIM(t.nome)) LIKE '%ricevuta%'
          AND LOWER(TRIM(t.nome)) LIKE '%albo%'
          AND LOWER(TRIM(t.nome)) LIKE '%conto terzi%'
          $whereVuota
    ", 'pigliacelli');
    try {
        sc_exec_sql('COMMIT', 'pigliacelli');
    } catch (Throwable $e) {
        // ok
    }
    sc_log_add('WIZARD', 'DOCS onScriptInit scad-fill+COMMIT sub=' . $subFix);
}

// Filtro elenco: NON usare sc_where() (non esiste / non espande → Fatal error).
// In ScriptCase → SQL → Where della form mettere ESATTAMENTE:
//   subvettore_id = [subvettoreId]
//   AND (subvettore_autista_id IS NULL OR subvettore_autista_id = 0)
//   AND (subvettore_mezzo_id IS NULL OR subvettore_mezzo_id = 0)
// [subvettoreId] deve essere valorizzato in onApplicationInit (già presente).

sc_lookup(rsDocWizGrp, "
    SELECT 1
    FROM sec_users_groups sug
    INNER JOIN sec_users su ON su.login = sug.login
    WHERE su.login = '[usr_login]'
      AND sug.group_id = 2
    LIMIT 1
", 'pigliacelli');

if (!empty({rsDocWizGrp[0][0]})) {
    sc_btn_display('new', 'off');
    sc_field_display({login}, 'off');
    sc_field_display({is_not_ok}, 'off');
    sc_field_display({subvettore_id}, 'off');
    {login} = [usr_login];

    if ((int)[subvettoreId] > 0) {
        {subvettore_id} = (int)[subvettoreId];
    }
}

// Flash da pulsante Completa wizard (niente sc_alert/JS)
if (!empty($_SESSION['wizard_flash_msg'])) {
    $flashMsg = (string)$_SESSION['wizard_flash_msg'];
    unset($_SESSION['wizard_flash_msg']);
    sc_error_message($flashMsg);
}

// Griglia: la colonna si nasconde qui. In onLoad non basta, sc_field_display
// lì non toglie la colonna della editable grid.
sc_field_display({in_possesso}, 'off');

// Niente sc_btn_display qui: spegnerebbe Chiudi anche nella modale.
// Prossimo, Indietro e btn_chiudi_modale si gestiscono in onLoad.
