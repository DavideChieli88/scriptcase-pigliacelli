 * Non usare sc_error_exit (modale).
 * Macro SC: niente spazi dentro le graffe.
 */

if (!function_exists('dic_si_no')) {
    function dic_si_no($raw)
    {
        if ($raw === null) {
            return null;
        }
        $s = trim((string)$raw);
        if ($s === '' || strcasecmp($s, 'null') === 0 || strcasecmp($s, 'undefined') === 0) {
            return null;
        }
        if ($s === '1') {
            return 1;
        }
        if ($s === '0') {
            return 0;
        }
        return null;
    }
}
if (!function_exists('dic_filled')) {
    function dic_filled($raw)
    {
        if ($raw === null) {
            return false;
        }
        $s = trim((string)$raw);
        if ($s === '' || strcasecmp($s, 'null') === 0 || strpos($s, '0000-00-00') === 0) {
            return false;
        }
        return true;
    }
}
if (!function_exists('dic_flag')) {
    function dic_flag($raw)
    {
        $s = strtolower(trim((string)$raw));
        return ($s === '1' || $s === 'y' || $s === 'on' || $s === 's') ? 1 : 0;
    }
}
if (!function_exists('dic_need_sino')) {
    function dic_need_sino($label, $raw, &$missing)
    {
        if (dic_si_no($raw) === null) {
            $missing[] = $label;
        }
    }
}
if (!function_exists('dic_need_text')) {
    function dic_need_text($label, $raw, &$missing)
