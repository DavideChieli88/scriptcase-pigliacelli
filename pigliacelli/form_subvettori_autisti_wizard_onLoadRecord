/**
 * form_subvettori_autisti_wizard → onLoadRecord
 *
 * Precarica docs virtuali PER RIGA (editable grid).
 * La modale *_inline spesso NON esegue questo evento → fallback in onLoad (id>0).
 *
 * Quirk SC Document: dopo sc_redir (Avanti/Indietro) i widget Document restano
 * vuoti anche se {patente}=nomefile è valorizzato. I campi Text *_info invece
 * si vedono sempre. Setup IDE:
 *   - Virtuali Text (sola lettura): patente_info, cqc_info, idoneita_sanitaria_info,
 *     formazione_sicurezza_info, dpi_iii_categoria_info, permesso_soggiorno_info
 *   - In View griglia: mostra le colonne *_info; i Document possono restare nascosti
 *     in grid (visibili solo in Form/modale per l'upload).
 */

$autistaId = isset({id}) ? (int){id} : 0;
sc_log_add('AUT_LOAD', "onLoadRecord START id=$autistaId");

if (!function_exists('aut_wiz_info_label')) {
    function aut_wiz_info_label($file)
    {
        $file = trim((string)$file);
        return ($file !== '') ? $file : '—';
    }
}

if ($autistaId <= 0) {
    {idoneita_sanitaria} = '';
    {patente} = '';
    {cqc} = '';
    {formazione_sicurezza} = '';
    {dpi_iii_categoria} = '';
    {permesso_soggiorno} = '';
    {permesso_soggiorno_flag} = 0;
    {scadenza_permesso_soggiorno} = '';
    {idoneita_sanitaria_info} = '—';
    {patente_info} = '—';
    {cqc_info} = '—';
    {formazione_sicurezza_info} = '—';
    {dpi_iii_categoria_info} = '—';
    {permesso_soggiorno_info} = '—';
    sc_log_add('AUT_LOAD', 'onLoadRecord NEW → flag=0, docs vuoti');
} else {

    sc_lookup(rsL18, "
        SELECT file FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 18
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    {idoneita_sanitaria} = !empty({rsL18[0][0]}) ? basename(trim((string){rsL18[0][0]})) : '';

    sc_lookup(rsL19a, "
        SELECT file FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 19
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    {patente} = !empty({rsL19a[0][0]}) ? basename(trim((string){rsL19a[0][0]})) : '';

    $tipoCqc = 0;
    sc_lookup(rsTipoCqcL, "
        SELECT id FROM tipi_documento
        WHERE LOWER(TRIM(nome)) = LOWER(TRIM('CQC autisti (fronte/retro)'))
        LIMIT 1
    ", 'pigliacelli');
    $tipoCqc = !empty({rsTipoCqcL[0][0]}) ? (int){rsTipoCqcL[0][0]} : 0;
    {cqc} = '';
    if ($tipoCqc > 0) {
        sc_lookup(rsLCqc, "
            SELECT file FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = $tipoCqc
              AND file IS NOT NULL AND TRIM(file) <> ''
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        {cqc} = !empty({rsLCqc[0][0]}) ? basename(trim((string){rsLCqc[0][0]})) : '';
    }

    sc_lookup(rsL20, "
        SELECT file FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 20
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    {formazione_sicurezza} = !empty({rsL20[0][0]}) ? basename(trim((string){rsL20[0][0]})) : '';

    sc_lookup(rsL21, "
        SELECT file FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 21
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    {dpi_iii_categoria} = !empty({rsL21[0][0]}) ? basename(trim((string){rsL21[0][0]})) : '';

    sc_lookup(rsL30, "
        SELECT file, in_possesso, data_scadenza
        FROM documenti
        WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 30
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');

    $file30 = '';
    if (!empty({rsL30[0][0]})) {
        $file30 = basename(trim((string){rsL30[0][0]}));
    }
    {permesso_soggiorno} = $file30;

    $inPoss30 = 0;
    if (isset({rsL30[0][1]}) && {rsL30[0][1]} !== '' && {rsL30[0][1]} !== null && (string){rsL30[0][1]} !== 'null') {
        $inPoss30 = ((int){rsL30[0][1]} === 1) ? 1 : 0;
    }
    if ($inPoss30 === 1 || $file30 !== '') {
        {permesso_soggiorno_flag} = 1;
    } else {
        {permesso_soggiorno_flag} = 0;
    }

    $scad30 = isset({scadenza_permesso_soggiorno}) ? trim((string){scadenza_permesso_soggiorno}) : '';
    if (($scad30 === '' || $scad30 === 'null') && !empty({rsL30[0][2]})) {
        {scadenza_permesso_soggiorno} = trim((string){rsL30[0][2]});
    }

    {idoneita_sanitaria_info} = aut_wiz_info_label({idoneita_sanitaria});
    {patente_info} = aut_wiz_info_label({patente});
    {cqc_info} = aut_wiz_info_label({cqc});
    {formazione_sicurezza_info} = aut_wiz_info_label({formazione_sicurezza});
    {dpi_iii_categoria_info} = aut_wiz_info_label({dpi_iii_categoria});
    {permesso_soggiorno_info} = aut_wiz_info_label($file30);

    sc_log_add(
        'AUT_LOAD',
        'onLoadRecord OK'
        . ' pat=[' . (string){patente} . ']'
        . ' cqc=[' . (string){cqc} . ']'
        . ' idon=[' . (string){idoneita_sanitaria} . ']'
        . ' form=[' . (string){formazione_sicurezza} . ']'
        . ' dpi=[' . (string){dpi_iii_categoria} . ']'
        . ' perm=[' . $file30 . ']'
        . ' flag=' . (int){permesso_soggiorno_flag}
    );
}

$flagPermesso = {permesso_soggiorno_flag};
if ($flagPermesso === '' || $flagPermesso === null || $flagPermesso === 'undefined' || $flagPermesso === 'null') {
    $flagPermesso = 0;
}
$flagPermesso = ((int)$flagPermesso === 1) ? 1 : 0;
{permesso_soggiorno_flag} = $flagPermesso;

// In griglia NON nascondere per-riga i Document (sc_field_display in onLoadRecord
// spesso spegne la colonna per TUTTE le righe). Show/hide solo in modale (onLoad).
