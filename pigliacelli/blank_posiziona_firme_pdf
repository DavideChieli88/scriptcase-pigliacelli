    <button type="button" class="btn btn-save" id="btnSave">Salva</button>
    <button type="button" class="btn btn-exit" id="btnExit">Esci</button>
  </div>
</div>
<div class="err-banner" id="errBanner"></div>
<div class="hint-bar">Clicca sul firmatario per aggiungere un riquadro; trascinalo anche sulle pagine successive</div>
<div class="chips" id="chips"></div>
<div class="viewer" id="viewer"></div>
<div class="toast" id="toast"></div>
<script>
window.BPF_CFG = <?php echo $cfgJson; ?>;
</script>
<script>
(function () {
  var cfg = window.BPF_CFG || {};
  var pageMmW = (cfg.pageMm && cfg.pageMm.w) || 210;
  var pageMmH = (cfg.pageMm && cfg.pageMm.h) || 297;
  var defW = (cfg.defaultMm && cfg.defaultMm.w) || 45;
  var defH = (cfg.defaultMm && cfg.defaultMm.h) || 14;
  var boxes = [];
  var pageViews = {};
  var boxSeq = 1;
  var currentPage = 1;

  function $(id) { return document.getElementById(id); }
  function toast(msg) {
    var el = $('toast');
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(function () { el.classList.remove('show'); }, 2200);
  }
  function showErr(msg) {
    var el = $('errBanner');
    el.style.display = 'block';
    el.textContent = msg;
  }

  document.getElementById('docTitle').textContent = cfg.title || '';

  function roleCount(role) {
    var n = 0;
    for (var i = 0; i < boxes.length; i++) if (boxes[i].role === role) n++;
    return n;
  }

  function refreshChips() {
    var host = $('chips');
    host.innerHTML = '';
    (cfg.signers || []).forEach(function (s) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip' + (roleCount(s.role) ? ' has-boxes' : '');
      btn.innerHTML = s.label + '<span class="cnt">' + roleCount(s.role) + '</span>';
      btn.addEventListener('click', function () { addBox(s.role, s.label); });
      host.appendChild(btn);
    });
  }

  function mmToCss(page, mmX, mmY, mmW, mmH) {
    var pv = pageViews[page];
    if (!pv) return { left: 0, top: 0, width: 40, height: 20 };
    return {
      left: (mmX / pageMmW) * pv.cssW,
      top: (mmY / pageMmH) * pv.cssH,
      width: (mmW / pageMmW) * pv.cssW,
      height: (mmH / pageMmH) * pv.cssH
    };
  }

  function cssToMm(page, left, top, width, height) {
    var pv = pageViews[page];
    if (!pv || !pv.cssW || !pv.cssH) {
      return { x: 0, y: 0, w: defW, h: defH };
    }
    // Niente floor 13.1mm qui: era il min EasyGN e al reload "rigonfiava" i box ristretti.
    // L'altezza minima API (37pt ≈ 13.1mm) si applica in easygn_start_wf in invio.
    return {
      x: Math.max(0, (left / pv.cssW) * pageMmW),
      y: Math.max(0, (top / pv.cssH) * pageMmH),
      w: Math.max(4, (width / pv.cssW) * pageMmW),
      h: Math.max(3, (height / pv.cssH) * pageMmH)
    };
  }

  function syncBoxDom(b) {
    var el = document.getElementById(b.id);
    if (!el) return;
    var c = mmToCss(b.page, b.x, b.y, b.w, b.h);
    el.style.left = c.left + 'px';
    el.style.top = c.top + 'px';
    el.style.width = c.width + 'px';
    el.style.height = c.height + 'px';
  }

  function removeBox(id) {
    boxes = boxes.filter(function (b) { return b.id !== id; });
    var el = document.getElementById(id);
    if (el && el.parentNode) el.parentNode.removeChild(el);
    refreshChips();
  }

  function findPageAtClientY(clientY) {
    var best = 1;
    var bestDist = Infinity;
    Object.keys(pageViews).forEach(function (p) {
      var num = parseInt(p, 10);
      var st = pageViews[num] && pageViews[num].stage;
      if (!st) return;
      var r = st.getBoundingClientRect();
      if (clientY >= r.top && clientY <= r.bottom) {
        best = num;
        bestDist = -1;
        return;
      }
      if (bestDist < 0) return;
      var mid = (r.top + r.bottom) / 2;
      var d = Math.abs(clientY - mid);
      if (d < bestDist) {
        bestDist = d;
        best = num;
      }
    });
    return best;
  }

  function autoScrollDuringDrag(clientY) {
    var edge = 72;
    var step = 28;
    var vh = window.innerHeight || document.documentElement.clientHeight;
    if (clientY < edge) {
      window.scrollBy(0, -step);
    } else if (clientY > vh - edge) {
      window.scrollBy(0, step);
    }
  }

  function placeBoxAtClient(el, box, clientX, clientY) {
    var page = findPageAtClientY(clientY);
    var pv = pageViews[page];
    if (!pv || !pv.stage) return;

    var rect = pv.stage.getBoundingClientRect();
    var w = el.offsetWidth || 80;
    var h = el.offsetHeight || 36;
    var left = clientX - rect.left - w / 2;
    var top = clientY - rect.top - h / 2;
    left = Math.min(Math.max(0, left), Math.max(0, pv.cssW - w));
    top = Math.min(Math.max(0, top), Math.max(0, pv.cssH - h));

    if (box.page !== page) {
      box.page = page;
      pv.layer.appendChild(el);
      currentPage = page;
    }
    el.style.left = left + 'px';
    el.style.top = top + 'px';
    var mm = cssToMm(page, left, top, w, h);
    box.x = mm.x; box.y = mm.y; box.w = mm.w; box.h = mm.h;
  }

  function bindInteract(el, box) {
    if (!window.interact) return;
    interact(el).draggable({
      listeners: {
        move: function (event) {
          var clientX = event.clientX;
          var clientY = event.clientY;
          if (typeof clientX !== 'number' && event.pageX != null) {
            clientX = event.pageX - (window.scrollX || window.pageXOffset || 0);
            clientY = event.pageY - (window.scrollY || window.pageYOffset || 0);
          }
          // fallback se interact non passa client*
          if (typeof clientX !== 'number') {
            clientX = (event.client && event.client.x) || 0;
            clientY = (event.client && event.client.y) || 0;
          }
          autoScrollDuringDrag(clientY);
          placeBoxAtClient(el, box, clientX, clientY);
        }
      },
      inertia: false
    }).resizable({
      edges: { right: true, bottom: true, left: false, top: false },
      listeners: {
        move: function (event) {
          var left = parseFloat(el.style.left) || 0;
          var top = parseFloat(el.style.top) || 0;
          var w = event.rect.width;
          var h = event.rect.height;
          var pv = pageViews[box.page];
          if (pv) {
            w = Math.min(w, pv.cssW - left);
            h = Math.min(h, pv.cssH - top);
          }
          el.style.width = w + 'px';
          el.style.height = h + 'px';
          var mm = cssToMm(box.page, left, top, w, h);
          box.x = mm.x; box.y = mm.y; box.w = mm.w; box.h = mm.h;
        }
      },
      modifiers: [
        interact.modifiers.restrictSize({ min: { width: 24, height: 14 } })
      ]
    });
  }

  function renderBox(b) {
    var pv = pageViews[b.page];
    if (!pv) return;
    var el = document.createElement('div');
    el.className = 'sign-box';
    el.id = b.id;
    el.textContent = b.label;
    var del = document.createElement('button');
    del.type = 'button';
    del.className = 'del';
    del.title = 'Elimina';
    del.textContent = '\u00d7';
    del.addEventListener('click', function (e) {
      e.stopPropagation();
      removeBox(b.id);
    });
    var handle = document.createElement('div');
    handle.className = 'resize-handle';
    el.appendChild(del);
    el.appendChild(handle);
    pv.layer.appendChild(el);
    syncBoxDom(b);
    bindInteract(el, b);
  }

  function addBox(role, label, preset) {
    var page = currentPage || 1;
    var x = 15, y = 20, w = defW, h = defH;
    if (preset) {
      page = preset.page || page;
      x = preset.x; y = preset.y; w = preset.w; h = preset.h;
    } else {
      var nSame = boxes.filter(function (b) { return b.page === page && b.role === role; }).length;
      y = 20 + nSame * 18;
    }
    if (!pageViews[page]) {
      toast('Pagina non pronta');
      return;
    }
    var b = {
      id: 'box-' + (boxSeq++),
      role: role,
      label: label,
      page: page,
      x: x, y: y, w: w, h: Math.max(3, h)
    };
    boxes.push(b);
    renderBox(b);
    refreshChips();
    if (!preset) {
      var pv = pageViews[page];
      if (pv && pv.stage) {
        pv.stage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
  }

  function trackCurrentPage() {
    var best = 1, bestVis = -1;
    Object.keys(pageViews).forEach(function (p) {
      var num = parseInt(p, 10);
      var st = pageViews[p].stage;
      if (!st) return;
      var r = st.getBoundingClientRect();
      var vis = Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0);
      if (vis > bestVis) { bestVis = vis; best = num; }
    });
    currentPage = best;
  }
  window.addEventListener('scroll', trackCurrentPage, { passive: true });

  function round2(n) {
    return Math.round((Number(n) || 0) * 100) / 100;
  }

  function buildPayload() {
    var visuals = { vettore: [], committente: [] };
    boxes.forEach(function (b) {
      if (!visuals[b.role]) visuals[b.role] = [];
      visuals[b.role].push({
        page: b.page,
        x: round2(b.x),
        y: round2(b.y),
        w: round2(b.w),
        h: round2(b.h)
      });
    });
    return { version: 1, visuals: visuals };
  }

  $('btnSave').addEventListener('click', function () {
    var btn = $('btnSave');
    btn.disabled = true;
    var payload = buildPayload();
    var body = new FormData();
    body.append('sign_boxes_json', JSON.stringify(payload));
    fetch(cfg.saveUrl, { method: 'POST', body: body, credentials: 'same-origin' })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        btn.disabled = false;
        if (!res.ok || !res.j || !res.j.ok) {
          showErr((res.j && res.j.error) ? res.j.error : 'Salvataggio fallito');
          toast('Errore salvataggio');
          return;
        }
        toast('Coordinate salvate');
      })
      .catch(function (e) {
        btn.disabled = false;
        showErr(String(e));
        toast('Errore rete');
      });
  });

  $('btnExit').addEventListener('click', function () {
    if (cfg.returnApp) {
      window.location.href = '../' + cfg.returnApp + '/';
      return;
    }
    if (window.history.length > 1) window.history.back();
    else window.close();
  });

  function loadExisting() {
    var ex = cfg.existing && cfg.existing.visuals ? cfg.existing.visuals : {};
    var labelOf = {};
    (cfg.signers || []).forEach(function (s) { labelOf[s.role] = s.label; });
    Object.keys(ex).forEach(function (role) {
      (ex[role] || []).forEach(function (box) {
        addBox(role, labelOf[role] || role, box);
      });
    });
    refreshChips();
  }

  if (!window.pdfjsLib) {
    showErr('PDF.js non caricato (CDN).');
    return;
  }
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

  var viewer = $('viewer');
  pdfjsLib.getDocument({ url: cfg.pdfUrl, withCredentials: true }).promise
    .then(function (pdf) {
      var chain = Promise.resolve();
      for (var p = 1; p <= pdf.numPages; p++) {
        (function (pageNum) {
          chain = chain.then(function () {
            return pdf.getPage(pageNum).then(function (page) {
              var base = page.getViewport({ scale: 1 });
              var maxCss = Math.min(845, viewer.clientWidth || 845);
              var scale = maxCss / base.width;
              var viewport = page.getViewport({ scale: scale });
              var wrap = document.createElement('div');
              wrap.className = 'page-wrap';
              var label = document.createElement('div');
              label.className = 'page-label';
              label.textContent = 'Pagina ' + pageNum + ' di ' + pdf.numPages;
              var stage = document.createElement('div');
              stage.className = 'page-stage';
              var canvas = document.createElement('canvas');
              canvas.width = viewport.width;
              canvas.height = viewport.height;
              canvas.style.width = viewport.width + 'px';
              canvas.style.height = viewport.height + 'px';
              var layer = document.createElement('div');
              layer.className = 'boxes-layer';
              stage.appendChild(canvas);
              stage.appendChild(layer);
              wrap.appendChild(label);
              wrap.appendChild(stage);
              viewer.appendChild(wrap);
              pageViews[pageNum] = {
                canvas: canvas,
                layer: layer,
                stage: stage,
                cssW: viewport.width,
                cssH: viewport.height
              };
              return page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise;
            });
          });
        })(p);
      }
      return chain;
    })
    .then(function () {
      trackCurrentPage();
      loadExisting();
      refreshChips();
    })
    .catch(function (e) {
      showErr('Impossibile caricare il PDF: ' + e);
    });
})();
</script>
