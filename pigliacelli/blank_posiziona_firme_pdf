/**
 * ScriptCase blank: blank_posiziona_firme_pdf → onExecute
 *
 * Editor riquadri firma su PDF (UX tipo Collab).
 * Salva sign_boxes_json su documenti o contratti (schema EGN_SIGN / mm).
 *
 * Parametri:
 *   documentoId / contrattoId  = id riga (globali SC o GET)
 *   target (solo GET interno)  = documenti | contratti (default documenti)
 *   return_app                 = app SC per Esci (opzionale)
 *   mode                       = ui | pdf | save
 *
 * Setup: docs/blank_posiziona_firme_pdf_SETUP.md
 * Nota SC: usare closure ($bpf_*), non function nominate (in metodo di classe non si registrano).
 */

$bpf_h = function ($s) {
    return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
};

$bpf_fail = function ($msg) use (&$bpf_h) {
    header('Content-Type: text/html; charset=UTF-8');
    echo '<!DOCTYPE html><html lang="it"><body style="font-family:Arial,Helvetica,sans-serif;padding:24px;color:#1a3a5c;background:#ffffff;">'
        . '<h1 style="margin:0 0 12px;font-size:20px;">Configurazione firme</h1>'
        . '<p style="margin:0;color:#4a5568;">' . $bpf_h($msg) . '</p></body></html>';
    exit;
};

$bpf_json_out = function ($arr, $code = 200) {
    http_response_code((int)$code);
    header('Content-Type: application/json; charset=UTF-8');
    header('Cache-Control: no-store');
    echo json_encode($arr, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    exit;
};

$bpf_param = function ($names, $default = '') {
    if (!is_array($names)) {
        $names = array($names);
    }
    foreach ($names as $n) {
        if (isset($_POST[$n]) && (string)$_POST[$n] !== '') {
            return trim((string)$_POST[$n]);
        }
        if (isset($_GET[$n]) && (string)$_GET[$n] !== '') {
            return trim((string)$_GET[$n]);
        }
        if (isset($_REQUEST[$n]) && (string)$_REQUEST[$n] !== '') {
            return trim((string)$_REQUEST[$n]);
        }
    }
    return $default;
};

$bpfExtraRoots = array();
if (isset($this->Ini->root) && trim((string)$this->Ini->root) !== '') {
    $bpfAppRoot = rtrim((string)$this->Ini->root, '/\\');
    $bpfExtraRoots[] = $bpfAppRoot;
    $bpfWs = @realpath($bpfAppRoot . '/..');
    if ($bpfWs !== false) {
        $bpfExtraRoots[] = $bpfWs;
    }
}
if (isset($this->Ini->path_doc) && trim((string)$this->Ini->path_doc) !== '') {
    $bpfPd = rtrim(trim((string)$this->Ini->path_doc), '/\\');
    $bpfExtraRoots[] = $bpfPd;
    $bpfExtraRoots[] = dirname($bpfPd);
}

$mode = strtolower($bpf_param(array('mode', 'bpf_mode'), 'ui'));
if ($mode === '') {
    $mode = 'ui';
}

// target solo da GET (pdf/save interni) — niente globale SC [target]
$target = strtolower($bpf_param(array('target'), 'documenti'));
if ($target !== 'contratti' && $target !== 'documenti') {
    $target = 'documenti';
}

$docIdIn = (int)$bpf_param(array('documentoId', 'documento_id'), '0');
$ctrIdIn = (int)$bpf_param(array('contrattoId', 'contratto_id'), '0');
// Form Execute SC: globali [documentoId] / [contrattoId]
if ($docIdIn <= 0 && isset([documentoId]) && (int)[documentoId] > 0) {
    $docIdIn = (int)[documentoId];
}
if ($ctrIdIn <= 0 && isset([contrattoId]) && (int)[contrattoId] > 0) {
    $ctrIdIn = (int)[contrattoId];
}
// GET interno mode=pdf|save usa target_id in query string (non globale SC)
$targetId = (int)$bpf_param(array('target_id'), '0');
if ($target === 'documenti' && $ctrIdIn > 0 && $docIdIn <= 0) {
    $target = 'contratti';
}
if ($targetId <= 0) {
    $targetId = ($target === 'contratti') ? $ctrIdIn : $docIdIn;
}
if ($target === 'contratti' && $targetId <= 0) {
    $targetId = $ctrIdIn;
}
if ($target === 'documenti' && $targetId <= 0) {
    $targetId = $docIdIn;
}

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}
$usrLogin = '';
if (!empty($_SESSION['usr_login'])) {
    $usrLogin = trim((string)$_SESSION['usr_login']);
}
$reqLogin = $bpf_param(array('usr_login'), '');
if ($reqLogin !== '' && strcasecmp($reqLogin, 'Guest') !== 0) {
    $usrLogin = $reqLogin;
    $_SESSION['usr_login'] = $usrLogin;
}
if ($usrLogin === '' || strcasecmp($usrLogin, 'Guest') === 0) {
    if ($targetId > 0) {
        $usrLogin = 'sc-exec';
    } else {
        sc_redir('app_Login');
    }
}

$returnApp = $bpf_param(array('return_app', 'returnApp'), '');
// sc_redir passa i param come globali SC — non solo GET
if ($returnApp === '' && isset([return_app]) && trim((string)[return_app]) !== '') {
    $returnApp = trim((string)[return_app]);
}
if ($returnApp === '' && isset([returnApp]) && trim((string)[returnApp]) !== '') {
    $returnApp = trim((string)[returnApp]);
}
$titleDoc = '';
$fileRel = '';
$existingJson = '';
$easygnFileId = '';

if ($targetId <= 0 && $mode !== 'ui') {
    if ($mode === 'save') {
        $bpf_json_out(array('ok' => false, 'error' => 'Manca documentoId/contrattoId'), 400);
    }
    $bpf_fail('Manca documentoId o contrattoId.');
}

if ($targetId > 0) {
    if ($target === 'documenti') {
        // Solo colonne sicure: easygn_file_id opzionale (se manca la SELECT fallisce → "non trovato")
        sc_lookup(rsBpfDoc, "
            SELECT id, COALESCE(file, '') AS f
            FROM documenti
            WHERE id = " . (int)$targetId . "
            LIMIT 1
        ", 'pigliacelli');
        // In SC: nessun record → {rs} === false (non usare empty({rs}))
        if ({rsBpfDoc} === false || !isset({rsBpfDoc[0][0]}) || (int){rsBpfDoc[0][0]} <= 0) {
            if ($mode === 'save') {
                $bpf_json_out(array('ok' => false, 'error' => 'Documento non trovato'), 404);
            }
            $bpf_fail('Documento #' . $targetId . ' non trovato.');
        }
        $fileRel = trim((string){rsBpfDoc[0][1]});
        $easygnFileId = '';
        sc_lookup(rsBpfDocEg, "
            SELECT COALESCE(easygn_file_id, '')
            FROM documenti
            WHERE id = " . (int)$targetId . "
            LIMIT 1
        ", 'pigliacelli');
        if ({rsBpfDocEg} !== false && isset({rsBpfDocEg[0][0]})) {
            $easygnFileId = trim((string){rsBpfDocEg[0][0]});
            if (strcasecmp($easygnFileId, 'null') === 0) {
                $easygnFileId = '';
            }
        }
        $titleDoc = 'Documento #' . (int)$targetId;
        sc_lookup(rsBpfDocMeta, "
            SELECT COALESCE(sign_boxes_json, '') AS j
            FROM documenti
            WHERE id = " . (int)$targetId . "
            LIMIT 1
        ", 'pigliacelli');
        if ({rsBpfDocMeta} !== false && isset({rsBpfDocMeta[0][0]})) {
            $existingJson = trim((string){rsBpfDocMeta[0][0]});
        }
    } else {
        sc_lookup(rsBpfCtr, "
            SELECT id, COALESCE(file, '') AS f
            FROM contratti
            WHERE id = " . (int)$targetId . "
            LIMIT 1
        ", 'pigliacelli');
        if ({rsBpfCtr} === false || !isset({rsBpfCtr[0][0]}) || (int){rsBpfCtr[0][0]} <= 0) {
            if ($mode === 'save') {
                $bpf_json_out(array('ok' => false, 'error' => 'Contratto non trovato'), 404);
            }
            $bpf_fail('Contratto #' . $targetId . ' non trovato.');
        }
        // contratti.file = nome file (es. contratto_1_....pdf), non il binario PDF
        $fileRel = trim((string){rsBpfCtr[0][1]});
        $easygnFileId = '';
        sc_lookup(rsBpfCtrEg, "
            SELECT COALESCE(easygn_file_id, '')
            FROM contratti
            WHERE id = " . (int)$targetId . "
            LIMIT 1
        ", 'pigliacelli');
        if ({rsBpfCtrEg} !== false && isset({rsBpfCtrEg[0][0]})) {
            $easygnFileId = trim((string){rsBpfCtrEg[0][0]});
            if (strcasecmp($easygnFileId, 'null') === 0) {
                $easygnFileId = '';
            }
        }
        $titleDoc = 'Contratto #' . (int)$targetId;
        sc_lookup(rsBpfCtrMeta, "
            SELECT COALESCE(sign_boxes_json, '') AS j
            FROM contratti
            WHERE id = " . (int)$targetId . "
            LIMIT 1
        ", 'pigliacelli');
        if ({rsBpfCtrMeta} !== false && isset({rsBpfCtrMeta[0][0]})) {
            $existingJson = trim((string){rsBpfCtrMeta[0][0]});
        }
    }
}

if ($mode === 'save') {
    $raw = '';
    if (isset($_POST['sign_boxes_json'])) {
        $raw = trim((string)$_POST['sign_boxes_json']);
    } else {
        $rawBody = file_get_contents('php://input');
        if (is_string($rawBody) && $rawBody !== '') {
            $tmp = json_decode($rawBody, true);
            if (is_array($tmp) && isset($tmp['sign_boxes_json'])) {
                $raw = is_string($tmp['sign_boxes_json'])
                    ? trim($tmp['sign_boxes_json'])
                    : json_encode($tmp['sign_boxes_json'], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
            } elseif (is_array($tmp) && isset($tmp['visuals'])) {
                $raw = json_encode($tmp, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
            }
        }
    }
    if ($raw === '') {
        $bpf_json_out(array('ok' => false, 'error' => 'JSON vuoto'), 400);
    }
    $decoded = json_decode($raw, true);
    if (!is_array($decoded) || !isset($decoded['visuals']) || !is_array($decoded['visuals'])) {
        $bpf_json_out(array('ok' => false, 'error' => 'JSON non valido (serve visuals)'), 400);
    }
    $normRoles = array('vettore', 'committente');
    $visuals = array();
    foreach ($normRoles as $role) {
        $visuals[$role] = array();
        if (!isset($decoded['visuals'][$role]) || !is_array($decoded['visuals'][$role])) {
            continue;
        }
        foreach ($decoded['visuals'][$role] as $box) {
            if (!is_array($box)) {
                continue;
            }
            $page = isset($box['page']) ? (int)$box['page'] : 0;
            if ($page < 1) {
                continue;
            }
            $visuals[$role][] = array(
                'page' => $page,
                'x'    => round((float)($box['x'] ?? 0), 2),
                'y'    => round((float)($box['y'] ?? 0), 2),
                'w'    => round((float)($box['w'] ?? 0), 2),
                'h'    => round((float)($box['h'] ?? 0), 2),
            );
        }
    }
    $payload = json_encode(
        array('version' => 1, 'visuals' => $visuals),
        JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
    );
    $sqlJson = str_replace("'", "''", $payload);
    $table = ($target === 'contratti') ? 'contratti' : 'documenti';
    sc_exec_sql("
        UPDATE `$table`
        SET sign_boxes_json = '$sqlJson'
        WHERE id = " . (int)$targetId . "
        LIMIT 1
    ", 'pigliacelli');
    sc_log_add(
        'BPF_SIGN',
        'save target=' . $target . ' id=' . $targetId
        . ' vettore=' . count($visuals['vettore'])
        . ' committente=' . count($visuals['committente'])
        . ' by=' . $usrLogin
    );
    $bpf_json_out(array('ok' => true, 'sign_boxes_json' => $payload));
}

if ($mode === 'pdf') {
    $path = '';
    $fileName = trim((string)$fileRel);
    if ($fileName !== '') {
        if (is_readable($fileName) && is_file($fileName)) {
            $path = $fileName;
        } else {
            $baseName = basename(str_replace(array('\\', '/'), DIRECTORY_SEPARATOR, $fileName));
            sc_lookup(rsBpfDirs, "
                SELECT set_name, set_value
                FROM sec_settings
                WHERE set_name IN ('contratti_base_dir', 'templates_path')
            ", 'pigliacelli');
            $contrattiBaseRaw = '';
            $templatesPath = '';
            if (!empty({rsBpfDirs})) {
                foreach ({rsBpfDirs} as $row) {
                    $n = isset($row[0]) ? (string)$row[0] : '';
                    $v = isset($row[1]) ? rtrim(trim((string)$row[1]), '/\\') : '';
                    if ($n === 'contratti_base_dir') {
                        $contrattiBaseRaw = $v;
                    }
                    if ($n === 'templates_path') {
                        $templatesPath = $v;
                    }
                }
            }
            $roots = $bpfExtraRoots;
            // Come nuovo_contratto_vettore: PDF in contratti_base_dir + nome file
            if ($contrattiBaseRaw !== '') {
                if ($contrattiBaseRaw[0] === '/' || preg_match('#^[A-Za-z]:#', $contrattiBaseRaw)) {
                    $roots[] = $contrattiBaseRaw;
                } else {
                    if (!empty($_SERVER['DOCUMENT_ROOT'])) {
                        $roots[] = rtrim((string)$_SERVER['DOCUMENT_ROOT'], '/\\')
                            . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $contrattiBaseRaw);
                    }
                    foreach ($bpfExtraRoots as $er) {
                        $roots[] = rtrim((string)$er, '/\\')
                            . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $contrattiBaseRaw);
                    }
                    $roots[] = '/opt/Scriptcase/v9-php82/wwwroot/scriptcase/'
                        . str_replace('\\', '/', $contrattiBaseRaw);
                    $roots[] = '/opt/Scriptcase/v9-php81/wwwroot/scriptcase/'
                        . str_replace('\\', '/', $contrattiBaseRaw);
                }
            }
            if ($templatesPath !== '') {
                $roots[] = $templatesPath;
                $roots[] = dirname($templatesPath);
            }
            $roots[] = '/opt/Scriptcase/v9-php82/wwwroot/scriptcase';
            $roots[] = '/opt/Scriptcase/v9-php81/wwwroot/scriptcase';
            // UAT: PDF contratti in pigliacelli_workspace/_lib/file/doc/{nome}.pdf
            $suffixes = array(
                '',
                '_lib/file/doc',
                'file/doc',
                '_lib/file/doc/contratti',
                'file/doc/contratti',
            );
            foreach (array_unique(array_filter($roots)) as $root) {
                $root = rtrim(str_replace(array('/', '\\'), DIRECTORY_SEPARATOR, (string)$root), '/\\');
                if ($root === '') {
                    continue;
                }
                $candidates = array(
                    $root . DIRECTORY_SEPARATOR . $baseName,
                    $root . DIRECTORY_SEPARATOR . $fileName,
                );
                foreach ($suffixes as $suf) {
                    if ($suf === '') {
                        continue;
                    }
                    $candidates[] = $root . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $suf)
                        . DIRECTORY_SEPARATOR . $baseName;
                }
                foreach ($candidates as $try) {
                    if ($try !== '' && is_readable($try) && is_file($try)) {
                        $path = $try;
                        break 2;
                    }
                }
            }
        }
    }
    $bin = '';
    $outName = 'document.pdf';
    if ($path !== '') {
        $bin = (string)@file_get_contents($path);
        $outName = basename($path);
    }
    // Fallback contratti: PDF firmato su EasyGN
    if (($bin === '' || strncmp($bin, '%PDF', 4) !== 0) && $easygnFileId !== '' && function_exists('curl_init')) {
        sc_lookup(rsBpfEgSet, "SELECT set_name, set_value FROM sec_settings WHERE set_name IN ('easygn_bearer','easygn_base_url')", 'pigliacelli');
        $bearer = '';
        $easygnBase = 'https://easygn.digiwebuno.it/api';
        if (!empty({rsBpfEgSet})) {
            foreach ({rsBpfEgSet} as $row) {
                $n = isset($row[0]) ? (string)$row[0] : '';
                $v = isset($row[1]) ? trim((string)$row[1]) : '';
                if ($n === 'easygn_bearer') {
                    $bearer = $v;
                }
                if ($n === 'easygn_base_url' && $v !== '') {
                    $easygnBase = rtrim($v, '/');
                }
            }
        }
        if ($bearer !== '') {
            $url = $easygnBase . '/files/download/' . rawurlencode($easygnFileId);
            $ch = curl_init();
            curl_setopt($ch, CURLOPT_URL, $url);
            curl_setopt($ch, CURLOPT_HTTPGET, true);
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 20);
            curl_setopt($ch, CURLOPT_TIMEOUT, 90);
            curl_setopt($ch, CURLOPT_HTTPHEADER, array(
                'Authorization: Bearer ' . $bearer,
                'Accept: application/pdf,application/octet-stream,*/*',
            ));
            $egBody = curl_exec($ch);
            $egHttp = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
            curl_close($ch);
            if ($egHttp >= 200 && $egHttp < 300 && is_string($egBody) && strncmp($egBody, '%PDF', 4) === 0) {
                $bin = $egBody;
                $outName = 'contratto_' . (int)$targetId . '.pdf';
            }
        }
    }
    if ($bin === '' || strncmp($bin, '%PDF', 4) !== 0) {
        http_response_code(404);
        header('Content-Type: text/plain; charset=UTF-8');
        echo 'PDF non disponibile per questo record.'
            . ' file_db=' . substr($fileRel, 0, 120)
            . ' easygn_file_id=' . ($easygnFileId !== '' ? $easygnFileId : '(vuoto)')
            . ' — per i contratti serve contratti.file su disco (dopo generazione PDF) oppure easygn_file_id.';
        exit;
    }
    header('Content-Type: application/pdf');
    header('Content-Length: ' . (string)strlen($bin));
    header('Content-Disposition: inline; filename="' . $outName . '"');
    header('Cache-Control: private, max-age=60');
    echo $bin;
    exit;
}

if ($targetId <= 0) {
    $bpf_fail('Apri questa app con documentoId=ID oppure contrattoId=ID (dopo upload PDF).');
}
if ($fileRel === '' && $easygnFileId === '') {
    $bpf_fail(
        'Nessun PDF collegato a questo record (contratti.file vuoto e easygn_file_id assente). '
        . 'Usa un contratto con PDF gia generato, oppure testa con documentoId (es. 1220).'
    );
}

// 1) se contratti.file e' un .pdf → URL diretto sotto _lib/file/doc/ (come in UAT)
// 2) altrimenti mode=pdf (risoluzione path) / EasyGN
$pdfUrl = '?mode=pdf&target=' . rawurlencode($target) . '&target_id=' . (int)$targetId;
$basePdfName = basename(str_replace(array('\\', '/'), DIRECTORY_SEPARATOR, (string)$fileRel));
if ($basePdfName !== '' && preg_match('/\.pdf$/i', $basePdfName)) {
    $pdfUrl = '../_lib/file/doc/' . rawurlencode($basePdfName);
} elseif ($easygnFileId !== '') {
    if ($target === 'contratti') {
        $pdfUrl = '../easygn_download_file/?contrattoId=' . (int)$targetId;
    } else {
        $pdfUrl = '../easygn_download_file/?documentoId=' . (int)$targetId;
    }
}
$saveUrl = '?mode=save&target=' . rawurlencode($target) . '&target_id=' . (int)$targetId;

$signers = array(
    array('role' => 'vettore', 'label' => 'Vettore'),
    array('role' => 'committente', 'label' => 'Committente'),
);
if ($target === 'documenti') {
    $signers = array(
        array('role' => 'vettore', 'label' => 'Subvettore'),
    );
}

$existingForJs = array('version' => 1, 'visuals' => array('vettore' => array(), 'committente' => array()));
if ($existingJson !== '') {
    $tmpEx = json_decode($existingJson, true);
    if (is_array($tmpEx) && isset($tmpEx['visuals']) && is_array($tmpEx['visuals'])) {
        $existingForJs = $tmpEx;
        if (!isset($existingForJs['version'])) {
            $existingForJs['version'] = 1;
        }
    }
}

$cfg = array(
    'pdfUrl'     => $pdfUrl,
    'saveUrl'    => $saveUrl,
    'target'     => $target,
    'targetId'   => (int)$targetId,
    'title'      => $titleDoc !== '' ? $titleDoc : ('#' . $targetId),
    'returnApp'  => $returnApp,
    'signers'    => $signers,
    'existing'   => $existingForJs,
    'defaultMm'  => array('w' => 45.0, 'h' => 14.0),
    'pageMm'     => array('w' => 210.0, 'h' => 297.0),
);

$cfgJson = json_encode($cfg, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP);

header('Content-Type: text/html; charset=UTF-8');
header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
?><!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Configurazione firme - Pigliacelli</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/interactjs@1.10.26/dist/interact.min.js"></script>
<style>
:root {
  --bg: #ffffff;
  --card: #ffffff;
  --ink: #1a3a5c;
  --muted: #4a5568;
  --line: #dde1e6;
  --accent: #1a3a5c;
  --chip: #2d3748;
  --chip-on: #2f855a;
  --box: rgba(214, 158, 46, 0.28);
  --box-border: #c05621;
  --danger: #c53030;
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg); color: #2d3748;
}
.top {
  background: var(--card);
  border-bottom: 1px solid var(--line);
  padding: 14px 20px;
  display: flex; flex-wrap: wrap; gap: 12px;
  align-items: center; justify-content: space-between;
}
.top h1 {
  margin: 0; font-size: 18px; color: var(--ink); letter-spacing: .02em;
  text-transform: uppercase;
}
.top .sub { margin: 4px 0 0; font-size: 13px; color: var(--muted); }
.actions { display: flex; gap: 8px; align-items: center; }
.btn {
  appearance: none; border: 0; cursor: pointer;
  border-radius: 8px; padding: 10px 16px;
  font-size: 13px; font-weight: 700; text-transform: uppercase;
  text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
}
.btn-save { background: var(--accent); color: #fff; }
.btn-save:disabled { opacity: .55; cursor: wait; }
.btn-exit { background: #edf2f7; color: var(--ink); }
.hint-bar {
  padding: 12px 20px 0; text-align: center; color: var(--muted); font-size: 13px;
}
.chips {
  display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;
  padding: 12px 20px 8px;
}
.chip {
