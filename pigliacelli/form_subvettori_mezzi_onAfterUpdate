// --- helpers locali (solo PHP puro: niente macro SC dentro) ---
$mezFileVal = function ($fieldVal, $hint) {
    $fieldVal = trim((string)$fieldVal);
    if ($fieldVal !== '') {
        return basename($fieldVal);
    }
    if (empty($_FILES) || !is_array($_FILES)) {
        return '';
    }
    $hint = strtolower((string)$hint);
    foreach ($_FILES as $k => $up) {
        if (!is_array($up)) {
            continue;
        }
        if ($hint !== '' && strpos(strtolower((string)$k), $hint) === false) {
            continue;
        }
        $nm = isset($up['name']) ? $up['name'] : '';
        if (is_array($nm)) {
            $nm = reset($nm);
        }
        $err = isset($up['error']) ? $up['error'] : 4;
        if (is_array($err)) {
            $err = reset($err);
        }
        if (trim((string)$nm) !== '' && (int)$err === 0) {
            return basename(trim((string)$nm));
        }
    }
    return '';
};

$mezCleanScad = function ($scadVal) {
    if (is_array($scadVal)) {
        $scadVal = reset($scadVal);
    }
    $scadVal = trim((string)$scadVal);
    if ($scadVal === '' || strcasecmp($scadVal, 'null') === 0) {
        return '';
    }
    $scadVal = str_replace('T', ' ', $scadVal);
    $u = strtoupper(str_replace(array('/', '-', ' ', '.', '_', ':'), '', $scadVal));
    if ($u === '' || $u === 'DDMMAAAA' || $u === 'GGMMAAAA' || $u === 'AAAAMMDD'
        || $u === 'YYYYMMDD' || $u === '00000000' || strpos($u, '00000000') === 0
    ) {
        return '';
    }
    if (preg_match('/^(\d{4})-(\d{2})-(\d{2})/', $scadVal, $m)) {
        if ($m[1] === '0000' || $m[2] === '00' || $m[3] === '00') {
            return '';
        }
        return $m[1] . '-' . $m[2] . '-' . $m[3];
    }
    if (preg_match('/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})/', $scadVal, $m)) {
        $d = (int)$m[1];
        $mo = (int)$m[2];
        $y = (int)$m[3];
        if ($d < 1 || $d > 31 || $mo < 1 || $mo > 12 || $y < 1990) {
            return '';
        }
        return sprintf('%04d-%02d-%02d', $y, $mo, $d);
    }
    if (preg_match('/^(\d{4})(\d{2})(\d{2})/', $u, $m)) {
        return $m[1] . '-' . $m[2] . '-' . $m[3];
    }
    return '';
};

$mezDefault30Aprile = function () {
    $y = (int)date('Y');
    $d = sprintf('%04d-04-30', $y);
    if (date('Y-m-d') > $d) {
        $d = sprintf('%04d-04-30', $y + 1);
    }
    return $d;
};

