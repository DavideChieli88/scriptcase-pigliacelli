/**
 * form_subvettori_autisti_wizard → onLoad
 *
 * Grid editabile (View) + form modal: SC genera anche *_wizard_inline
 * (non la crei tu). In modale spesso gira solo onLoad (con {id}), NON onLoadRecord.
 * Per questo il caricamento documenti è QUI quando id > 0.
 *
 * 1) Tasti wizard: ON in griglia, OFF in modale
 * 2) Precarica docs virtuali se id > 0 (fallback modale inline)
 * 3) Show/hide permesso_soggiorno da flag
 *
 * Setup radio permesso_soggiorno_flag:
 *   - Valore iniziale = 0
 *   - Reload = OFF
 *   - Ajax onClick (non onChange)
 *
 * Name Buttons: next_step_btn_mezzi, back_step_btn_autisti, btn_chiudi_modale
 * (Exit SC nativo spegnuto: vedi wizard_btn_chiudi_modale)
 */

// --- Tasti wizard ---
$op = '';
if (isset($this->nmgp_opcao)) {
    $op = strtolower(trim((string)$this->nmgp_opcao));
} elseif (isset($_POST['nmgp_opcao'])) {
    $op = strtolower(trim((string)$_POST['nmgp_opcao']));
} elseif (isset($_GET['nmgp_opcao'])) {
    $op = strtolower(trim((string)$_GET['nmgp_opcao']));
}

sc_log_add('WIZ_BTN', 'autisti onLoad op=[' . $op . ']');

// Modale SOLO se path/nome app contengono davvero "_inline".
// NON usare Embutida_*: sulla main (op=novo) sono spesso true → falso positivo
// e spariscono Avanti/Indietro sulla griglia dietro la modale.
$isInline = false;
$codApl = (isset($this->Ini->nm_cod_apl) ? (string)$this->Ini->nm_cod_apl : '');
$checks = array(
    $codApl,
    (string)__FILE__,
    isset($_SERVER['PHP_SELF']) ? (string)$_SERVER['PHP_SELF'] : '',
    isset($_SERVER['SCRIPT_NAME']) ? (string)$_SERVER['SCRIPT_NAME'] : '',
    isset($_SERVER['REQUEST_URI']) ? (string)$_SERVER['REQUEST_URI'] : '',
    isset($_SERVER['SCRIPT_FILENAME']) ? (string)$_SERVER['SCRIPT_FILENAME'] : '',
);
foreach ($checks as $p) {
    $p = str_replace('\\', '/', strtolower($p));
    if ($p !== '' && (
        substr($p, -7) === '_inline'
        || strpos($p, '_inline/') !== false
        || strpos($p, '_inline.') !== false
        || strpos($p, '_inline_') !== false
    )) {
        $isInline = true;
        break;
    }
}

// Reload della modale (radio con "Reload form when value has changed" = ON → op=recarga):
// il path può non contenere più "_inline" → senza questo tornavano Avanti/Indietro e spariva Chiudi.
// Il reload esiste solo nella form di edit, mai sulla griglia.
if (!$isInline && ($op === 'recarga' || $op === 'reload')) {
    $isInline = true;
}

if ($isInline) {
    // Modale: wizard nav OFF, salvataggio ON, Exit SC OFF, Chiudi custom ON
    sc_btn_display('next_step_btn_mezzi', 'off');
    sc_btn_display('back_step_btn_autisti', 'off');
    sc_btn_display('update', 'on');
    sc_btn_display('ok', 'on');
    sc_btn_display('save', 'on');
    sc_btn_display('insert', 'on');
    sc_btn_display('alterar', 'on');
    sc_btn_display('incluir', 'on');
    // Exit nativo (anche se duplicato in HTML): tutti OFF
    sc_btn_display('exit', 'off');
    sc_btn_display('sair', 'off');
    sc_btn_display('back', 'off');
    sc_btn_display('btn_chiudi_modale', 'on');
} else {
    // Griglia: Avanti/Indietro ON, Chiudi modale OFF
    sc_btn_display('next_step_btn_mezzi', 'on');
    sc_btn_display('back_step_btn_autisti', 'on');
    sc_btn_display('btn_chiudi_modale', 'off');
    sc_btn_display('exit', 'off');
}

sc_log_add(
    'WIZ_BTN',
    'autisti onLoad inline=' . ($isInline ? '1' : '0')
    . ' op=[' . $op . ']'
    . ' cod=[' . $codApl . ']'
    . ' self=[' . (isset($_SERVER['PHP_SELF']) ? $_SERVER['PHP_SELF'] : '') . ']'
    . ' id=' . (isset({id}) ? (int){id} : 0)
);

// --- Precarica documenti (necessario in modale *_inline dove manca onLoadRecord) ---
$autistaId = isset({id}) ? (int){id} : 0;

if ($autistaId > 0) {
    // Solo se i virtuali sono ancora vuoti (evita doppio lavoro se onLoadRecord ha già popolato)
    $patNow = trim((string){patente});
    if ($patNow === '') {
        sc_lookup(rsOL18, "
            SELECT file FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 18
              AND file IS NOT NULL AND TRIM(file) <> ''
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        {idoneita_sanitaria} = !empty({rsOL18[0][0]}) ? basename(trim((string){rsOL18[0][0]})) : '';

        sc_lookup(rsOL19a, "
            SELECT file FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 19
              AND file IS NOT NULL AND TRIM(file) <> ''
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        {patente} = !empty({rsOL19a[0][0]}) ? basename(trim((string){rsOL19a[0][0]})) : '';

        $idPrima = 0;
        sc_lookup(rsOL19id, "
            SELECT id FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 19
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsOL19id[0][0]})) {
            $idPrima = (int){rsOL19id[0][0]};
        }

        sc_lookup(rsOL19b, "
            SELECT file FROM documenti
            WHERE subvettore_autista_id = $autistaId
              AND tipo_documento_id = 19
              AND id <> $idPrima
              AND file IS NOT NULL AND TRIM(file) <> ''
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        {cqc} = !empty({rsOL19b[0][0]}) ? basename(trim((string){rsOL19b[0][0]})) : '';

        sc_lookup(rsOL20, "
            SELECT file FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 20
              AND file IS NOT NULL AND TRIM(file) <> ''
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        {formazione_sicurezza} = !empty({rsOL20[0][0]}) ? basename(trim((string){rsOL20[0][0]})) : '';

        sc_lookup(rsOL21, "
            SELECT file FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 21
              AND file IS NOT NULL AND TRIM(file) <> ''
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        {dpi_iii_categoria} = !empty({rsOL21[0][0]}) ? basename(trim((string){rsOL21[0][0]})) : '';

        sc_lookup(rsOL30, "
            SELECT file, in_possesso, data_scadenza FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 30
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');

        $file30 = '';
        if (!empty({rsOL30[0][0]})) {
            $file30 = basename(trim((string){rsOL30[0][0]}));
        }
        {permesso_soggiorno} = $file30;

        $inPoss30 = 0;
        if (isset({rsOL30[0][1]}) && {rsOL30[0][1]} !== '' && {rsOL30[0][1]} !== null && (string){rsOL30[0][1]} !== 'null') {
            $inPoss30 = ((int){rsOL30[0][1]} === 1) ? 1 : 0;
        }
        if ($inPoss30 === 1 || $file30 !== '') {
            {permesso_soggiorno_flag} = 1;
        } else {
            {permesso_soggiorno_flag} = 0;
        }

        $scad30 = isset({scadenza_permesso_soggiorno}) ? trim((string){scadenza_permesso_soggiorno}) : '';
        if (($scad30 === '' || $scad30 === 'null') && !empty({rsOL30[0][2]})) {
            {scadenza_permesso_soggiorno} = trim((string){rsOL30[0][2]});
        }

        sc_log_add(
            'AUT_LOAD',
            'onLoad FILL id=' . $autistaId
            . ' pat=[' . (string){patente} . ']'
            . ' perm=[' . $file30 . ']'
            . ' flag=' . (int){permesso_soggiorno_flag}
        );
    }
}

// --- Display permesso: in MODALE (inline). In editable grid → onLoadRecord per riga ---
sc_field_display({permesso_soggiorno_flag}, 'on');

if ($isInline) {
    $flagPermesso = {permesso_soggiorno_flag};
    if ($flagPermesso === '' || $flagPermesso === null || $flagPermesso === 'undefined' || $flagPermesso === 'null') {
        $flagPermesso = 0;
    }
    $flagPermesso = ((int)$flagPermesso === 1) ? 1 : 0;
    {permesso_soggiorno_flag} = $flagPermesso;

    if ($flagPermesso === 1) {
        sc_field_display({permesso_soggiorno}, 'on');
        sc_field_display({scadenza_permesso_soggiorno}, 'on');
    } else {
        sc_field_display({permesso_soggiorno}, 'off');
        sc_field_display({scadenza_permesso_soggiorno}, 'off');
    }
}

sc_log_add(
    'AUT_LOAD',
    'onLoad display inline=' . ($isInline ? '1' : '0')
    . ' flag=[' . trim((string){permesso_soggiorno_flag}) . ']'
    . ' pat=[' . trim((string){patente}) . ']'
    . ' id=' . $autistaId
);
