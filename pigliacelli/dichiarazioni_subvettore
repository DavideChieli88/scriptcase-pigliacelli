$sqlQuote = function ($v) {
    return "'" . str_replace("'", "''", (string)$v) . "'";
};

$rsBaseDir = $this->Db->Execute("
    SELECT set_value FROM sec_settings WHERE set_name = 'templates_path' LIMIT 1
");
$baseDirRaw = '';
if ($rsBaseDir !== false && !$rsBaseDir->EOF) {
    $baseDirRaw = trim((string)$rsBaseDir->fields[0]);
    $rsBaseDir->Close();
}
if ($baseDirRaw === '') {
    $rsBaseDir2 = $this->Db->Execute("
        SELECT set_value FROM sec_settings WHERE set_name = 'contratti_base_dir' LIMIT 1
    ");
    if ($rsBaseDir2 !== false && !$rsBaseDir2->EOF) {
        $baseDirRaw = trim((string)$rsBaseDir2->fields[0]);
        $rsBaseDir2->Close();
    }
}
if ($baseDirRaw === '') {
    die('Impostare sec_settings.templates_path o contratti_base_dir.');
}

$baseDir = rtrim(str_replace('\\', '/', $baseDirRaw), '/');
$docDir = $baseDir . '/documenti';
if (!is_dir($docDir)) {
    @mkdir($docDir, 0775, true);
}
if (!is_dir($docDir)) {
    $docDir = $baseDir;
    $relName = $pdfFileName;
    $fullPath = rtrim($docDir, '/\\') . DIRECTORY_SEPARATOR . $pdfFileName;
} else {
    $relName = 'documenti/' . $pdfFileName;
    $fullPath = rtrim($docDir, '/\\') . DIRECTORY_SEPARATOR . $pdfFileName;
}

$pdfBin = $pdf->Output($pdfFileName, 'S');
if (!is_string($pdfBin) || strncmp($pdfBin, '%PDF', 4) !== 0) {
    die('Generazione PDF dichiarazioni non valida.');
}
if (@file_put_contents($fullPath, $pdfBin) === false) {
    die('Impossibile salvare PDF: ' . $fullPath);
}

if ($documentoId <= 0) {
    $rsDoc = $this->Db->Execute("
        SELECT d.id
        FROM documenti d
        INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
        WHERE d.subvettore_id = " . (int)$subvector . "
          AND LOWER(td.nome) LIKE '%dichiaraz%'
          AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
          AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
        ORDER BY d.id
        LIMIT 1
    ");
    if ($rsDoc !== false && !$rsDoc->EOF) {
        $documentoId = (int)$rsDoc->fields[0];
        $rsDoc->Close();
    }
}

if ($documentoId > 0) {
    $this->Db->Execute("
        UPDATE documenti
        SET file = " . $sqlQuote($relName) . ",
            stato_documento_id = 1,
            updated_at = NOW()
        WHERE id = " . (int)$documentoId . "
    ");
}

