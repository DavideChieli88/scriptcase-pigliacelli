$clearScBlankPages = function () use ($pdf) {
    if (!method_exists($pdf, 'getNumPages') || !method_exists($pdf, 'deletePage')) {
        return;
    }
    $guard = 0;
    while ((int)$pdf->getNumPages() > 0 && $guard < 20) {
        $pdf->deletePage(1);
        $guard++;
