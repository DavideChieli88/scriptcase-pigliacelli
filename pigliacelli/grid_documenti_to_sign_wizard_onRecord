/**
 * grid_documenti_to_sign_wizard → onRecord
 *
 * Nasconde sign_doc_btn se il documento è già firmato (firmato_il valorizzato).
 *
 * Campi SC: {d.firmato_il} (alias d nella SELECT)
 * Action Bar: sign_doc_btn (Ajax)
 *
 * Per Action Bar usare sc_actionbar_show / sc_actionbar_hide
 * (non sc_btn_display). Chiamare SEMPRE show o hide su ogni riga.
 */

$firmatoIl = '';
if (isset({d.firmato_il})) {
    $firmatoIl = trim((string){d.firmato_il});
} elseif (isset({firmato_il})) {
    $firmatoIl = trim((string){firmato_il});
}

$firmato = (
    $firmatoIl !== ''
    && strcasecmp($firmatoIl, 'null') !== 0
    && strpos($firmatoIl, '0000-00-00') !== 0
);

if ($firmato) {
    sc_actionbar_hide('sign_doc_btn');
} else {
    sc_actionbar_show('sign_doc_btn');
}
