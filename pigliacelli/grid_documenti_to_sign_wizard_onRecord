/**
 * grid_documenti_to_sign_wizard → onRecord
 *
 * Action Bar names (da creare in IDE):
 *   open_pdf_btn      → Apri PDF
 *   sign_doc_btn      → Firma
 *   generate_pdf_btn  → Genera PDF (solo Dichiarazioni)
 *
 * Campi usati (fisici o virtuali):
 *   {id}, {file}, {firmato_il}, {tipo_documento_id}
 *   opz. {td_nome} / join nome tipo
 *   virtuale {stato_firma_label}
 *
 * Chiamare SEMPRE show o hide su ogni riga.
 */

$docId = isset({id}) ? (int){id} : 0;
$fileVal = isset({file}) ? trim((string){file}) : '';
$firmatoIl = isset({firmato_il}) ? trim((string){firmato_il}) : '';
$firmato = ($firmatoIl !== '' && $firmatoIl !== '0000-00-00 00:00:00');

$tipoNome = '';
if (isset({td_nome})) {
    $tipoNome = trim((string){td_nome});
} elseif (isset({nome_tipo})) {
    $tipoNome = trim((string){nome_tipo});
} elseif (isset({tipo_documento_id}) && (int){tipo_documento_id} > 0) {
    $tid = (int){tipo_documento_id};
    sc_lookup(rsGridFirmTipo, "
        SELECT COALESCE(nome, '') FROM tipi_documento WHERE id = $tid LIMIT 1
    ", 'pigliacelli');
    $tipoNome = !empty({rsGridFirmTipo[0][0]}) ? trim((string){rsGridFirmTipo[0][0]}) : '';
}

$isDichiarazioni = (stripos($tipoNome, 'dichiaraz') !== false);
$isPlaceholder = ($fileVal === '' || stripos($fileVal, 'placeholder_documento_verde') !== false);
$hasPdf = (!$isPlaceholder && $fileVal !== '');
$needsGenerate = ($isDichiarazioni && $isPlaceholder && !$firmato);

if ($firmato) {
    $label = 'Firmato';
    if ($firmatoIl !== '') {
        // firmato_il può arrivare già formattato dalla grid
        $label .= ' (' . htmlspecialchars($firmatoIl, ENT_QUOTES, 'UTF-8') . ')';
    }
    if (isset({stato_firma_label})) {
        {stato_firma_label} = "<span style='color:#2e7d32;font-weight:bold'>" . $label . "</span>";
    }
    sc_actionbar_show('open_pdf_btn');
    sc_actionbar_hide('sign_doc_btn');
    sc_actionbar_hide('generate_pdf_btn');
} elseif ($needsGenerate) {
    if (isset({stato_firma_label})) {
        {stato_firma_label} = "<span style='color:#c05600'>PDF da generare</span>";
    }
    sc_actionbar_hide('open_pdf_btn');
    sc_actionbar_hide('sign_doc_btn');
    sc_actionbar_show('generate_pdf_btn');
} elseif ($hasPdf) {
    if (isset({stato_firma_label})) {
        {stato_firma_label} = "<span style='color:#1a3a5c'>Da firmare</span>";
    }
    sc_actionbar_show('open_pdf_btn');
    sc_actionbar_show('sign_doc_btn');
    if ($isDichiarazioni) {
        sc_actionbar_show('generate_pdf_btn');
    } else {
        sc_actionbar_hide('generate_pdf_btn');
    }
} else {
    if (isset({stato_firma_label})) {
        {stato_firma_label} = "<span style='color:#718096'>In attesa template</span>";
    }
    sc_actionbar_hide('open_pdf_btn');
    sc_actionbar_hide('sign_doc_btn');
    sc_actionbar_hide('generate_pdf_btn');
}

// evita warning unused
unset($docId);
