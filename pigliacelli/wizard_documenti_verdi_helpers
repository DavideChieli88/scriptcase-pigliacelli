/**
 * Helper condivisi — Wizard step 5 documenti verdi.
 * Incollare / riusare in grid_documenti_to_sign_wizard e web_hook_firma
 * (function_exists per evitare ridefinizioni).
 */

if (!function_exists('wiz_verdi_sql_quote')) {
    function wiz_verdi_sql_quote($s)
    {
        return str_replace("'", "''", (string)$s);
    }
}

if (!function_exists('wiz_verdi_setting')) {
    function wiz_verdi_setting($name, $default = '')
    {
        $safe = wiz_verdi_sql_quote(trim((string)$name));
        sc_lookup(rsWizVerdiSet, "SELECT set_value FROM sec_settings WHERE set_name = '" . $safe . "' LIMIT 1", 'pigliacelli');
        if (isset({rsWizVerdiSet[0][0]})) {
            return trim((string){rsWizVerdiSet[0][0]});
        }
        return (string)$default;
    }
}

/**
 * Crea righe documenti per tipi is_readonly=1 mancanti e assegna placeholder se file vuoto.
 * @return int numero righe assicurate (insert + update file)
 */
if (!function_exists('wiz_verdi_ensure_documenti')) {
    function wiz_verdi_ensure_documenti($subvettore_id, $login = '')
    {
        $subvettore_id = (int)$subvettore_id;
        if ($subvettore_id <= 0) {
            return 0;
        }

        $login = trim((string)$login);
        if ($login === '') {
            sc_lookup(rsWizVerdiLogin, "
                SELECT COALESCE(login_subvettore, '')
                FROM subvettori
                WHERE id = $subvettore_id
                LIMIT 1
            ", 'pigliacelli');
            $login = !empty({rsWizVerdiLogin[0][0]}) ? trim((string){rsWizVerdiLogin[0][0]}) : '';
        }
        $loginSql = wiz_verdi_sql_quote($login);
        $placeholder = wiz_verdi_setting('documento_verde_placeholder', 'placeholder_documento_verde.pdf');
        if ($placeholder === '') {
            $placeholder = 'placeholder_documento_verde.pdf';
        }
        $phSql = wiz_verdi_sql_quote($placeholder);

        $n = 0;

        sc_exec_sql("
            INSERT INTO documenti (
                tipo_documento_id,
                subvettore_id,
                login,
                stato_documento_id,
                file
            )
            SELECT
                td.id,
                $subvettore_id,
                '$loginSql',
                1,
                CASE
                    WHEN LOWER(COALESCE(td.nome, '')) LIKE '%dichiaraz%' THEN NULL
                    ELSE '$phSql'
                END
            FROM tipi_documento td
            WHERE COALESCE(td.is_readonly, 0) = 1
              AND NOT EXISTS (
                  SELECT 1
                  FROM documenti d
                  WHERE d.subvettore_id = $subvettore_id
                    AND d.tipo_documento_id = td.id
                    AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
                    AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
              )
        ", 'pigliacelli');

        sc_lookup(rsWizVerdiIns, "SELECT ROW_COUNT()", 'pigliacelli');
        $n += !empty({rsWizVerdiIns[0][0]}) ? (int){rsWizVerdiIns[0][0]} : 0;

        sc_exec_sql("
            UPDATE documenti d
            INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
            SET d.file = '$phSql'
            WHERE d.subvettore_id = $subvettore_id
              AND COALESCE(td.is_readonly, 0) = 1
              AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
              AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
              AND (d.file IS NULL OR TRIM(d.file) = '')
              AND d.firmato_il IS NULL
              AND LOWER(COALESCE(td.nome, '')) NOT LIKE '%dichiaraz%'
        ", 'pigliacelli');

        sc_lookup(rsWizVerdiUpd, "SELECT ROW_COUNT()", 'pigliacelli');
        $n += !empty({rsWizVerdiUpd[0][0]}) ? (int){rsWizVerdiUpd[0][0]} : 0;

        return $n;
    }
}

/**
 * True se esistono tipi verdi e tutti i relativi documenti del sub hanno firmato_il.
 */
if (!function_exists('wiz_verdi_tutti_firmati')) {
    function wiz_verdi_tutti_firmati($subvettore_id)
    {
        $subvettore_id = (int)$subvettore_id;
        if ($subvettore_id <= 0) {
            return false;
        }

        sc_lookup(rsWizVerdiCnt, "
            SELECT
                COUNT(*) AS tot,
                SUM(CASE WHEN d.firmato_il IS NOT NULL THEN 1 ELSE 0 END) AS firmati
            FROM documenti d
            INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
            WHERE d.subvettore_id = $subvettore_id
              AND COALESCE(td.is_readonly, 0) = 1
              AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
              AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
        ", 'pigliacelli');

        $tot = !empty({rsWizVerdiCnt[0][0]}) ? (int){rsWizVerdiCnt[0][0]} : 0;
        $firmati = !empty({rsWizVerdiCnt[0][1]}) ? (int){rsWizVerdiCnt[0][1]} : 0;
        return $tot > 0 && $firmati >= $tot;
    }
}

/**
 * Chiude wizard e notifica operatori (mail + SC notification).
 * Idempotente se wizard_complete già 1.
 */
if (!function_exists('wiz_verdi_complete_wizard_and_notify')) {
    function wiz_verdi_complete_wizard_and_notify($subvettore_id)
    {
        $subvettore_id = (int)$subvettore_id;
        if ($subvettore_id <= 0) {
            return false;
        }

        sc_lookup(rsWizVerdiDone, "
            SELECT COALESCE(wizard_complete, 0), COALESCE(ragione_sociale, ''), COALESCE(login_subvettore, '')
            FROM subvettori
            WHERE id = $subvettore_id
            LIMIT 1
        ", 'pigliacelli');

        $already = !empty({rsWizVerdiDone[0][0]}) ? (int){rsWizVerdiDone[0][0]} : 0;
        $ragioneSociale = !empty({rsWizVerdiDone[0][1]}) ? trim((string){rsWizVerdiDone[0][1]}) : '';
        $loginSub = !empty({rsWizVerdiDone[0][2]}) ? trim((string){rsWizVerdiDone[0][2]}) : '';

        if ($already === 1) {
            return true;
        }
        if (!wiz_verdi_tutti_firmati($subvettore_id)) {
            return false;
        }

        sc_exec_sql("
            UPDATE subvettori
            SET wizard_complete = 1,
                wizard_step = 0
            WHERE id = $subvettore_id
              AND wizard_complete = 0
        ", 'pigliacelli');

        wiz_verdi_notify_operatori($subvettore_id, $ragioneSociale, $loginSub);
        return true;
    }
}

if (!function_exists('wiz_verdi_mail_logo_src')) {
    function wiz_verdi_mail_logo_src()
    {
        $rel = '_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png';
        $dir = realpath(dirname(__FILE__));
        for ($i = 0; $i < 12 && $dir; $i++) {
            $try = $dir . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $rel);
            if (is_readable($try)) {
                $bin = @file_get_contents($try);
                if ($bin !== false && $bin !== '' && strlen($bin) < 500000) {
                    return 'data:image/png;base64,' . base64_encode($bin);
                }
            }
            $p = dirname($dir);
            if ($p === $dir) {
                break;
            }
            $dir = $p;
        }
        $base = rtrim(trim(wiz_verdi_setting('mail_base_url', '')), '/');
        if ($base !== '' && preg_match('#^https?://#i', $base) === 1) {
            return htmlspecialchars(
                $base . '/_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png',
                ENT_QUOTES,
                'UTF-8'
            );
        }
        return '';
    }
}

