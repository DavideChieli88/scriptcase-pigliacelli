            . 'font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#718096;">'
            . 'Messaggio automatico &mdash; non rispondere.</td></tr>'
            . '</table></td></tr></table></body></html>';
    }
}

if (!function_exists('wiz_verdi_notify_operatori')) {
    function wiz_verdi_notify_operatori($subId, $ragioneSociale, $loginSub)
    {
        $subId = (int)$subId;
        $ragioneSociale = trim((string)$ragioneSociale);
        $loginSub = trim((string)$loginSub);

        sc_lookup(rsWizVerdiOps, "
            SELECT DISTINCT su.login, su.email
            FROM sec_users su
            INNER JOIN sec_users_groups sug ON sug.login = su.login
            WHERE su.active = 'Y'
              AND su.login IS NOT NULL
              AND TRIM(su.login) <> ''
              AND su.email IS NOT NULL
              AND TRIM(su.email) <> ''
              AND sug.group_id IN (1, 3)
        ", 'pigliacelli');

        $emailPlaceholder = array('admin@admin.com', 'admin@localhost', 'admin@example.com');
        $destinatari = array();
        $operatorLogins = array();

        if (isset({rsWizVerdiOps[0][0]})) {
            foreach ({rsWizVerdiOps} as $row) {
                $loginOp = trim((string)$row[0]);
                $email = strtolower(trim((string)$row[1]));
                if ($loginOp === '' || strcasecmp($loginOp, 'Guest') === 0) {
                    continue;
                }
                if ($email === '' || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
                    continue;
                }
                if (in_array($email, $emailPlaceholder, true)) {
                    continue;
                }
                $destinatari[] = $email;
                $operatorLogins[] = $loginOp;
            }
        }
        $destinatari = array_values(array_unique($destinatari));
        $operatorLogins = array_values(array_unique($operatorLogins));

        $loginUrl = rtrim(trim(wiz_verdi_setting('login_url', '')), '/');

        sc_lookup(rs_smtp_wiz_verdi, "SELECT set_name, set_value FROM sec_settings", 'pigliacelli');
        if (isset({rs_smtp_wiz_verdi[0][0]})) {
            foreach ({rs_smtp_wiz_verdi} as $f) {
                $_SESSION['sett_' . $f[0]] = $f[1];
            }
        }

        $sett_smtp = array();
        if (isset($_SESSION['sett_smtp_api']) && $_SESSION['sett_smtp_api'] === 'custom') {
            $sett_smtp = array(
                'settings' => array(
                    'gateway'       => 'smtp',
                    'smtp_server'   => $_SESSION['sett_smtp_server'],
                    'smtp_protocol' => $_SESSION['sett_smtp_security'],
                    'smtp_port'     => $_SESSION['sett_smtp_port'],
                    'smtp_user'     => $_SESSION['sett_smtp_user'],
                    'smtp_password' => $_SESSION['sett_smtp_pass'],
                    'from_email'    => $_SESSION['sett_smtp_from_email'],
                    'from_name'     => $_SESSION['sett_smtp_from_name'],
                ),
            );
        } else {
            $sett_smtp = array('profile' => isset($_SESSION['sett_smtp_api']) ? $_SESSION['sett_smtp_api'] : '');
        }

        $labelSub = $ragioneSociale !== '' ? $ragioneSociale : ('ID ' . $subId);
        $safeRagione = htmlspecialchars($labelSub, ENT_QUOTES, 'UTF-8');
        $safeLogin = htmlspecialchars($loginSub, ENT_QUOTES, 'UTF-8');
        $safeLoginUrl = htmlspecialchars($loginUrl, ENT_QUOTES, 'UTF-8');

        if (!empty($destinatari) && function_exists('sc_send_mail_api')) {
            $soggetto = 'Wizard completato — abilitare subvettore ' . $labelSub;
            $testoPlain = "Gentile operatore,\n\n"
                . "il subvettore $labelSub ha completato il wizard di onboarding "
                . "(documenti caricati e documenti verdi firmati).\n\n"
                . "Subvettore: $labelSub\n"
                . ($loginSub !== '' ? "Login: $loginSub\n" : '')
                . "ID: $subId\n\n"
                . "Verificare i documenti e abilitare il subvettore se tutto e' corretto.\n\n"
                . ($loginUrl !== '' ? "Accesso: $loginUrl\n\n" : '')
                . "Messaggio automatico — non rispondere.";

            $btnHtml = '';
            if ($loginUrl !== '') {
                $btnHtml = '<p style="margin:24px 0 8px;text-align:center;">'
                    . '<a href="' . $safeLoginUrl . '" style="display:inline-block;padding:12px 26px;'
                    . 'background:#1a3a5c;color:#ffffff;text-decoration:none;border-radius:8px;'
                    . 'font-weight:bold;font-size:15px;">Accedi al portale</a></p>';
            }

            $infoBox = '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" '
                . 'style="margin:16px 0;background:#f7f9fb;border:1px solid #e2e8f0;border-radius:8px;">'
                . '<tr><td style="padding:14px 18px;font-size:14px;line-height:1.6;">'
                . '<strong style="color:#1a3a5c;">Subvettore:</strong> ' . $safeRagione . '<br>'
                . ($loginSub !== '' ? '<strong style="color:#1a3a5c;">Login:</strong> ' . $safeLogin . '<br>' : '')
                . '<strong style="color:#1a3a5c;">ID:</strong> ' . (int)$subId
                . '</td></tr></table>';

            $innerHtml = '<p style="margin:0 0 12px;">Gentile operatore,</p>'
                . '<p style="margin:0 0 12px;">il subvettore <strong>' . $safeRagione . '</strong> ha completato '
                . 'il wizard di onboarding (documenti caricati e documenti verdi firmati).</p>'
                . $infoBox
                . '<p style="margin:0 0 12px;">Verificare i documenti caricati e <strong>abilitare il subvettore</strong> '
                . 'se tutto e\' corretto.</p>'
                . $btnHtml;

            $mailLogoUrl = wiz_verdi_mail_logo_src();
            $testoHtml = wiz_verdi_mail_layout('Wizard completato — abilitazione subvettore', $innerHtml, $mailLogoUrl);

            foreach ($destinatari as $dest) {
                try {
                    sc_send_mail_api(array_merge($sett_smtp, array(
                        'message' => array(
                            'to'      => $dest,
                            'subject' => $soggetto,
                            'html'    => $testoHtml,
                            'text'    => $testoPlain,
                        ),
                    )));
                } catch (Exception $e) {
                    // ignore
                }
            }
        }

        $notifyProfile = trim(wiz_verdi_setting('notification_profile', 'Pigliacelli_Notifications'));
        if ($notifyProfile === '') {
            $notifyProfile = 'Pigliacelli_Notifications';
        }
        if (!empty($operatorLogins) && function_exists('sc_send_notification')) {
            $notifyTitle = 'Wizard completato — abilitare ' . $labelSub;
            $notifyMessage = 'Il subvettore ' . $labelSub
                . ' ha completato il wizard (firme verdi incluse). Verificare documenti e abilitare l\'account.';
            $notifyExpire = date('Y-m-d H:i:s', strtotime('+30 days'));
            $notifyTo = implode(';', $operatorLogins);
            try {
                sc_send_notification(array(
                    'title'        => $notifyTitle,
                    'message'      => $notifyMessage,
                    'destiny_type' => 'user',
                    'to'           => $notifyTo,
                    'from'         => '',
                    'link'         => '',
                    'dtexpire'     => $notifyExpire,
                    'profile'      => $notifyProfile,
                ));
            } catch (Exception $e) {
                // ignore
            }
        }
    }
}
