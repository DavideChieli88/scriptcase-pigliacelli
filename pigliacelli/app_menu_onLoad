// Scriptcase — app_menu → onLoad
// NON usare "return" (pagina bianca).
//
// Subvettore (group 2) con wizard_complete=0 → blank_wizard_landing.
// Filtrare SEMPRE sug.group_id = 2: un utente può avere più gruppi e
// LIMIT 1 senza filtro rendeva il redirect casuale (menu vs blank).

[menu_description] = "";

if (!is_numeric([usr_login])) {
    [menu_description] .= [usr_login];
}

if (!empty([usr_email])) {
    [menu_description] .= !empty([menu_description]) ? ' / ' : '';
    [menu_description] .= [usr_email];
}

if (!empty([usr_phone])) {
    [menu_description] .= !empty([menu_description]) ? ' / ' : '';
    [menu_description] .= [usr_phone];
}

$usrLogin = trim((string)[usr_login]);
if ($usrLogin === '' || strcasecmp($usrLogin, 'Guest') === 0) {
    // skip
} else {
    $loginSql = str_replace("'", "''", $usrLogin);

    // group 2: valorizza [subvettoreId] (serve alle grid menu
    // con WHERE subvettore_id = [subvettoreId]; onApplicationInit NON puo' fare lookup)
    sc_lookup(rsMenuSubId, "
        SELECT COALESCE(su.subvettore_id, 0)
        FROM sec_users su
        INNER JOIN sec_users_groups sug
            ON sug.login = su.login
           AND sug.group_id = 2
        WHERE su.login = '$loginSql'
          AND su.active = 'Y'
          AND su.subvettore_id > 0
        LIMIT 1
    ", 'pigliacelli');
    $menuSubId = !empty({rsMenuSubId[0][0]}) ? (int){rsMenuSubId[0][0]} : 0;
    if ($menuSubId > 0) {
        [subvettoreId] = $menuSubId;
    }

    // group 2 + wizard incompleto + subvettore associato → landing
    sc_lookup(rsWizMenuOk, "
        SELECT 1
        FROM sec_users su
        INNER JOIN sec_users_groups sug
            ON sug.login = su.login
           AND sug.group_id = 2
        INNER JOIN subvettori s ON s.id = su.subvettore_id
        WHERE su.login = '$loginSql'
          AND COALESCE(s.wizard_complete, 0) = 0
        LIMIT 1
    ", 'pigliacelli');

    if (!empty({rsWizMenuOk[0][0]})) {
        sc_redir('blank_wizard_landing');
    }

    // Flash solo se restiamo sul menu
    if (!empty($_SESSION['wizard_flash_msg'])) {
        $flashMsg = (string)$_SESSION['wizard_flash_msg'];
        unset($_SESSION['wizard_flash_msg']);
        sc_error_message($flashMsg);
    }

    // primo accesso menu
    try {
        sc_lookup(rsHasLogged, "
            SELECT COALESCE(hasLoggedFirst, 0)
            FROM sec_users
            WHERE login = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');
        if (isset({rsHasLogged[0][0]}) && (int){rsHasLogged[0][0]} === 0) {
            sc_exec_sql("
                UPDATE sec_users
                SET hasLoggedFirst = 1
                WHERE login = '$loginSql'
                  AND COALESCE(hasLoggedFirst, 0) = 0
            ", 'pigliacelli');
            sc_log_add('FIRST_LOGIN', "hasLoggedFirst=1 login=$usrLogin (app_menu onLoad)");
        }
    } catch (Throwable $e) {
        sc_log_add('FIRST_LOGIN', 'ERRORE onLoad login=' . $usrLogin . ' — ' . $e->getMessage());
    }
}
