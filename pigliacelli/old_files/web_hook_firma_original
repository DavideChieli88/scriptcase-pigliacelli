function webhook_contratto_gia_completato($contrattoId)
{
    $idCompletato = webhook_stato_id_by_nome('Completato');
    if ($idCompletato <= 0) {
        return false;
    }
    sc_lookup(rsSt, "SELECT stato_contratto_id FROM contratti WHERE id = " . (int)$contrattoId . " LIMIT 1");
    return !empty({rsSt[0][0]}) && (int){rsSt[0][0]} === $idCompletato;
}

function webhook_generate_temp_password()
{
    $chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=';
    $len = strlen($chars);
    $out = '';
    for ($i = 0; $i < 12; $i++) {
        $out .= $chars[random_int(0, $len - 1)];
    }
    return $out;
}

function webhook_user_active_is_yes($active)
{
    $a = strtoupper(trim((string)$active));
    return ($a === 'Y' || $a === '1' || $a === 'S' || $a === 'SI' || $a === 'YES');
}

/** Dopo stato Completato (id 2): active=Y su sec_users + mail credenziali al subvettore */
function webhook_activate_subvettore_after_completato($contrattoId)
{
    $contrattoId = (int)$contrattoId;
    if ($contrattoId <= 0) {
        return;
    }
    sc_lookup(rsSub, "
        SELECT
            sc.subvettore_id,
            s.login_subvettore,
            s.ragione_sociale,
            COALESCE(NULLIF(TRIM(s.phone), ''), NULLIF(TRIM(s.cellphone), ''), '') AS phone_sub,
            sc.email_firmatario,
            sc.email_rappresentante,
            TRIM(CONCAT(COALESCE(sc.nome_firmatario, sc.nome_rappresentante, ''), ' ', COALESCE(sc.cognome_firmatario, sc.cognome_rappresentante, ''))) AS nome_firm
        FROM subvettori_contratti sc
        INNER JOIN subvettori s ON s.id = sc.subvettore_id
        WHERE sc.contratto_id = $contrattoId
        ORDER BY sc.id ASC
        LIMIT 1
    ");
    if (empty({rsSub[0][0]})) {
        webhook_sc_log('completato: nessun subvettore per contratto_id=' . $contrattoId);
        return;
    }
    $subvettoreId = (int){rsSub[0][0]};
    $loginSubv = trim((string){rsSub[0][1]});
    $ragioneSociale = trim((string){rsSub[0][2]});
    $phoneSub = trim((string){rsSub[0][3]});
    $emailF = trim((string){rsSub[0][4]});
    $emailR = trim((string){rsSub[0][5]});
    $nomeFirm = trim((string){rsSub[0][6]});
    $emailSub = $emailF !== '' ? $emailF : $emailR;
    if ($emailSub === '' || filter_var($emailSub, FILTER_VALIDATE_EMAIL) === false) {
        webhook_sc_log('completato: email subvettore assente contratto_id=' . $contrattoId);
        return;
    }
    $login = $loginSubv;
    $userLogin = '';
    $userActive = '';
    $userEmail = '';
    if ($login !== '') {
        $lq = webhook_sql_quote($login);
        sc_lookup(rsU, "SELECT login, active, email FROM sec_users WHERE login = '$lq' LIMIT 1");
    }
    if (empty({rsU[0][0]})) {
        sc_lookup(rsU2, "SELECT login, active, email FROM sec_users WHERE subvettore_id = $subvettoreId LIMIT 1");
        if (!empty({rsU2[0][0]})) {
            $userLogin = trim((string){rsU2[0][0]});
            $userActive = trim((string){rsU2[0][1]});
            $userEmail = trim((string){rsU2[0][2]});
            $login = $userLogin;
        }
    } else {
        $userLogin = trim((string){rsU[0][0]});
        $userActive = trim((string){rsU[0][1]});
        $userEmail = trim((string){rsU[0][2]});
    }
    $plainPassword = '';
    $mustSendCredentials = false;
    if ($userLogin === '') {
        $login = $emailSub;
        $plainPassword = webhook_generate_temp_password();
        $pswHash = md5($plainPassword);
        $lq = webhook_sql_quote($login);
        $le = webhook_sql_quote($emailSub);
        $ln = webhook_sql_quote($ragioneSociale !== '' ? $ragioneSociale : $nomeFirm);
        $lp = webhook_sql_quote($phoneSub);
        sc_exec_sql("
            INSERT INTO sec_users (login, pswd, name, email, phone, active, subvettore_id)
            VALUES ('$lq', '" . webhook_sql_quote($pswHash) . "', '$ln', '$le', '$lp', 'Y', $subvettoreId)
        ");
        sc_lookup(rsGrp, "SELECT login FROM sec_users_groups WHERE login = '$lq' AND group_id = 2 LIMIT 1");
        if (empty({rsGrp[0][0]})) {
            sc_exec_sql("INSERT INTO sec_users_groups (login, group_id) VALUES ('$lq', 2)");
        }
        if ($loginSubv === '') {
            sc_exec_sql("UPDATE subvettori SET login_subvettore = '$lq' WHERE id = $subvettoreId");
        }
        $mustSendCredentials = true;
        webhook_sc_log('completato: creato sec_users login=' . $login . ' subvettore_id=' . $subvettoreId);
    } elseif (webhook_user_active_is_yes($userActive)) {
        $plainPassword = webhook_generate_temp_password();
        $pswHash = webhook_sql_quote(md5($plainPassword));
        $lq = webhook_sql_quote($login);
        sc_exec_sql("UPDATE sec_users SET active = 'Y', pswd = '$pswHash' WHERE login = '$lq'");
        $mustSendCredentials = true;
        webhook_sc_log('completato: account già attivo login=' . $login . ' — nuova password temporanea e mail credenziali');
    } else {
        $plainPassword = webhook_generate_temp_password();
        $pswHash = webhook_sql_quote(md5($plainPassword));
        $lq = webhook_sql_quote($login);
        sc_exec_sql("UPDATE sec_users SET active = 'Y', pswd = '$pswHash' WHERE login = '$lq'");
        $mustSendCredentials = true;
        webhook_sc_log('completato: attivato sec_users login=' . $login . ' (era inactive)');
    }
    if ($mustSendCredentials && $plainPassword !== '') {
        $toEmail = $userEmail !== '' ? $userEmail : $emailSub;
        if (!webhook_send_credenziali_subvettore_email($contrattoId, $toEmail, $login, $plainPassword, $ragioneSociale !== '' ? $ragioneSociale : $nomeFirm)) {
            webhook_sc_log('completato: invio credenziali FALLITO to=' . $toEmail . ' login=' . $login);
        }
    } else {
        webhook_sc_log('completato: mail credenziali non inviata (mustSend=' . ($mustSendCredentials ? '1' : '0') . ')');
    }
}

function webhook_send_credenziali_subvettore_email($contrattoId, $to, $login, $plainPassword, $displayName)
{
    $to = trim((string)$to);
    $login = trim((string)$login);
    if ($to === '' || filter_var($to, FILTER_VALIDATE_EMAIL) === false) {
        webhook_sc_log('credenziali SKIP email non valida contratto_id=' . $contrattoId);
        return false;
    }
    if ($login === '' || $plainPassword === '') {
        webhook_sc_log('credenziali SKIP login/password vuoti contratto_id=' . $contrattoId);
        return false;
    }
    if (!function_exists('sc_send_mail_api')) {
        webhook_sc_log('credenziali SKIP sc_send_mail_api assente');
        return false;
    }
    webhook_init_smtp_config();
    $portalUrl = webhook_setting('portal_url', '');
    if ($portalUrl === '') {
        $portalUrl = webhook_setting('app_url', '');
    }
    if ($portalUrl === '') {
        $portalUrl = webhook_setting('login_url', '');
    }
    $nome = trim((string)$displayName);
    if ($nome === '') {
        $nome = 'Gentile utente';
    }
    $titolo = 'Credenziali area riservata — contratto #' . (int)$contrattoId;
    $testo = $nome . ",\n\n"
        . "Il contratto #" . (int)$contrattoId . " è stato completato.\n"
