if (!function_exists('dea_build_mails')) {
    /**
     * @param int $daysBefore  null per fixed; 0 = scaduto oggi/passato; >0 = in scadenza
     */
    function dea_build_mails(
        $documento_id,
        $nome_documento,
        $data_scadenza_it,
        $subvettore_label,
        $ragione_label,
        $loginUrl,
        $daysBefore,
        $isFixed,
        $fixedMd
    ) {
        $mailLogoUrl = dea_mail_logo_src();
        $ragione = trim((string)$ragione_label);
        $salutoSub = $ragione !== '' && $ragione !== 'n/d' ? 'Gentile ' . $ragione : 'Gentile subvettore';
        $safeSalutoSub = htmlspecialchars($salutoSub, ENT_QUOTES, 'UTF-8');
        $subEtichetta = ($ragione !== '' && $ragione !== 'n/d')
            ? $ragione . ' (ID ' . $subvettore_label . ')'
            : 'ID ' . $subvettore_label;

        $isExpiryDay = (!$isFixed && (int)$daysBefore === 0)
            || ($isFixed && $fixedMd !== '' && substr($fixedMd, -2) === date('d') && (int)$daysBefore === 0);

        if ($isFixed && (int)$daysBefore !== 0) {
            // fixed pre: treat as reminder
            $isExpiryDay = false;
        }
        if ($isFixed) {
            // 01-31 = expiry day for Albo
            $isExpiryDay = ($fixedMd === '01-31');
        }

        if ($isExpiryDay) {
            $title = 'Documento scaduto';
            $whenLabel = 'Scaduto il';
            $whenVal = $data_scadenza_it;
            $subjectSub = 'Documento scaduto — ' . $nome_documento . ' (#' . (int)$documento_id . ')';
            $introSub = 'il seguente documento è scaduto. '
                . 'La preghiamo di accedere alla sua <strong>area riservata</strong> per caricare una versione aggiornata.';
            $introOp = 'il documento del subvettore <strong>'
                . htmlspecialchars($subEtichetta, ENT_QUOTES, 'UTF-8')
                . '</strong> è scaduto. Verificare in griglia documenti.';
            $textWhen = "Scaduto il: $data_scadenza_it";
        } else {
            $gg = (int)$daysBefore;
            $title = 'Documento in scadenza';
            $whenLabel = 'Scade il';
            $whenVal = $data_scadenza_it;
            if ($isFixed) {
                $subjectSub = 'Documento in scadenza — ' . $nome_documento . ' (#' . (int)$documento_id . ')';
                $introSub = 'le ricordiamo che il seguente documento è in scadenza. '
                    . 'Acceda alla <strong>area riservata</strong> per aggiornarlo per tempo.';
                $textWhen = "Scade il: $data_scadenza_it (promemoria calendario)";
            } else {
                $subjectSub = 'Documento in scadenza tra ' . $gg . ' giorni — '
                    . $nome_documento . ' (#' . (int)$documento_id . ')';
                $introSub = 'il seguente documento scade tra <strong>' . $gg . ' giorni</strong>. '
                    . 'Acceda alla <strong>area riservata</strong> per aggiornarlo.';
                $textWhen = "Scade il: $data_scadenza_it (tra $gg giorni)";
            }
            $introOp = 'il documento del subvettore <strong>'
                . htmlspecialchars($subEtichetta, ENT_QUOTES, 'UTF-8')
                . '</strong> è in scadenza. Verificare in griglia documenti.';
        }

        if (stripos((string)$nome_documento, 'dichiaraz') !== false) {
            if ($isExpiryDay) {
                $introSub = 'la dichiarazione è scaduta. '
                    . 'Dal menu <strong>Dichiarazioni</strong> può ricompilarla e firmarla per l\'anno nuovo.';
            } else {
                $introSub = 'la dichiarazione è in scadenza. '
                    . 'Dal menu <strong>Dichiarazioni</strong> può ricompilarla e firmarla per l\'anno nuovo.';
            }
        }

        $subjectOp = $subjectSub;

        $textSub = $salutoSub . ",\n\n"
            . strip_tags(str_replace(array('<strong>', '</strong>'), '', $introSub)) . "\n\n"
            . "Tipo documento: $nome_documento\n"
            . "Riferimento: #" . (int)$documento_id . "\n"
            . $textWhen . "\n\n"
            . ($loginUrl !== '' ? "Area riservata:\n$loginUrl\n\n" : '')
            . "Messaggio automatico — non rispondere.";

        $textOp = "Gentile operatore,\n\n"
            . "Tipo documento: $nome_documento\n"
            . "Riferimento: #" . (int)$documento_id . "\n"
            . "Subvettore: $subEtichetta\n"
            . $textWhen . "\n\n"
            . ($loginUrl !== '' ? "Area gestione:\n$loginUrl\n\n" : '')
            . "Messaggio automatico — non rispondere.";

        $infoSub = dea_mail_detail_line('Tipo documento', $nome_documento)
            . dea_mail_detail_line('Riferimento', '#' . (int)$documento_id)
            . dea_mail_detail_line($whenLabel, $whenVal);

        $innerSub = '<p style="margin:0 0 12px;">' . $safeSalutoSub . ',</p>'
            . '<p style="margin:0 0 12px;">' . $introSub . '</p>'
            . dea_mail_info_box($infoSub)
            . dea_mail_btn($loginUrl, 'Accedi all\'area riservata');

        $infoOp = dea_mail_detail_line('Tipo documento', $nome_documento)
            . dea_mail_detail_line('Riferimento', '#' . (int)$documento_id)
            . dea_mail_detail_line('Subvettore', $subEtichetta)
            . dea_mail_detail_line($whenLabel, $whenVal);

        $innerOp = '<p style="margin:0 0 12px;">Gentile operatore,</p>'
            . '<p style="margin:0 0 12px;">' . $introOp . '</p>'
            . dea_mail_info_box($infoOp)
            . dea_mail_btn($loginUrl, 'Accedi all\'area di gestione');

        return array(
            'htmlSub'    => dea_mail_layout($title, $innerSub, $mailLogoUrl),
            'textSub'    => $textSub,
            'htmlOp'     => dea_mail_layout($title, $innerOp, $mailLogoUrl),
            'textOp'     => $textOp,
            'subjectSub' => $subjectSub,
            'subjectOp'  => $subjectOp,
            'title'      => $title,
        );
    }
}

// ---- main ----

$loginUrl = isset($_SESSION['sett_login_url']) ? trim((string)$_SESSION['sett_login_url']) : '';
if ($loginUrl === '') {
    $loginUrl = rtrim(trim(dea_mail_setting('login_url', '')), '/');
}

$oggi = date('Y-m-d');
$oggiMd = date('m-d');
$notifyExpire = date('Y-m-d H:i:s', strtotime('+30 days'));
$notifyFrom = 'admin';
$notifyProfile = 'Pigliacelli_Notifications';

sc_log_add('MAIL_DOCS_ALERT', 'START send_doc_expiry_alerts oggi=' . $oggi);

$operatori = dea_load_operatori();
$operatorEmails = $operatori['emails'];
$operatorLogins = $operatori['logins'];

// Carica regole attive
$rulesByTipo = array();
sc_lookup(rsDeaRules, "
    SELECT id, tipo_documento_id, rule_type, days_before, fixed_md, dest_scope
    FROM tipi_documento_alert
    WHERE active = 1
    ORDER BY tipo_documento_id, id
", 'pigliacelli');

if (!empty({rsDeaRules})) {
    foreach ({rsDeaRules} as $r) {
        $tid = (int)$r[1];
        if (!isset($rulesByTipo[$tid])) {
            $rulesByTipo[$tid] = array();
        }
        $rulesByTipo[$tid][] = array(
            'id'          => (int)$r[0],
            'rule_type'   => (string)$r[2],
            'days_before' => $r[3] === null || $r[3] === '' ? null : (int)$r[3],
            'fixed_md'    => $r[4] !== null ? (string)$r[4] : '',
            'dest_scope'  => (string)$r[5],
        );
    }
}

if (empty($rulesByTipo)) {
    sc_log_add('MAIL_DOCS_ALERT', 'Nessuna regola in tipi_documento_alert — END');
    return;
}

$sql = "
    SELECT
        d.id,
        d.tipo_documento_id,
        td.nome,
        d.data_scadenza,
        d.login,
        d.subvettore_id,
        COALESCE(s.login_subvettore, '') AS email_sub,
        COALESCE(s.ragione_sociale, '') AS ragione_sociale
    FROM documenti d
    INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
    LEFT JOIN subvettori s ON s.id = d.subvettore_id
    WHERE d.data_scadenza IS NOT NULL
      AND d.file IS NOT NULL AND TRIM(d.file) <> ''
      AND d.stato_documento_id IN (2, 3)
      AND d.tipo_documento_id IN (
          SELECT DISTINCT tipo_documento_id FROM tipi_documento_alert WHERE active = 1
      )
    ORDER BY d.data_scadenza, d.id
";

sc_select(dsDea, $sql, 'pigliacelli');

$statLetti = 0;
$statMatch = 0;
$statMailSub = 0;
$statMailOp = 0;
$statNotifSub = 0;
$statNotifOp = 0;

if ({dsDea} === false) {
    sc_log_add('MAIL_DOCS_ALERT', 'ERRORE query documenti');
} else {
    while (!{dsDea}->EOF) {
        $statLetti++;
        $documento_id    = (int){dsDea}->fields[0];
        $tipo_id         = (int){dsDea}->fields[1];
        $nome_documento  = trim((string){dsDea}->fields[2]);
        $data_scadenza_db = (string){dsDea}->fields[3];
        $login           = trim((string){dsDea}->fields[4]);
        $subvettore_id   = (int){dsDea}->fields[5];
        $emailSub        = trim((string){dsDea}->fields[6]);
        $ragione_sociale = trim((string){dsDea}->fields[7]);

        if (!isset($rulesByTipo[$tipo_id])) {
            {dsDea}->MoveNext();
            continue;
        }

        $tsScad = strtotime($data_scadenza_db);
        if ($tsScad === false) {
            {dsDea}->MoveNext();
            continue;
        }
        $data_scadenza_it = date('d/m/Y', $tsScad);
        $delta = (int)floor(($tsScad - strtotime($oggi)) / 86400);

        foreach ($rulesByTipo[$tipo_id] as $rule) {
            $match = false;
            $daysBeforeForMail = $rule['days_before'];
            $isFixed = ($rule['rule_type'] === 'fixed_md');

            if ($rule['rule_type'] === 'days_before') {
                $db = (int)$rule['days_before'];
                $match = ($delta === $db);
            } elseif ($rule['rule_type'] === 'fixed_md') {
                $match = ($oggiMd === $rule['fixed_md']);
                $daysBeforeForMail = ($rule['fixed_md'] === '01-31') ? 0 : 1;
            }

            if (!$match) {
                continue;
            }

            $statMatch++;
            $destScope = $rule['dest_scope'];
            $sendSub = ($destScope === 'sub' || $destScope === 'both');
            $sendOp  = ($destScope === 'ops' || $destScope === 'both');

            $emailSubvettore = dea_resolve_email($login, $emailSub);
            $subvettore_label = $subvettore_id > 0 ? (string)$subvettore_id : 'n/d';
            $ragione_label = $ragione_sociale !== '' ? $ragione_sociale : 'n/d';

            $mails = dea_build_mails(
                $documento_id,
                $nome_documento,
                $data_scadenza_it,
                $subvettore_label,
                $ragione_label,
                $loginUrl,
                $daysBeforeForMail,
                $isFixed,
                $rule['fixed_md']
            );

            $channels = array();

            if ($sendSub && $login !== '' && function_exists('sc_send_notification')) {
                try {
                    sc_send_notification(array(
                        'title'        => $mails['subjectSub'],
                        'message'      => $mails['textSub'],
                        'destiny_type' => 'user',
                        'to'           => $login,
                        'from'         => $notifyFrom,
                        'link'         => '',
                        'dtexpire'     => $notifyExpire,
                        'profile'      => $notifyProfile,
                    ));
                    $statNotifSub++;
                    $channels[] = 'notif_sub';
                } catch (Throwable $e) {
                    sc_log_add('MAIL_DOCS_ALERT', "notif sub ERR doc=$documento_id — " . $e->getMessage());
                }
            }

            if ($sendOp && !empty($operatorLogins) && function_exists('sc_send_notification')) {
                try {
                    sc_send_notification(array(
                        'title'        => $mails['subjectOp'],
                        'message'      => $mails['textOp'],
                        'destiny_type' => 'user',
                        'to'           => implode(';', $operatorLogins),
                        'from'         => $notifyFrom,
                        'link'         => '',
                        'dtexpire'     => $notifyExpire,
                        'profile'      => $notifyProfile,
                    ));
                    $statNotifOp++;
                    $channels[] = 'notif_op';
                } catch (Throwable $e) {
                    sc_log_add('MAIL_DOCS_ALERT', "notif op ERR doc=$documento_id — " . $e->getMessage());
                }
            }

            if ($sendSub && $emailSubvettore !== '') {
                try {
                    $mailOk = sc_send_mail_api(array_merge([sett_smtp], array(
                        'message' => array(
                            'html'    => $mails['htmlSub'],
                            'text'    => $mails['textSub'],
                            'to'      => $emailSubvettore,
                            'subject' => $mails['subjectSub'],
                        ),
                    )));
                    if ($mailOk !== false && $mailOk !== null) {
                        $statMailSub++;
                        $channels[] = 'mail_sub';
                    } else {
                        sc_log_add('MAIL_DOCS_ALERT', "mail sub FAIL doc=$documento_id dest=$emailSubvettore");
                    }
                } catch (Throwable $e) {
                    sc_log_add('MAIL_DOCS_ALERT', "mail sub ERR doc=$documento_id — " . $e->getMessage());
                }
            }

            if ($sendOp) {
                foreach ($operatorEmails as $emailOp) {
                    try {
                        $mailOkOp = sc_send_mail_api(array_merge([sett_smtp], array(
                            'message' => array(
                                'html'    => $mails['htmlOp'],
                                'text'    => $mails['textOp'],
                                'to'      => $emailOp,
                                'subject' => $mails['subjectOp'],
                            ),
                        )));
                        if ($mailOkOp !== false && $mailOkOp !== null) {
                            $statMailOp++;
                            if (!in_array('mail_op', $channels, true)) {
                                $channels[] = 'mail_op';
                            }
                        }
                    } catch (Throwable $e) {
                        sc_log_add('MAIL_DOCS_ALERT', "mail op ERR doc=$documento_id dest=$emailOp — " . $e->getMessage());
                    }
                }
            }

            sc_log_add(
                'MAIL_DOCS_ALERT',
                "SENT doc=$documento_id tipo=$tipo_id delta=$delta scope=$destScope ch=" . implode(',', $channels)
            );
        }

        {dsDea}->MoveNext();
    }
    {dsDea}->Close();
}

