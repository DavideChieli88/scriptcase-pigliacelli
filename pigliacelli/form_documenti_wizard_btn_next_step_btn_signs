/**
 * form_documenti_wizard → pulsante PHP next_step_btn_signs (label: Prossimo / Next)
 *
 * Step 4 → 5:
 * 1) Controlla documenti aziendali (upload, is_readonly=0)
 * 2) Se OK: wizard_step=5
 * 3) Redirect grid_documenti_to_sign_wizard
 *
 * Errori: flash in sessione + sc_redir (niente sc_error_message/sc_error_exit:
 * in alcuni contesti SC generano PHP non valido).
 * Globale SC: [subvettoreId]
 */

$subId = 0;
if (isset([subvettoreId]) && (int)[subvettoreId] > 0) {
    $subId = (int)[subvettoreId];
}
if ($subId <= 0) {
    $usrLogin = trim((string)[usr_login]);
    if ($usrLogin !== '' && strcasecmp($usrLogin, 'Guest') !== 0) {
        $loginSql = str_replace("'", "''", $usrLogin);
        sc_lookup(rsNextSub, "
            SELECT COALESCE(su.subvettore_id, 0)
            FROM sec_users su
            WHERE su.login = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');
        $subId = !empty({rsNextSub[0][0]}) ? (int){rsNextSub[0][0]} : 0;
    }
}

if ($subId <= 0) {
    $_SESSION['wizard_flash_msg'] = 'Subvettore non identificato.';
    sc_redir('blank_wizard_landing');
}

[subvettoreId] = $subId;

sc_lookup(rsWizDone, "
    SELECT COALESCE(wizard_complete, 0), COALESCE(wizard_step, 1)
    FROM subvettori
    WHERE id = $subId
    LIMIT 1
", 'pigliacelli');
$alreadyDone = !empty({rsWizDone[0][0]}) ? (int){rsWizDone[0][0]} : 0;

if ($alreadyDone === 1) {
    $_SESSION['wizard_flash_msg'] = 'Wizard gia completato.';
    sc_redir('app_menu');
}

sc_lookup(rsWizDocBad, "
    SELECT td.nome,
           COALESCE(td.mandatory, 0),
           COALESCE(td.flag_possesso, 0),
           COALESCE(d.in_possesso, 0),
           CASE WHEN d.file IS NOT NULL AND TRIM(d.file) <> '' THEN 1 ELSE 0 END,
           CASE WHEN d.data_scadenza IS NOT NULL THEN 1 ELSE 0 END
    FROM documenti d
    INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
    WHERE d.subvettore_id = $subId
      AND COALESCE(td.is_readonly, 0) = 0
      AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
      AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
      AND (
            (
                COALESCE(td.mandatory, 0) = 1
                AND COALESCE(td.flag_possesso, 0) = 0
                AND (
                    d.file IS NULL OR TRIM(d.file) = ''
                    OR d.data_scadenza IS NULL
                )
            )
            OR (
                COALESCE(td.flag_possesso, 0) = 1
                AND COALESCE(d.in_possesso, 0) = 1
                AND (d.file IS NULL OR TRIM(d.file) = '')
            )
          )
    ORDER BY td.nome
", 'pigliacelli');

$missing = array();
if (isset({rsWizDocBad[0][0]})) {
    foreach ({rsWizDocBad} as $row) {
        $nome = trim((string)$row[0]);
        $mand = (int)$row[1];
        $flagP = (int)$row[2];
        $inPoss = (int)$row[3];
        $hasFile = (int)$row[4];
        $hasScad = (int)$row[5];
        $parts = array();
        if ($hasFile !== 1) {
            $parts[] = 'file';
        }
        if ($mand === 1 && $flagP === 0 && $hasScad !== 1) {
            $parts[] = 'data scadenza';
        }
        if ($flagP === 1 && $inPoss === 1 && $hasFile !== 1 && empty($parts)) {
            $parts[] = 'file';
        }
        if (!empty($parts)) {
            $missing[] = ($nome !== '' ? $nome : 'Documento') . ' (' . implode(', ', $parts) . ')';
        }
    }
}

if (!empty($missing)) {
    $_SESSION['wizard_flash_msg'] = 'Completare i documenti obbligatori prima di proseguire: '
        . implode('; ', $missing);
    sc_redir('form_documenti_wizard', subvettoreId=[subvettoreId]);
}

sc_exec_sql("
    UPDATE subvettori
    SET wizard_step = 5
    WHERE id = $subId
      AND wizard_complete = 0
", 'pigliacelli');

// Crea subito i documenti verdi (is_readonly=1): la SQL della grid
// può girare PRIMA di onScriptInit, quindi non bastare ensure lì.
$usrLoginIns = trim((string)[usr_login]);
$loginIns = $usrLoginIns;
sc_lookup(rsVerdiLogin, "
    SELECT COALESCE(login_subvettore, '')
    FROM subvettori
    WHERE id = $subId
    LIMIT 1
", 'pigliacelli');
if (!empty({rsVerdiLogin[0][0]}) && trim((string){rsVerdiLogin[0][0]}) !== '') {
    $loginIns = trim((string){rsVerdiLogin[0][0]});
}
$loginInsSql = str_replace("'", "''", $loginIns);
$phSql = 'placeholder_documento_verde.pdf';
sc_lookup(rsVerdiPh, "
    SELECT set_value FROM sec_settings
    WHERE set_name = 'documento_verde_placeholder'
    LIMIT 1
", 'pigliacelli');
if (!empty({rsVerdiPh[0][0]}) && trim((string){rsVerdiPh[0][0]}) !== '') {
    $phSql = str_replace("'", "''", trim((string){rsVerdiPh[0][0]}));
}

sc_exec_sql("
    INSERT INTO documenti (tipo_documento_id, subvettore_id, login, stato_documento_id, file)
    SELECT td.id, $subId, '$loginInsSql', 1,
        CASE
            WHEN LOWER(COALESCE(td.nome, '')) LIKE '%dichiaraz%' THEN NULL
            ELSE '$phSql'
        END
    FROM tipi_documento td
    WHERE COALESCE(td.is_readonly, 0) = 1
      AND NOT EXISTS (
          SELECT 1
          FROM documenti d
          WHERE d.subvettore_id = $subId
            AND d.tipo_documento_id = td.id
            AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
            AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
      )
", 'pigliacelli');

// Pulisci id documento dello step 4 (altrimenti Firma al 1° click usa il giallo)
[documentoId] = 0;
if (isset($_SESSION['documentoId'])) {
    unset($_SESSION['documentoId']);
}
if (isset($_SESSION['pdf_next'])) {
    unset($_SESSION['pdf_next']);
}
$_SESSION['wizard_subvettore_id'] = $subId;

$_SESSION['wizard_flash_msg'] = 'Documenti caricati. Firmare i documenti predisposti e poi inviare per attivazione.';
sc_redir('grid_documenti_to_sign_wizard', subvettoreId=[subvettoreId]);
