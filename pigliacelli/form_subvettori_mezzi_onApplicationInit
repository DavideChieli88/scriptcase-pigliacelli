/**
 * form_subvettori_mezzi → onApplicationInit
 */

if (!isset([subvettoreId]) || (int)[subvettoreId] <= 0) {
    if (session_status() !== PHP_SESSION_ACTIVE) {
        @session_start();
    }

    $subId = 0;

    if (isset($_GET['subvettoreId']) && (int)$_GET['subvettoreId'] > 0) {
        $subId = (int)$_GET['subvettoreId'];
    } elseif (isset($_REQUEST['subvettoreId']) && (int)$_REQUEST['subvettoreId'] > 0) {
        $subId = (int)$_REQUEST['subvettoreId'];
    } elseif (isset($_SESSION['wizard_subvettore_id']) && (int)$_SESSION['wizard_subvettore_id'] > 0) {
        $subId = (int)$_SESSION['wizard_subvettore_id'];
    }

    if ($subId > 0) {
        [subvettoreId] = $subId;
        $_SESSION['wizard_subvettore_id'] = $subId;
    }
}
