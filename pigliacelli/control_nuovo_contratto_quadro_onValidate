/**
 * control_nuovo_contratto_quadro → onValidate
 *
 * App Control (nessuna tabella). Campi:
 *   subvettore_id  Select
 *   Lookup: solo chi non ha gia un contratto tipo 1
 *   SELECT s.id, CONCAT(COALESCE(s.codice_sga, ''), ' - ', s.ragione_sociale)
 *   FROM subvettori s
 *   WHERE NOT EXISTS (
 *       SELECT 1
 *       FROM subvettori_contratti sc
 *       INNER JOIN contratti c ON c.id = sc.contratto_id
 *       WHERE sc.subvettore_id = s.id
 *         AND c.tipo_contratto_id = 1
 *   )
 *   ORDER BY s.ragione_sociale
 *
 *   template_id  Select (N1)
 *   Lookup:
 *   SELECT id, nome
 *   FROM contratti_template
 *   WHERE attivo = 1
 *   ORDER BY is_default DESC, nome ASC
 *
 * Prima del save: wizard_complete deve essere 1.
 * Il blank nuovo_contratto_quadro crea il tipo 1, collega tratte,
 * salva template_id e copia html_body → html_body_snapshot.
 */
$subId = isset({subvettore_id}) ? (int){subvettore_id} : 0;
if ($subId <= 0) {
    sc_error_message('Selezionare un subvettore.');
    return;
}

$templateId = 0;
if (isset({template_id})) {
    $templateId = (int){template_id};
}

// Se non scelto: usa il default attivo
if ($templateId <= 0) {
    sc_lookup(rsNcqTplDef, "
        SELECT id
        FROM contratti_template
        WHERE attivo = 1
        ORDER BY is_default DESC, id ASC
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsNcqTplDef[0][0]})) {
        $templateId = (int){rsNcqTplDef[0][0]};
    }
}

if ($templateId <= 0) {
    sc_error_message(
        'Nessun template contratto disponibile. '
        . 'Crearne uno in Template contratti (form_contratti_template) e impostarlo attivo.'
    );
    return;
}

sc_lookup(rsNcqTplOk, "
    SELECT id
    FROM contratti_template
    WHERE id = " . (int)$templateId . "
      AND attivo = 1
    LIMIT 1
", 'pigliacelli');
if (empty({rsNcqTplOk})) {
    sc_error_message('Template non valido o non attivo.');
    return;
}

sc_lookup(rsNcqWiz, "
    SELECT COALESCE(wizard_complete, 0)
    FROM subvettori
    WHERE id = " . (int)$subId . "
    LIMIT 1
", 'pigliacelli');

if (empty({rsNcqWiz})) {
    sc_error_message('Subvettore non trovato.');
    return;
}

if ((int){rsNcqWiz[0][0]} !== 1) {
    sc_error_message('Questo subvettore non ha completato il wizard. Completare l\'onboarding prima di creare il contratto quadro.');
    return;
}

// Pre-check tratte: altrimenti il blank torna alla grid e in modale l'alert spariva
sc_lookup(rsNcqTrattePre, "
    SELECT COUNT(*)
    FROM tratte
    WHERE subvettore_id = " . (int)$subId . "
      AND tariffa IS NOT NULL
      AND tariffa > 0
", 'pigliacelli');
$nTrattePre = empty({rsNcqTrattePre[0][0]}) ? 0 : (int){rsNcqTrattePre[0][0]};
if ($nTrattePre <= 0) {
    sc_error_message(
        'Nessuna tratta con tariffa valida per questo subvettore. '
        . 'Inserire almeno una tratta (tariffa > 0) prima di creare il contratto quadro.'
    );
    return;
}

// Globali SC piu' affidabili dei soli parametri in sc_redir (modale)
[subvettoreId] = $subId;
[templateId] = $templateId;
sc_redir('nuovo_contratto_quadro', subvettoreId=$subId; templateId=$templateId);
