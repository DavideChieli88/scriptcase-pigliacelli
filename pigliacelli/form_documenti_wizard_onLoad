/**
 * form_documenti_wizard → onLoad
 *
 * Form multirecord: Avanti e Indietro restano visibili anche dopo il salvataggio.
 * btn_chiudi_modale era il Chiudi della modale. In griglia resta spento.
 *
 * Name pulsanti SC:
 *   - next_step_btn_signs   (Prossimo / Next → step 6)
 *   - back_btn_docs
 *   - send_for_activation   (legacy: sempre off qui)
 */

sc_btn_display('send_for_activation', 'off');
sc_btn_display('next_step_btn_signs', 'on');
sc_btn_display('back_btn_docs', 'on');
sc_btn_display('exit', 'off');
sc_btn_display('sair', 'off');
sc_btn_display('back', 'off');
// Modale non più usata. Il nome in toolbar è btn_chiudi_modale.
sc_btn_display('btn_chiudi_modale', 'off');
sc_btn_display('btn_chiudi_modale_3', 'off');

// Editable grid: sc_field_display vale per tutta la colonna.
// Una riga con flag_possesso=1, dopo il salvataggio, accendeva
// "In possesso" anche sui documenti che non lo usano.
sc_field_display({in_possesso}, 'off');
