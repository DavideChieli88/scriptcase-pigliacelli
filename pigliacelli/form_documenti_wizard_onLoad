/**
 * form_documenti_wizard → onLoad
 *
 * Editable grid (view) + modale di edit (*_inline).
 * Griglia: Prossimo (next_step_btn_signs) e Avanti (back_btn_docs) accesi, Chiudi spento.
 * Modale: Prossimo e Avanti spenti, Chiudi custom acceso.
 * Exit nativo sempre spento.
 *
 * Toolbar: back_btn_docs, next_step_btn_signs, btn_chiudi_modale_3, Exit.
 */

$op = '';
if (isset($this->nmgp_opcao)) {
    $op = strtolower(trim((string)$this->nmgp_opcao));
} elseif (isset($_POST['nmgp_opcao'])) {
    $op = strtolower(trim((string)$_POST['nmgp_opcao']));
} elseif (isset($_GET['nmgp_opcao'])) {
    $op = strtolower(trim((string)$_GET['nmgp_opcao']));
}

$isInline = false;
$codApl = (isset($this->Ini->nm_cod_apl) ? (string)$this->Ini->nm_cod_apl : '');
$checks = array(
    $codApl,
    (string)__FILE__,
    isset($_SERVER['PHP_SELF']) ? (string)$_SERVER['PHP_SELF'] : '',
    isset($_SERVER['SCRIPT_NAME']) ? (string)$_SERVER['SCRIPT_NAME'] : '',
    isset($_SERVER['REQUEST_URI']) ? (string)$_SERVER['REQUEST_URI'] : '',
    isset($_SERVER['SCRIPT_FILENAME']) ? (string)$_SERVER['SCRIPT_FILENAME'] : '',
);
foreach ($checks as $p) {
    $p = str_replace('\\', '/', strtolower($p));
    if ($p !== '' && (
        substr($p, -7) === '_inline'
        || strpos($p, '_inline/') !== false
        || strpos($p, '_inline.') !== false
        || strpos($p, '_inline_') !== false
    )) {
        $isInline = true;
        break;
    }
}
if (!$isInline && ($op === 'recarga' || $op === 'reload')) {
    $isInline = true;
}

sc_btn_display('send_for_activation', 'off');
sc_btn_display('exit', 'off');
sc_btn_display('sair', 'off');

$wizComplete = 0;
$subNav = isset([subvettoreId]) ? (int)[subvettoreId] : 0;
if ($subNav > 0) {
    sc_lookup(rsDocWizNav, "
        SELECT COALESCE(wizard_complete, 0)
        FROM subvettori
        WHERE id = $subNav
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsDocWizNav[0][0]})) {
        $wizComplete = (int){rsDocWizNav[0][0]};
    }
}

if ($isInline) {
    sc_btn_display('next_step_btn_signs', 'off');
    sc_btn_display('back_btn_docs', 'off');
    sc_btn_display('forward', 'off');
    sc_btn_display('next', 'off');
    sc_btn_display('back', 'off');
    sc_btn_display('update', 'on');
    sc_btn_display('ok', 'on');
    sc_btn_display('save', 'on');
    sc_btn_display('btn_chiudi_modale', 'on');
    sc_btn_display('btn_chiudi_modale_3', 'on');
} else {
    if ($wizComplete === 0) {
        sc_btn_display('next_step_btn_signs', 'on');
        sc_btn_display('back_btn_docs', 'on');
    } else {
        sc_btn_display('next_step_btn_signs', 'off');
        sc_btn_display('back_btn_docs', 'off');
    }
    sc_btn_display('btn_chiudi_modale', 'off');
    sc_btn_display('btn_chiudi_modale_3', 'off');
}

// Editable grid: sc_field_display vale per tutta la colonna.
// Una riga con flag_possesso=1, dopo il salvataggio, accendeva
// "In possesso" anche sui documenti che non lo usano.
sc_field_display({in_possesso}, 'off');
