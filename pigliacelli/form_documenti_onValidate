/**
 * form_documenti → onValidate
 * group_id = 2: file + data_scadenza obbligatori.
 * altri gruppi: subvettore_id obbligatorio (login risolto in onBeforeInsert/Update).
 */

sc_lookup(rsGrp, "SELECT group_id FROM sec_users_groups WHERE login = '[usr_login]' LIMIT 1");
$groupId = !empty({rsGrp[0][0]}) ? (int){rsGrp[0][0]} : 0;

if ($groupId === 2) {
    $err = array();

    if (empty({data_scadenza}) || {data_scadenza} == 'null') {
        $err[] = 'data di scadenza';
    }

    $hasFile = trim((string){file}) !== '';
    if (!$hasFile && !empty($_FILES)) {
        foreach ($_FILES as $up) {
            if (!empty($up['name'])) {
                $hasFile = true;
                break;
            }
        }
    }
    if (!$hasFile) {
        $err[] = 'file';
    }

    if (!empty($err)) {
        sc_error_message('Obbligatorio: ' . implode(' e ', $err) . '.');
    }
    return;
}

if ((int){subvettore_id} <= 0) {
    sc_error_message('Obbligatorio: subvettore.');
}
