/**
 * dashboard_dettaglio_subvettore → onApplicationInit
 *
 * Doc SC: primo evento, PRIMA di SQL/HTML. Globali OK.
 * DB NON ancora aperto → niente sc_lookup.
 *
 * Il warning PHP 8.2 "Creation of dynamic property ...::$sc_temp_subvettoreId"
 * e' codice GENERATO da SC (index.php), non questo evento. Non si sistema da qui.
 *
 * IDE — dashboard:
 *   subvettoreId → Integer, default 0, NON richiedere a startup
 *   (IN se il link della grid lo passa; mai stringa 'null')
 *
 * IDE — link dalla grid verso questa dashboard:
 *   subvettoreId = {id}
 *   NON passare subvettoreContrattoId
 *
 * IDE — ogni widget (le 5 grid):
 *   parametro subvettoreId = [subvettoreId] della dashboard
 *   SQL: WHERE subvettore_id = [subvettoreId]
 *
 * Risolve: GET / REQUEST / [subvettoreId] gia' in sessione dal link.
 * Niente $_SESSION['scriptcase']['subvettore_id'] (non esiste in questo progetto).
 */

if (!isset([subvettoreId]) || (string)[subvettoreId] === '' || (int)[subvettoreId] < 0) {
    [subvettoreId] = 0;
}

$subId = 0;

if (isset($_GET['subvettoreId']) && (int)$_GET['subvettoreId'] > 0) {
    $subId = (int)$_GET['subvettoreId'];
} elseif (isset($_REQUEST['subvettoreId']) && (int)$_REQUEST['subvettoreId'] > 0) {
    $subId = (int)$_REQUEST['subvettoreId'];
} elseif ((int)[subvettoreId] > 0) {
    $subId = (int)[subvettoreId];
}

[subvettoreId] = $subId > 0 ? $subId : 0;
