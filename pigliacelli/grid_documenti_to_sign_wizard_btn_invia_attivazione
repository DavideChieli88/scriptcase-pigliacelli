/**
 * grid_documenti_to_sign_wizard → Toolbar PHP: send_for_activation
 * Label: "Invia per attivazione"
 *
 * Pulsante PHP (non Ajax): sc_alert qui non parte.
 * Errori: testo in $_SESSION + sc_redir sulla stessa grid (niente globali SC).
 * onScriptInit se la sessione ha il testo → sc_alert, poi unset.
 *
 * Requisiti: tutti i documenti verdi firmati (firmato_il).
 * Effetto: wizard_complete=1 + mail/notifica operatori gruppi 1 e 3.
 *
 * Globale SC: [subvettoreId]
 */

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}

$subId = 0;
if (isset([subvettoreId]) && (int)[subvettoreId] > 0) {
    $subId = (int)[subvettoreId];
}
if ($subId <= 0) {
    $usrLogin = trim((string)[usr_login]);
    if ($usrLogin !== '' && strcasecmp($usrLogin, 'Guest') !== 0) {
        $loginSql = str_replace("'", "''", $usrLogin);
        sc_lookup(rsAttSub, "
            SELECT COALESCE(su.subvettore_id, 0)
            FROM sec_users su
            WHERE su.login = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');
        $subId = !empty({rsAttSub[0][0]}) ? (int){rsAttSub[0][0]} : 0;
    }
}

$blockMsg = '';
$already = 0;
$ragione = '';
$loginSub = '';
$tot = 0;
$firmati = 0;

if ($subId <= 0) {
    $blockMsg = 'Subvettore non identificato.';
} else {
    [subvettoreId] = $subId;

    sc_lookup(rsAttDone, "
        SELECT COALESCE(wizard_complete, 0), COALESCE(ragione_sociale, ''), COALESCE(login_subvettore, '')
        FROM subvettori
        WHERE id = $subId
        LIMIT 1
    ", 'pigliacelli');
    $already = !empty({rsAttDone[0][0]}) ? (int){rsAttDone[0][0]} : 0;
    $ragione = !empty({rsAttDone[0][1]}) ? trim((string){rsAttDone[0][1]}) : '';
    $loginSub = !empty({rsAttDone[0][2]}) ? trim((string){rsAttDone[0][2]}) : '';

    if ($already === 1) {
        $blockMsg = 'Wizard gia\' completato. Gli operatori sono stati avvisati.';
    } else {
        sc_lookup(rsAttCnt, "
            SELECT
                COUNT(*) AS tot,
                SUM(CASE WHEN d.firmato_il IS NOT NULL AND d.firmato_il <> '0000-00-00 00:00:00' THEN 1 ELSE 0 END) AS firmati
            FROM documenti d
            INNER JOIN tipi_documento td ON td.id = d.tipo_documento_id
            WHERE d.subvettore_id = $subId
              AND COALESCE(td.is_readonly, 0) = 1
              AND (d.subvettore_autista_id IS NULL OR d.subvettore_autista_id = 0)
              AND (d.subvettore_mezzo_id IS NULL OR d.subvettore_mezzo_id = 0)
        ", 'pigliacelli');
        $tot = !empty({rsAttCnt[0][0]}) ? (int){rsAttCnt[0][0]} : 0;
        $firmati = !empty({rsAttCnt[0][1]}) ? (int){rsAttCnt[0][1]} : 0;

        if ($tot <= 0) {
            $blockMsg = 'Nessun documento da firmare configurato.';
        } elseif ($firmati < $tot) {
            $blockMsg = 'Firmare tutti i documenti prima di inviare per attivazione. '
                . 'Firmati: ' . $firmati . ' / ' . $tot . '.';
        }
    }
}

$redirApp = 'grid_documenti_to_sign_wizard';
if ($blockMsg !== '') {
    $_SESSION['wizard_flash_msg'] = $blockMsg;
} else {
    sc_exec_sql("
        UPDATE subvettori
        SET wizard_complete = 1, wizard_step = 0
        WHERE id = $subId AND wizard_complete = 0
    ", 'pigliacelli');

    // --- mail + notifica operatori (gruppi 1, 3) ---
    sc_lookup(rsAttOps, "
        SELECT DISTINCT su.login, su.email
        FROM sec_users su
        INNER JOIN sec_users_groups sug ON sug.login = su.login
        WHERE su.active = 'Y'
          AND su.login IS NOT NULL
          AND TRIM(su.login) <> ''
          AND su.email IS NOT NULL
          AND TRIM(su.email) <> ''
          AND sug.group_id IN (1, 3)
    ", 'pigliacelli');

    $emailPlaceholder = array('admin@admin.com', 'admin@localhost', 'admin@example.com');
    $destinatari = array();
    $operatorLogins = array();

    if (isset({rsAttOps[0][0]})) {
        foreach ({rsAttOps} as $row) {
            $loginOp = trim((string)$row[0]);
            $email = strtolower(trim((string)$row[1]));
            if ($loginOp === '' || strcasecmp($loginOp, 'Guest') === 0) {
                continue;
            }
            if ($email === '' || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
                continue;
            }
            if (in_array($email, $emailPlaceholder, true)) {
                continue;
            }
            $destinatari[] = $email;
            $operatorLogins[] = $loginOp;
        }
    }
    $destinatari = array_values(array_unique($destinatari));
    $operatorLogins = array_values(array_unique($operatorLogins));

    $loginUrl = '';
    sc_lookup(rsAttLoginUrl, "
        SELECT set_value FROM sec_settings WHERE set_name = 'login_url' LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsAttLoginUrl[0][0]})) {
        $loginUrl = rtrim(trim((string){rsAttLoginUrl[0][0]}), '/');
    }

    sc_lookup(rsAttSmtp, "SELECT set_name, set_value FROM sec_settings", 'pigliacelli');
    if (isset({rsAttSmtp[0][0]})) {
        foreach ({rsAttSmtp} as $f) {
            $_SESSION['sett_' . $f[0]] = $f[1];
        }
    }

    $sett_smtp = array();
    if (isset($_SESSION['sett_smtp_api']) && $_SESSION['sett_smtp_api'] === 'custom') {
        $sett_smtp = array(
            'settings' => array(
                'gateway'       => 'smtp',
                'smtp_server'   => $_SESSION['sett_smtp_server'],
                'smtp_protocol' => $_SESSION['sett_smtp_security'],
                'smtp_port'     => $_SESSION['sett_smtp_port'],
                'smtp_user'     => $_SESSION['sett_smtp_user'],
                'smtp_password' => $_SESSION['sett_smtp_pass'],
                'from_email'    => $_SESSION['sett_smtp_from_email'],
                'from_name'     => $_SESSION['sett_smtp_from_name'],
            ),
        );
    } else {
        $sett_smtp = array('profile' => isset($_SESSION['sett_smtp_api']) ? $_SESSION['sett_smtp_api'] : '');
    }

    $labelSub = $ragione !== '' ? $ragione : ('ID ' . $subId);
    $safeRagione = htmlspecialchars($labelSub, ENT_QUOTES, 'UTF-8');
    $safeLogin = htmlspecialchars($loginSub, ENT_QUOTES, 'UTF-8');
    $safeLoginUrl = htmlspecialchars($loginUrl, ENT_QUOTES, 'UTF-8');

    if (!empty($destinatari) && function_exists('sc_send_mail_api')) {
        $soggetto = 'Wizard completato — abilitare subvettore ' . $labelSub;
        $testoPlain = "Gentile operatore,\n\n"
            . "il subvettore $labelSub ha completato il wizard di onboarding.\n\n"
            . "Subvettore: $labelSub\n"
            . ($loginSub !== '' ? "Login: $loginSub\n" : '')
            . "ID: $subId\n\n"
            . "Verificare i documenti e abilitare il subvettore se tutto e' corretto.\n\n"
            . ($loginUrl !== '' ? "Accesso: $loginUrl\n\n" : '')
            . "Messaggio automatico — non rispondere.";

        $btnHtml = '';
        if ($loginUrl !== '') {
            $btnHtml = '<p style="margin:24px 0 8px;text-align:center;">'
                . '<a href="' . $safeLoginUrl . '" style="display:inline-block;padding:12px 26px;'
                . 'background:#1a3a5c;color:#ffffff;text-decoration:none;border-radius:8px;'
                . 'font-weight:bold;font-size:15px;">Accedi al portale</a></p>';
        }

        $infoBox = '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" '
            . 'style="margin:16px 0;background:#f7f9fb;border:1px solid #e2e8f0;border-radius:8px;">'
            . '<tr><td style="padding:14px 18px;font-size:14px;line-height:1.6;">'
            . '<strong style="color:#1a3a5c;">Subvettore:</strong> ' . $safeRagione . '<br>'
            . ($loginSub !== '' ? '<strong style="color:#1a3a5c;">Login:</strong> ' . $safeLogin . '<br>' : '')
            . '<strong style="color:#1a3a5c;">ID:</strong> ' . (int)$subId
            . '</td></tr></table>';

        $innerHtml = '<p style="margin:0 0 12px;">Gentile operatore,</p>'
            . '<p style="margin:0 0 12px;">il subvettore <strong>' . $safeRagione . '</strong> ha completato '
            . 'il wizard di onboarding.</p>'
            . $infoBox
            . '<p style="margin:0 0 12px;">Verificare i documenti caricati e <strong>abilitare il subvettore</strong> '
            . 'se tutto e\' corretto.</p>'
            . $btnHtml;

        $mailLogoUrl = '';
        $relLogo = '_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png';
        $dirLogo = realpath(dirname(__FILE__));
        for ($iLogo = 0; $iLogo < 12 && $dirLogo; $iLogo++) {
            $tryLogo = $dirLogo . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $relLogo);
            if (is_readable($tryLogo)) {
                $binLogo = @file_get_contents($tryLogo);
                if ($binLogo !== false && $binLogo !== '' && strlen($binLogo) < 500000) {
                    $mailLogoUrl = 'data:image/png;base64,' . base64_encode($binLogo);
                    break;
                }
            }
            $pLogo = dirname($dirLogo);
            if ($pLogo === $dirLogo) {
                break;
            }
            $dirLogo = $pLogo;
        }
        if ($mailLogoUrl === '') {
            sc_lookup(rsAttMailBase, "
                SELECT set_value FROM sec_settings WHERE set_name = 'mail_base_url' LIMIT 1
            ", 'pigliacelli');
            $baseMail = !empty({rsAttMailBase[0][0]}) ? rtrim(trim((string){rsAttMailBase[0][0]}), '/') : '';
            if ($baseMail !== '' && preg_match('#^https?://#i', $baseMail) === 1) {
                $mailLogoUrl = htmlspecialchars(
                    $baseMail . '/_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png',
                    ENT_QUOTES,
                    'UTF-8'
                );
            }
        }

        $logoTd = '';
        if ($mailLogoUrl !== '') {
            $logoTd = '<td align="right" valign="middle" style="width:148px;padding-left:16px;">'
                . '<img src="' . $mailLogoUrl . '" alt="Pigliacelli" width="140" '
                . 'style="display:block;max-width:140px;width:140px;height:auto;border:0;" />'
                . '</td>';
        }
        $mailTitle = 'Wizard completato — abilitazione subvettore';
        $safeTitle = htmlspecialchars($mailTitle, ENT_QUOTES, 'UTF-8');
        $testoHtml = '<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8">'
            . '<meta name="viewport" content="width=device-width,initial-scale=1">'
            . '<title>' . $safeTitle . '</title></head>'
            . '<body style="margin:0;padding:0;background:#eef1f4;">'
            . '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#eef1f4;">'
            . '<tr><td align="center" style="padding:32px 16px;">'
            . '<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" '
            . 'style="max-width:600px;width:100%;background:#fff;border-radius:12px;border:1px solid #dde1e6;">'
            . '<tr><td style="padding:22px 28px 18px;border-bottom:1px solid #e8ebef;background:#fafbfc;">'
            . '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>'
            . '<td valign="middle" style="font-family:Arial,Helvetica,sans-serif;font-size:19px;font-weight:bold;color:#1a3a5c;line-height:1.3;">'
            . $safeTitle . '</td>'
            . $logoTd . '</tr></table></td></tr>'
            . '<tr><td style="padding:26px 28px 22px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#2d3748;">'
            . $innerHtml . '</td></tr>'
            . '<tr><td style="padding:14px 28px;background:#f4f6f8;border-top:1px solid #e8ebef;'
            . 'font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#718096;">'
            . 'Messaggio automatico &mdash; non rispondere.</td></tr>'
            . '</table></td></tr></table></body></html>';

        foreach ($destinatari as $dest) {
            try {
                sc_send_mail_api(array_merge($sett_smtp, array(
                    'message' => array(
                        'to'      => $dest,
                        'subject' => $soggetto,
                        'html'    => $testoHtml,
                        'text'    => $testoPlain,
                    ),
                )));
            } catch (Exception $e) {
                // ignore
            }
        }
    }

    $notifyProfile = 'Pigliacelli_Notifications';
    sc_lookup(rsAttNotifyProf, "
        SELECT set_value FROM sec_settings WHERE set_name = 'notification_profile' LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsAttNotifyProf[0][0]})) {
        $tmpProf = trim((string){rsAttNotifyProf[0][0]});
        if ($tmpProf !== '') {
            $notifyProfile = $tmpProf;
        }
    }
    if (!empty($operatorLogins) && function_exists('sc_send_notification')) {
        $notifyTitle = 'Wizard completato — abilitare ' . $labelSub;
        $notifyMessage = 'Il subvettore ' . $labelSub
            . ' ha completato il wizard (firme verdi incluse). Verificare documenti e abilitare l\'account.';
        $notifyExpire = date('Y-m-d H:i:s', strtotime('+30 days'));
        $notifyTo = implode(';', $operatorLogins);
        try {
            sc_send_notification(array(
                'title'        => $notifyTitle,
                'message'      => $notifyMessage,
                'destiny_type' => 'user',
                'to'           => $notifyTo,
                'from'         => '',
                'link'         => '',
                'dtexpire'     => $notifyExpire,
                'profile'      => $notifyProfile,
            ));
        } catch (Exception $e) {
            // ignore
        }
    }

    $redirApp = 'app_menu';
}

sc_redir($redirApp);
