/**
 * form_subvettori_starting_wizard → onValidate
 *
 * Form SINGOLA = solo step 1 anagrafica (wizard multi-step SC dismesso).
 * Avanzamento: onBeforeUpdate imposta wizard_step=2; onAfterUpdate redirige.
 * Non usare sc_error_exit (AJAX).
 */

$errors = array();

$checkEmpty = function ($value) {
    $v = trim((string)$value);
    return ($v === '' || $v === 'null');
};

// --- Azienda ---
if ($checkEmpty(isset({ragione_sociale}) ? {ragione_sociale} : '')) {
    $errors[] = 'Ragione sociale';
}
if ($checkEmpty(isset({sede_citta}) ? {sede_citta} : '')) {
    $errors[] = 'Sede città';
}
if ($checkEmpty(isset({sede_prov}) ? {sede_prov} : '')) {
    $errors[] = 'Sede provincia';
}
if ($checkEmpty(isset({indirizzo}) ? {indirizzo} : '')) {
    $errors[] = 'Indirizzo';
}
if ($checkEmpty(isset({civico}) ? {civico} : '')) {
    $errors[] = 'Civico';
}
if ($checkEmpty(isset({cod_fiscale}) ? {cod_fiscale} : '')) {
    $errors[] = 'Codice fiscale';
}
if ($checkEmpty(isset({piva}) ? {piva} : '')) {
    $errors[] = 'Partita IVA';
}
if ($checkEmpty(isset({num_iscrizione_reg_imprese}) ? {num_iscrizione_reg_imprese} : '')) {
    $errors[] = 'Numero iscrizione Registro Imprese';
}
if ($checkEmpty(isset({locazione_iscrizione_reg_imprese}) ? {locazione_iscrizione_reg_imprese} : '')) {
    $errors[] = 'Luogo iscrizione Registro Imprese';
}
if ($checkEmpty(isset({rea}) ? {rea} : '')) {
    $errors[] = 'R.E.A.';
}
if ($checkEmpty(isset({phone}) ? {phone} : '')) {
    $errors[] = 'Telefono / cellulare';
}

// --- Albo conto terzi + pagamenti (SAL 16/09 P1) ---
if ($checkEmpty(isset({num_iscrizione_albo}) ? {num_iscrizione_albo} : '')) {
    $errors[] = 'Numero iscrizione Albo conto terzi';
}
if ($checkEmpty(isset({provincia_albo}) ? {provincia_albo} : '')) {
    $errors[] = 'Provincia Albo conto terzi';
}
if ($checkEmpty(isset({banca}) ? {banca} : '')) {
    $errors[] = 'Banca';
}
if ($checkEmpty(isset({iban}) ? {iban} : '')) {
    $errors[] = 'IBAN';
}
if ($checkEmpty(isset({codice_destinatario_sdi}) ? {codice_destinatario_sdi} : '')) {
    $errors[] = 'Codice destinatario SDI';
}

// --- Legale rappresentante ---
if ($checkEmpty(isset({nome_rappresentante}) ? {nome_rappresentante} : '')) {
    $errors[] = 'Nome legale rappresentante';
}
if ($checkEmpty(isset({cognome_rappresentante}) ? {cognome_rappresentante} : '')) {
    $errors[] = 'Cognome legale rappresentante';
}
if ($checkEmpty(isset({email_rappresentante}) ? {email_rappresentante} : '')) {
    $errors[] = 'Email legale rappresentante';
}
if ($checkEmpty(isset({telefono_rappresentante}) ? {telefono_rappresentante} : '')) {
    $errors[] = 'Telefono legale rappresentante';
}
if ($checkEmpty(isset({luogo_nascita_rappresentante}) ? {luogo_nascita_rappresentante} : '')) {
    $errors[] = 'Luogo di nascita rappresentante';
}
if ($checkEmpty(isset({prov_luogo_nascita_rappresentante}) ? {prov_luogo_nascita_rappresentante} : '')) {
    $errors[] = 'Provincia di nascita rappresentante';
}
if ($checkEmpty(isset({data_nascita_rappresentante}) ? {data_nascita_rappresentante} : '')) {
    $errors[] = 'Data di nascita rappresentante';
}
if ($checkEmpty(isset({cod_fiscale_rappresentante}) ? {cod_fiscale_rappresentante} : '')) {
    $errors[] = 'Codice fiscale legale rappresentante';
}
if ($checkEmpty(isset({residenza_citta_rappresentante}) ? {residenza_citta_rappresentante} : '')) {
    $errors[] = 'Residenza rappresentante – città';
}
if ($checkEmpty(isset({residenza_prov_rappresentante}) ? {residenza_prov_rappresentante} : '')) {
    $errors[] = 'Residenza rappresentante – provincia';
}
if ($checkEmpty(isset({residenza_indirizzo_rappresentante}) ? {residenza_indirizzo_rappresentante} : '')) {
    $errors[] = 'Residenza rappresentante – indirizzo';
}
if ($checkEmpty(isset({residenza_civico_rappresentante}) ? {residenza_civico_rappresentante} : '')) {
    $errors[] = 'Residenza rappresentante – civico';
}

$emailLr = isset({email_rappresentante}) ? trim((string){email_rappresentante}) : '';
if ($emailLr !== '' && filter_var($emailLr, FILTER_VALIDATE_EMAIL) === false) {
    $errors[] = 'Email legale rappresentante non valida';
}

if (!empty($errors)) {
    sc_error_message(
        "Compilare i campi obbligatori dell'anagrafica:\n- "
        . implode("\n- ", $errors)
    );
}
