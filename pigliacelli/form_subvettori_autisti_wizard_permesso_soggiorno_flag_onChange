/**
 * form_subvettori_autisti_wizard → Ajax onClick di permesso_soggiorno_flag
 *
 * Setup SC sul campo permesso_soggiorno_flag (Radio):
 *   1) "Reload form when value has changed" = OFF
 *   2) Ajax Events → nuovo evento → campo permesso_soggiorno_flag → onClick
 *      (NON onChange: la doc SC dice che il radio non è compatibile con onChange)
 *
 * Show/hide: file permesso_soggiorno + scadenza_permesso_soggiorno.
 */

$flagPermesso = {permesso_soggiorno_flag};
if ($flagPermesso === '' || $flagPermesso === null || $flagPermesso === 'undefined' || $flagPermesso === 'null') {
    $flagPermesso = 0;
}
$flagPermesso = ((int)$flagPermesso === 1) ? 1 : 0;

if ($flagPermesso === 1) {
    sc_field_display({permesso_soggiorno}, 'on');
    sc_field_display({scadenza_permesso_soggiorno}, 'on');
} else {
    sc_field_display({permesso_soggiorno}, 'off');
    sc_field_display({scadenza_permesso_soggiorno}, 'off');
}
