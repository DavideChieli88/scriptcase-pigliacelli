/**
 * onLoad — incollare su:
 *   - form_subvettori_contratti (form operatore)
 *
 * Per le form magic link usare:
 *   - form_subvettori_contratti_for_subvectors_onLoad
 *   - form_subvettori_contratti_magic_link_review_onLoad
 *
 * 1) Modale errore EasyGN (redirect con dati mancanti)
 * 2) Visibilità blocco autisti per tipoContrattoId (tipo 2/3 nascosto)
 * 3) Precaricamento anagrafica da subvettori.
 *    Telefono: phone, altrimenti cellphone.
 * 4) Rappresentante, albo e nascita: valore del contratto se compilato,
 *    altrimenti la colonna omonima di subvettori.
 * 5) Campi *_firmatario nascosti
 * 6) stato_contratto_id > 2: anagrafica master sola lettura; campi rappresentante sempre editabili;
 *    save_and_send_magic_link solo stato 1–2; pulsante Salva attivo per aggiornare il rappresentante
 *    Detail tratte/autisti: onScriptInit (sc_apl_conf + sc_lookup pigliacelli)
 */

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}

if (!empty($_SESSION['easygn_error_modal'])) {
    $msg = $_SESSION['easygn_error_modal'];
    unset($_SESSION['easygn_error_modal']);

    sc_ajax_message(
        $msg,
        "Dati mancanti per la firma",
        "error",
        "Y",
        0,
        "OK",
        "Y",
        "350",
        "auto"
    );
}

if (!function_exists('magic_link_form_tipo_contratto_id')) {
    function magic_link_form_tipo_contratto_id($scId)
    {
        if ((int)$scId > 0) {
            sc_lookup(rsTipoContrattoForm, "
                SELECT c.tipo_contratto_id
                FROM subvettori_contratti sc
                INNER JOIN contratti c ON c.id = sc.contratto_id
                WHERE sc.id = " . (int)$scId . "
                LIMIT 1
            ", "pigliacelli");

            if (!empty({rsTipoContrattoForm[0][0]})) {
                return (int){rsTipoContrattoForm[0][0]};
            }
        }

        if (isset({contratto_id}) && (int){contratto_id} > 0) {
            sc_lookup(rsTipoContrattoByContratto, "
                SELECT tipo_contratto_id
                FROM contratti
                WHERE id = " . (int){contratto_id} . "
                LIMIT 1
            ", "pigliacelli");

            if (!empty({rsTipoContrattoByContratto[0][0]})) {
                return (int){rsTipoContrattoByContratto[0][0]};
            }
        }

        return 0;
    }
}

if (!function_exists('magic_link_form_apply_tipo_contratto_visibility')) {
    function magic_link_form_apply_tipo_contratto_visibility($tipoContrattoId)
    {
        // num_iscrizione_albo: sempre visibile; obbligatorio solo tipo 1 in onValidate.
        $displayAutisti = in_array((int)$tipoContrattoId, array(2, 3), true) ? 'off' : 'on';
        sc_block_display(subvettori_autisti, $displayAutisti);
    }
}

$subvettoreId = 0;
if (isset({subvettore_id}) && (int){subvettore_id} > 0) {
    $subvettoreId = (int){subvettore_id};
}

$scId = 0;
if (isset({id}) && (int){id} > 0) {
    $scId = (int){id};
} elseif (isset([subvettore_contratto_id]) && (int)[subvettore_contratto_id] > 0) {
    $scId = (int)[subvettore_contratto_id];
}

magic_link_form_apply_tipo_contratto_visibility(magic_link_form_tipo_contratto_id($scId));

if ($subvettoreId <= 0 && $scId > 0) {
    sc_lookup(rsSubId, "
        SELECT subvettore_id
        FROM subvettori_contratti
        WHERE id = " . (int)$scId . "
        LIMIT 1
    ", "pigliacelli");
    if (!empty({rsSubId[0][0]})) {
        $subvettoreId = (int){rsSubId[0][0]};
    }
}

if ($subvettoreId > 0) {
    sc_lookup(rsSub, "
        SELECT
            ragione_sociale,
            sede_citta,
            sede_prov,
            indirizzo,
            civico,
            cod_fiscale,
            piva,
            num_iscrizione_reg_imprese,
            locazione_iscrizione_reg_imprese,
            rea,
            COALESCE(NULLIF(TRIM(phone), ''), NULLIF(TRIM(cellphone), ''))
        FROM subvettori
        WHERE id = " . (int)$subvettoreId . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({rsSub})) {
        {ragione_sociale}                  = (string){rsSub[0][0]};
        {sede_citta}                       = (string){rsSub[0][1]};
        {sede_prov}                        = (string){rsSub[0][2]};
        {indirizzo}                        = (string){rsSub[0][3]};
        {civico}                           = (string){rsSub[0][4]};
        {cod_fiscale}                      = (string){rsSub[0][5]};
        {piva}                             = (string){rsSub[0][6]};
        {num_iscrizione_reg_imprese}       = (string){rsSub[0][7]};
        {locazione_iscrizione_reg_imprese} = (string){rsSub[0][8]};
        {rea}                              = (string){rsSub[0][9]};
        {phone}                            = (string){rsSub[0][10]};
    }
}

if ($subvettoreId > 0) {
    sc_lookup(rsScLegal, "
        SELECT
            COALESCE(NULLIF(TRIM(sc.num_iscrizione_albo), ''), NULLIF(TRIM(s.num_iscrizione_albo), '')),
            COALESCE(NULLIF(TRIM(sc.nome_rappresentante), ''), NULLIF(TRIM(s.nome_rappresentante), '')),
            COALESCE(NULLIF(TRIM(sc.cognome_rappresentante), ''), NULLIF(TRIM(s.cognome_rappresentante), '')),
            COALESCE(NULLIF(TRIM(sc.email_rappresentante), ''), NULLIF(TRIM(s.email_rappresentante), '')),
            COALESCE(NULLIF(TRIM(sc.telefono_rappresentante), ''), NULLIF(TRIM(s.telefono_rappresentante), '')),
            COALESCE(NULLIF(TRIM(sc.luogo_nascita_rappresentante), ''), NULLIF(TRIM(s.luogo_nascita_rappresentante), '')),
            COALESCE(NULLIF(TRIM(sc.prov_luogo_nascita_rappresentante), ''), NULLIF(TRIM(s.prov_luogo_nascita_rappresentante), '')),
            COALESCE(
                IF(sc.data_nascita_rappresentante IS NULL OR sc.data_nascita_rappresentante < '1900-01-01', NULL, sc.data_nascita_rappresentante),
                IF(s.data_nascita_rappresentante IS NULL OR s.data_nascita_rappresentante < '1900-01-01', NULL, s.data_nascita_rappresentante)
            )
        FROM subvettori s
        LEFT JOIN subvettori_contratti sc
          ON sc.subvettore_id = s.id
         AND sc.id = " . (int)$scId . "
        WHERE s.id = " . (int)$subvettoreId . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({rsScLegal})) {
        {num_iscrizione_albo}               = (string){rsScLegal[0][0]};
        {nome_rappresentante}               = (string){rsScLegal[0][1]};
        {cognome_rappresentante}            = (string){rsScLegal[0][2]};
        {email_rappresentante}              = (string){rsScLegal[0][3]};
        {telefono_rappresentante}           = (string){rsScLegal[0][4]};
        {luogo_nascita_rappresentante}      = (string){rsScLegal[0][5]};
        {prov_luogo_nascita_rappresentante} = (string){rsScLegal[0][6]};
        {data_nascita_rappresentante}       = {rsScLegal[0][7]};
    }
}

if (!function_exists('pigliacelli_hide_campi_firmatario_form')) {
    function pigliacelli_hide_campi_firmatario_form()
    {
        foreach (array('nome_firmatario', 'cognome_firmatario', 'email_firmatario', 'telefono_firmatario') as $campo) {
            sc_field_display($campo, 'off');
        }
    }
}
pigliacelli_hide_campi_firmatario_form();

$statoContrattoForm = 0;
if ($scId > 0) {
    sc_lookup(rsStatoContrFormOp, "
        SELECT c.stato_contratto_id
        FROM subvettori_contratti sc
        INNER JOIN contratti c ON c.id = sc.contratto_id
        WHERE sc.id = " . (int)$scId . "
        LIMIT 1
    ", "pigliacelli");
    if (!empty({rsStatoContrFormOp[0][0]})) {
        $statoContrattoForm = (int){rsStatoContrFormOp[0][0]};
    }
}

// save_and_send_magic_link: solo stato 1–2 (Da inviare / Inviato al subvettore)
$displaySaveSendMagicLink = ($statoContrattoForm > 2) ? 'off' : 'on';
sc_btn_display('save_and_send_magic_link_ajax', $displaySaveSendMagicLink);

if ($statoContrattoForm > 2) {
    sc_field_readonly({subvettore_id}, 'on');
    sc_field_readonly({contratto_id}, 'on');
    sc_field_readonly({ragione_sociale}, 'on');
    sc_field_readonly({sede_citta}, 'on');
    sc_field_readonly({sede_prov}, 'on');
    sc_field_readonly({indirizzo}, 'on');
    sc_field_readonly({civico}, 'on');
    sc_field_readonly({cod_fiscale}, 'on');
    sc_field_readonly({piva}, 'on');
    sc_field_readonly({num_iscrizione_reg_imprese}, 'on');
    sc_field_readonly({locazione_iscrizione_reg_imprese}, 'on');
    sc_field_readonly({rea}, 'on');
    sc_field_readonly({phone}, 'on');
    sc_field_readonly({num_iscrizione_albo}, 'on');
    sc_field_readonly({nome_firmatario}, 'on');
    sc_field_readonly({cognome_firmatario}, 'on');
    sc_field_readonly({email_firmatario}, 'on');
    sc_field_readonly({telefono_firmatario}, 'on');

    // Rappresentante: sempre editabile (nome, email, nascita, ecc.)
    sc_field_readonly({nome_rappresentante}, 'off');
    sc_field_readonly({cognome_rappresentante}, 'off');
    sc_field_readonly({email_rappresentante}, 'off');
    sc_field_readonly({telefono_rappresentante}, 'off');
    sc_field_readonly({luogo_nascita_rappresentante}, 'off');
    sc_field_readonly({prov_luogo_nascita_rappresentante}, 'off');
    sc_field_readonly({prov_nascita_rappresentante}, 'off');
    sc_field_readonly({data_nascita_rappresentante}, 'off');

    sc_btn_display('delete', 'off');
    sc_btn_display('new', 'off');
}
