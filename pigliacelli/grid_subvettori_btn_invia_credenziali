}

if (!function_exists('gsc_invia_mail_credenziali')) {
    function gsc_invia_mail_credenziali($to, $login, $plainPassword, $displayName)
    {
        $to = trim((string)$to);
        $login = trim((string)$login);
        $plainPassword = (string)$plainPassword;

        if ($plainPassword === '' || !gsc_email_valida($to) || $login === '') {
            return false;
        }
        if (!function_exists('sc_send_mail_api')) {
            sc_log_add('GRID_CRED', 'SKIP sc_send_mail_api assente login=' . $login);
            return false;
        }

        $portalUrl = gsc_portal_url();
        $nome = trim((string)$displayName);
        if ($nome === '') {
            $nome = 'Gentile subvettore';
        }

        $titolo = 'Credenziali area riservata';
        $testo = $nome . ",\n\n"
            . "E' stato creato il tuo accesso all'area riservata subvettori.\n"
            . "Puoi accedere con le credenziali seguenti (password temporanea).\n\n"
            . "Login: " . $login . "\n"
            . "Password: " . $plainPassword . "\n";
        if ($portalUrl !== '') {
            $testo .= "\nArea riservata: " . $portalUrl . "\n";
        }
        $testo .= "\nMessaggio automatico — non rispondere.";

        $safeLogin = htmlspecialchars($login, ENT_QUOTES, 'UTF-8');
        $safePwd = htmlspecialchars($plainPassword, ENT_QUOTES, 'UTF-8');
        $safeNome = htmlspecialchars($nome, ENT_QUOTES, 'UTF-8');
        $inner = '<p style="margin:0 0 16px;">' . $safeNome . ',</p>'
            . '<p style="margin:0 0 20px;">E\' stato creato il tuo accesso all\'<strong>area riservata subvettori</strong>. '
            . 'Ecco le credenziali di accesso (password temporanea).</p>'
            . '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" '
            . 'style="margin:0 0 20px;background:#f8f9fb;border:1px solid #e2e6ea;border-radius:8px;">'
            . '<tr><td style="padding:16px 18px;font-size:14px;line-height:1.6;">'
            . '<strong>Login:</strong> ' . $safeLogin . '<br><strong>Password:</strong> ' . $safePwd
            . '</td></tr></table>';
        if ($portalUrl !== '') {
            $safePortal = htmlspecialchars($portalUrl, ENT_QUOTES, 'UTF-8');
            $inner .= '<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px;"><tr>'
                . '<td align="center" bgcolor="#1a3a5c" style="border-radius:8px;background-color:#1a3a5c;">'
                . '<a href="' . $safePortal . '" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;'
                . 'color:#ffffff;text-decoration:none;">Accedi all\'area riservata</a>'
                . '</td></tr></table>';
        }
        $html = gsc_mail_layout($titolo, $inner, gsc_mail_logo_src());

        try {
            $mailOk = sc_send_mail_api(array_merge(gsc_get_smtp_config(), array(
                'message' => array(
                    'html'    => $html,
                    'text'    => $testo,
                    'to'      => $to,
                    'subject' => $titolo,
                ),
            )));
            if ($mailOk === false || $mailOk === null) {
                return false;
            }
        } catch (Throwable $e) {
            sc_log_add('GRID_CRED', 'mail EXCEPTION login=' . $login . ' msg=' . $e->getMessage());
            return false;
        }
        return true;
    }
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

// Evita lookup vuoti / fatal PDO su tx già aperta (Ajax Action Bar)
sc_exec_sql('COMMIT');

$subId = isset({id}) ? (int){id} : 0;
sc_log_add('GRID_CRED', 'send_credentials_btn START sub=' . $subId);

if ($subId <= 0) {
    sc_ajax_message('Subvettore non identificato.');
    return;
}

sc_lookup(rsGscSub, "
    SELECT
        TRIM(COALESCE(login_subvettore, '')),
        TRIM(COALESCE(ragione_sociale, '')),
        mail_credenziali_inviata_at
    FROM subvettori
    WHERE id = $subId
    LIMIT 1
", 'pigliacelli');

if ((!isset({rsGscSub[0][0]}) || trim((string){rsGscSub[0][0]}) === '')
    && (!isset({rsGscSub[0][1]}) || trim((string){rsGscSub[0][1]}) === '')
) {
    sc_ajax_message('Subvettore non trovato (id=' . $subId . ').');
    return;
}

$login = isset({rsGscSub[0][0]}) ? trim((string){rsGscSub[0][0]}) : '';
$nome  = isset({rsGscSub[0][1]}) ? trim((string){rsGscSub[0][1]}) : '';
$inviataAt = isset({rsGscSub[0][2]}) ? {rsGscSub[0][2]} : null;

sc_log_add(
    'GRID_CRED',
    'sub row id=' . $subId . ' login=[' . $login . '] nome=[' . $nome . '] inviataAt=[' . (string)$inviataAt . ']'
);

if ($login === '' || !gsc_email_valida($login)) {
    sc_ajax_message('Email/login subvettore mancante o non valida (sub=' . $subId . ').');
    return;
}

if ($inviataAt !== '' && $inviataAt !== null && (string)$inviataAt !== 'null') {
    sc_ajax_message('Credenziali già inviate il ' . (string)$inviataAt . '.');
    return;
}

// Cerca utenza per login (case-insensitive) — non dipende dal join sul gruppo
sc_lookup(rsGscUser, "
    SELECT
        su.login,
        su.active,
        su.subvettore_id
    FROM sec_users su
    WHERE LOWER(su.login) = LOWER(" . gsc_sql_quote($login) . ")
    LIMIT 1
", 'pigliacelli');

$userLogin = (isset({rsGscUser[0][0]}) && trim((string){rsGscUser[0][0]}) !== '')
    ? trim((string){rsGscUser[0][0]})
    : '';
$userActive = isset({rsGscUser[0][1]}) ? trim((string){rsGscUser[0][1]}) : '';
$userSubId = isset({rsGscUser[0][2]}) && {rsGscUser[0][2]} !== null && {rsGscUser[0][2]} !== ''
    ? (int){rsGscUser[0][2]}
    : 0;

sc_log_add(
    'GRID_CRED',
    'lookup user login=[' . $login . '] found=' . ($userLogin !== '' ? '1' : '0')
        . ' active=[' . $userActive . '] sub_id=' . $userSubId . ' grid_sub=' . $subId
);

if ($userLogin === '') {
    // Fallback: utenza collegata al subvettore con login diverso
    sc_lookup(rsGscUserBySub, "
        SELECT su.login, su.active, su.subvettore_id
        FROM sec_users su
        WHERE su.subvettore_id = $subId
        LIMIT 1
    ", 'pigliacelli');
    $userLogin = !empty({rsGscUserBySub[0][0]}) ? trim((string){rsGscUserBySub[0][0]}) : '';
    $userActive = isset({rsGscUserBySub[0][1]}) ? trim((string){rsGscUserBySub[0][1]}) : '';
    $userSubId = isset({rsGscUserBySub[0][2]}) && {rsGscUserBySub[0][2]} !== null && {rsGscUserBySub[0][2]} !== ''
        ? (int){rsGscUserBySub[0][2]}
        : 0;
    if ($userLogin !== '') {
        sc_log_add('GRID_CRED', 'fallback by subvettore_id: login=[' . $userLogin . ']');
        $login = $userLogin;
    }
}

if ($userLogin === '') {
    sc_log_add('GRID_CRED', 'utenza assente: creo ora sub=' . $subId . ' login=' . $login);
    sc_lookup(rsGscPhone, "
        SELECT TRIM(COALESCE(phone, '')), TRIM(COALESCE(cellphone, ''))
        FROM subvettori
        WHERE id = $subId
        LIMIT 1
    ", 'pigliacelli');
    $phone = '';
    if (!empty({rsGscPhone[0][0]})) {
        $phone = trim((string){rsGscPhone[0][0]});
    }
    if ($phone === '' && !empty({rsGscPhone[0][1]})) {
        $phone = trim((string){rsGscPhone[0][1]});
    }

    $plainBootstrap = gsc_generate_temp_password();
    try {
        sc_exec_sql("
            INSERT INTO sec_users (
                login, pswd, name, email, phone, active, subvettore_id
            ) VALUES (
                " . gsc_sql_quote($login) . ",
                " . gsc_sql_quote(md5($plainBootstrap)) . ",
                " . gsc_sql_quote($nome) . ",
                " . gsc_sql_quote($login) . ",
                " . gsc_sql_quote($phone) . ",
                'Y',
                $subId
            )
        ", 'pigliacelli');
        sc_exec_sql("
            INSERT INTO sec_users_groups (login, group_id)
            VALUES (" . gsc_sql_quote($login) . ", 2)
        ", 'pigliacelli');
        sc_exec_sql('COMMIT');
        $userLogin = $login;
        $userActive = 'Y';
        $userSubId = $subId;
    } catch (Throwable $e) {
        sc_log_add('GRID_CRED', 'ERRORE create utenza sub=' . $subId . ' — ' . $e->getMessage());
        sc_ajax_message('Impossibile creare l\'utenza portale. Controllare i log.');
        return;
    }
}

// Allinea subvettore_id se manca o diverso
if ($userSubId !== $subId) {
    sc_log_add(
        'GRID_CRED',
        'fix subvettore_id su sec_users login=' . $login . ' old=' . $userSubId . ' new=' . $subId
    );
    try {
        sc_exec_sql("
            UPDATE sec_users
            SET subvettore_id = $subId
            WHERE login = " . gsc_sql_quote($login) . "
            LIMIT 1
        ", 'pigliacelli');
        $userSubId = $subId;
    } catch (Throwable $e) {
        sc_log_add('GRID_CRED', 'ERRORE link subvettore_id — ' . $e->getMessage());
        sc_ajax_message('Utenza trovata ma non collegabile al subvettore.');
        return;
    }
}

// Assicura gruppo 2
sc_lookup(rsGscGrp, "
    SELECT 1 FROM sec_users_groups
    WHERE login = " . gsc_sql_quote($login) . "
      AND group_id = 2
    LIMIT 1
", 'pigliacelli');
if (empty({rsGscGrp[0][0]})) {
    sc_log_add('GRID_CRED', 'manca group_id=2: lo aggiungo login=' . $login);
    try {
        sc_exec_sql("
            INSERT INTO sec_users_groups (login, group_id)
            VALUES (" . gsc_sql_quote($login) . ", 2)
        ", 'pigliacelli');
    } catch (Throwable $e) {
        sc_log_add('GRID_CRED', 'ERRORE add group 2 sub=' . $subId . ' — ' . $e->getMessage());
        sc_ajax_message('Utenza senza gruppo portale (2). Controllare i log.');
        return;
    }
}

if ($userActive !== 'Y') {
    sc_exec_sql("
        UPDATE sec_users SET active = 'Y'
        WHERE login = " . gsc_sql_quote($login) . "
        LIMIT 1
    ", 'pigliacelli');
}

$plain = gsc_generate_temp_password();
$hash  = md5($plain);

try {
    sc_exec_sql("
        UPDATE sec_users
        SET pswd = " . gsc_sql_quote($hash) . ",
            active = 'Y',
            subvettore_id = $subId
        WHERE login = " . gsc_sql_quote($login) . "
        LIMIT 1
    ", 'pigliacelli');
} catch (Throwable $e) {
    sc_log_add('GRID_CRED', 'ERRORE update pswd sub=' . $subId . ' — ' . $e->getMessage());
    sc_ajax_message('Errore aggiornamento password.');
    return;
}

$ok = gsc_invia_mail_credenziali($login, $login, $plain, $nome);
if (!$ok) {
    sc_log_add('GRID_CRED', 'FAIL mail sub=' . $subId . ' to=' . $login);
    sc_ajax_message('Invio mail fallito. Riprovare più tardi.');
    return;
}

try {
    sc_exec_sql("
        UPDATE subvettori
        SET mail_credenziali_inviata_at = NOW()
        WHERE id = $subId
    ", 'pigliacelli');
} catch (Throwable $e) {
    sc_log_add('GRID_CRED', 'WARN mail OK ma flag non aggiornato sub=' . $subId . ' — ' . $e->getMessage());
    sc_ajax_message('Mail inviata, ma flag non aggiornato. Controllare i log.');
    return;
}

sc_log_add('GRID_CRED', 'OK mail inviata sub=' . $subId . ' to=' . $login);
sc_ajax_message('Credenziali inviate a ' . $login . '.');

/*
 * --- onRecord (stessa grid) — show/hide pulsante ---
 *
 * $show = 0;
 * $mailAt = {mail_credenziali_inviata_at};
 * $loginRow = trim((string){login_subvettore});
 * if (($mailAt === '' || $mailAt === null || $mailAt === 'null') && $loginRow !== '') {
 *     $show = 1;
 * }
 * sc_btn_display('send_credentials_btn', $show === 1 ? 'on' : 'off');
 */
