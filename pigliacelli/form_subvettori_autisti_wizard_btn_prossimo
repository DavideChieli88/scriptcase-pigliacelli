/**
 * form_subvettori_autisti_wizard -> pulsante PHP "Prossimo"
 *
 * Errori: flash sessione + sc_redir (niente sc_alert/JS).
 */

$subId = isset([subvettoreId]) ? (int)[subvettoreId] : 0;
if ($subId <= 0 && isset($_SESSION['wizard_subvettore_id'])) {
    $subId = (int)$_SESSION['wizard_subvettore_id'];
}

sc_log_add('WIZARD', 'form_subvettori_autisti_wizard Prossimo START subvettoreId=' . $subId);

if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}

if ($subId <= 0) {
    $_SESSION['wizard_flash_msg'] = 'Subvettore non identificato.';
    sc_redir('blank_wizard_landing');
}

[subvettoreId] = $subId;
$_SESSION['wizard_subvettore_id'] = $subId;

sc_lookup(rsWizAutCnt, "
    SELECT COUNT(*) FROM subvettori_autisti WHERE subvettore_id = $subId
", 'pigliacelli');
$nAutisti = !empty({rsWizAutCnt[0][0]}) ? (int){rsWizAutCnt[0][0]} : 0;
if ($nAutisti < 1) {
    $_SESSION['wizard_flash_msg'] = 'Inserire almeno un autista prima di proseguire.';
    sc_redir('form_subvettori_autisti_wizard', subvettoreId=[subvettoreId]);
}

sc_lookup(rsWizAutBad, "
    SELECT COUNT(*)
    FROM subvettori_autisti sa
    WHERE sa.subvettore_id = $subId
      AND (
          (SELECT COUNT(*) FROM documenti d
           WHERE d.subvettore_autista_id = sa.id
             AND d.tipo_documento_id = 18
             AND d.file IS NOT NULL AND TRIM(d.file) <> '') < 1
          OR (SELECT COUNT(*) FROM documenti d
           WHERE d.subvettore_autista_id = sa.id
             AND d.tipo_documento_id = 19
             AND d.file IS NOT NULL AND TRIM(d.file) <> '') < 2
          OR (SELECT COUNT(*) FROM documenti d
           WHERE d.subvettore_autista_id = sa.id
             AND d.tipo_documento_id = 20
             AND d.file IS NOT NULL AND TRIM(d.file) <> '') < 1
          OR (SELECT COUNT(*) FROM documenti d
           WHERE d.subvettore_autista_id = sa.id
             AND d.tipo_documento_id = 21
             AND d.file IS NOT NULL AND TRIM(d.file) <> '') < 1
          OR (
              EXISTS (SELECT 1 FROM documenti d30
                      WHERE d30.subvettore_autista_id = sa.id
                        AND d30.tipo_documento_id = 30
                        AND d30.in_possesso = 1)
              AND (SELECT COUNT(*) FROM documenti d30f
                   WHERE d30f.subvettore_autista_id = sa.id
                     AND d30f.tipo_documento_id = 30
                     AND d30f.in_possesso = 1
                     AND d30f.file IS NOT NULL AND TRIM(d30f.file) <> '') < 1
          )
      )
", 'pigliacelli');
$nBad = !empty({rsWizAutBad[0][0]}) ? (int){rsWizAutBad[0][0]} : 0;
if ($nBad > 0) {
    $_SESSION['wizard_flash_msg'] = 'Caricare tutti i documenti obbligatori di ogni autista prima di proseguire.';
    sc_redir('form_subvettori_autisti_wizard', subvettoreId=[subvettoreId]);
}

sc_lookup(rsWizAutStep, "
    SELECT COALESCE(wizard_step, 1), COALESCE(wizard_complete, 0)
    FROM subvettori
    WHERE id = $subId
    LIMIT 1
", 'pigliacelli');
$wizStep = !empty({rsWizAutStep[0][0]}) ? (int){rsWizAutStep[0][0]} : 1;
$wizComplete = !empty({rsWizAutStep[0][1]}) ? (int){rsWizAutStep[0][1]} : 0;

if ($wizComplete === 0 && $wizStep === 2) {
    sc_exec_sql("
        UPDATE subvettori
        SET wizard_step = 3
        WHERE id = $subId
          AND wizard_complete = 0
          AND wizard_step = 2
    ", 'pigliacelli');
}

sc_exec_sql('COMMIT');

sc_log_add('WIZARD', 'form_subvettori_autisti_wizard Prossimo OK -> form_subvettori_mezzi subvettoreId=' . $subId);
sc_redir('form_subvettori_mezzi', subvettoreId=[subvettoreId]);
