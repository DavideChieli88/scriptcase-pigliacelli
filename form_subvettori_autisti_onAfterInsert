/**
 * form_subvettori_autisti_wizard → onAfterInsert
 * Campi virtuali reali: patente, cqc, formazione_sicurezza,
 * idoneita_sanitaria, dpi_iii_categoria, permesso_soggiorno
 */

$autistaId = (int){id};
$subId     = (int){subvettore_id};

sc_log_add('AUT_DOCS', "onAfterInsert START autista=$autistaId sub=$subId");

if ($autistaId <= 0 || $subId <= 0) {
    sc_error_message("AUT_DOCS: id autista o subvettore mancante.");
} else {

    // login FK
    $login = trim((string)[usr_login]);
    sc_lookup(rsLoginAny, "
        SELECT login
        FROM sec_users
        WHERE subvettore_id = $subId
        ORDER BY login
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsLoginAny[0][0]})) {
        $login = trim((string){rsLoginAny[0][0]});
    }
    $loginSql = str_replace("'", "''", $login);

    $fPatente   = trim((string){patente});
    $fCqc       = trim((string){cqc});
    $fFormaz    = trim((string){formazione_sicurezza});
    $fIdoneita  = trim((string){idoneita_sanitaria});
    $fDpi       = trim((string){dpi_iii_categoria});
    $fPermesso  = trim((string){permesso_soggiorno});

    sc_log_add('AUT_DOCS', "FILES patente=[$fPatente] cqc=[$fCqc] form=[$fFormaz] idoneita=[$fIdoneita] dpi=[$fDpi] perm=[$fPermesso] login=$login");

    if ($fPatente === '' && $fCqc === '' && $fFormaz === '' && $fIdoneita === '' && $fDpi === '' && $fPermesso === '') {
        sc_error_message("AUT_DOCS: nessun file ricevuto (patente/cqc/…).");
    }

    // 18 idoneità
    if ($fIdoneita !== '') {
        $fileSql = str_replace("'", "''", basename($fIdoneita));
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
            VALUES (18, $subId, $autistaId, '$loginSql', 1, '$fileSql')
        ", 'pigliacelli');
        sc_log_add('AUT_DOCS', "INSERT 18 $fileSql");
    }

    // 19 patente (prima riga tipo 19)
    if ($fPatente !== '') {
        $fileSql = str_replace("'", "''", basename($fPatente));
        $scadSql = 'NULL';
        if (isset({scadenza_patente}) && {scadenza_patente} !== '' && {scadenza_patente} !== 'null') {
            $scadSql = "'" . str_replace("'", "''", (string){scadenza_patente}) . "'";
        }
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
            VALUES (19, $subId, $autistaId, '$loginSql', 1, '$fileSql', $scadSql)
        ", 'pigliacelli');
        sc_log_add('AUT_DOCS', "INSERT 19 patente $fileSql");
    }

    // 19 cqc (seconda riga stesso tipo — Patenti e CQC)
    if ($fCqc !== '') {
        $fileSql = str_replace("'", "''", basename($fCqc));
        $scadSql = 'NULL';
        if (isset({scadenza_cqc}) && {scadenza_cqc} !== '' && {scadenza_cqc} !== 'null') {
            $scadSql = "'" . str_replace("'", "''", (string){scadenza_cqc}) . "'";
        }
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
            VALUES (19, $subId, $autistaId, '$loginSql', 1, '$fileSql', $scadSql)
        ", 'pigliacelli');
        sc_log_add('AUT_DOCS', "INSERT 19 cqc $fileSql");
    }

    // 20 formazione
    if ($fFormaz !== '') {
        $fileSql = str_replace("'", "''", basename($fFormaz));
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
            VALUES (20, $subId, $autistaId, '$loginSql', 1, '$fileSql')
        ", 'pigliacelli');
        sc_log_add('AUT_DOCS', "INSERT 20 $fileSql");
    }

    // 21 DPI
    if ($fDpi !== '') {
        $fileSql = str_replace("'", "''", basename($fDpi));
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
            VALUES (21, $subId, $autistaId, '$loginSql', 1, '$fileSql')
        ", 'pigliacelli');
        sc_log_add('AUT_DOCS', "INSERT 21 $fileSql");
    }

    // 30 permesso
    if ($fPermesso !== '') {
        $fileSql = str_replace("'", "''", basename($fPermesso));
        sc_exec_sql("
            INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
            VALUES (30, $subId, $autistaId, '$loginSql', 1, '$fileSql')
        ", 'pigliacelli');
        sc_log_add('AUT_DOCS', "INSERT 30 $fileSql");
    }

    sc_lookup(rsCntDocs, "
        SELECT COUNT(*) FROM documenti WHERE subvettore_autista_id = $autistaId
    ", 'pigliacelli');
    $n = !empty({rsCntDocs[0][0]}) ? (int){rsCntDocs[0][0]} : 0;
    sc_log_add('AUT_DOCS', "FINE onAfterInsert docs_count=$n");
}
