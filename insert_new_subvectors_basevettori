// Versione T2BaseVettori: anagrafica da T2BaseVettori (codice vettore), non BaCliFor.
// Filtro: vettori societa 1 con viaggi T2ViaggiVettori ANNO >= 2024, meno 60 codici esclusi,
// piu 4152 / 5911 / 5967 sempre inclusi. P.IVA e C.F. da BaCliFor via FORNITORE_*.

function log_insert_subvettori($msg)
{
    sc_log_add('INSERT_SUBVETTORI', (string)$msg);
}

function sql_quote($v)
{
    if ($v === null) {
        return "NULL";
    }
    $v = (string)$v;
    return "'" . str_replace("'", "''", $v) . "'";
}

function connetti_pdo_sga($settings)
{
    $set_names = ['sgam_user', 'sgam_pswd', 'sgam_db', 'sgam_server'];

    foreach ($set_names as $set_name) {
        if (!array_key_exists($set_name, $settings) || trim((string)$settings[$set_name]) === '') {
            log_insert_subvettori("ERRORE parametro sec_settings mancante o vuoto: $set_name");
            sc_error_message("Parametro '" . $set_name . "' non trovato o vuoto in sec_settings.");
            return null;
        }
    }

    try {
        $dsn_sga = "sqlsrv:Server=" . $settings['sgam_server'] .
                   ";Database=" . $settings['sgam_db'] .
                   ";Encrypt=1" .
                   ";TrustServerCertificate=1";

        log_insert_subvettori(
            "Connessione PDO SGA server=" . $settings['sgam_server'] .
            " db=" . $settings['sgam_db'] .
            " user=" . $settings['sgam_user']
        );

        return new PDO(
            $dsn_sga,
            $settings['sgam_user'],
            $settings['sgam_pswd'],
            [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_NUM,
            ]
        );
    } catch (PDOException $e) {
        log_insert_subvettori("ERRORE connessione PDO SGA: " . $e->getMessage());
        sc_error_message("Errore connessione PDO SGA: " . $e->getMessage());
        return null;
    }
}

log_insert_subvettori('START import subvettori T2BaseVettori (filtro viaggi ANNO>=2024)');

// --- pigliacelli: credenziali SGA da sec_settings ---
sc_lookup(settingsRows, "
    SELECT set_name, set_value
    FROM sec_settings
    WHERE set_name IN ('sgam_user', 'sgam_pswd', 'sgam_db', 'sgam_server')
", "pigliacelli");

$settings = [];
if (!empty({settingsRows})) {
    foreach ({settingsRows} as $settingRow) {
        $settings[$settingRow[0]] = $settingRow[1];
    }
}

log_insert_subvettori('sec_settings SGA caricati: ' . count($settings) . ' parametri');

$pdo_sga = connetti_pdo_sga($settings);
if ($pdo_sga === null) {
    log_insert_subvettori('STOP connessione SGA non disponibile');
    return;
}

log_insert_subvettori('Connessione PDO SGA OK');

// --- pigliacelli: codici gia' importati (evita N sc_lookup nel loop) ---
$codici_esistenti = [];
sc_lookup(subEsistentiRows, "SELECT codice_sga FROM subvettori WHERE codice_sga IS NOT NULL", "pigliacelli");
if (!empty({subEsistentiRows})) {
    foreach ({subEsistentiRows} as $subRow) {
        $codici_esistenti[(string)$subRow[0]] = true;
    }
}

log_insert_subvettori('Subvettori gia presenti in pigliacelli: ' . count($codici_esistenti));

// --- SGA: T2BaseVettori + BaCliFor (solo fiscalita) ---
$sql = "
  SELECT
    tbvt.CODICE,
    tbvt.RAGIONE_SOCIALE,
    COALESCE(NULLIF(RTRIM(tbvt.INDIRIZZO), ''), NULLIF(RTRIM(tbvt.VIA), '')) AS INDIRIZZO,
    tbvt.LOCALITA,
    tbvt.PROVINCIA,
    tbvt.TELEFONO,
    tbvt.CELLULARE,
    COALESCE(NULLIF(RTRIM(tbvt.E_MAIL), ''), NULLIF(RTRIM(tbvt.B2B_EMAIL), '')) AS E_MAIL,
    b.PARTITA_IVA,
    b.CODICE_FISCALE
  FROM T2BaseVettori tbvt
  LEFT JOIN BaCliFor b
    ON b.SOCIETA = tbvt.SOCIETA
   AND b.CLIENTE_FORNITORE = tbvt.FORNITORE_CLIFOR
   AND b.CODICE = tbvt.FORNITORE_CODICE
  WHERE
    tbvt.SOCIETA = 1
    AND (
      (
        EXISTS (
          SELECT 1
          FROM T2ViaggiVettori tvv
          WHERE tvv.VETTORE = tbvt.CODICE
            AND tvv.ANNO >= 2024
            AND tvv.SOCIETA = 1
        )
        AND tbvt.CODICE NOT IN (
          94, 213, 648, 694, 980, 1072, 1480, 1541, 1989, 2408, 3115, 3644, 3752,
          4010, 4169, 4364, 4390, 4407, 4429, 4785, 5055, 5252, 5439, 5469, 5490,
          5607, 5611, 5799, 5878, 5885, 5914, 5963, 5976, 5990, 6042, 6051, 6086,
          6154, 6160, 6167, 6169, 6173, 6177, 6179, 6180, 6191, 6192, 6200, 6223,
          6225, 6227, 6237, 6250, 6251, 6254, 6271, 6279, 6289, 6291, 6293, 6312, 6363
        )
      )
      OR tbvt.CODICE IN (4152, 5911, 5967)
    )
  ORDER BY tbvt.CODICE
";

log_insert_subvettori('Esecuzione SELECT SGA T2BaseVettori + BaCliFor');

try {
    $stmt = $pdo_sga->query($sql);
    log_insert_subvettori('SELECT SGA eseguita OK');
} catch (PDOException $e) {
    log_insert_subvettori('ERRORE SELECT SGA: ' . $e->getMessage());
    sc_error_message("Errore select T2BaseVettori: " . $e->getMessage());
    return;
}

$letti_sga   = 0;
$inseriti    = 0;
$saltati     = 0;
$errori      = 0;
$senza_email = 0;
$senza_piva  = 0;

while (($row = $stmt->fetch(PDO::FETCH_NUM)) !== false) {
    $letti_sga++;
    $codice_sga      = $row[0];
    $ragione_sociale = $row[1];
    $indirizzo       = $row[2];
    $sede_citta      = $row[3];
    $sede_prov       = $row[4];
    $phone           = $row[5];
    $cellphone       = $row[6];
    $email           = trim((string)$row[7]);
    $piva            = $row[8];
    $cod_fiscale     = $row[9];

    if ($email === '') {
        $senza_email++;
    }
    if (trim((string)$piva) === '' && trim((string)$cod_fiscale) === '') {
        $senza_piva++;
    }

    if (isset($codici_esistenti[(string)$codice_sga])) {
        $saltati++;
        continue;
    }

    $ins = "
      INSERT INTO subvettori
        (login_subvettore, ragione_sociale, cod_fiscale, piva, phone, cellphone,
         indirizzo, sede_citta, sede_prov, codice_sga)
      VALUES
        (" . sql_quote($email) . ", " . sql_quote($ragione_sociale) . ", " . sql_quote($cod_fiscale) . ", " . sql_quote($piva) . ", " . sql_quote($phone) . ", " . sql_quote($cellphone) . ",
         " . sql_quote($indirizzo) . ", " . sql_quote($sede_citta) . ", " . sql_quote($sede_prov) . ", " . sql_quote($codice_sga) . ")
    ";

    try {
        sc_exec_sql($ins, "pigliacelli");
        $codici_esistenti[(string)$codice_sga] = true;
        $inseriti++;
    } catch (Exception $e) {
        $errori++;
        log_insert_subvettori(
            "ERRORE INSERT codice_sga=$codice_sga login=$email — " . $e->getMessage()
        );
    } catch (Throwable $e) {
        $errori++;
        log_insert_subvettori(
            "ERRORE INSERT codice_sga=$codice_sga login=$email — " . $e->getMessage()
        );
    }
}

$stmt->closeCursor();

log_insert_subvettori(
    'END riepilogo: letti_sga=' . $letti_sga .
    ' inseriti=' . $inseriti .
    ' saltati=' . $saltati .
    ' errori=' . $errori .
    ' senza_email=' . $senza_email .
    ' senza_piva_cf=' . $senza_piva
);

sc_log_add(
    'EXPORT_DATA',
    'Subvettori T2BaseVettori (viaggi>=2024): letti=' . $letti_sga .
    ' inseriti=' . $inseriti .
    " gia' presenti=" . $saltati .
    ' errori=' . $errori
);
