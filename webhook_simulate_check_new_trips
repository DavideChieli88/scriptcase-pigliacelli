// Scriptcase blank app: web_hook_simulate_check_new_trips
//
// Simula l'arrivo di un nuovo contratto subvettore SENZA passare da SGA.
// Allineato SOLO a check_new_trips_nuovo_contratto_basevettori (import DB, nessuna mail).
// Credenziali / magic link: step successivo manuale via send_magic_link_credenziali
// (vedi test_urls.send_magic_link_credenziali nella response).
//
// Il contratto contiene SOLO le tratte del payload valide per la firma
// (PARTENZA_DATA_ORA e IMPORTO_UNITARIO presenti); le altre vengono loggate e saltate.
//
// Riceve in POST un JSON con subvettore + tratte e fa gli inserimenti a DB:
//
//   1) subvettori                  (find o insert per codice_sga)
//   2) tratte + tratte_localita    (insert o UPDATE se stesso carico/scarico, come il job)
//   3) contratti                   (solo se almeno una tratta valida per contratto)
//   4) subvettori_contratti
//   5) contratti_tratte            (solo tratte valide del payload)
//
// I dati per la firma (email/telefono/nome/cognome) NON vengono impostati qui:
// vanno compilati in form come legale rappresentante (email_rappresentante, ecc.).
// vanno compilati a mano seguendo il flusso (magic link / form).
//
// NB: helper definiti come CLOSURE in variabili (le function nominate non sono
//     affidabili dentro l'evento ScriptCase: vengono perse). Stesso pattern di
//     easygn_start_wf_auto.

@set_time_limit(0);
@ini_set('memory_limit', '256M');

if (!headers_sent()) {
    header('Content-Type: application/json; charset=UTF-8');
    header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
}

// --- Helper (closure) ---
$wh_sql_quote = function ($v) {
    if ($v === null) {
        return "NULL";
    }
    return "'" . str_replace("'", "''", (string)$v) . "'";
};

$wh_sql_num = function ($v) {
    if ($v === null || $v === '') {
        return "NULL";
    }
    return (string)(0 + $v);
};

$wh_split_localita = function ($s) {
    $s = trim((string)$s);
    if ($s === '') {
        return array();
    }
    $parts = preg_split('/\s*\+\s*/', $s);
    $out = array();
    foreach ($parts as $p) {
        if ($p !== '') {
            $out[] = $p;
        }
    }
    return $out;
};

$wh_normalizza_stringa = function ($s) {
    $s = trim((string)$s);
    $s = strtoupper($s);
    $s = preg_replace('/\s+/', ' ', $s);
    return $s;
};

$wh_crea_hash_tratta = function ($carico_str, $scarico_str, $codice_vettore, $importo_unitario) use ($wh_split_localita, $wh_normalizza_stringa) {
    $carichi = array();
    foreach ($wh_split_localita($carico_str) as $loc) {
        $carichi[] = $wh_normalizza_stringa($loc);
    }
    $scarichi = array();
    foreach ($wh_split_localita($scarico_str) as $loc) {
        $scarichi[] = $wh_normalizza_stringa($loc);
    }
    $carico_norm  = implode('|', $carichi);
    $scarico_norm = implode('|', $scarichi);
    $vettore      = $wh_normalizza_stringa($codice_vettore);
    $importo      = number_format((float)$importo_unitario, 2, '.', '');
    return hash('sha256', $carico_norm . '#' . $scarico_norm . '#' . $vettore . '#' . $importo);
};

$wh_valore = function ($arr, $key, $default = null) {
    if (!is_array($arr) || !array_key_exists($key, $arr)) {
        return $default;
    }
    $v = $arr[$key];
    if (is_string($v)) {
        $v = trim($v);
        if ($v === '') {
            return $default;
        }
    }
    return $v;
};

$wh_respond = function ($httpCode, array $body) {
    if (!headers_sent()) {
        http_response_code($httpCode);
    }
    echo json_encode($body, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT);
    exit;
};

$wh_partenza_data_ora_valida = function ($value) {
    $value = trim((string)$value);
    if ($value === '') {
        return false;
    }
    if ($value === '1900-01-01 00:00:00' || strpos($value, '1900-01-01') === 0) {
        return false;
    }
    return strtotime($value) !== false;
};

$wh_importo_unitario_valido = function ($value) {
    if ($value === null) {
        return false;
    }
    if (is_string($value) && trim($value) === '') {
        return false;
    }
    return is_numeric($value);
};

$wh_tratta_ammessa_per_contratto = function ($tr, &$motivo_skip) use ($wh_valore, $wh_partenza_data_ora_valida, $wh_importo_unitario_valido) {
    $motivo_skip = '';
    $partenza = $wh_valore($tr, 'partenza_data_ora');
    $importo = array_key_exists('importo_unitario', $tr) ? $tr['importo_unitario'] : null;

    if (!$wh_partenza_data_ora_valida($partenza)) {
        $motivo_skip = 'partenza_data_ora_mancante';
        return false;
    }
    if (!$wh_importo_unitario_valido($importo)) {
        $motivo_skip = 'importo_unitario_mancante';
        return false;
    }
    return true;
};

$wh_email_valida = function ($email) {
    $email = trim((string)$email);
    if ($email === '') {
        return false;
    }
    if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
        return false;
    }
    return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
};

$wh_login_tecnico = function ($login) {
    $login = trim((string)$login);
    return strncmp($login, 'SUBVETTORE_', 11) === 0;
};

$wh_login_collegato_a_sub = function ($login, $subvettore_id) use ($wh_sql_quote, $wh_sql_num) {
    $login = trim((string)$login);
    $subvettore_id = (int)$subvettore_id;
    if ($login === '' || $subvettore_id <= 0) {
        return false;
    }
    sc_lookup(rsWhLcSub, "
        SELECT login
        FROM sec_users
        WHERE login = " . $wh_sql_quote($login) . "
          AND subvettore_id = " . $wh_sql_num($subvettore_id) . "
        LIMIT 1
    ", "pigliacelli");
    return !empty({rsWhLcSub});
};

$wh_login_sub_gia_usato_da_altro_sub = function ($login, $subvettore_id) use ($wh_sql_quote) {
    $login = trim((string)$login);
    $subvettore_id = (int)$subvettore_id;
    if ($login === '') {
        return false;
    }
    sc_lookup(rsWhLoginAlt, "
        SELECT subvettore_id
        FROM sec_users
        WHERE login = " . $wh_sql_quote($login) . "
        LIMIT 1
    ", "pigliacelli");
    if (empty({rsWhLoginAlt})) {
        return false;
    }
    $sub_alt = {rsWhLoginAlt[0][0]};
    if ($sub_alt === null || $sub_alt === '') {
        return true;
    }
    return (int)$sub_alt !== $subvettore_id;
};

$wh_disabilita_utenza_subvettore = function ($subvettore_id, $vecchio_login) use ($wh_sql_quote, $wh_sql_num) {
    $subvettore_id = (int)$subvettore_id;
    $vecchio_login = trim((string)$vecchio_login);
    if ($subvettore_id <= 0 || $vecchio_login === '') {
        return;
    }
    sc_exec_sql("
        UPDATE sec_users
        SET active = 'N'
        WHERE login = " . $wh_sql_quote($vecchio_login) . "
          AND subvettore_id = " . $wh_sql_num($subvettore_id) . "
    ", "pigliacelli");
    sc_log_add('WEBHOOK_SIM', 'disabilitata utenza precedente sub=' . $subvettore_id . ' login=' . $vecchio_login);
};

$wh_crea_utenza_subvettore = function ($subvettore_id, $email, $ragione_sociale, $phone, $active = 'N')
    use ($wh_sql_quote, $wh_sql_num, $wh_email_valida, $wh_login_collegato_a_sub, $wh_login_sub_gia_usato_da_altro_sub) {
    $subvettore_id = (int)$subvettore_id;
    $email = trim((string)$email);
    $active = strtoupper(trim((string)$active)) === 'N' ? 'N' : 'Y';
    if (!$wh_email_valida($email)) {
        return null;
    }
    if ($wh_login_collegato_a_sub($email, $subvettore_id)) {
        return $email;
    }
    if ($wh_login_sub_gia_usato_da_altro_sub($email, $subvettore_id)) {
        sc_log_add('WEBHOOK_SIM', 'skip crea utenza: email=' . $email . ' gia login altro sub');
        return null;
    }
    $tempPassword = '';
    $alfabeto = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_!+-*';
    $alfabetoLen = strlen($alfabeto);
    for ($p = 0; $p < 12; $p++) {
        $tempPassword .= $alfabeto[random_int(0, $alfabetoLen - 1)];
    }
    sc_exec_sql("
        INSERT INTO sec_users (login, pswd, name, email, phone, active, subvettore_id)
        VALUES (
            " . $wh_sql_quote($email) . ",
            " . $wh_sql_quote(md5($tempPassword)) . ",
            " . $wh_sql_quote($ragione_sociale) . ",
            " . $wh_sql_quote($email) . ",
            " . $wh_sql_quote($phone) . ",
            " . $wh_sql_quote($active) . ",
            " . $wh_sql_num($subvettore_id) . "
        )
    ", "pigliacelli");
    sc_exec_sql("
        INSERT INTO sec_users_groups (login, group_id)
        VALUES (" . $wh_sql_quote($email) . ", 2)
    ", "pigliacelli");
    sc_log_add('WEBHOOK_SIM', 'creata nuova utenza sub=' . $subvettore_id . ' login=' . $email);
    return $email;
};

$wh_intestatario_primo_utente_sub = function ($subvettore_id) use ($wh_sql_num) {
    sc_lookup(rsWhPrimoUser, "
        SELECT login
        FROM sec_users
        WHERE subvettore_id = " . $wh_sql_num($subvettore_id) . "
        ORDER BY login
        LIMIT 1
    ", "pigliacelli");
    if (!empty({rsWhPrimoUser[0][0]})) {
        return trim((string){rsWhPrimoUser[0][0]});
    }
    return null;
};

$wh_sync_intestatario_subvettore = function ($subvettore_id, $email, $ragione_sociale, $phone, $utenza_active = 'N')
    use (
        $wh_sql_quote,
        $wh_sql_num,
        $wh_email_valida,
        $wh_login_collegato_a_sub,
        $wh_login_sub_gia_usato_da_altro_sub,
        $wh_disabilita_utenza_subvettore,
        $wh_crea_utenza_subvettore,
        $wh_intestatario_primo_utente_sub,
        $wh_login_tecnico
    ) {
    $subvettore_id = (int)$subvettore_id;
    $email = trim((string)$email);
    $ragione_sociale = trim((string)$ragione_sociale);
    $phone = trim((string)$phone);

    sc_lookup(rsWhSubMail, "
        SELECT login_subvettore
        FROM subvettori
        WHERE id = " . $wh_sql_num($subvettore_id) . "
        LIMIT 1
    ", "pigliacelli");
    $login_db = !empty({rsWhSubMail[0][0]}) ? trim((string){rsWhSubMail[0][0]}) : '';

    if (!$wh_email_valida($email)) {
        $login = $wh_intestatario_primo_utente_sub($subvettore_id);
        if ($login !== null) {
            return $login;
        }
        return 'SUBVETTORE_' . $subvettore_id;
    }

    if ($wh_login_sub_gia_usato_da_altro_sub($email, $subvettore_id)) {
        sc_log_add('WEBHOOK_SIM', 'email payload gia login altro sub — fallback sub=' . $subvettore_id);
        $login = $wh_intestatario_primo_utente_sub($subvettore_id);
        return $login !== null ? $login : ('SUBVETTORE_' . $subvettore_id);
    }

    if ($wh_login_collegato_a_sub($email, $subvettore_id)) {
        sc_exec_sql("
            UPDATE sec_users
            SET email = " . $wh_sql_quote($email) . ",
                name = " . $wh_sql_quote($ragione_sociale) . ",
                phone = " . $wh_sql_quote($phone) . "
            WHERE subvettore_id = " . $wh_sql_num($subvettore_id) . "
              AND login = " . $wh_sql_quote($email) . "
        ", "pigliacelli");
        if ($login_db !== '' && strcasecmp($login_db, $email) !== 0) {
            sc_exec_sql("
                UPDATE subvettori
                SET login_subvettore = " . $wh_sql_quote($email) . "
                WHERE id = " . $wh_sql_num($subvettore_id) . "
            ", "pigliacelli");
        }
        return $email;
    }

    if ($login_db !== '' && strcasecmp($login_db, $email) !== 0 && $wh_login_collegato_a_sub($login_db, $subvettore_id)) {
        $wh_disabilita_utenza_subvettore($subvettore_id, $login_db);
    }

    $login = $wh_crea_utenza_subvettore($subvettore_id, $email, $ragione_sociale, $phone, $utenza_active);
    if ($login === null) {
        $login = $wh_intestatario_primo_utente_sub($subvettore_id);
        if ($login !== null && !$wh_login_tecnico($login)) {
            return $login;
        }
        return 'SUBVETTORE_' . $subvettore_id;
    }

    sc_exec_sql("
        UPDATE subvettori
        SET login_subvettore = " . $wh_sql_quote($email) . "
        WHERE id = " . $wh_sql_num($subvettore_id) . "
    ", "pigliacelli");

    return $login;
};

// --- 1) Lettura payload JSON (più sorgenti per compatibilità ScriptCase/Apache) ---
$rawBody = (string)@file_get_contents('php://input');

if (trim($rawBody) === '' && isset($_POST['payload'])) {
    $rawBody = (string)$_POST['payload'];
}
if (trim($rawBody) === '' && isset($GLOBALS['HTTP_RAW_POST_DATA'])) {
    $rawBody = (string)$GLOBALS['HTTP_RAW_POST_DATA'];
}
if (trim($rawBody) === '' && is_array($_POST) && count($_POST) === 1) {
    $solaChiave = array_keys($_POST)[0];
    $solaValore = $_POST[$solaChiave];
    if (is_string($solaValore) && trim($solaValore) === '' && strpos($solaChiave, '{') === 0) {
        $rawBody = $solaChiave;
    } elseif (is_string($solaValore) && strpos(trim($solaValore), '{') === 0) {
        $rawBody = $solaValore;
    }
}

$rawBody = preg_replace('/^\xEF\xBB\xBF/', '', $rawBody);

$data = json_decode(trim($rawBody), true);
if (!is_array($data)) {
    $diag = array(
        'metodo'        => isset($_SERVER['REQUEST_METHOD']) ? $_SERVER['REQUEST_METHOD'] : '',
        'content_type'  => isset($_SERVER['CONTENT_TYPE']) ? $_SERVER['CONTENT_TYPE'] : '',
        'body_len'      => strlen($rawBody),
        'post_keys'     => is_array($_POST) ? array_keys($_POST) : array(),
        'json_error'    => json_last_error_msg(),
    );
    sc_log_add('WEBHOOK_SIM', 'Payload JSON non valido | ' . json_encode($diag, JSON_UNESCAPED_SLASHES));
    $wh_respond(400, array(
        'ok'    => false,
        'error' => 'Payload JSON mancante o non valido. Inviare un body JSON in POST.',
        'hint'  => 'Se il metodo risulta GET, è un redirect (301) che ha perso il body: usa la URL CON lo slash finale e/o disattiva CURLOPT_FOLLOWLOCATION.',
        'diag'  => $diag,
    ));
}

// --- 2) Sezione subvettore ---
$sub = is_array($wh_valore($data, 'subvettore')) ? $data['subvettore'] : array();

$codice_sga      = $wh_valore($sub, 'codice_sga', $wh_valore($sub, 'codice_vettore'));
$ragione_sociale = $wh_valore($sub, 'ragione_sociale');
$piva            = $wh_valore($sub, 'piva');
$cod_fiscale     = $wh_valore($sub, 'cod_fiscale');
$indirizzo       = $wh_valore($sub, 'indirizzo');
$sede_citta      = $wh_valore($sub, 'sede_citta');
$sede_prov       = $wh_valore($sub, 'sede_prov');
$phone           = $wh_valore($sub, 'phone');
$cellphone       = $wh_valore($sub, 'cellphone');
$email           = $wh_valore($sub, 'email');

if ($codice_sga === null) {
    $wh_respond(400, array(
        'ok'    => false,
        'error' => 'subvettore.codice_sga (o codice_vettore) obbligatorio.',
    ));
}

// --- 3) Tipo contratto + tratte ---
$tipo_contratto_id = (int)$wh_valore($data, 'tipo_contratto_id', 2);
if ($tipo_contratto_id <= 0) {
    $tipo_contratto_id = 2;
}

$tratte_in = $wh_valore($data, 'tratte', array());
if (!is_array($tratte_in) || count($tratte_in) === 0) {
    $wh_respond(400, array(
        'ok'    => false,
        'error' => 'Almeno una tratta richiesta in "tratte" (array).',
    ));
}

sc_log_add('WEBHOOK_SIM', 'Avvio simulazione contratto codice_sga=' . $codice_sga
    . ' tipo=' . $tipo_contratto_id . ' tratte=' . count($tratte_in));

// --- 4) Subvettore: find o insert ---
sc_lookup(rsSub, "SELECT id FROM subvettori WHERE codice_sga = " . $wh_sql_quote($codice_sga) . " LIMIT 1", "pigliacelli");

$subvettore_creato = false;
if (!empty({rsSub})) {
    $subvettore_id = (int){rsSub[0][0]};
} else {
    sc_exec_sql("
        INSERT INTO subvettori
          (login_subvettore, ragione_sociale, cod_fiscale, piva, phone, cellphone,
           indirizzo, sede_citta, sede_prov, codice_sga)
        VALUES
          (" . $wh_sql_quote($email) . ",
           " . $wh_sql_quote($ragione_sociale) . ",
           " . $wh_sql_quote($cod_fiscale) . ",
           " . $wh_sql_quote($piva) . ",
           " . $wh_sql_quote($phone) . ",
           " . $wh_sql_quote($cellphone) . ",
           " . $wh_sql_quote($indirizzo) . ",
           " . $wh_sql_quote($sede_citta) . ",
           " . $wh_sql_quote($sede_prov) . ",
           " . $wh_sql_quote($codice_sga) . ")
    ", "pigliacelli");

    sc_lookup(rsLastSub, "SELECT LAST_INSERT_ID()", "pigliacelli");
    if (empty({rsLastSub}) || (int){rsLastSub[0][0]} <= 0) {
        $wh_respond(500, array('ok' => false, 'error' => 'Inserimento subvettore fallito.'));
    }
    $subvettore_id = (int){rsLastSub[0][0]};
    $subvettore_creato = true;
}

// --- 5) Intestatario contratto: multi-utenza come form_subvettori (email SGA → utenza) ---
// Utenza inactive fino a firma completata (web_hook_firma invia credenziali con active=N).
$intestatario = $wh_sync_intestatario_subvettore($subvettore_id, $email, $ragione_sociale, $phone, 'N');

// Utenza tecnica: crea record sec_users se assente (per FK contratti)
if ($wh_login_tecnico($intestatario)) {
    sc_lookup(rsLoginTec, "SELECT login FROM sec_users WHERE login = " . $wh_sql_quote($intestatario) . " LIMIT 1", "pigliacelli");
    if (empty({rsLoginTec})) {
        $tempPassword = '';
        $alfabeto = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        $alfabetoLen = strlen($alfabeto);
        for ($p = 0; $p < 12; $p++) {
            $tempPassword .= $alfabeto[random_int(0, $alfabetoLen - 1)];
        }
        sc_exec_sql("
            INSERT INTO sec_users (login, pswd, name, email, phone, active, subvettore_id)
            VALUES (
                " . $wh_sql_quote($intestatario) . ",
                " . $wh_sql_quote(md5($tempPassword)) . ",
                " . $wh_sql_quote($ragione_sociale) . ",
                " . $wh_sql_quote($intestatario . '@local.invalid') . ",
                " . $wh_sql_quote($phone) . ",
                'N',
                " . $wh_sql_num($subvettore_id) . "
            )
        ", "pigliacelli");
        sc_exec_sql("
            INSERT INTO sec_users_groups (login, group_id)
            VALUES (" . $wh_sql_quote($intestatario) . ", 2)
        ", "pigliacelli");
    }
}

// --- 6) Tratte + localita (sempre); contratto solo per quelle valide ---
$tratte_create = array();
$tratte_skipped = array();
$tratte_per_contratto = array();

foreach ($tratte_in as $idx => $tr) {
    if (!is_array($tr)) {
        continue;
    }
    $carico_str       = (string)$wh_valore($tr, 'carico', $wh_valore($tr, 'carico_str', ''));
    $scarico_str      = (string)$wh_valore($tr, 'scarico', $wh_valore($tr, 'scarico_str', ''));
    $tariffa_sigla    = $wh_valore($tr, 'tariffa_sigla');
    $importo_raw      = array_key_exists('importo_unitario', $tr) ? $tr['importo_unitario'] : null;
    $importo_unitario = $wh_importo_unitario_valido($importo_raw) ? (float)$importo_raw : 0;
    $extra_totale     = (float)$wh_valore($tr, 'extra_totale', 0);

    if ($carico_str === '' && $scarico_str === '') {
        continue;
    }

    $motivo_skip = '';
    $ammessa_contratto = $wh_tratta_ammessa_per_contratto($tr, $motivo_skip);

    $totale = $importo_unitario + $extra_totale;
    $hash   = $wh_crea_hash_tratta($carico_str, $scarico_str, $codice_sga, $importo_unitario);

    // Mappa sigla tariffa (P/G/F) -> tipo_tariffa_id
    $tipo_tariffa_id = null;
    if ($tariffa_sigla !== null) {
        $tariffa_sigla = strtoupper((string)$tariffa_sigla);
        sc_lookup(rsTipoTar, "SELECT id FROM tipo_tariffe WHERE UPPER(descrizione) = " . $wh_sql_quote($tariffa_sigla) . " LIMIT 1", "pigliacelli");
        if (!empty({rsTipoTar})) {
            $tipo_tariffa_id = (int){rsTipoTar[0][0]};
        }
    }
    $tipo_tariffa_sql = $tipo_tariffa_id === null ? "NULL" : $wh_sql_num($tipo_tariffa_id);

    $tratta_id = 0;
    $tratta_modificata = false;
    $tratta_version = 1;

    // tratta (riusa se hash gia' presente per il subvettore)
    sc_lookup(rsHash, "
        SELECT id, version FROM tratte
        WHERE hash = " . $wh_sql_quote($hash) . " AND subvettore_id = " . $wh_sql_num($subvettore_id) . "
        LIMIT 1
    ", "pigliacelli");

    if (!empty({rsHash})) {
        $tratta_id = (int){rsHash[0][0]};
        $verHash = {rsHash[0][1]};
        $tratta_version = ($verHash === null || $verHash === '') ? 1 : (int)$verHash;
    } else {
        // Stesso carico/scarico ma importo diverso: hash diverso → UPDATE (come check_new_trips).
        sc_lookup(rsExist, "
            SELECT t.id, t.tariffa, t.extra, t.totale, t.version
            FROM tratte t
            WHERE t.subvettore_id = " . $wh_sql_num($subvettore_id) . "
              AND (
                    SELECT GROUP_CONCAT(tl.localita ORDER BY tl.progressivo SEPARATOR ' + ')
                    FROM tratte_localita tl
                    WHERE tl.tratta_id = t.id AND tl.tipo_tratta = 'C'
                  ) = " . $wh_sql_quote($carico_str) . "
              AND (
                    SELECT GROUP_CONCAT(tl.localita ORDER BY tl.progressivo SEPARATOR ' + ')
                    FROM tratte_localita tl
                    WHERE tl.tratta_id = t.id AND tl.tipo_tratta = 'S'
                  ) = " . $wh_sql_quote($scarico_str) . "
            LIMIT 1
        ", "pigliacelli");

        if (!empty({rsExist})) {
            $tratta_id = (int){rsExist[0][0]};
            $importo_esistente = (float){rsExist[0][1]};
            $extra_esistente   = (float){rsExist[0][2]};
            $totale_esistente  = (float){rsExist[0][3]};
            $version_esistente = {rsExist[0][4]};

            $has_modifica_tratta = (
                abs($importo_esistente - (float)$importo_unitario) > 0.0001 ||
                abs($extra_esistente - (float)$extra_totale) > 0.0001 ||
                abs($totale_esistente - (float)$totale) > 0.0001
            );

            if ($has_modifica_tratta) {
                $tratta_modificata = true;
                $tratta_version = ($version_esistente === null || $version_esistente === '')
                    ? 2
                    : ((int)$version_esistente + 1);

                sc_exec_sql("
                    UPDATE tratte
                    SET tipo_tariffa_id = " . $tipo_tariffa_sql . ",
                        tariffa = " . $wh_sql_num($importo_unitario) . ",
                        extra = " . $wh_sql_num($extra_totale) . ",
                        totale = " . $wh_sql_num($totale) . ",
                        hash = " . $wh_sql_quote($hash) . ",
                        version = " . $wh_sql_num($tratta_version) . "
                    WHERE id = " . $wh_sql_num($tratta_id) . "
                ", "pigliacelli");

                sc_log_add(
                    'WEBHOOK_SIM',
                    'tratta_modificata id=' . $tratta_id .
                    ' subvettore=' . $subvettore_id .
                    ' tariffa ' . $importo_esistente . '->' . $importo_unitario .
                    ' version=' . $tratta_version
                );
            } else {
                $tratta_version = ($version_esistente === null || $version_esistente === '')
                    ? 1
                    : (int)$version_esistente;
            }
        } else {
            sc_exec_sql("
                INSERT INTO tratte
                  (subvettore_id, merce, caricatore, proprietario_merce, tipo_tariffa_id, tariffa, extra, totale, hash, version)
                VALUES
                  (" . $wh_sql_num($subvettore_id) . ", NULL, NULL, NULL, " . $tipo_tariffa_sql . ",
                   " . $wh_sql_num($importo_unitario) . ", " . $wh_sql_num($extra_totale) . ", " . $wh_sql_num($totale) . ",
                   " . $wh_sql_quote($hash) . ", 1)
                ON DUPLICATE KEY UPDATE id = LAST_INSERT_ID(id)
            ", "pigliacelli");

            sc_lookup(rsLastTr, "SELECT LAST_INSERT_ID()", "pigliacelli");
            if (empty({rsLastTr}) || (int){rsLastTr[0][0]} <= 0) {
                continue;
            }
            $tratta_id = (int){rsLastTr[0][0]};

            $i = 1;
            foreach ($wh_split_localita($carico_str) as $loc) {
                sc_exec_sql("
                    INSERT INTO tratte_localita (tratta_id, tipo_tratta, localita, progressivo)
                    VALUES (" . $wh_sql_num($tratta_id) . ", 'C', " . $wh_sql_quote($loc) . ", " . $wh_sql_num($i) . ")
                ", "pigliacelli");
                $i++;
            }
            $i = 1;
            foreach ($wh_split_localita($scarico_str) as $loc) {
                sc_exec_sql("
                    INSERT INTO tratte_localita (tratta_id, tipo_tratta, localita, progressivo)
                    VALUES (" . $wh_sql_num($tratta_id) . ", 'S', " . $wh_sql_quote($loc) . ", " . $wh_sql_num($i) . ")
                ", "pigliacelli");
                $i++;
            }
        }
    }

    if ($tratta_id <= 0) {
        continue;
    }

    $tratta_info = array(
        'tratta_id' => $tratta_id,
        'carico'    => $carico_str,
        'scarico'   => $scarico_str,
        'totale'    => $totale,
        'modificata'=> $tratta_modificata,
        'version'   => $tratta_version,
        'in_contratto' => $ammessa_contratto,
    );

    if ($ammessa_contratto) {
        $tratte_per_contratto[] = array(
            'tratta_id'        => $tratta_id,
            'carico_str'       => $carico_str,
            'scarico_str'      => $scarico_str,
            'tipo_tariffa_id'  => $tipo_tariffa_id,
            'importo_unitario' => $importo_unitario,
            'extra_totale'     => $extra_totale,
            'totale'           => $totale,
            'hash'             => $hash,
            'version'          => $tratta_version,
        );
    } else {
        sc_log_add(
            'WEBHOOK_SIM',
            'SKIP_CONTR motivo=' . $motivo_skip .
            ' codice_sga=' . $codice_sga .
            ' tratta_id=' . $tratta_id .
            ' partenza=' . (string)$wh_valore($tr, 'partenza_data_ora', '') .
            ' importo_unitario=' . (is_scalar($importo_raw) ? (string)$importo_raw : '')
        );
        $tratta_info['skip_motivo'] = $motivo_skip;
        $tratte_skipped[] = $tratta_info;
    }

    $tratte_create[] = $tratta_info;
}

if (count($tratte_per_contratto) === 0) {
    $wh_respond(422, array(
        'ok'              => false,
        'error'           => 'Nessuna tratta valida per contratto (servono partenza_data_ora e importo_unitario).',
        'subvettore_id'   => $subvettore_id,
        'subvettore_creato' => $subvettore_creato,
        'tratte'          => $tratte_create,
        'tratte_skipped'  => $tratte_skipped,
    ));
}

// --- 7) Contratto (solo tratte valide del payload, come il job a fine run) ---
sc_exec_sql("
    INSERT INTO contratti
      (tipo_contratto_id, intestatario)
    VALUES
      (" . $wh_sql_num($tipo_contratto_id) . ", " . $wh_sql_quote($intestatario) . ")
", "pigliacelli");

sc_lookup(rsLastContr, "SELECT LAST_INSERT_ID()", "pigliacelli");
if (empty({rsLastContr}) || (int){rsLastContr[0][0]} <= 0) {
    $wh_respond(500, array('ok' => false, 'error' => 'Inserimento contratto fallito.'));
}
$contratto_id = (int){rsLastContr[0][0]};

// --- 8) subvettori_contratti ---
sc_exec_sql("
    INSERT INTO subvettori_contratti
      (subvettore_id, contratto_id)
    VALUES
      (" . $wh_sql_num($subvettore_id) . ", " . $wh_sql_num($contratto_id) . ")
", "pigliacelli");

sc_lookup(rsLastSc, "SELECT LAST_INSERT_ID()", "pigliacelli");
$subvettori_contratti_id = empty({rsLastSc}) ? 0 : (int){rsLastSc[0][0]};

// --- 9) contratti_tratte (solo tratte valide) ---
foreach ($tratte_per_contratto as $tr_contr) {
    $tratta_id = (int)$tr_contr['tratta_id'];
    $tipo_tariffa_sql = $tr_contr['tipo_tariffa_id'] === null ? "NULL" : $wh_sql_num($tr_contr['tipo_tariffa_id']);

    sc_lookup(rsCt, "
        SELECT id FROM contratti_tratte
        WHERE contratto_id = " . $wh_sql_num($contratto_id) . " AND tratta_id = " . $wh_sql_num($tratta_id) . "
        LIMIT 1
    ", "pigliacelli");

    if (empty({rsCt})) {
        $ct_version = isset($tr_contr['version']) ? (int)$tr_contr['version'] : 1;
        if ($ct_version <= 0) {
            $ct_version = 1;
        }
        sc_exec_sql("
            INSERT INTO contratti_tratte
              (tratta_id, contratto_id, version, carico, scarico, merce, caricatore, proprietario_merce,
               tipo_tariffa_id, tariffa, extra, totale, hash)
            VALUES
              (" . $wh_sql_num($tratta_id) . ", " . $wh_sql_num($contratto_id) . ", " . $wh_sql_num($ct_version) . ",
               " . $wh_sql_quote($tr_contr['carico_str']) . ", " . $wh_sql_quote($tr_contr['scarico_str']) . ",
               NULL, NULL, NULL,
               " . $tipo_tariffa_sql . ", " . $wh_sql_num($tr_contr['importo_unitario']) . ",
               " . $wh_sql_num($tr_contr['extra_totale']) . ", " . $wh_sql_num($tr_contr['totale']) . ",
               " . $wh_sql_quote($tr_contr['hash']) . ")
        ", "pigliacelli");
    }
}

// --- 10) URL di test (base da sec_settings.mail_base_url) ---
sc_lookup(rsBase, "SELECT set_value FROM sec_settings WHERE set_name = 'mail_base_url' LIMIT 1", "pigliacelli");
$baseUrl = empty({rsBase[0][0]}) ? '' : rtrim((string){rsBase[0][0]}, '/');

$finalizeUrl = '';
$easygnUrl   = '';
$magicLinkCredUrl = '';
if ($baseUrl !== '') {
    $finalizeUrl = $baseUrl . '/finalize_contract_subvector/?contrattoId=' . $contratto_id
        . '&subvettoreId=' . $subvettore_id
        . '&tipoContrattoId=' . $tipo_contratto_id;
    $easygnUrl = $baseUrl . '/easygn_start_wf_auto/?contrattoId=' . $contratto_id
        . '&subvettoreId=' . $subvettore_id
        . '&tipo_contratto_id=' . $tipo_contratto_id
        . '&tipoContrattoId=' . $tipo_contratto_id
        . '&mode=subvettore&wf_mode=subvettore';
    $magicLinkCredUrl = $baseUrl . '/send_magic_link_credenziali/?contrattoId=' . $contratto_id
        . '&subvettoreId=' . $subvettore_id;
}

sc_log_add('WEBHOOK_SIM', 'Completato: subvettore=' . $subvettore_id
    . ' contratto=' . $contratto_id . ' sc=' . $subvettori_contratti_id
    . ' tratte_contratto=' . count($tratte_per_contratto)
    . ' tratte_skipped=' . count($tratte_skipped));

$wh_respond(200, array(
    'ok'                      => true,
    'subvettore_id'           => $subvettore_id,
    'subvettore_creato'       => $subvettore_creato,
    'contratto_id'            => $contratto_id,
    'tipo_contratto_id'       => $tipo_contratto_id,
    'subvettori_contratti_id' => $subvettori_contratti_id,
    'intestatario'            => $intestatario,
    'tratte'                  => $tratte_create,
    'tratte_in_contratto'     => count($tratte_per_contratto),
    'tratte_skipped'          => $tratte_skipped,
    'test_urls'               => array(
        'finalize'                  => $finalizeUrl,
        'easygn_diretto'            => $easygnUrl,
        'send_magic_link_credenziali' => $magicLinkCredUrl,
        'send_magic_link_credenziali_params' => array(
            'contrattoId'  => $contratto_id,
            'subvettoreId' => $subvettore_id,
        ),
    ),
));
