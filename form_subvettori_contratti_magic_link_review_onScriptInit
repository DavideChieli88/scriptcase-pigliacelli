/**
 * form_subvettori_contratti_magic_link_review → onScriptInit
 *
 * Avvia il JavaScript Method mlReviewConfirmInit al caricamento pagina.
 * Senza questo evento, il metodo JS in Programming NON parte da solo.
 *
 * Deploy:
 * 1) Programming → JavaScript Methods → mlReviewConfirmInit
 *    → incolla form_subvettori_contratti_magic_link_review_confirm.js
 * 2) Eventi → onScriptInit → incolla QUESTO file
 * 3) Rigenera la form
 */

?>
<script type="text/javascript">
(function () {
    var attempts = 0;

    function bootMlReviewConfirm() {
        attempts += 1;
        if (typeof mlReviewConfirmInit === 'function') {
            mlReviewConfirmInit();
            return;
        }
        if (attempts < 60) {
            setTimeout(bootMlReviewConfirm, 150);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootMlReviewConfirm);
    } else {
        bootMlReviewConfirm();
    }
})();
</script>
<?php
