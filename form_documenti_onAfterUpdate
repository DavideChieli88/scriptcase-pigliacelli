sc_lookup(grId, "SELECT group_id FROM sec_users_groups sug INNER JOIN sec_users su ON su.login = sug.login
  WHERE su.login = '[usr_login]'
");

$group_id = {grId[0][0]};


$tipo_documento = {tipo_documento_id};
sc_lookup(rs, "SELECT nome FROM tipi_documento WHERE id = $tipo_documento");
$nome_documento = {rs[0][0]};
$intestatario   = {login};
$usrLogin       = [usr_login];
$docId          = {id};

$fileNow  = trim((string){file});
$statoDoc = (int){stato_documento_id};

// 1 = in attesa, 2 = caricato, 3 = da revisionare
$statiAttesaCaricamento = array(1, 3);

// Subvettore ha caricato il file: notifica operatori via email
// (il campo file non espone [file] in onAfterUpdate, si usa stato documento e is_not_ok)
$isNotOk = (int){is_not_ok};

$isUploadSubvettore = (
    $fileNow !== ''
    && strcasecmp(trim((string)$usrLogin), trim((string)$intestatario)) === 0
    && (in_array($statoDoc, $statiAttesaCaricamento, true) || $isNotOk === 1)
);

if ($isUploadSubvettore) {

    // group_id: 1 = admin, 2 = subvettore, 3 = operatore
    sc_lookup(rsOps, "
        SELECT DISTINCT su.email
        FROM sec_users su
        INNER JOIN sec_users_groups sug ON sug.login = su.login
        WHERE su.active = 'Y'
          AND su.email IS NOT NULL
          AND TRIM(su.email) <> ''
          AND sug.group_id IN (1, 3)
    ");

    $emailPlaceholder = array('admin@admin.com', 'admin@localhost', 'admin@example.com');

    $destinatari   = array();
    $emailScartate = array();
    if (isset({rsOps[0][0]})) {
        foreach ({rsOps} as $row) {
            $email = strtolower(trim((string)$row[0]));

            if ($email === '') {
                continue;
            }
            if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
                $emailScartate[] = $email . ' (formato non valido)';
                continue;
            }
            if (in_array($email, $emailPlaceholder, true)) {
                $emailScartate[] = $email . ' (email predefinita non utilizzabile)';
                continue;
            }

            $destinatari[] = $email;
        }
    }
    $destinatari = array_values(array_unique($destinatari));

    if (!empty($emailScartate)) {
        sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId — email operatori scartate: " . implode('; ', $emailScartate));
    }

    if (empty($destinatari)) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId tipo='$nome_documento' — nessun operatore con email valida");
    } else {

        sc_lookup(rs_smtp, "SELECT set_name, set_value FROM sec_settings");
        $loginUrl = '';
        if (isset({rs_smtp[0][0]})) {
            foreach ({rs_smtp} as $f) {
                $_SESSION['sett_' . $f[0]] = $f[1];
                if ($f[0] === 'login_url') {
                    $loginUrl = trim((string)$f[1]);
                }
            }
        }

        if (isset($_SESSION['sett_smtp_api']) && $_SESSION['sett_smtp_api'] == 'custom') {
            $sett_smtp = array(
                'settings' => array(
                    'gateway'       => 'smtp',
                    'smtp_server'   => $_SESSION['sett_smtp_server'],
                    'smtp_protocol' => $_SESSION['sett_smtp_security'],
                    'smtp_port'     => $_SESSION['sett_smtp_port'],
                    'smtp_user'     => $_SESSION['sett_smtp_user'],
                    'smtp_password' => $_SESSION['sett_smtp_pass'],
                    'from_email'    => $_SESSION['sett_smtp_from_email'],
                    'from_name'     => $_SESSION['sett_smtp_from_name'],
                ),
            );
        } else {
            $sett_smtp = array(
                'profile' => isset($_SESSION['sett_smtp_api']) ? $_SESSION['sett_smtp_api'] : ''
            );
        }

        $soggetto     = "Documento caricato — " . $nome_documento . " (#$docId)";
        $safeDocNome  = htmlspecialchars($nome_documento, ENT_QUOTES, 'UTF-8');
        $safeDocId    = (int)$docId;
        $safeLoginUrl = htmlspecialchars($loginUrl, ENT_QUOTES, 'UTF-8');
        $safeSub      = htmlspecialchars(trim((string)$intestatario), ENT_QUOTES, 'UTF-8');

        $testoPlain = "Gentile operatore,\n\n"
            . "il subvettore $intestatario ha caricato il seguente documento:\n\n"
            . "Tipo documento: $nome_documento\n"
            . "Riferimento: #$safeDocId\n"
            . "Subvettore: $intestatario\n\n"
            . "Per verificarlo, acceda all'area di gestione:\n" . $loginUrl . "\n\n"
            . "Messaggio automatico — non rispondere.";

        $testoHtml = "
<html>
<head>
<style>
  body { margin:0; font-family: Arial, sans-serif; background: #f4f4f4; padding: 20px; }
  .box { background:#fff; border-radius: 8px; overflow: hidden; max-width: 560px; margin: 0 auto; }
  .head { padding: 16px 18px; background: #d1fae5; color: #065f46; font-weight: bold; font-size: 16px; }
  .content { padding: 18px; color: #111827; line-height: 1.6; }
  .detail-row { display: flex; gap: 8px; margin: 6px 0; font-size: 14px; }
  .detail-label { color: #6b7280; min-width: 140px; }
  .detail-value { color: #111827; font-weight: bold; }
  .btn { display: inline-block; margin-top: 20px; padding: 10px 18px;
         background: #111827; color: #fff; text-decoration: none;
         border-radius: 8px; font-weight: bold; font-size: 14px; }
  .footer { padding: 12px 18px; background: #f9fafb;
            border-top: 1px solid #e5e7eb; font-size: 12px; color: #9ca3af; }
</style>
</head>
<body>
<div class='box'>
  <div class='head'>Documento caricato dal subvettore</div>
  <div class='content'>
    <p>Gentile operatore,</p>
    <p>il subvettore <strong>$safeSub</strong> ha caricato un documento in attesa di verifica.</p>
    <div class='detail-row'>
      <span class='detail-label'>Tipo documento:</span>
      <span class='detail-value'>$safeDocNome</span>
    </div>
    <div class='detail-row'>
      <span class='detail-label'>Riferimento:</span>
      <span class='detail-value'>#$safeDocId</span>
    </div>
    <div class='detail-row'>
      <span class='detail-label'>Subvettore:</span>
      <span class='detail-value'>$safeSub</span>
    </div>
    <a class='btn' href='$safeLoginUrl'>Accedi all'area di gestione</a>
  </div>
  <div class='footer'>Messaggio automatico — non rispondere a questa email.</div>
</div>
</body>
</html>";

        $mailInviate = array();
        $mailErrori  = array();

        foreach ($destinatari as $emailOp) {
            try {
                $mailOk = sc_send_mail_api(array_merge($sett_smtp, array(
                    'message' => array(
                        'to'      => $emailOp,
                        'subject' => $soggetto,
                        'html'    => $testoHtml,
                        'text'    => $testoPlain,
                    ),
                )));

                if ($mailOk === false || $mailOk === null) {
                    $mailErrori[] = $emailOp;
                } else {
                    $mailInviate[] = $emailOp;
                }

            } catch (Exception $e) {
                $mailErrori[] = $emailOp . ' (' . $e->getMessage() . ')';
            } catch (Throwable $e) {
                $mailErrori[] = $emailOp . ' (' . $e->getMessage() . ')';
            }
        }

        if (!empty($mailInviate)) {
            sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId tipo='$nome_documento' — mail operatori inviata a " . implode(', ', $mailInviate));
        }
        if (!empty($mailErrori)) {
            sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId tipo='$nome_documento' — mail operatori fallita per: " . implode('; ', $mailErrori));
        }
    }

    try {
        sc_exec_sql("UPDATE documenti SET stato_documento_id = 2, updated_at = NOW(), is_not_ok = 0 WHERE id = " . (int)$docId);
        sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId — stato=caricato, is_not_ok=0");

    } catch (Exception $e) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — aggiornamento stato: " . $e->getMessage());
    } catch (Throwable $e) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — aggiornamento stato: " . $e->getMessage());
    }
}

if ({is_not_ok} == 1 && (int)$group_id !== 2) {

    try {
        sc_exec_sql("UPDATE documenti SET stato_documento_id = 3, updated_at = NOW() WHERE id = {id}");
    } catch (Exception $e) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — aggiornamento stato da revisionare: " . $e->getMessage());
    } catch (Throwable $e) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — aggiornamento stato da revisionare: " . $e->getMessage());
    }

    $titolo    = "Documento $nome_documento da correggere";
    $messaggio = "Il documento '$nome_documento' risulta errato e deve essere sostituito o corretto. Si richiede di effettuare l'upload di una versione aggiornata.";

    try {
        sc_send_notification([
            'title'        => $titolo,
            'message'      => $messaggio,
            'destiny_type' => 'user',
            'to'           => $intestatario,
            'from'         => $usrLogin,
            'link'         => '',
            'dtexpire'     => '',
            'profile'      => 'Pigliacelli_Notifications'
        ]);
        sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId — notifica revisione inviata a $intestatario");

    } catch (Exception $e) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — notifica revisione a $intestatario: " . $e->getMessage());
    } catch (Throwable $e) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — notifica revisione a $intestatario: " . $e->getMessage());
    }

    $destinatario = trim((string)$intestatario);

    if ($destinatario === '' || filter_var($destinatario, FILTER_VALIDATE_EMAIL) === false) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — email subvettore non valida: [$destinatario]");
    } else {

        sc_lookup(rs_smtp_rev, "SELECT set_name, set_value FROM sec_settings");
        $loginUrlRev = '';
        if (isset({rs_smtp_rev[0][0]})) {
            foreach ({rs_smtp_rev} as $f) {
                $_SESSION['sett_' . $f[0]] = $f[1];
                if ($f[0] === 'login_url') {
                    $loginUrlRev = trim((string)$f[1]);
                }
            }
        }

        if (isset($_SESSION['sett_smtp_api']) && $_SESSION['sett_smtp_api'] == 'custom') {
            $sett_smtp_rev = array(
                'settings' => array(
                    'gateway'       => 'smtp',
                    'smtp_server'   => $_SESSION['sett_smtp_server'],
                    'smtp_protocol' => $_SESSION['sett_smtp_security'],
                    'smtp_port'     => $_SESSION['sett_smtp_port'],
                    'smtp_user'     => $_SESSION['sett_smtp_user'],
                    'smtp_password' => $_SESSION['sett_smtp_pass'],
                    'from_email'    => $_SESSION['sett_smtp_from_email'],
                    'from_name'     => $_SESSION['sett_smtp_from_name'],
                ),
            );
        } else {
            $sett_smtp_rev = array(
                'profile' => isset($_SESSION['sett_smtp_api']) ? $_SESSION['sett_smtp_api'] : ''
            );
        }

        $soggettoRev     = "Documento da correggere — " . $nome_documento . " (#$docId)";
        $safeDocNomeRev  = htmlspecialchars($nome_documento, ENT_QUOTES, 'UTF-8');
        $safeDocIdRev    = (int)$docId;
        $safeLoginUrlRev = htmlspecialchars($loginUrlRev, ENT_QUOTES, 'UTF-8');

        $testoPlainRev = "Gentile subvettore,\n\n"
            . "il documento seguente risulta errato e deve essere sostituito o corretto:\n\n"
            . "Tipo documento: $nome_documento\n"
            . "Riferimento: #$safeDocIdRev\n\n"
            . "Si richiede di effettuare l'upload di una versione aggiornata.\n"
            . "Per procedere, acceda alla sua area riservata:\n" . $loginUrlRev . "\n\n"
            . "Messaggio automatico — non rispondere.";

        $testoHtmlRev = "
<html>
<head>
<style>
  body { margin:0; font-family: Arial, sans-serif; background: #f4f4f4; padding: 20px; }
  .box { background:#fff; border-radius: 8px; overflow: hidden; max-width: 560px; margin: 0 auto; }
  .head { padding: 16px 18px; background: #fef3c7; color: #92400e; font-weight: bold; font-size: 16px; }
  .content { padding: 18px; color: #111827; line-height: 1.6; }
  .detail-row { display: flex; gap: 8px; margin: 6px 0; font-size: 14px; }
  .detail-label { color: #6b7280; min-width: 140px; }
  .detail-value { color: #111827; font-weight: bold; }
  .btn { display: inline-block; margin-top: 20px; padding: 10px 18px;
         background: #111827; color: #fff; text-decoration: none;
         border-radius: 8px; font-weight: bold; font-size: 14px; }
  .footer { padding: 12px 18px; background: #f9fafb;
            border-top: 1px solid #e5e7eb; font-size: 12px; color: #9ca3af; }
</style>
</head>
<body>
<div class='box'>
  <div class='head'>Documento da correggere</div>
  <div class='content'>
    <p>Gentile subvettore,</p>
    <p>il documento indicato risulta <strong>errato</strong> e deve essere sostituito o corretto. Si richiede di effettuare l'upload di una versione aggiornata.</p>
    <div class='detail-row'>
      <span class='detail-label'>Tipo documento:</span>
      <span class='detail-value'>$safeDocNomeRev</span>
    </div>
    <div class='detail-row'>
      <span class='detail-label'>Riferimento:</span>
      <span class='detail-value'>#$safeDocIdRev</span>
    </div>
    <a class='btn' href='$safeLoginUrlRev'>Accedi all'area riservata</a>
  </div>
  <div class='footer'>Messaggio automatico — non rispondere a questa email.</div>
</div>
</body>
</html>";

        try {
            $mailOkRev = sc_send_mail_api(array_merge($sett_smtp_rev, array(
                'message' => array(
                    'to'      => $destinatario,
                    'subject' => $soggettoRev,
                    'html'    => $testoHtmlRev,
                    'text'    => $testoPlainRev,
                ),
            )));

            if ($mailOkRev === false || $mailOkRev === null) {
                sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId tipo='$nome_documento' — invio mail revisione fallito (dest: $destinatario)");
            } else {
                sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId tipo='$nome_documento' — mail revisione inviata a $destinatario");
            }

        } catch (Exception $e) {
            sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — mail revisione a $destinatario: " . $e->getMessage());
        } catch (Throwable $e) {
            sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — mail revisione a $destinatario: " . $e->getMessage());
        }
    }

    sc_log_add("Revisione documento", "Documento '$nome_documento' (id={id}) segnato da correggere da $usrLogin");
}
