$tipo_documento = {tipo_documento_id};
sc_lookup(rs, "SELECT nome FROM tipi_documento WHERE id = $tipo_documento");
$nome_documento = {rs[0][0]};
$intestatario   = {login};
$usrLogin       = [usr_login];
$docId          = {id};

// Una sola sc_send_notification in tutto l'evento (SC espande solo la prima occorrenza nel file lungo)
$fdScNotifySend   = false;
$fdScNotifyTitle  = '';
$fdScNotifyMsg    = '';
$fdScNotifyTo     = '';
$fdScNotifyFrom   = 'admin';
$fdScNotifyLink   = 'app_Login';
$fdScNotifyExpire = '';
$fdScNotifyLogOk  = '';
$fdScNotifyLogErr = '';

$fileNow  = trim((string){file});
$statoDoc = (int){stato_documento_id};
$docSubId = (int){subvettore_id};

// 1 = in attesa, 2 = caricato, 3 = da revisionare
$statiAttesaCaricamento = array(1, 3);

// Subvettore ha caricato il file: notifica operatori via email
// (il campo file non espone [file] in onAfterUpdate, si usa stato documento e is_not_ok)
$isNotOk = ((int){is_not_ok} === 1);

$usrSubId = 0;
if ((int)$group_id === 2 && trim((string)$usrLogin) !== '') {
    $usrSql = str_replace("'", "''", trim((string)$usrLogin));
    sc_lookup(rsFdUsrSub, "
        SELECT subvettore_id
        FROM sec_users
        WHERE login = '$usrSql'
        LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsFdUsrSub[0][0]})) {
        $usrSubId = (int){rsFdUsrSub[0][0]};
    }
}

$sameSubLogin = (
    $docSubId > 0
    && $usrSubId > 0
    && $docSubId === $usrSubId
);

$isUploadSubvettore = (
    $fileNow !== ''
    && (
        strcasecmp(trim((string)$usrLogin), trim((string)$intestatario)) === 0
        || $sameSubLogin
    )
    && (in_array($statoDoc, $statiAttesaCaricamento, true) || $isNotOk)
);

if ($isUploadSubvettore) {

    $subEtichetta = form_docs_etichetta_subvettore($docSubId, $intestatario);

    // group_id: 1 = admin, 2 = subvettore, 3 = operatore
    sc_lookup(rsOps, "
        SELECT DISTINCT su.login, su.email
        FROM sec_users su
        INNER JOIN sec_users_groups sug ON sug.login = su.login
        WHERE su.active = 'Y'
          AND su.login IS NOT NULL
          AND TRIM(su.login) <> ''
          AND su.email IS NOT NULL
          AND TRIM(su.email) <> ''
          AND sug.group_id IN (1, 3)
    ");

    $emailPlaceholder = array('admin@admin.com', 'admin@localhost', 'admin@example.com');

    $destinatari     = array();
    $operatorLogins  = array();
    $emailScartate   = array();
    if (isset({rsOps[0][0]})) {
        foreach ({rsOps} as $row) {
            $loginOpRaw = trim((string)$row[0]);
            $loginOp    = form_docs_email_pulisci($loginOpRaw);

            if ($loginOp === '' || strcasecmp($loginOp, 'Guest') === 0) {
                continue;
            }

            $emailDest = form_docs_resolve_operator_email($loginOpRaw, $row[1]);
            if ($emailDest === '') {
                $emailScartate[] = strtolower(form_docs_email_pulisci($row[1])) . ' (formato non valido)';
                continue;
            }
            if (in_array($emailDest, $emailPlaceholder, true)) {
                $emailScartate[] = $emailDest . ' (email predefinita non utilizzabile)';
                continue;
            }

            $destinatari[]    = $emailDest;
            $operatorLogins[] = $loginOpRaw;
        }
    }
    $destinatari    = array_values(array_unique($destinatari));
    $operatorLogins = array_values(array_unique($operatorLogins));

    if (!empty($emailScartate)) {
        sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId — email operatori scartate: " . implode('; ', $emailScartate));
    }

    if (empty($destinatari)) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId tipo='$nome_documento' — nessun operatore con email valida");
    } else {

        sc_lookup(rs_smtp, "SELECT set_name, set_value FROM sec_settings");
        $loginUrl = '';
        if (isset({rs_smtp[0][0]})) {
            foreach ({rs_smtp} as $f) {
                $_SESSION['sett_' . $f[0]] = $f[1];
                if ($f[0] === 'login_url') {
                    $loginUrl = trim((string)$f[1]);
                }
            }
        }

        if (isset($_SESSION['sett_smtp_api']) && $_SESSION['sett_smtp_api'] == 'custom') {
            $sett_smtp = array(
                'settings' => array(
                    'gateway'       => 'smtp',
                    'smtp_server'   => $_SESSION['sett_smtp_server'],
                    'smtp_protocol' => $_SESSION['sett_smtp_security'],
                    'smtp_port'     => $_SESSION['sett_smtp_port'],
                    'smtp_user'     => $_SESSION['sett_smtp_user'],
                    'smtp_password' => $_SESSION['sett_smtp_pass'],
                    'from_email'    => $_SESSION['sett_smtp_from_email'],
                    'from_name'     => $_SESSION['sett_smtp_from_name'],
                ),
            );
        } else {
            $sett_smtp = array(
                'profile' => isset($_SESSION['sett_smtp_api']) ? $_SESSION['sett_smtp_api'] : ''
            );
        }

        $soggetto     = "Documento caricato — " . $nome_documento . " (#$docId)";
        $safeDocId    = (int)$docId;
        $safeSub      = htmlspecialchars($subEtichetta, ENT_QUOTES, 'UTF-8');

        $testoPlain = "Gentile operatore,\n\n"
            . "il subvettore $subEtichetta ha caricato il seguente documento:\n\n"
            . "Tipo documento: $nome_documento\n"
            . "Riferimento: #$safeDocId\n"
            . "Subvettore: $subEtichetta\n\n"
            . "Per verificarlo, acceda all'area di gestione:\n" . $loginUrl . "\n\n"
            . "Messaggio automatico — non rispondere.";

        $mailLogoUrl = form_docs_mail_logo_src();
        $mailInfoRows = form_docs_mail_detail_line('Tipo documento', $nome_documento)
            . form_docs_mail_detail_line('Riferimento', '#' . $safeDocId)
            . form_docs_mail_detail_line('Subvettore', $subEtichetta);
        $mailInner = '<p style="margin:0 0 12px;">Gentile operatore,</p>'
            . '<p style="margin:0 0 12px;">il subvettore <strong>' . $safeSub . '</strong> ha caricato un documento in attesa di verifica.</p>'
            . form_docs_mail_info_box($mailInfoRows)
            . form_docs_mail_btn($loginUrl, 'Accedi all\'area di gestione');
        $testoHtml = form_docs_mail_layout('Documento caricato dal subvettore', $mailInner, $mailLogoUrl);

        $mailInviate = array();
        $mailErrori  = array();

        foreach ($destinatari as $emailOp) {
            try {
                $mailOk = sc_send_mail_api(array_merge($sett_smtp, array(
                    'message' => array(
                        'to'      => $emailOp,
                        'subject' => $soggetto,
                        'html'    => $testoHtml,
                        'text'    => $testoPlain,
                    ),
                )));

                if ($mailOk === false || $mailOk === null) {
                    $mailErrori[] = $emailOp;
                } else {
                    $mailInviate[] = $emailOp;
                }

            } catch (Exception $e) {
                $mailErrori[] = $emailOp . ' (' . $e->getMessage() . ')';
            } catch (Throwable $e) {
                $mailErrori[] = $emailOp . ' (' . $e->getMessage() . ')';
            }
        }

        if (!empty($mailInviate)) {
            sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId tipo='$nome_documento' — mail operatori inviata a " . implode(', ', $mailInviate));
        }
        if (!empty($mailErrori)) {
            sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId tipo='$nome_documento' — mail operatori fallita per: " . implode('; ', $mailErrori));
        }
    }

    if (!empty($operatorLogins)) {
        $notifyFrom = trim((string)$usrLogin);
        if ($notifyFrom === '') {
            $notifyFrom = trim((string)$intestatario);
        }
        if ($notifyFrom === '') {
            $notifyFrom = 'admin';
        }
        $notifyLink   = isset($loginUrl) && $loginUrl !== '' ? $loginUrl : 'app_Login';
        $notifyExpire = date('Y-m-d H:i:s', strtotime('+30 days'));
        $notifyTitle  = 'Documento caricato — ' . $nome_documento . ' (#' . (int)$docId . ')';
        $notifyMsg    = 'Il subvettore ' . $subEtichetta
            . ' ha caricato il documento "' . $nome_documento . '" (#' . (int)$docId . '). Verificare in griglia documenti.';

        $fdScNotifySend   = true;
        $fdScNotifyTitle  = $notifyTitle;
        $fdScNotifyMsg    = $notifyMsg;
        $fdScNotifyTo     = implode(';', $operatorLogins);
        $fdScNotifyFrom   = $notifyFrom;
        $fdScNotifyLink   = $notifyLink;
        $fdScNotifyExpire = $notifyExpire;
        $fdScNotifyLogOk  = "onAfterUpdate doc=$docId — notifica SC operatori inviata a " . implode(';', $operatorLogins) . " from=$notifyFrom";
        $fdScNotifyLogErr = "onAfterUpdate doc=$docId — notifica SC operatori";
    } else {
        sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId — notifica SC operatori saltata: nessun login valido");
    }

    try {
        sc_exec_sql("UPDATE documenti SET stato_documento_id = 2, updated_at = NOW(), is_not_ok = 0 WHERE id = " . (int)$docId);
        sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId — stato=caricato, is_not_ok=0");

    } catch (Exception $e) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — aggiornamento stato: " . $e->getMessage());
    } catch (Throwable $e) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — aggiornamento stato: " . $e->getMessage());
    }
}

// Operatore/admin segna da correggere: notifica + mail al subvettore
// (statoDoc !== 3 evita ripetere se già "da revisionare"; non usare [is_not_ok] = globale SC)
if ((int){is_not_ok} === 1 && (int)$group_id !== 2 && (int)$statoDoc !== 3) {

    sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId — revisione attiva intestatario=$intestatario staff=$usrLogin");

    try {
        sc_exec_sql("UPDATE documenti SET stato_documento_id = 3, updated_at = NOW() WHERE id = {id}");
    } catch (Exception $e) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — aggiornamento stato da revisionare: " . $e->getMessage());
    } catch (Throwable $e) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — aggiornamento stato da revisionare: " . $e->getMessage());
    }

    $titolo    = "Documento $nome_documento da correggere";
    $messaggio = "Il documento '$nome_documento' risulta errato e deve essere sostituito o corretto. Si richiede di effettuare l'upload di una versione aggiornata.";

    $notifyFromRev = trim((string)$usrLogin);
    if ($notifyFromRev === '') {
        $notifyFromRev = 'admin';
    }
    $notifyLinkRev   = '';
    $notifyExpireRev = date('Y-m-d H:i:s', strtotime('+30 days'));
    sc_lookup(rs_smtp_rev_link, "SELECT set_value FROM sec_settings WHERE set_name = 'login_url' LIMIT 1");
    if (isset({rs_smtp_rev_link[0][0]})) {
        $notifyLinkRev = trim((string){rs_smtp_rev_link[0][0]});
    }
    if ($notifyLinkRev === '') {
        $notifyLinkRev = 'app_Login';
    }

    $fdScNotifySend   = true;
    $fdScNotifyTitle  = $titolo;
    $fdScNotifyMsg    = $messaggio;
    $fdScNotifyTo     = $intestatario;
    $fdScNotifyFrom   = $notifyFromRev;
    $fdScNotifyLink   = $notifyLinkRev;
    $fdScNotifyExpire = $notifyExpireRev;
    $fdScNotifyLogOk  = "onAfterUpdate doc=$docId — notifica revisione inviata a $intestatario from=$notifyFromRev";
    $fdScNotifyLogErr = "onAfterUpdate doc=$docId — notifica revisione a $intestatario";

    $destinatario = '';
    if ($docSubId > 0) {
        sc_lookup(rsFdSubRev, "
            SELECT login_subvettore
            FROM subvettori
            WHERE id = $docSubId
            LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsFdSubRev[0][0]}) && form_docs_email_valida({rsFdSubRev[0][0]})) {
            $destinatario = trim((string){rsFdSubRev[0][0]});
            sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId — destinatario SMTP revisione da subvettore_id=$docSubId → $destinatario");
        }
    }
    if ($destinatario === '' || !form_docs_email_valida($destinatario)) {
        $destinatario = form_docs_resolve_destinatario($intestatario);
    }

    if ($destinatario === '' || !form_docs_email_valida($destinatario)) {
        sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — email subvettore non valida: subvettore_id=$docSubId login=[$intestatario] dest=[$destinatario]");
    } else {

        sc_lookup(rs_smtp_rev, "SELECT set_name, set_value FROM sec_settings");
        $loginUrlRev = '';
        if (isset({rs_smtp_rev[0][0]})) {
            foreach ({rs_smtp_rev} as $f) {
                $_SESSION['sett_' . $f[0]] = $f[1];
                if ($f[0] === 'login_url') {
                    $loginUrlRev = trim((string)$f[1]);
                }
            }
        }

        if (isset($_SESSION['sett_smtp_api']) && $_SESSION['sett_smtp_api'] == 'custom') {
            $sett_smtp_rev = array(
                'settings' => array(
                    'gateway'       => 'smtp',
                    'smtp_server'   => $_SESSION['sett_smtp_server'],
                    'smtp_protocol' => $_SESSION['sett_smtp_security'],
                    'smtp_port'     => $_SESSION['sett_smtp_port'],
                    'smtp_user'     => $_SESSION['sett_smtp_user'],
                    'smtp_password' => $_SESSION['sett_smtp_pass'],
                    'from_email'    => $_SESSION['sett_smtp_from_email'],
                    'from_name'     => $_SESSION['sett_smtp_from_name'],
                ),
            );
        } else {
            $sett_smtp_rev = array(
                'profile' => isset($_SESSION['sett_smtp_api']) ? $_SESSION['sett_smtp_api'] : ''
            );
        }

        $soggettoRev     = "Documento da correggere — " . $nome_documento . " (#$docId)";
        $safeDocIdRev    = (int)$docId;

        $salutoSubRev     = form_docs_saluto_subvettore($docSubId);
        $safeSalutoSubRev = htmlspecialchars($salutoSubRev, ENT_QUOTES, 'UTF-8');

        $testoPlainRev = $salutoSubRev . ",\n\n"
            . "il documento seguente risulta errato e deve essere sostituito o corretto:\n\n"
            . "Tipo documento: $nome_documento\n"
            . "Riferimento: #$safeDocIdRev\n\n"
            . "Si richiede di effettuare l'upload di una versione aggiornata.\n"
            . "Per procedere, acceda alla sua area riservata:\n" . $loginUrlRev . "\n\n"
            . "Messaggio automatico — non rispondere.";

        $mailLogoUrlRev = form_docs_mail_logo_src();
        $mailInfoRowsRev = form_docs_mail_detail_line('Tipo documento', $nome_documento)
            . form_docs_mail_detail_line('Riferimento', '#' . $safeDocIdRev);
        $mailInnerRev = '<p style="margin:0 0 12px;">' . $safeSalutoSubRev . ',</p>'
            . '<p style="margin:0 0 12px;">il documento indicato risulta <strong>errato</strong> e deve essere sostituito o corretto. '
            . 'Si richiede di effettuare l\'upload di una versione aggiornata.</p>'
            . form_docs_mail_info_box($mailInfoRowsRev)
            . form_docs_mail_btn($loginUrlRev, 'Accedi all\'area riservata');
        $testoHtmlRev = form_docs_mail_layout('Documento da correggere', $mailInnerRev, $mailLogoUrlRev);

        try {
            $mailOkRev = sc_send_mail_api(array_merge($sett_smtp_rev, array(
                'message' => array(
                    'to'      => $destinatario,
                    'subject' => $soggettoRev,
                    'html'    => $testoHtmlRev,
                    'text'    => $testoPlainRev,
                ),
            )));

            if ($mailOkRev === false || $mailOkRev === null) {
                sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId tipo='$nome_documento' — invio mail revisione fallito (dest: $destinatario)");
            } else {
                sc_log_add('MAIL_DOCS', "onAfterUpdate doc=$docId tipo='$nome_documento' — mail revisione inviata a $destinatario");
            }

        } catch (Exception $e) {
            sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — mail revisione a $destinatario: " . $e->getMessage());
        } catch (Throwable $e) {
            sc_log_add('MAIL_DOCS', "ERRORE onAfterUpdate doc=$docId — mail revisione a $destinatario: " . $e->getMessage());
        }
    }

    sc_log_add("Revisione documento", "Documento '$nome_documento' (id={id}) segnato da correggere da $usrLogin");
}

if ($fdScNotifySend && $fdScNotifyTo !== '' && $fdScNotifyTitle !== '') {
    if ($fdScNotifyExpire === '') {
        $fdScNotifyExpire = date('Y-m-d H:i:s', strtotime('+30 days'));
    }
    try {
        sc_send_notification(array(
            'title'        => $fdScNotifyTitle,
            'message'      => $fdScNotifyMsg,
            'destiny_type' => 'user',
            'to'           => $fdScNotifyTo,
            'from'         => $fdScNotifyFrom,
            'link'         => $fdScNotifyLink,
            'dtexpire'     => $fdScNotifyExpire,
            'profile'      => 'Pigliacelli_Notifications',
        ));
        sc_log_add('MAIL_DOCS', $fdScNotifyLogOk);
    } catch (Exception $e) {
        sc_log_add('MAIL_DOCS', "ERRORE $fdScNotifyLogErr: " . $e->getMessage());
    } catch (Throwable $e) {
        sc_log_add('MAIL_DOCS', "ERRORE $fdScNotifyLogErr: " . $e->getMessage());
    }
}
