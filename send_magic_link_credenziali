$smlc_get_smtp_config = function () {
    sc_lookup(rsSmlcSmtp, 'SELECT set_name, set_value FROM sec_settings', 'pigliacelli');
    if (!empty({rsSmlcSmtp})) {
        foreach ({rsSmlcSmtp} as $f) {
            $_SESSION['sett_' . $f[0]] = $f[1];
        }
    }
    $smtpApi = isset($_SESSION['sett_smtp_api']) ? (string)$_SESSION['sett_smtp_api'] : '';
    if ($smtpApi === 'custom') {
        return array(
            'settings' => array(
                'gateway'       => 'smtp',
                'smtp_server'   => (string)($_SESSION['sett_smtp_server'] ?? ''),
                'smtp_protocol' => (string)($_SESSION['sett_smtp_security'] ?? ''),
                'smtp_port'     => (string)($_SESSION['sett_smtp_port'] ?? ''),
                'smtp_user'     => (string)($_SESSION['sett_smtp_user'] ?? ''),
                'smtp_password' => (string)($_SESSION['sett_smtp_pass'] ?? ''),
                'from_email'    => (string)($_SESSION['sett_smtp_from_email'] ?? ''),
                'from_name'     => (string)($_SESSION['sett_smtp_from_name'] ?? ''),
            ),
        );
    }
    return array('profile' => $smtpApi);
};

$smlc_portal_url = function () use ($sc_setting) {
    $loginUrl = rtrim(trim($sc_setting('login_url', '')), '/');
    if ($loginUrl !== '') {
        return $loginUrl;
    }
    $portalUrl = rtrim(trim($sc_setting('portal_url', '')), '/');
    if ($portalUrl !== '') {
        return $portalUrl;
    }
    return rtrim(trim($sc_setting('app_url', '')), '/');
};

