        . 'color:#ffffff;text-decoration:none;">Accedi all\'area riservata</a>'
        . '</td></tr></table>';
    $html = pigliacelli_mail_layout($titolo, $inner, $mailLogoUrl);
    try {
        sc_send_mail_api(array_merge($smlc_get_smtp_config(), array(
            'message' => array(
                'html'    => $html,
                'text'    => $testo,
                'to'      => $to,
                'subject' => $titolo,
            ),
        )));
    } catch (Throwable $e) {
        sc_log_add('MAGIC_LINK_CRED', 'MAIL_AREA EXCEPTION contratto=' . (int)$contratto_id . ' msg=' . $e->getMessage());
        return false;
    }
    sc_log_add('MAGIC_LINK_CRED', 'MAIL_AREA inviato link area riservata contratto=' . (int)$contratto_id
        . ' to=' . $to
        . ($toOrig !== $to ? ' orig=' . $toOrig : ''));
    return true;
};

// --- Mail credenziali / area riservata (solo contratti tipo 2 o 3) ---
$tipoContrattoId = 0;
sc_lookup(rsTipoContr, "
    SELECT tipo_contratto_id
    FROM contratti
    WHERE id = " . (int)$contrattoId . "
    LIMIT 1
", 'pigliacelli');
if (!empty({rsTipoContr[0][0]})) {
    $tipoContrattoId = (int){rsTipoContr[0][0]};
}

$esitoCred = 'skip';

if (!in_array($tipoContrattoId, array(2, 3), true)) {
    sc_log_add(
        'MAGIC_LINK_CRED',
        'MAIL_SUB skip tipo_contratto=' . $tipoContrattoId . ' (credenziali solo per tipo 2/3)'
    );
    $esitoCred = 'skip_tipo';
} else {
    $toEmailCred = smlc_email_valida($loginSub) ? $loginSub : '';

    sc_lookup(rsUserCred, "
        SELECT login, active, email
        FROM sec_users
        WHERE subvettore_id = " . smlc_sql_num($subvettoreId) . "
        LIMIT 1
    ", 'pigliacelli');

    $userLogin = '';
    $userActive = '';
    $userEmail = '';
    if (!empty({rsUserCred[0][0]})) {
        $userLogin = trim((string){rsUserCred[0][0]});
        $userActive = trim((string){rsUserCred[0][1]});
        $userEmail = trim((string){rsUserCred[0][2]});
    }

    // Stessa email su altro subvettore_id: riusa login esistente senza INSERT
    if ($userLogin === '' && smlc_email_valida($loginSub)) {
        sc_lookup(rsUserByLogin, "
            SELECT login, active, email, subvettore_id
            FROM sec_users
            WHERE login = " . smlc_sql_quote($loginSub) . "
            LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsUserByLogin[0][0]})) {
            $userLogin = trim((string){rsUserByLogin[0][0]});
            $userActive = trim((string){rsUserByLogin[0][1]});
            $userEmail = trim((string){rsUserByLogin[0][2]});
            sc_log_add(
                'MAGIC_LINK_CRED',
                'MAIL_SUB riuso login esistente login=' . $userLogin
                . ' subvettore_utenza=' . (int){rsUserByLogin[0][3]}
                . ' subvettore_richiesto=' . (int)$subvettoreId
            );
        }
    }

    if ($userLogin === '' || !smlc_utenza_valida($userLogin, $userEmail)) {
        sc_log_add(
            'MAGIC_LINK_CRED',
            'MAIL_SUB skip nessuna utenza valida (utenza creata dal job import) subvettore='
            . (int)$subvettoreId . ' login=[' . $userLogin . '] — magic link comunque a anagrafica'
        );
        $esitoCred = ($userLogin !== '' && smlc_login_is_tecnico($userLogin)) ? 'skip_tecnico' : 'skip_no_utenza';
    } else {
        $toEmailCred = smlc_email_valida($userEmail) ? $userEmail : $loginSub;

        if (smlc_user_active_is_yes($userActive)) {
            if ($smlc_send_mail_area_riservata($contrattoId, $toEmailCred, $displayNameCred)) {
                $esitoCred = 'area_riservata';
            } else {
                $esitoCred = 'errore';
            }
        } else {
            $plainPassword = smlc_generate_temp_password();
            $pswHash = md5($plainPassword);
            sc_exec_sql("
                UPDATE sec_users
                SET active = 'Y',
                    pswd = " . smlc_sql_quote($pswHash) . ",
                    email = " . smlc_sql_quote($loginSub) . ",
                    name = " . smlc_sql_quote($ragioneSociale) . ",
                    phone = " . smlc_sql_quote($phoneSub) . "
                WHERE login = " . smlc_sql_quote($userLogin) . "
            ", 'pigliacelli');
            $loginInvio = $userLogin !== '' ? $userLogin : $loginSub;
            if ($smlc_send_mail_credenziali($contrattoId, $toEmailCred, $loginInvio, $plainPassword, $displayNameCred)) {
                $esitoCred = 'credenziali';
            } else {
                $esitoCred = 'errore';
            }
        }
    }
}

sc_log_add(
    'MAGIC_LINK_CRED',
    'cred_esito=' . $esitoCred
    . ' tipo_contratto=' . $tipoContrattoId
    . ' subvettore=' . (int)$subvettoreId
    . ' contratto=' . (int)$contrattoId
);

// --- Magic link (sempre al subvettore reale, non mail_override) ---
$payload = json_encode(array(
    'scId'         => $scId,
    'contrattoId'  => (int)$contrattoId,
    'subvettoreId' => (int)$subvettoreId,
    'exp'          => time() + ($ttlDays * 86400),
), JSON_UNESCAPED_UNICODE);

$token = magic_link_encryptData($payload, $cypherKey);

$base = rtrim($formBaseUrl, '?&');
$join = (strpos($base, '?') !== false) ? '&' : '?';
$magicUrl = $base . $join . 't=' . rawurlencode($token);

$sett_smtp = $smlc_get_smtp_config();

$subjectTpl = trim($sc_setting('magic_link_mail_subject', ''));
$titolo = ($subjectTpl !== '')
    ? str_replace(['{contrattoId}', '{subvettoreId}'], [(string)$contrattoId, (string)$subvettoreId], $subjectTpl)
    : 'Compilazione dati contratto #' . (int)$contrattoId;

$safeUrl = htmlspecialchars($magicUrl, ENT_QUOTES, 'UTF-8');
$safeNome = htmlspecialchars($displayNameMl, ENT_QUOTES, 'UTF-8');

$messaggioTesto = $displayNameMl . ",\n\n"
    . "Per compilare i dati del contratto #" . (int)$contrattoId . " apra il link seguente:\n\n"
    . $magicUrl . "\n\n"
    . "Il link è personale, cifrato e scade tra " . (int)$ttlDays . " giorni.\n\n"
    . "Messaggio automatico — non rispondere.";

$mailBase = rtrim(trim($sc_setting('mail_base_url', '')), '/');
$mailLogoLog = (strpos($mailLogoUrl, 'data:image/') === 0)
    ? 'embed bytes=' . (strlen($mailLogoUrl) - 22)
    : 'url src=[' . $mailLogoUrl . ']';
sc_log_add('MAGIC_LINK_CRED', 'magic_link mail_logo ' . $mailLogoLog . ' mail_base_url=[' . $mailBase . '] to=' . $toEmail);

$mailInner = '<p style="margin:0 0 16px;">' . $safeNome . ',</p>'
    . '<p style="margin:0 0 24px;">Le chiediamo di compilare i dati per il contratto <strong>#' . (int)$contrattoId . '</strong>.</p>'
    . '<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;"><tr>'
    . '<td align="center" bgcolor="#5b2d8e" style="border-radius:8px;background-color:#5b2d8e;">'
    . '<a href="' . $safeUrl . '" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:bold;'
    . 'color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;">Apri il modulo</a>'
    . '</td></tr></table>'
    . '<p style="margin:0 0 8px;font-size:13px;color:#718096;">Oppure copi questo indirizzo nel browser:</p>'
    . '<p style="margin:0;word-break:break-all;font-size:13px;">'
    . '<a href="' . $safeUrl . '" style="color:#5b2d8e;">' . $safeUrl . '</a></p>';
$htmlContent = pigliacelli_mail_layout($titolo, $mailInner, $mailLogoUrl);

try {
    sc_send_mail_api(array_merge($sett_smtp, array(
        'message' => array(
            'html'    => $htmlContent,
            'text'    => $messaggioTesto,
            'to'      => $toEmail,
            'subject' => $titolo,
        ),
    )));
} catch (Throwable $e) {
    sc_log_add('MAGIC_LINK_CRED', 'MAGIC_LINK EXCEPTION msg=' . $e->getMessage());
    $ajax_fail('Errore invio magic link: ' . $e->getMessage());
}

sc_lookup(rsStInviato, "
    SELECT id
    FROM stati_contratti
    WHERE nome = 'Inviato al subvettore'
    LIMIT 1
", 'pigliacelli');
if (!empty({rsStInviato[0][0]})) {
    sc_exec_sql("
        UPDATE contratti
        SET stato_contratto_id = " . (int){rsStInviato[0][0]} . "
        WHERE id = " . (int)$contrattoId . "
        LIMIT 1
    ", 'pigliacelli');
    sc_log_add('MAGIC_LINK_CRED', 'stato contratto=' . (int)$contrattoId . ' → Inviato al subvettore');
} else {
    sc_log_add('MAGIC_LINK_CRED', "WARN: stato 'Inviato al subvettore' assente in stati_contratti");
}

$msgOk = 'Magic link inviato a ' . $toEmail . ' (email anagrafica subvettore)';
if ($esitoCred === 'credenziali') {
    $msgOk .= '; credenziali area riservata inviate (utenza riattivata)';
} elseif ($esitoCred === 'area_riservata') {
    $msgOk .= '; notifica area riservata inviata (usa le credenziali gia\' in tuo possesso)';
} elseif ($esitoCred === 'skip_tipo') {
    $msgOk .= '; mail credenziali non prevista per questo tipo contratto';
} elseif ($esitoCred === 'skip_tecnico') {
    $msgOk .= '; utenza tecnica — mail credenziali non inviata (creare utenza reale via import/anagrafica)';
} elseif ($esitoCred === 'skip_no_utenza') {
    $msgOk .= '; nessuna utenza in sec_users — mail credenziali non inviata (utenza creata dal job import)';
} elseif ($esitoCred === 'errore') {
    $msgOk .= '; attenzione: mail credenziali/area riservata non inviata (vedi log MAGIC_LINK_CRED)';
}

$ajax_ok($msgOk);
