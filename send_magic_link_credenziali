/**
 * Invio magic link + eventuale mail credenziali/area riservata.
 *
 * MAGIC LINK (sempre, se anagrafica ok):
 *   Destinatario: subvettori.login_subvettore (email in anagrafica).
 *   Non dipende da sec_users: anche senza utenza valida, il link va all'email del subvettore.
 *   Se login_subvettore mancante/non valido → errore, nessuna mail inviata.
 *
 * MAIL CREDENZIALI (solo contratti tipo 2 o 3, mai crea utenze — le crea il job import):
 *   - utenza valida in sec_users + active=Y → mail “accedi con le tue credenziali”
 *   - utenza valida + active=N → riattiva (UPDATE), nuova password + mail credenziali
 *   - nessuna utenza / SUBVETTORE_* / tipo ≠ 2,3 → skip mail credenziali (magic link comunque)
 *
 * Test UAT credenziali (solo mail area riservata/credenziali, non il magic link):
 *   ?mail_override=1 | ?mail_override=tua@email.it | ?mail_override=1&mail_to=altra@email.it
 *   Override attivo solo con valore esplicito in URL; parametri SC vuoti/spuri ignorati.
 */

$SMLC_MAIL_OVERRIDE_DEFAULT = 'davide.chieli@digiwebuno.it';

if (!function_exists('smlc_sql_quote')) {
    function smlc_sql_quote($v)
    {
        if ($v === null) {
            return 'NULL';
        }
        return "'" . str_replace("'", "''", (string)$v) . "'";
    }
}

if (!function_exists('smlc_sql_num')) {
    function smlc_sql_num($v)
    {
        if ($v === null || $v === '') {
            return 'NULL';
        }
        return (string)(0 + $v);
    }
}

if (!function_exists('smlc_email_valida')) {
    function smlc_email_valida($email)
    {
        $email = trim((string)$email);

        if ($email === '') {
            return false;
        }

        if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
            return false;
        }

        return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
    }
}

if (!function_exists('smlc_generate_temp_password')) {
    function smlc_generate_temp_password()
    {
        $characters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=';
        $charactersLength = strlen($characters);
        $temporaryPassword = '';

        for ($i = 0; $i < 12; $i++) {
            $temporaryPassword .= $characters[random_int(0, $charactersLength - 1)];
        }

        return $temporaryPassword;
    }
}

if (!function_exists('smlc_user_active_is_yes')) {
    function smlc_user_active_is_yes($active)
    {
        $a = strtoupper(trim((string)$active));
        return ($a === 'Y' || $a === '1' || $a === 'S' || $a === 'SI' || $a === 'YES');
    }
}

if (!function_exists('smlc_login_is_tecnico')) {
    function smlc_login_is_tecnico($login)
    {
        $login = trim((string)$login);
        return strncmp($login, 'SUBVETTORE_', 11) === 0;
    }
}

if (!function_exists('smlc_utenza_valida')) {
    function smlc_utenza_valida($login, $email)
    {
        $login = trim((string)$login);
        if ($login === '' || smlc_login_is_tecnico($login)) {
            return false;
        }
        if (smlc_email_valida($email)) {
            return true;
        }
        return smlc_email_valida($login);
    }
}

if (!function_exists('magic_link_encryptData')) {
    function magic_link_encryptData($data, $key)
    {
        $iv = openssl_random_pseudo_bytes(16);
        $encrypted = openssl_encrypt((string)$data, 'AES-256-CBC', $key, 0, $iv);

        return base64_encode($iv . $encrypted);
    }
}

$sc_setting = function ($name, $default = '') {
    $safeName = str_replace("'", "''", trim((string)$name));
    sc_lookup(rsSet, "SELECT set_value FROM sec_settings WHERE set_name = '" . $safeName . "' LIMIT 1");
    if (isset({rsSet[0][0]})) {
        return (string){rsSet[0][0]};
    }
    return $default;
};

if (!function_exists('pigliacelli_mail_logo_read_embed')) {
    function pigliacelli_mail_logo_read_embed($anchorFile = null)
    {
        $rel = '_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png';
        $dir = realpath(dirname($anchorFile ?: __FILE__));
        for ($i = 0; $i < 12 && $dir; $i++) {
            $try = $dir . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $rel);
            if (is_readable($try)) {
                $bin = @file_get_contents($try);
                if ($bin !== false && $bin !== '' && strlen($bin) < 500000) {
                    return 'data:image/png;base64,' . base64_encode($bin);
                }
            }
            $p = dirname($dir);
            if ($p === $dir) {
                break;
            }
            $dir = $p;
        }
        return '';
    }
}

if (!function_exists('pigliacelli_mail_logo_src')) {
    function pigliacelli_mail_logo_src($getSetting, $anchorFile = null)
    {
        $embed = pigliacelli_mail_logo_read_embed($anchorFile);
        if ($embed !== '') {
            return $embed;
        }
        $base = rtrim(trim((string)$getSetting('mail_base_url', '')), '/');
        if ($base !== '' && preg_match('#^https?://#i', $base) === 1) {
            return htmlspecialchars(
                $base . '/_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png',
                ENT_QUOTES,
                'UTF-8'
            );
        }
        return '';
    }
}

