// --- Mail override UAT (solo credenziali/area riservata; magic link sempre al subvettore reale) ---
$smlc_mail_override_to = '';

$smlc_override_raw_candidates = array();

if (isset($_GET['mail_override'])) {
    $smlc_override_raw_candidates[] = trim((string)$_GET['mail_override']);
}
if (isset($_REQUEST['mail_override'])) {
    $smlc_override_raw_candidates[] = trim((string)$_REQUEST['mail_override']);
}
if (!empty($_SERVER['QUERY_STRING'])) {
    $qsMo = array();
    parse_str((string)$_SERVER['QUERY_STRING'], $qsMo);
    if (isset($qsMo['mail_override'])) {
        $smlc_override_raw_candidates[] = trim((string)$qsMo['mail_override']);
    }
    if (isset($qsMo['mail_to'])) {
        $smlc_override_raw_candidates[] = trim((string)$qsMo['mail_to']);
    }
}
if (!empty($_SERVER['REQUEST_URI'])) {
    $qMo = parse_url((string)$_SERVER['REQUEST_URI'], PHP_URL_QUERY);
    if (is_string($qMo) && $qMo !== '') {
        $qsMo = array();
        parse_str($qMo, $qsMo);
        if (isset($qsMo['mail_override'])) {
            $smlc_override_raw_candidates[] = trim((string)$qsMo['mail_override']);
        }
        if (isset($qsMo['mail_to'])) {
            $smlc_override_raw_candidates[] = trim((string)$qsMo['mail_to']);
        }
    }
}
if (isset($_GET['nmgp_arg']) && is_string($_GET['nmgp_arg'])) {
    $nmgpMo = array();
    parse_str((string)$_GET['nmgp_arg'], $nmgpMo);
    if (isset($nmgpMo['mail_override'])) {
        $smlc_override_raw_candidates[] = trim((string)$nmgpMo['mail_override']);
    }
    if (isset($nmgpMo['mail_to'])) {
        $smlc_override_raw_candidates[] = trim((string)$nmgpMo['mail_to']);
    }
}

$rawMo = '';
$mailToMo = '';
foreach ($smlc_override_raw_candidates as $cand) {
    $cand = trim((string)$cand);
    if ($cand === '') {
        continue;
    }
    if ($rawMo === '' && strpos($cand, '@') === false) {
        $rawMo = $cand;
    }
    if ($mailToMo === '' && strpos($cand, '@') !== false && smlc_email_valida($cand)) {
        $mailToMo = $cand;
    }
    if ($rawMo === '' && strpos($cand, '@') !== false) {
        $rawMo = $cand;
    }
}

// UAT esplicito: mail_override=1|true|yes oppure email in mail_override / mail_to
if ($rawMo !== '' && $rawMo !== '0' && strcasecmp($rawMo, 'false') !== 0) {
    if (strpos($rawMo, '@') !== false) {
        $smlc_mail_override_to = $rawMo;
    } elseif ($mailToMo !== '') {
        $smlc_mail_override_to = $mailToMo;
    } elseif ($rawMo === '1' || strcasecmp($rawMo, 'true') === 0 || strcasecmp($rawMo, 'yes') === 0) {
        global $SMLC_MAIL_OVERRIDE_DEFAULT;
        $smlc_mail_override_to = trim((string)$SMLC_MAIL_OVERRIDE_DEFAULT);
    }
}

if ($smlc_mail_override_to !== '' && !smlc_email_valida($smlc_mail_override_to)) {
