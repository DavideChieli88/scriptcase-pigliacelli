if (is_readable($contractHtmlPath)) {
    $rawHtml = @file_get_contents($contractHtmlPath);
    if ($rawHtml !== false && $rawHtml !== '') {
        // I file Word/HTML possono avere encoding non UTF-8.
        if (function_exists('mb_convert_encoding')) {
            $rawHtml = mb_convert_encoding($rawHtml, 'UTF-8', 'UTF-8, ISO-8859-1, Windows-1252');
        }

        // Estrae solo il body, cosi' evitiamo stili/meta che disturbano TCPDF.
        if (preg_match('/<body[^>]*>(.*)<\/body>/is', $rawHtml, $m)) {
            $htmlContratto = $m[1];
        } else {
            $htmlContratto = $rawHtml;
        }

        // Pulizia minima markup Word/MSO.
        $htmlContratto = preg_replace('/<!--\[if.*?<!\[endif\]-->/is', '', $htmlContratto);
        $htmlContratto = preg_replace('/<o:p>\s*<\/o:p>/i', '', $htmlContratto);
        $htmlContratto = preg_replace('/<o:p>.*?<\/o:p>/is', '', $htmlContratto);

        // "Tra" iniziale al centro: rimuove il primo "Tra" dal corpo HTML
        // e lo renderizza separatamente centrato.
        $htmlBefore = $htmlContratto;
        $htmlContratto = preg_replace('/>\s*Tra\s*</u', '><', $htmlContratto, 1);
        if ($htmlContratto !== null && $htmlContratto !== $htmlBefore) {
            $renderTraCentered = true;
        }

        // Una spaziatura dopo "...ISO 9001/2015 e".
        $htmlContratto = str_replace(
            'ISO 9001/2015 e',
            'ISO 9001/2015 e<br>',
            $htmlContratto
        );

        // Una spaziatura tra un articolo e l'altro.
        $htmlContratto = preg_replace('/(Art\.\s*\d+\))/u', '<br>$1', $htmlContratto);
    }
}

