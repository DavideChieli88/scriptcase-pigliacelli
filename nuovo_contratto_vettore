        if (in_array($i, $multilineIdxB, true)) {
            $pdf->MultiCell((float)$B_w[$i], $lineH_B, (string)$colTexts[$i], 0, $align, false);
            $pdf->SetXY($x + (float)$B_w[$i], $yRow);
        } else {
            $pdf->Cell((float)$B_w[$i], $rowH_B, (string)$colTexts[$i], 0, 0, $align);
            $pdf->SetXY($x + (float)$B_w[$i], $yRow);
        }
        $x += (float)$B_w[$i];
    }

    $pdf->SetY($yRow + $rowH_B);
}

$sigPageB = method_exists($pdf, 'getNumPages') ? (int)$pdf->getNumPages() : 0;
$pageH = $refreshPageH_B();
$sigY_B = $pageH - $marginBottom_A - 12;
$easygnSignPush('vettore', $sigPageB, 196, $sigY_B, 75.01, 12.51);
$contrattiAttachEasygnSignMeta($pdf, $easygnSignVisuals);

// --- Output: anteprima browser (default) oppure salvataggio per campo Document filename ---
$autoSavePdf = (
    (isset($_SESSION['pdf_auto_save']) && strtoupper(trim((string)$_SESSION['pdf_auto_save'])) === 'S') ||
    (isset([auto_save_pdf]) && strtoupper(trim((string)[auto_save_pdf])) === 'S')
);
if ($autoSavePdf) {
    $sqlQuote = function ($v) {
        return "'" . str_replace("'", "''", (string)$v) . "'";
    };

    $rsBaseDir = $this->Db->Execute("
        SELECT set_value
        FROM sec_settings
        WHERE set_name = 'contratti_base_dir'
        LIMIT 1
    ");

    $contrattiBaseDirRaw = '';
    if ($rsBaseDir !== false && !$rsBaseDir->EOF) {
        $contrattiBaseDirRaw = trim((string)$rsBaseDir->fields[0]);
        $rsBaseDir->Close();
    }
    if ($contrattiBaseDirRaw === '') {
        die('Impostare sec_settings.contratti_base_dir.');
    }

    if (!function_exists('contratti_detect_workspace_root')) {
        function contratti_detect_workspace_root($anchorFile = null)
        {
            if ($anchorFile === null || $anchorFile === '') {
                $anchorFile = __FILE__;
            }
            if (is_dir($anchorFile)) {
                $dir = realpath($anchorFile);
            } else {
                $dir = dirname($anchorFile);
                $resolved = realpath($dir);
                if ($resolved !== false) {
                    $dir = $resolved;
                }
            }
            if ($dir === false || $dir === '') {
                return '';
            }
            $current = $dir;
            for ($i = 0; $i < 12; $i++) {
                if (is_file($current . DIRECTORY_SEPARATOR . 'index.php')
                    && (is_dir($current . DIRECTORY_SEPARATOR . '_lib') || is_dir($current . DIRECTORY_SEPARATOR . 'grid_contratti'))) {
                    return $current;
                }
                $parent = dirname($current);
                if ($parent === $current) {
                    break;
                }
                $current = $parent;
            }
            $parent = dirname($dir);
            return ($parent !== '' && $parent !== $dir) ? $parent : $dir;
        }
    }
    if (!function_exists('contratti_resolve_anchor_file')) {
        function contratti_resolve_anchor_file()
        {
            if (!empty($_SERVER['SCRIPT_FILENAME']) && is_file((string)$_SERVER['SCRIPT_FILENAME'])) {
                return (string)$_SERVER['SCRIPT_FILENAME'];
            }
            return __FILE__;
        }
    }
    if (!function_exists('contratti_is_scriptcase_install_path')) {
        function contratti_is_scriptcase_install_path($path)
        {
            $p = strtolower(str_replace('\\', '/', trim((string)$path)));
            if ($p === '') {
                return false;
            }
            if (preg_match('#/(opt|usr)/scriptcase/#', $p)) {
                return true;
            }
            if (preg_match('#/v9-php\d+/#', $p)) {
                return true;
            }
            if (strpos($p, '/wwwroot/scriptcase/') !== false) {
                return true;
            }
            return false;
        }
    }
    if (!function_exists('contratti_path_under_docroot')) {
        function contratti_path_under_docroot($path)
        {
            if (empty($_SERVER['DOCUMENT_ROOT'])) {
                return true;
            }
            $docRoot = @realpath((string)$_SERVER['DOCUMENT_ROOT']);
            if ($docRoot === false || $docRoot === '') {
                return true;
            }
            $resolved = @realpath(str_replace('/', DIRECTORY_SEPARATOR, (string)$path));
            $check = ($resolved !== false && $resolved !== '') ? $resolved : (string)$path;
            $docRoot = str_replace('\\', '/', $docRoot);
            $check = str_replace('\\', '/', $check);
            return ($check === $docRoot || strpos($check, $docRoot . '/') === 0);
        }
    }
    if (!function_exists('resolve_contratti_base_dir')) {
        function resolve_contratti_base_dir($configuredPath, $anchorFile = null)
        {
            $configuredPath = trim((string)$configuredPath);
            if ($configuredPath === '') {
                return '';
            }
            $normalized = str_replace('\\', '/', $configuredPath);
            if ($normalized !== '' && $normalized[0] === '/') {
                $resolved = @realpath($configuredPath);
                if ($resolved !== false) {
                    return $resolved;
                }
                if (@mkdir($configuredPath, 0775, true) || is_dir($configuredPath)) {
                    $resolved = @realpath($configuredPath);
                    return $resolved !== false ? $resolved : rtrim($configuredPath, "/\\");
                }
                return rtrim($configuredPath, "/\\");
            }
            if (preg_match('#^[A-Za-z]:/#', $normalized) || preg_match('#^[A-Za-z]:\\\\#', $configuredPath)) {
                $resolved = realpath($configuredPath);
                if ($resolved !== false) {
                    return $resolved;
                }
                if (@mkdir($configuredPath, 0775, true) || is_dir($configuredPath)) {
                    $resolved = @realpath($configuredPath);
                    return $resolved !== false ? $resolved : rtrim($configuredPath, "/\\");
                }
                return rtrim($configuredPath, "/\\");
            }
            if (!empty($_SERVER['DOCUMENT_ROOT'])) {
                $docRoot = @realpath((string)$_SERVER['DOCUMENT_ROOT']);
                if ($docRoot !== false && $docRoot !== '') {
                    $docCand = $docRoot . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, trim($normalized, '/'));
                    if (is_dir($docCand)) {
                        $resolved = realpath($docCand);
                        return $resolved !== false ? $resolved : $docCand;
                    }
                    if (@mkdir($docCand, 0775, true) || is_dir($docCand)) {
                        $resolved = realpath($docCand);
                        return $resolved !== false ? $resolved : $docCand;
                    }
                }
            }
            if ($anchorFile === null || $anchorFile === '') {
                $anchorFile = contratti_resolve_anchor_file();
            }
            $root = contratti_detect_workspace_root($anchorFile);
            if ($root === '') {
                return '';
            }
            $full = $root . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, trim($normalized, '/'));
            $resolved = realpath($full);
            return $resolved !== false ? $resolved : $full;
        }
    }
    $contrattiBaseDir = resolve_contratti_base_dir($contrattiBaseDirRaw, contratti_resolve_anchor_file());
    if ($contrattiBaseDir === '') {
        die('contratti_base_dir non risolvibile: ' . $contrattiBaseDirRaw);
    }

    $relPath = $pdfFileName;
    $fullPath = $contrattiBaseDir . DIRECTORY_SEPARATOR . $relPath;
    $dirPdf = dirname($fullPath);
    if (!is_dir($dirPdf) && !@mkdir($dirPdf, 0775, true) && !is_dir($dirPdf)) {
        die('Impossibile creare la cartella: ' . $dirPdf);
    }

    // Genera in memoria, salva su disco, poi mostra inline nel browser.
    $pdfBin = $pdf->Output($pdfFileName, 'S');
    if (!is_string($pdfBin) || strncmp($pdfBin, '%PDF', 4) !== 0) {
        die('Generazione PDF non valida (no header %PDF).');
    }
    if (@file_put_contents($fullPath, $pdfBin) === false) {
        die('Impossibile salvare PDF su disco: ' . $fullPath);
    }
    if (function_exists('sc_log_add')) {
        sc_log_add(
            'PDF_SAVE',
            'nuovo_contratto_vettore contratto=' . (int)$contrattoId
            . ' path=' . $fullPath
            . ' docroot=' . (isset($_SERVER['DOCUMENT_ROOT']) ? (string)$_SERVER['DOCUMENT_ROOT'] : '')
            . ' anchor=' . contratti_resolve_anchor_file()
        );
    }

    $okUpdate = $this->Db->Execute("
        UPDATE contratti
        SET file = " . $sqlQuote($relPath) . "
        WHERE id = " . (int)$contrattoId . "
    ");
    if ($okUpdate === false) {
        die('Errore update contratti.file: ' . $this->Db->ErrorMsg());
    }

    $redirectAfter = isset($_SESSION['pdf_redirect_after']) ? trim((string)$_SESSION['pdf_redirect_after']) : '';
    if ($redirectAfter === '' && isset([redirect_after])) {
        $redirectAfter = trim((string)[redirect_after]);
    }
    unset($_SESSION['pdf_auto_save'], $_SESSION['pdf_redirect_after']);
    if ($redirectAfter !== '') {
        header('Location: ' . $redirectAfter);
        exit;
    }

    header('Content-Type: application/pdf');
    header('Content-Disposition: inline; filename="' . $pdfFileName . '"');
    header('Content-Length: ' . strlen($pdfBin));
    echo $pdfBin;
    exit;
}

