$formatDbDate = function ($value) {
    $value = trim((string)$value);
    if ($value === '' || $value === '0000-00-00') return '';

    // Gestisce sia DATE (YYYY-MM-DD) sia DATETIME (YYYY-MM-DD HH:MM:SS)
    $base = substr($value, 0, 10);
    $dt = \DateTime::createFromFormat('Y-m-d', $base);
    if ($dt instanceof \DateTime) return $dt->format('d/m/Y');

    $ts = strtotime($value);
    if ($ts !== false) return date('d/m/Y', $ts);

    return $value;
};


