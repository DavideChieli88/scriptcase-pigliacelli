$tipoContrattoId = (int)[tipoContrattoId];
$subvectorId = (int)[subvectorId];
$contrattoId = (int)[contrattoId];

if ($subvectorId <= 0 || $contrattoId <= 0) {
    sc_error_message('Parametri mancanti: subvectorId/contrattoId.');
    return;
}

// --- AJAX interno: stato contratti.file ---
if (isset($_GET['ajax']) && $_GET['ajax'] === 'status') {
    $cid = isset($_GET['contrattoId']) ? (int)$_GET['contrattoId'] : $contrattoId;
    if ($cid <= 0) {
        header('Content-Type: application/json; charset=UTF-8');
        echo json_encode(['ok' => false, 'error' => 'contrattoId non valido'], JSON_UNESCAPED_UNICODE);
        exit;
    }

    sc_lookup(rsC, "
        SELECT file
        FROM contratti
        WHERE id = " . (int)$cid . "
        LIMIT 1
    ");

    $fileVal = '';
    if (isset({rsC[0][0]})) {
        $fileVal = trim((string){rsC[0][0]});
    }

    header('Content-Type: application/json; charset=UTF-8');
    header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
    header('Pragma: no-cache');
    echo json_encode([
        'ok' => true,
        'contrattoId' => $cid,
        'ready' => ($fileVal !== ''),
        'file' => $fileVal,
    ], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    exit;
}

$_SESSION['pdf_auto_save'] = 'S';
$_SESSION['pdf_redirect_after'] = '';

$reportApp = '';
switch ($tipoContrattoId) {
    case 1:
        $reportApp = 'nuovo_contratto_vettore';
        break;
    case 2:
    case 3:
        $reportApp = 'variazione_contratto';
        break;
    default:
        sc_error_message('tipoContrattoId non gestito: ' . $tipoContrattoId);
        return;
}

$reportUrl = '../' . $reportApp . '/?subvector=' . (int)$subvectorId . '&contratto=' . (int)$contrattoId;
$statusUrl = '?ajax=status&contrattoId=' . (int)$contrattoId
    . '&subvectorId=' . (int)$subvectorId
    . '&tipoContrattoId=' . (int)$tipoContrattoId;

$reportUrlEsc = htmlspecialchars($reportUrl, ENT_QUOTES, 'UTF-8');
$statusUrlEsc = htmlspecialchars($statusUrl, ENT_QUOTES, 'UTF-8');

echo <<<HTML
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Generazione PDF...</title>
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; }
  body {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    background: #f3f4f6;
    color: #111827;
  }
  #pdfFrame {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    z-index: 1;
    background: #fff;
  }
  #overlay {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.88);
    padding: 16px;
  }
  #overlay.done { display: none; }
  .wrap {
    max-width: 520px;
    padding: 20px 22px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(0,0,0,.08);
    text-align: center;
  }
  .title { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
  .sub { font-size: 14px; color: #6b7280; }
  .spinner {
    width: 36px; height: 36px; margin: 16px auto 0;
    border: 3px solid #e5e7eb; border-top-color: #111827;
    border-radius: 50%; animation: spin 1s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  #toolbar {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 20;
    padding: 10px 14px;
    background: rgba(255,255,255,.95);
    border-bottom: 1px solid #e5e7eb;
    box-sizing: border-box;
  }
  #toolbar.visible { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  #toolbar .hint { font-size: 13px; color: #6b7280; }
  #btnClose {
    appearance: none; border: 0; border-radius: 8px;
    padding: 8px 14px; font-weight: 600; cursor: pointer;
    background: #111827; color: #fff;
  }
</style>
</head>
<body>
<div id="toolbar">
  <span class="hint" id="toolbarHint">PDF generato e salvato.</span>
  <button type="button" id="btnClose">Torna alla lista</button>
</div>

<div id="overlay">
  <div class="wrap">
    <div class="title">Generazione PDF in corso</div>
    <div class="sub" id="msg">Attendere il salvataggio del file...</div>
    <div class="spinner" id="spin"></div>
  </div>
</div>

<iframe id="pdfFrame" src="{$reportUrlEsc}" title="Anteprima PDF"></iframe>

<script>
(function () {
  const statusUrl = "{$statusUrlEsc}";
  const t0 = Date.now();
  const timeoutMs = 120000;
  const intervalMs = 2000;
  let gridReloaded = false;

  document.getElementById('btnClose').addEventListener('click', function () {
    if (window.opener && !window.opener.closed) {
      window.opener.focus();
    }
    window.close();
  });

  function onPdfReady() {
    var overlay = document.getElementById('overlay');
    if (overlay) overlay.classList.add('done');
    document.getElementById('toolbar').classList.add('visible');
    if (!gridReloaded && window.opener && !window.opener.closed) {
      gridReloaded = true;
      window.opener.location.reload();
    }
  }

  const timer = setInterval(async function () {
    if (Date.now() - t0 > timeoutMs) {
      clearInterval(timer);
      document.getElementById('msg').textContent = 'Timeout: salvataggio non rilevato. Se vedi il PDF sotto, puoi chiudere.';
      var sp = document.getElementById('spin');
      if (sp) sp.style.display = 'none';
      document.getElementById('overlay').classList.add('done');
      document.getElementById('toolbar').classList.add('visible');
      return;
    }

    try {
      const r = await fetch(statusUrl, { cache: 'no-store' });
      const j = await r.json();
      if (j && j.ok && j.ready) {
        clearInterval(timer);
        onPdfReady();
      }
    } catch (e) {}
  }, intervalMs);
})();
</script>
</body>
</html>
HTML;

exit;
