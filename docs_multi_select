if (!function_exists('docs_multi_resolve_login_from_subvettore')) {
    function docs_multi_resolve_login_from_subvettore($subvettore_id)
    {
        $subId = (int)$subvettore_id;
        if ($subId <= 0) {
            return '';
        }

        sc_lookup(rsFdLs, "
            SELECT login_subvettore
            FROM subvettori
            WHERE id = $subId
            LIMIT 1
        ", 'pigliacelli');
        $ls = isset({rsFdLs[0][0]}) ? trim((string){rsFdLs[0][0]}) : '';
        if ($ls !== '') {
            $lsSql = str_replace("'", "''", $ls);
            sc_lookup(rsFdUl, "
                SELECT login
                FROM sec_users
                WHERE login = '$lsSql'
                  AND subvettore_id = $subId
                LIMIT 1
            ", 'pigliacelli');
            if (!empty({rsFdUl[0][0]})) {
                return trim((string){rsFdUl[0][0]});
            }
        }

        sc_lookup(rsFdUf, "
            SELECT login
            FROM sec_users
            WHERE subvettore_id = $subId
            ORDER BY login
            LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsFdUf[0][0]})) {
            return trim((string){rsFdUf[0][0]});
        }

        return '';
    }
}

if (!function_exists('docs_multi_resolve_destinatario')) {
    function docs_multi_resolve_destinatario($loginField)
    {
        $loginField = trim((string)$loginField);
        if ($loginField === '') {
            return '';
        }
        if (docs_multi_email_valida($loginField)) {
            return $loginField;
        }

        $loginSql = str_replace("'", "''", $loginField);
        sc_lookup(rsFdUser, "
            SELECT email, subvettore_id
            FROM sec_users
            WHERE login = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');

        if (!empty({rsFdUser[0][0]})) {
            $emailUser = trim((string){rsFdUser[0][0]});
            if (docs_multi_email_valida($emailUser)) {
                return $emailUser;
            }
            $subId = (int){rsFdUser[0][1]};
            if ($subId > 0) {
                sc_lookup(rsFdSub, "
                    SELECT login_subvettore
                    FROM subvettori
                    WHERE id = $subId
                    LIMIT 1
                ", 'pigliacelli');
                if (!empty({rsFdSub[0][0]})) {
                    $emailSub = trim((string){rsFdSub[0][0]});
                    if (docs_multi_email_valida($emailSub)) {
                        return $emailSub;
                    }
                }
            }
        }

        sc_lookup(rsFdUserEmail, "
            SELECT email
            FROM sec_users
            WHERE email = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsFdUserEmail[0][0]}) && docs_multi_email_valida({rsFdUserEmail[0][0]})) {
            return trim((string){rsFdUserEmail[0][0]});
        }

        return '';
    }
}

if (!function_exists('docs_multi_mail_setting')) {
    function docs_multi_mail_setting($name, $default = '')
    {
        $key = 'sett_' . $name;
