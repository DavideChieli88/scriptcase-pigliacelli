            return (string)$_SESSION[$key];
        }
        $safeName = str_replace("'", "''", trim((string)$name));
        sc_lookup(rsFdMailSet, "SELECT set_value FROM sec_settings WHERE set_name = '$safeName' LIMIT 1");
        if (isset({rsFdMailSet[0][0]})) {
            return (string){rsFdMailSet[0][0]};
        }
        return $default;
    }
}

if (!function_exists('docs_multi_mail_logo_read_embed')) {
    function docs_multi_mail_logo_read_embed($anchorFile = null)
    {
        $rel = '_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png';
        $dir = realpath(dirname($anchorFile ?: __FILE__));
        for ($i = 0; $i < 12 && $dir; $i++) {
            $try = $dir . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $rel);
            if (is_readable($try)) {
                $bin = @file_get_contents($try);
                if ($bin !== false && $bin !== '' && strlen($bin) < 500000) {
                    return 'data:image/png;base64,' . base64_encode($bin);
                }
            }
            $p = dirname($dir);
            if ($p === $dir) {
                break;
            }
            $dir = $p;
        }
        return '';
    }
}

if (!function_exists('docs_multi_mail_logo_src')) {
    function docs_multi_mail_logo_src()
    {
        $embed = docs_multi_mail_logo_read_embed();
