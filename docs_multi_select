if (!function_exists('docs_multi_process_after_insert')) {
    function docs_multi_process_after_insert($docId, $tipo_documento_id, $loginField, $subvettore_id)
    {
        $docId = (int)$docId;
        $tipo_documento_id = (int)$tipo_documento_id;
        $loginField = trim((string)$loginField);
        $docSubId = (int)$subvettore_id;
        $logCtx = "docs_multi_process_after_insert doc=$docId";

        if ($docId <= 0) {
            sc_log_add('MAIL_DOCS', "$logCtx — saltato: docId non valido");
            return false;
        }

        $docNome = docs_multi_tipo_nome($tipo_documento_id);
        $destinatario = '';

        if ($docSubId > 0) {
            sc_lookup(rsFdSubMail, "
                SELECT login_subvettore
                FROM subvettori
                WHERE id = $docSubId
                LIMIT 1
            ", 'pigliacelli');
            if (!empty({rsFdSubMail[0][0]}) && docs_multi_email_valida({rsFdSubMail[0][0]})) {
                $destinatario = trim((string){rsFdSubMail[0][0]});
                sc_log_add('MAIL_DOCS', "$logCtx — destinatario SMTP da subvettore_id=$docSubId → $destinatario");
            }
        }

        $loginSql = str_replace("'", "''", $loginField);
        $userLogin = '';
        $userActive = '';
        $userDisplayName = '';
        $storedPassword = '';
        $hasLoggedFirst = 0;
        $plainPassword = '';
        $sendCredentials = false;

        sc_lookup(rsUserDoc, "
            SELECT login, active, name, email, pswd, COALESCE(hasLoggedFirst, 0)
            FROM sec_users
            WHERE login = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');

        if (!isset({rsUserDoc[0][0]}) && docs_multi_email_valida($loginField)) {
            sc_lookup(rsUserDoc, "
                SELECT login, active, name, email, pswd, COALESCE(hasLoggedFirst, 0)
                FROM sec_users
                WHERE email = '$loginSql'
                LIMIT 1
            ", 'pigliacelli');
        }

        if (isset({rsUserDoc[0][0]})) {
            $userLogin = trim((string){rsUserDoc[0][0]});
            $userActive = trim((string){rsUserDoc[0][1]});
            $userDisplayName = trim((string){rsUserDoc[0][2]});
            $storedPassword = trim((string){rsUserDoc[0][4]});
            $hasLoggedFirst = (int){rsUserDoc[0][5]};

            $activeNorm = strtoupper($userActive);
            $isActive = ($activeNorm === 'Y' || $activeNorm === '1' || $activeNorm === 'S' || $activeNorm === 'SI' || $activeNorm === 'YES');
            $wasInactive = !$isActive;

            if ($wasInactive) {
                $loginUpd = str_replace("'", "''", $userLogin);
                sc_exec_sql("UPDATE sec_users SET active = 'Y' WHERE login = '$loginUpd'", 'pigliacelli');
                sc_log_add('MAIL_DOCS', "$logCtx — attivato sec_users login=$userLogin (era inactive)");
            }

            if ($wasInactive && $hasLoggedFirst === 0) {
                $pswLooksMd5 = ($storedPassword !== '' && preg_match('/^[a-f0-9]{32}$/i', $storedPassword));

                if ($storedPassword !== '' && !$pswLooksMd5) {
                    $plainPassword = $storedPassword;
                    $sendCredentials = true;
                    sc_log_add('MAIL_DOCS', "$logCtx — credenziali da pswd in chiaro login=$userLogin");
                } else {
                    $chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_!+-*';
                    $charsLen = strlen($chars);
                    for ($i = 0; $i < 12; $i++) {
                        $plainPassword .= $chars[random_int(0, $charsLen - 1)];
                    }

                    $pswHash = str_replace("'", "''", md5($plainPassword));
                    $loginUpd = str_replace("'", "''", $userLogin);
                    sc_exec_sql("UPDATE sec_users SET pswd = '$pswHash' WHERE login = '$loginUpd'", 'pigliacelli');
                    $sendCredentials = true;
                    sc_log_add('MAIL_DOCS', "$logCtx — nuova password temporanea login=$userLogin (hasLoggedFirst=0, pswd DB era hash)");
                }
            } elseif ($isActive) {
                sc_log_add('MAIL_DOCS', "$logCtx — login=$userLogin già attivo (active=Y), mail credenziali non inviata");
            } else {
                sc_log_add('MAIL_DOCS', "$logCtx — login=$userLogin già loggato (hasLoggedFirst=1), mail credenziali non inviata");
            }
        }

        if (!docs_multi_email_valida($destinatario)) {
            $destinatarioResolved = docs_multi_resolve_destinatario($loginField);
            if ($destinatarioResolved !== '') {
                $destinatario = $destinatarioResolved;
