        return docs_multi_email_valida($destinatario) ? $destinatario : '';
    }
}

if (!function_exists('docs_multi_prepare_mail_context')) {
    /**
     * Risolve destinatario, attiva utente se serve e prepara SMTP (una volta per batch).
     *
     * @return array|false
     */
    function docs_multi_prepare_mail_context($subvettore_id, $loginField)
    {
        $loginField = trim((string)$loginField);
        $docSubId = (int)$subvettore_id;
        $logCtx = 'docs_multi_prepare_mail_context';

        if ($loginField === '' || $docSubId <= 0) {
            sc_log_add('MAIL_DOCS', "$logCtx — login o subvettore_id mancante");
            return false;
        }

        $destinatario = '';
        if ($docSubId > 0) {
            sc_lookup(rsFdSubMailCtx, "
                SELECT login_subvettore
                FROM subvettori
                WHERE id = $docSubId
                LIMIT 1
            ", 'pigliacelli');
            if (!empty({rsFdSubMailCtx[0][0]}) && docs_multi_email_valida({rsFdSubMailCtx[0][0]})) {
                $destinatario = trim((string){rsFdSubMailCtx[0][0]});
            }
        }

        $loginSql = str_replace("'", "''", $loginField);
        $userLogin = '';
        $userDisplayName = '';
        $plainPassword = '';
        $sendCredentials = false;
        $hasLoggedFirst = 0;

        sc_lookup(rsUserDocCtx, "
            SELECT login, active, name, email, pswd, COALESCE(hasLoggedFirst, 0)
            FROM sec_users
            WHERE login = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');

        if (!isset({rsUserDocCtx[0][0]}) && docs_multi_email_valida($loginField)) {
            sc_lookup(rsUserDocCtx, "
                SELECT login, active, name, email, pswd, COALESCE(hasLoggedFirst, 0)
                FROM sec_users
                WHERE email = '$loginSql'
                LIMIT 1
            ", 'pigliacelli');
        }

        if (isset({rsUserDocCtx[0][0]})) {
            $userLogin = trim((string){rsUserDocCtx[0][0]});
            $userActive = trim((string){rsUserDocCtx[0][1]});
            $userDisplayName = trim((string){rsUserDocCtx[0][2]});
            $storedPassword = trim((string){rsUserDocCtx[0][4]});
            $hasLoggedFirst = (int){rsUserDocCtx[0][5]};

            $activeNorm = strtoupper($userActive);
            $isActive = ($activeNorm === 'Y' || $activeNorm === '1' || $activeNorm === 'S' || $activeNorm === 'SI' || $activeNorm === 'YES');
            $wasInactive = !$isActive;

            if ($wasInactive) {
                $loginUpd = str_replace("'", "''", $userLogin);
                sc_exec_sql("UPDATE sec_users SET active = 'Y' WHERE login = '$loginUpd'", 'pigliacelli');
                sc_log_add('MAIL_DOCS', "$logCtx — attivato sec_users login=$userLogin (era inactive)");
            }

            if ($wasInactive && $hasLoggedFirst === 0) {
                $pswLooksMd5 = ($storedPassword !== '' && preg_match('/^[a-f0-9]{32}$/i', $storedPassword));

                if ($storedPassword !== '' && !$pswLooksMd5) {
                    $plainPassword = $storedPassword;
                    $sendCredentials = true;
                    sc_log_add('MAIL_DOCS', "$logCtx — credenziali da pswd in chiaro login=$userLogin");
                } else {
                    $chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_!+-*';
                    $charsLen = strlen($chars);
                    for ($i = 0; $i < 12; $i++) {
                        $plainPassword .= $chars[random_int(0, $charsLen - 1)];
                    }

                    $pswHash = str_replace("'", "''", md5($plainPassword));
                    $loginUpd = str_replace("'", "''", $userLogin);
                    sc_exec_sql("UPDATE sec_users SET pswd = '$pswHash' WHERE login = '$loginUpd'", 'pigliacelli');
                    $sendCredentials = true;
                    sc_log_add('MAIL_DOCS', "$logCtx — nuova password temporanea login=$userLogin (hasLoggedFirst=0, pswd DB era hash)");
                }
            } elseif ($isActive) {
                sc_log_add('MAIL_DOCS', "$logCtx — login=$userLogin già attivo (active=Y), mail credenziali non inviata");
            } elseif (isset({rsUserDocCtx[0][0]})) {
                sc_log_add('MAIL_DOCS', "$logCtx — login=$userLogin già loggato (hasLoggedFirst=1), mail credenziali non inviata");
            }
        }

        if (!docs_multi_email_valida($destinatario)) {
            $destinatarioResolved = docs_multi_resolve_destinatario($loginField);
            if ($destinatarioResolved !== '') {
                $destinatario = $destinatarioResolved;
            }
        }

        if ($destinatario === '' || !docs_multi_email_valida($destinatario)) {
            sc_log_add('MAIL_DOCS', "$logCtx — email non valida: subvettore_id=$docSubId login=[$loginField] dest=[$destinatario]");
            return false;
        }

        sc_lookup(rs_smtp_ctx, "SELECT set_name, set_value FROM sec_settings");
        $loginUrl = '';
        if (isset({rs_smtp_ctx[0][0]})) {
            foreach ({rs_smtp_ctx} as $f) {
                $_SESSION['sett_' . $f[0]] = $f[1];
                if ($f[0] === 'login_url') {
                    $loginUrl = trim((string)$f[1]);
                }
            }
        }

        if (isset($_SESSION['sett_smtp_api']) && $_SESSION['sett_smtp_api'] == 'custom') {
            $sett_smtp = array(
                'settings' => array(
                    'gateway'       => 'smtp',
                    'smtp_server'   => $_SESSION['sett_smtp_server'],
                    'smtp_protocol' => $_SESSION['sett_smtp_security'],
                    'smtp_port'     => $_SESSION['sett_smtp_port'],
                    'smtp_user'     => $_SESSION['sett_smtp_user'],
                    'smtp_password' => $_SESSION['sett_smtp_pass'],
                    'from_email'    => $_SESSION['sett_smtp_from_email'],
                    'from_name'     => $_SESSION['sett_smtp_from_name'],
                ),
            );
        } else {
            $sett_smtp = array(
                'profile' => isset($_SESSION['sett_smtp_api']) ? $_SESSION['sett_smtp_api'] : ''
            );
        }

        return array(
            'destinatario'    => $destinatario,
            'loginField'      => $loginField,
            'userLogin'       => $userLogin,
            'userDisplayName' => $userDisplayName,
            'plainPassword'   => $plainPassword,
            'sendCredentials' => $sendCredentials,
            'hasLoggedFirst'  => $hasLoggedFirst,
            'loginUrl'        => $loginUrl,
            'sett_smtp'       => $sett_smtp,
        );
    }
}

if (!function_exists('docs_multi_send_batch_summary')) {
    /** Una sola mail (e una notifica SC) con l'elenco dei documenti creati. */
    function docs_multi_send_batch_summary($mailCtx, $createdDocs, $subvettore_id)
    {
        if (empty($mailCtx) || !is_array($mailCtx) || empty($createdDocs)) {
            return false;
        }

        $docSubId = (int)$subvettore_id;
        $destinatario = trim((string)$mailCtx['destinatario']);
        $loginField = trim((string)$mailCtx['loginField']);
        $userLogin = trim((string)$mailCtx['userLogin']);
        $plainPassword = trim((string)$mailCtx['plainPassword']);
        $sendCredentials = !empty($mailCtx['sendCredentials']) && $plainPassword !== '';
        $loginUrl = trim((string)$mailCtx['loginUrl']);
        $sett_smtp = $mailCtx['sett_smtp'];
        $logCtx = 'docs_multi_send_batch_summary';
        $count = count($createdDocs);

        $plainLines = array();
        $htmlLines = '';
        foreach ($createdDocs as $row) {
            $nome = isset($row['nome']) ? trim((string)$row['nome']) : 'Documento';
            $docId = isset($row['docId']) ? (int)$row['docId'] : 0;
            $plainLines[] = '- ' . $nome . ' (#' . $docId . ')';
            $htmlLines .= '<li>' . htmlspecialchars($nome, ENT_QUOTES, 'UTF-8')
                . ' <span style="color:#718096;">(#' . $docId . ')</span></li>';
        }

        $soggetto = $count === 1
            ? 'Richiesta documento — ' . $createdDocs[0]['nome'] . ' (#' . (int)$createdDocs[0]['docId'] . ')'
            : 'Richiesta documenti — ' . $count . ' documenti';

        $credBlockPlain = '';
        $credBlockHtml = '';
        if ($sendCredentials) {
            $safeCredLogin = htmlspecialchars($userLogin, ENT_QUOTES, 'UTF-8');
            $safeCredPwd = htmlspecialchars($plainPassword, ENT_QUOTES, 'UTF-8');
            $soggetto = $count === 1
                ? 'Richiesta documento e credenziali — ' . $createdDocs[0]['nome']
                : 'Richiesta documenti e credenziali — ' . $count . ' documenti';

            $credBlockPlain = "\n\nIl suo account è stato attivato. Credenziali area riservata (password temporanea):\n"
                . "Login: $userLogin\n"
                . "Password: $plainPassword\n";

            $credBlockHtml = '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" '
                . 'style="margin:16px 0;background:#f8f9fb;border:1px solid #e2e6ea;border-radius:8px;">'
                . '<tr><td style="padding:16px 18px;font-size:14px;line-height:1.6;">'
                . '<p style="margin:0 0 10px;"><strong>Account attivato</strong> — credenziali per l\'area riservata (password temporanea):</p>'
                . '<strong>Login:</strong> ' . $safeCredLogin . '<br>'
                . '<strong>Password:</strong> ' . $safeCredPwd
                . '</td></tr></table>';
        }

        $salutoSub = docs_multi_saluto_subvettore($docSubId);
        $safeSalutoSub = htmlspecialchars($salutoSub, ENT_QUOTES, 'UTF-8');
        $docListPlain = implode("\n", $plainLines);

        $introPlain = $count === 1
            ? "è stato richiesto l'inserimento del seguente documento:\n\n"
            : "è stato richiesto l'inserimento dei seguenti documenti:\n\n";

        $testoPlain = $salutoSub . ",\n\n"
            . $introPlain
            . $docListPlain . "\n\n"
            . "Per procedere, acceda alla sua area riservata:\n" . $loginUrl
            . $credBlockPlain
            . "\n\nMessaggio automatico — non rispondere.";

        $mailTitolo = $sendCredentials
            ? ($count === 1 ? 'Richiesta documento e credenziali' : 'Richiesta documenti e credenziali')
            : ($count === 1 ? 'Richiesta inserimento documento' : 'Richiesta inserimento documenti');

        $introHtml = $count === 1
            ? 'è stato richiesto l\'inserimento del seguente documento.'
            : 'è stato richiesto l\'inserimento dei seguenti documenti.';

        $mailLogoUrl = docs_multi_mail_logo_src();
