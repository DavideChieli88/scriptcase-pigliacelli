        $batchLogin = docs_multi_resolve_login_from_subvettore($subvettoreId);
        if ($batchLogin === '') {
            $errors[] = 'Login non trovato per il subvettore selezionato.';
        } elseif (docs_multi_validate_destinatario($subvettoreId, $batchLogin) === '') {
            $errors[] = 'Impossibile inviare la mail: destinatario non valido per il subvettore selezionato.';
        }
    }

    if (empty($errors)) {
        foreach ($tipiSelezionati as $tipoId) {
            $result = docs_multi_insert_documento($subvettoreId, $tipoId, $batchLogin);
            if (!empty($result['ok'])) {
                $created[] = array(
                    'docId' => (int)$result['docId'],
                    'tipoId' => (int)$tipoId,
                    'nome' => docs_multi_tipo_nome($tipoId),
                );
            } else {
                $tipoNome = docs_multi_tipo_nome($tipoId);
                $errMsg = isset($result['error']) ? trim((string)$result['error']) : 'Errore sconosciuto';
                $errors[] = $tipoNome . ': ' . $errMsg;
            }
        }
    }

    if (!empty($created) && empty($errors)) {
        $mailCtx = docs_multi_prepare_mail_context($subvettoreId, $batchLogin);
        if ($mailCtx === false) {
            $errors[] = 'Documenti creati ma invio mail fallito: destinatario non valido.';
        } else {
            docs_multi_send_batch_summary($mailCtx, $created, $subvettoreId);
        }
    }

    if (!empty($created) && empty($errors)) {
        sc_log_add(
            'MAIL_DOCS',
            'docs_multi_select — creati ' . count($created) . ' documenti per subvettore_id=' . $subvettoreId
        );

        $okQuery = 'docs_multi_ok=' . count($created);
        if (!empty($mailCtx['sendCredentials'])) {
            $okQuery .= '&docs_multi_creds=1';
        }

        header('Location: ?' . $okQuery);
        exit;
    }
}

