if (!function_exists('docs_multi_insert_documento')) {
    function docs_multi_insert_documento($subvettore_id, $tipo_documento_id, $login = '')
    {
        $subvettore_id = (int)$subvettore_id;
        $tipo_documento_id = (int)$tipo_documento_id;

        if ($subvettore_id <= 0 || $tipo_documento_id <= 0) {
            return array('ok' => false, 'docId' => 0, 'error' => 'Parametri non validi', 'login' => '');
        }

        sc_lookup(rsDocsMultiTipoOk, "
            SELECT id
            FROM tipi_documento
            WHERE id = $tipo_documento_id
            LIMIT 1
        ", 'pigliacelli');
        if (empty({rsDocsMultiTipoOk[0][0]})) {
            return array(
                'ok' => false,
                'docId' => 0,
                'error' => 'Tipo documento non trovato (id=' . $tipo_documento_id . ')',
                'login' => ''
            );
        }

        if (trim((string)$login) === '') {
            $login = docs_multi_resolve_login_from_subvettore($subvettore_id);
        } else {
            $login = trim((string)$login);
        }
        if ($login === '') {
            return array('ok' => false, 'docId' => 0, 'error' => 'Login non trovato per il subvettore selezionato', 'login' => '');
        }

        $loginSql = str_replace("'", "''", $login);

        try {
            sc_exec_sql("
                INSERT INTO documenti
                    (tipo_documento_id, subvettore_id, login, stato_documento_id)
                VALUES
                    ($tipo_documento_id, $subvettore_id, '$loginSql', 1)
            ", 'pigliacelli');
        } catch (Exception $e) {
            $msg = $e->getMessage();
            if (stripos($msg, 'documenti_tipi_documento_fk') !== false && stripos($msg, 'FOREIGN KEY (`id`)') !== false) {
                return array(
                    'ok' => false,
                    'docId' => 0,
                    'error' => 'FK documenti errata: il vincolo documenti_tipi_documento_fk è su colonna id invece di tipo_documento_id. Eseguire fix_documenti_fk_tipi_documento.sql'
                );
            }
            return array('ok' => false, 'docId' => 0, 'error' => 'Inserimento documento fallito: ' . $msg);
        } catch (Throwable $e) {
            $msg = $e->getMessage();
            if (stripos($msg, 'documenti_tipi_documento_fk') !== false && stripos($msg, 'FOREIGN KEY (`id`)') !== false) {
                return array(
                    'ok' => false,
                    'docId' => 0,
                    'error' => 'FK documenti errata: il vincolo documenti_tipi_documento_fk è su colonna id invece di tipo_documento_id. Eseguire fix_documenti_fk_tipi_documento.sql'
                );
            }
            return array('ok' => false, 'docId' => 0, 'error' => 'Inserimento documento fallito: ' . $msg);
        }

        sc_lookup(rsDocsMultiNewDoc, "SELECT LAST_INSERT_ID()", 'pigliacelli');
        $docId = isset({rsDocsMultiNewDoc[0][0]}) ? (int){rsDocsMultiNewDoc[0][0]} : 0;
        if ($docId <= 0) {
            return array('ok' => false, 'docId' => 0, 'error' => 'Inserimento documento fallito', 'login' => $login);
        }

        return array('ok' => true, 'docId' => $docId, 'error' => '', 'login' => $login);
    }
}

