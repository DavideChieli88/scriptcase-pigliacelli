if (!function_exists('docs_multi_validate_destinatario')) {
    /** Verifica destinatario mail senza effetti collaterali (no attivazione utente). */
    function docs_multi_validate_destinatario($subvettore_id, $loginField)
    {
        $docSubId = (int)$subvettore_id;
        $loginField = trim((string)$loginField);
        if ($loginField === '' || $docSubId <= 0) {
            return '';
        }

        $destinatario = '';
        sc_lookup(rsFdSubMailVal, "
            SELECT login_subvettore
            FROM subvettori
            WHERE id = $docSubId
            LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsFdSubMailVal[0][0]}) && docs_multi_email_valida({rsFdSubMailVal[0][0]})) {
