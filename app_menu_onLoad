// Scriptcase — app_menu → onLoad
// NON usare "return" (pagina bianca).

$usrLogin = trim((string)[usr_login]);
if ($usrLogin === '' || strcasecmp($usrLogin, 'Guest') === 0) {
    // skip
} else {
    $loginSql = str_replace("'", "''", $usrLogin);

    // group 2 + wizard incompleto → pagina atterraggio (non direttamente lo step)
    sc_lookup(rsWizMenu, "
        SELECT sug.group_id, COALESCE(s.wizard_complete, 0)
        FROM sec_users su
        INNER JOIN sec_users_groups sug ON sug.login = su.login
        LEFT JOIN subvettori s ON s.id = su.subvettore_id
        WHERE su.login = '$loginSql'
        LIMIT 1
    ", 'pigliacelli');

    if (!empty({rsWizMenu[0][0]})
        && (int){rsWizMenu[0][0]} === 2
        && (int){rsWizMenu[0][1]} === 0
    ) {
        sc_redir('blank_wizard_landing');
    }

    // primo accesso menu
    try {
        sc_lookup(rsHasLogged, "
            SELECT COALESCE(hasLoggedFirst, 0)
            FROM sec_users
            WHERE login = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');
        if (isset({rsHasLogged[0][0]}) && (int){rsHasLogged[0][0]} === 0) {
            sc_exec_sql("
                UPDATE sec_users
                SET hasLoggedFirst = 1
                WHERE login = '$loginSql'
                  AND COALESCE(hasLoggedFirst, 0) = 0
            ", 'pigliacelli');
            sc_log_add('FIRST_LOGIN', "hasLoggedFirst=1 login=$usrLogin (app_menu onLoad)");
        }
    } catch (Throwable $e) {
        sc_log_add('FIRST_LOGIN', 'ERRORE onLoad login=' . $usrLogin . ' — ' . $e->getMessage());
    }
}
