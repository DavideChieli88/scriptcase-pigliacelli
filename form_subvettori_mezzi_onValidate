/**
 * form_subvettori_mezzi → onValidate
 *
 * Obbliga dati mezzo + carta di circolazione (tipo 22) + autista collegato.
 * Non usare sc_error_exit (form multi-step / AJAX).
 */

$errors = array();
$mezzoId = isset({id}) ? (int){id} : 0;

$vTarga    = isset({targa}) ? trim((string){targa}) : '';
$vScadCarta = isset({scadenza_carta_circolazione}) ? trim((string){scadenza_carta_circolazione}) : '';
$vCarta    = isset({carta_circolazione}) ? trim((string){carta_circolazione}) : '';
$autistaId = isset({autista_id}) ? (int){autista_id} : 0;

if ($vTarga === '') {
    $errors[] = 'Targa';
}
if ($vScadCarta === '' || $vScadCarta === 'null') {
    $errors[] = 'Scadenza carta di circolazione';
}
if ($autistaId <= 0) {
    $errors[] = 'Autista collegato al mezzo';
}

$hasCartaCircolazione = ($vCarta !== '');
if (!$hasCartaCircolazione && $mezzoId > 0) {
    sc_lookup(rsMezVal22, "
        SELECT id FROM documenti
        WHERE subvettore_mezzo_id = $mezzoId
          AND tipo_documento_id = 22
          AND file IS NOT NULL AND TRIM(file) <> ''
        ORDER BY id ASC LIMIT 1
    ", 'pigliacelli');
    $hasCartaCircolazione = !empty({rsMezVal22[0][0]});
}
if (!$hasCartaCircolazione) {
    $errors[] = 'Documento carta di circolazione';
}

if (!empty($errors)) {
    sc_error_message(
        "Compilare tutti i dati e documenti obbligatori del mezzo:\n- "
        . implode("\n- ", $errors)
    );
}
