sc_lookup(rsOpsReview, "
    SELECT DISTINCT su.login, su.email
    FROM sec_users su
    INNER JOIN sec_users_groups sug ON sug.login = su.login
    WHERE su.active = 'Y'
      AND su.login IS NOT NULL
      AND TRIM(su.login) <> ''
      AND su.email IS NOT NULL
      AND TRIM(su.email) <> ''
      AND sug.group_id IN (1, 3)
", "pigliacelli");

$emailPlaceholder = array('admin@admin.com', 'admin@localhost', 'admin@example.com');
$destinatari = array();
$operatorLogins = array();
$emailScartate = array();

if (isset({rsOpsReview[0][0]})) {
    foreach ({rsOpsReview} as $row) {
        $loginOp = trim((string)$row[0]);
        $email = strtolower(trim((string)$row[1]));
        if ($loginOp === '' || strcasecmp($loginOp, 'Guest') === 0) {
            continue;
        }
        if ($email === '') {
            continue;
        }
        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            $emailScartate[] = $email . ' (formato non valido)';
            continue;
        }
        if (in_array($email, $emailPlaceholder, true)) {
            $emailScartate[] = $email . ' (email predefinita)';
            continue;
        }
        $destinatari[] = $email;
        $operatorLogins[] = $loginOp;
    }
}
$destinatari = array_values(array_unique($destinatari));
$operatorLogins = array_values(array_unique($operatorLogins));

if (!empty($emailScartate)) {
    sc_log_add('MAGIC_LINK_REVIEW', 'email operatori scartate: ' . implode('; ', $emailScartate));
}

$loginUrl = rtrim(trim(magic_link_review_setting('login_url', '')), '/');
$gridUrl = $loginUrl !== '' ? $loginUrl . '/grid_contratti/' : '';

