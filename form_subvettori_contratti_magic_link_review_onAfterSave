}

if (!function_exists('magic_link_review_mail_logo_read_embed')) {
    function magic_link_review_mail_logo_read_embed()
    {
        $rel = '_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png';
        $dir = realpath(dirname(__FILE__));
        for ($i = 0; $i < 12 && $dir; $i++) {
            $try = $dir . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $rel);
            if (is_readable($try)) {
                $bin = @file_get_contents($try);
                if ($bin !== false && $bin !== '' && strlen($bin) < 500000) {
                    return 'data:image/png;base64,' . base64_encode($bin);
                }
            }
            $p = dirname($dir);
            if ($p === $dir) {
                break;
            }
            $dir = $p;
        }
        return '';
    }
}

if (!function_exists('magic_link_review_mail_logo_src')) {
    function magic_link_review_mail_logo_src()
    {
        $embed = magic_link_review_mail_logo_read_embed();
        if ($embed !== '') {
            return $embed;
        }
        $base = rtrim(trim(magic_link_review_setting('mail_base_url', '')), '/');
        if ($base !== '' && preg_match('#^https?://#i', $base) === 1) {
            return htmlspecialchars(
                $base . '/_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png',
                ENT_QUOTES,
                'UTF-8'
            );
        }
        return '';
    }
}

