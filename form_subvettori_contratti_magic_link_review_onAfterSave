if (!function_exists('magic_link_review_setting')) {
    function magic_link_review_setting($name, $default = '')
    {
        $safeName = str_replace("'", "''", trim((string)$name));
        sc_lookup(rsSetReview, "SELECT set_value FROM sec_settings WHERE set_name = '" . $safeName . "' LIMIT 1");
