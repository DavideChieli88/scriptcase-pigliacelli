if (!function_exists('contratti_detect_workspace_root')) {
    function contratti_detect_workspace_root($anchorFile = null)
    {
        if ($anchorFile === null || $anchorFile === '') {
            $anchorFile = __FILE__;
        }
        if (is_dir($anchorFile)) {
            $dir = realpath($anchorFile);
        } else {
            $dir = dirname($anchorFile);
            $resolved = realpath($dir);
            if ($resolved !== false) {
                $dir = $resolved;
            }
        }
        if ($dir === false || $dir === '') {
            return '';
        }
        $current = $dir;
        for ($i = 0; $i < 12; $i++) {
            if (is_file($current . DIRECTORY_SEPARATOR . 'index.php')
                && (is_dir($current . DIRECTORY_SEPARATOR . '_lib') || is_dir($current . DIRECTORY_SEPARATOR . 'grid_contratti'))) {
                return $current;
            }
            $parent = dirname($current);
            if ($parent === $current) {
                break;
            }
            $current = $parent;
        }
        $parent = dirname($dir);
        return ($parent !== '' && $parent !== $dir) ? $parent : $dir;
    }
}
if (!function_exists('resolve_contratti_base_dir')) {
    function resolve_contratti_base_dir($configuredPath, $anchorFile = null)
    {
        $configuredPath = trim((string)$configuredPath);
        if ($configuredPath === '') {
            return '';
        }
        $normalized = str_replace('\\', '/', $configuredPath);
        if ($normalized !== '' && $normalized[0] === '/') {
            $resolved = realpath($configuredPath);
            return $resolved !== false ? $resolved : rtrim($configuredPath, "/\\");
        }
        if (preg_match('#^[A-Za-z]:/#', $normalized) || preg_match('#^[A-Za-z]:\\\\#', $configuredPath)) {
            $resolved = realpath($configuredPath);
            return $resolved !== false ? $resolved : rtrim($configuredPath, "/\\");
        }
        $root = contratti_detect_workspace_root($anchorFile);
        if ($root === '') {
            return '';
        }
        $full = $root . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, trim($normalized, '/'));
        $resolved = realpath($full);
        return $resolved !== false ? $resolved : $full;
    }
}

