    if (strlen($s) > $max) $s = substr($s, 0, $max) . '...';
    return $s;
};

// URL di firma da un singolo oggetto signer (risposta create/start)
$extract_sign_link_from_signer = function ($signer) {
    if (!is_array($signer)) {
        return '';
    }
    $isHttpUrl = function ($s) {
        $s = trim((string)$s);
        return $s !== '' && preg_match('#^https?://#i', $s) === 1;
    };
    $signerKeys = [
        'link', 'url', 'href',
        'sign_url', 'signUrl', 'sign_link', 'signLink',
        'signing_url', 'signingUrl', 'signingLink', 'signing_link',
        'invitation_url', 'invitationUrl', 'invite_url', 'inviteUrl',
        'signature_url', 'signatureUrl', 'web_url', 'webUrl',
        'redirect_url', 'redirectUrl', 'callback_url', 'callbackUrl',
    ];
    foreach ($signerKeys as $k) {
        if (!array_key_exists($k, $signer)) {
            continue;
        }
        $c = $signer[$k];
        if (is_string($c) && $isHttpUrl($c)) {
            return trim($c);
        }
    }
    foreach (['link', 'url', 'sign_url'] as $k) {
        if (isset($signer[$k]) && is_string($signer[$k]) && trim($signer[$k]) !== '') {
            return trim((string)$signer[$k]);
        }
    }
    $looksLikeSignUrl = function ($s) {
        $s = trim((string)$s);
        if ($s === '' || preg_match('#^https?://#i', $s) !== 1) {
            return false;
        }
        return stripos($s, 'sign') !== false
            || stripos($s, 'firma') !== false
            || stripos($s, 'invitation') !== false
            || stripos($s, 'invite') !== false
            || stripos($s, '/platform/') !== false
            || stripos($s, 'signature') !== false
            || stripos($s, 'workflow') !== false;
    };
    $found = '';
    $walker = function ($v) use (&$walker, &$found, $looksLikeSignUrl) {
        if ($found !== '') {
            return;
        }
        if (is_string($v)) {
            if ($looksLikeSignUrl($v)) {
                $found = trim($v);
            }
            return;
        }
        if (is_array($v)) {
            foreach ($v as $vv) {
                $walker($vv);
            }
        }
    };
    $walker($signer);
    return $found;
};

// Link per subvettore (signers[0]) e committente (signers[1]) in easygn_sign_link come JSON.
// - Risposta create: spesso i link sono in files[0].signers[].
// - Risposta PUT workflow/start/{id}: in molte installazioni i link sono in signers[] a livello root (vedi esempio Yousign).
$extract_sign_links_paired = function ($data) use ($extract_sign_link_from_signer) {
    $pair = [
        'link_subvettore' => '',
        'link_committente' => '',
    ];
    if (!is_array($data)) {
        return $pair;
    }

    $linkAt = function ($idx) use ($data, $extract_sign_link_from_signer) {
        $f0 = $data['files'][0] ?? null;
        $fromFile = (is_array($f0) && isset($f0['signers'][$idx]) && is_array($f0['signers'][$idx]))
            ? $extract_sign_link_from_signer($f0['signers'][$idx])
            : '';
        if ($fromFile !== '') {
            return $fromFile;
        }
        $root = $data['signers'] ?? null;
        if (is_array($root) && isset($root[$idx]) && is_array($root[$idx])) {
            return $extract_sign_link_from_signer($root[$idx]);
        }
        return '';
    };

    $pair['link_subvettore'] = $linkAt(0);
    $pair['link_committente'] = $linkAt(1);
    return $pair;
};

