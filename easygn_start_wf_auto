if (!function_exists('easygn_pdf_decode_pdf_string')) {
    function easygn_pdf_decode_pdf_string($raw)
    {
        $raw = (string)$raw;
        if ($raw === '') {
            return '';
        }
        if (strncmp($raw, "\xFE\xFF", 2) === 0) {
            $out = '';
            $len = strlen($raw);
            for ($i = 2; $i + 1 < $len; $i += 2) {
                $out .= chr(ord($raw[$i]) * 256 + ord($raw[$i + 1]));
            }
            return $out;
        }
        return stripcslashes($raw);
    }
}

$easygn_pdf_extract_subject = function ($pdfBin) {
    $pdfBin = (string)$pdfBin;
    if ($pdfBin === '') {
        return '';
    }
    if (preg_match('/\/Subject\s*\((?:\\\\.|[^\\\\\)])*\)/s', $pdfBin, $m)) {
        $inner = substr($m[0], 9, -1);
        return easygn_pdf_decode_pdf_string($inner);
    }
    if (preg_match('/\/Subject\s*<([0-9A-Fa-f]+)>/', $pdfBin, $m)) {
        $hex = $m[1];
        if (strncmp($hex, 'FEFF', 4) === 0) {
            $hex = substr($hex, 4);
        }
        $bin = @hex2bin($hex);
        return $bin === false ? '' : easygn_pdf_decode_pdf_string($bin);
    }
    return '';
};

$easygn_pdf_parse_sign_visuals = function ($pdfBin) use ($easygn_pdf_extract_subject) {
    $subject = $easygn_pdf_extract_subject($pdfBin);
    if ($subject === '' || stripos($subject, 'EGN_SIGN:') !== 0) {
        return null;
    }
    $b64 = trim(substr($subject, 9));
    if ($b64 === '') {
        return null;
    }
    $json = base64_decode($b64, true);
    if (!is_string($json) || $json === '') {
        return null;
    }
    $data = json_decode($json, true);
    if (!is_array($data) || !isset($data['visuals']) || !is_array($data['visuals'])) {
        return null;
    }
    $norm = function ($rows) {
        $out = array();
        if (!is_array($rows)) {
            return $out;
        }
        foreach ($rows as $row) {
            if (!is_array($row)) {
                continue;
            }
            $page = isset($row['page']) ? (int)$row['page'] : 0;
            if ($page < 1) {
                continue;
            }
            $out[] = array(
                'page' => $page,
                'x'    => isset($row['x']) ? (float)$row['x'] : 0.0,
                'y'    => isset($row['y']) ? (float)$row['y'] : 0.0,
                'w'    => isset($row['w']) ? (float)$row['w'] : 0.0,
                'h'    => isset($row['h']) ? (float)$row['h'] : 0.0,
            );
        }
        return $out;
    };
    return array(
        'vettore'     => $norm($data['visuals']['vettore'] ?? array()),
        'committente' => $norm($data['visuals']['committente'] ?? array()),
    );
};

