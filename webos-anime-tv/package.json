{
  "name": "webos-anime-tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal anime aggregator for LG webOS TV",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/copy-webos-assets.mjs",
    "preview": "vite preview",
    "proxy": "node tools/cors-proxy/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run tests/integration/live-movies.test.ts --environment=jsdom",
    "package:webos": "npm run build && ares-package.cmd --no-minify dist -o release",
    "install:webos": "ares-install.cmd -d lg-tv release\\com.personal.webanimetv_0.1.0_all.ipk && ares-launch.cmd -d lg-tv com.personal.webanimetv",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "jsdom": "^30.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "hls.js": "^1.6.16"
  }
}
