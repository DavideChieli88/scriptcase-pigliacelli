      b.INDIRIZZO,
      b.LOCALITA,
      b.PROVINCIA,
      b.TELEFONO,
      b.CELLULARE,
      b.E_MAIL,
      b.PARTITA_IVA,
      b.CODICE_FISCALE,
      v.TARIFFA,
      v.IMPORTO_UNITARIO,
      v.PARTENZA_DATA_ORA AS partenza_data_ora,
      COALESCE(v.UPDATE_DATA_ORA, v.INSERT_DATA_ORA, '1900-01-01 00:00:00') AS sync_data_ora
    FROM T2ViaggiVettori v
    JOIN BaCliFor b
      ON b.CODICE = v.VETTORE
     AND b.SOCIETA = 1
     AND b.CLIENTE_FORNITORE = 'F'
     AND b.ATTIVO = 'S'
    WHERE v.SOCIETA = 1
      AND COALESCE(v.UPDATE_DATA_ORA, v.INSERT_DATA_ORA, '1900-01-01 00:00:00') > :soglia_data_ora
      AND COALESCE(v.UPDATE_DATA_ORA, v.INSERT_DATA_ORA, '1900-01-01 00:00:00') <= :fine_sync_data_ora
    ORDER BY COALESCE(v.UPDATE_DATA_ORA, v.INSERT_DATA_ORA, '1900-01-01 00:00:00'), v.ANNO, v.NUMERO
";

$sql_localita = "
    SELECT OPERAZIONE, LOCALITA
    FROM T2ViaggiVettoriClienti
    WHERE SOCIETA = :societa
      AND ANNO = :anno
      AND NUMERO = :numero
      AND OPERAZIONE IN ('C', 'S')
    ORDER BY OPERAZIONE, PROGRESSIVO
";

$sql_extra = "
    SELECT COALESCE(SUM(IMPORTO_TOTALE), 0)
    FROM T2ViaggiVettoriAddebiti
    WHERE SOCIETA = :societa
      AND ANNO = :anno
      AND NUMERO = :numero
";

try {
    $stmt_viaggi_base = $pdo_sga->prepare($sql_viaggi_base);
    $stmt_localita = $pdo_sga->prepare($sql_localita);
    $stmt_extra = $pdo_sga->prepare($sql_extra);

    $stmt_viaggi_base->execute([
        'soglia_data_ora' => $soglia_data_ora,
        'fine_sync_data_ora' => $fine_sync_data_ora,
    ]);
} catch (PDOException $e) {
    sc_error_message("Errore select PDO SGA: " . $e->getMessage());
    return;
}

$ultima_sync_data_ora = null;
$viaggi_unici = [];

try {
    // Chiude il cursore principale prima delle query di dettaglio: evita problemi SQL Server senza MARS.
    $viaggi_base_rows = $stmt_viaggi_base->fetchAll(PDO::FETCH_NUM);
    $stmt_viaggi_base->closeCursor();

    foreach ($viaggi_base_rows as $row_sga) {
        $societa          = $row_sga[0];
        $anno             = $row_sga[1];
        $numero           = $row_sga[2];
        $codice_vettore   = $row_sga[3];
        $ragione_sociale  = $row_sga[4];
        $indirizzo        = $row_sga[5];
        $sede_citta       = $row_sga[6];
        $sede_prov        = $row_sga[7];
        $phone            = $row_sga[8];
        $cellphone        = $row_sga[9];
        $email            = $row_sga[10];
        $piva             = $row_sga[11];
        $cod_fiscale      = $row_sga[12];
        $tariffa_sigla    = trim((string)$row_sga[13]);   // es. 'P'/'G'/'F'
        $importo_unitario = $row_sga[14];
        $partenza_data_ora = $row_sga[15];
        $sync_data_ora    = $row_sga[16];

        if ($sync_data_ora !== null && ($ultima_sync_data_ora === null || $sync_data_ora > $ultima_sync_data_ora)) {
            $ultima_sync_data_ora = $sync_data_ora;
        }

        [$carico_str, $scarico_str] = carica_localita_viaggio($stmt_localita, $societa, $anno, $numero);

        // Mantiene il comportamento dei JOIN della query originale: senza carico o scarico il viaggio non entra.
        if ($carico_str === '' || $scarico_str === '') {
            continue;
        }

        $extra_totale = carica_extra_viaggio($stmt_extra, $societa, $anno, $numero);
        $key = (string)$codice_vettore . '|' . $carico_str . '|' . $scarico_str;

        $viaggio = [
            'SOCIETA' => $societa,
            'ANNO' => $anno,
            'NUMERO' => $numero,
            'codice_vettore' => $codice_vettore,
            'ragione_sociale' => $ragione_sociale,
            'indirizzo' => $indirizzo,
            'sede_citta' => $sede_citta,
            'sede_prov' => $sede_prov,
            'phone' => $phone,
            'cellphone' => $cellphone,
            'email' => $email,
            'piva' => $piva,
            'cod_fiscale' => $cod_fiscale,
            'carico_str' => $carico_str,
            'scarico_str' => $scarico_str,
            'tariffa_sigla' => $tariffa_sigla,
            'importo_unitario' => $importo_unitario,
            'extra_totale' => $extra_totale,
            'partenza_data_ora' => $partenza_data_ora,
            'sync_data_ora' => $sync_data_ora,
        ];

        if (!isset($viaggi_unici[$key]) || viaggio_piu_recente($viaggio, $viaggi_unici[$key])) {
            $viaggi_unici[$key] = $viaggio;
        }
    }
} catch (PDOException $e) {
    sc_error_message("Errore elaborazione dati PDO SGA: " . $e->getMessage());
    return;
}

ksort($viaggi_unici);

$contratti_batch = array();
$pending_nuove_tratte = array();
$pending_modifiche_tariffa = array();
$intestatari_sub = array();

foreach ($viaggi_unici as $viaggio) {
    $codice_vettore   = $viaggio['codice_vettore'];
    $ragione_sociale  = $viaggio['ragione_sociale'];
    $indirizzo        = $viaggio['indirizzo'];
    $sede_citta       = $viaggio['sede_citta'];
    $sede_prov        = $viaggio['sede_prov'];
    $phone            = $viaggio['phone'];
    $cellphone        = $viaggio['cellphone'];
    $email            = $viaggio['email'];
    $piva             = $viaggio['piva'];
    $cod_fiscale      = $viaggio['cod_fiscale'];
    $carico_str       = $viaggio['carico_str'];
    $scarico_str      = $viaggio['scarico_str'];
    $tariffa_sigla    = $viaggio['tariffa_sigla'];
    $importo_unitario = $viaggio['importo_unitario'];
    $extra_totale     = $viaggio['extra_totale'];
    $hash             = crea_hash_tratta($carico_str, $scarico_str, $codice_vettore, $importo_unitario);

    // Recupera o crea il subvettore su pigliacelli.
    $qSub = "SELECT id FROM subvettori WHERE codice_sga = " . sql_quote($codice_vettore) . " LIMIT 1";
    sc_lookup(sub, $qSub, "pigliacelli");
    if (empty({sub})) {
        $insSub = "
          INSERT INTO subvettori
            (login_subvettore, ragione_sociale, cod_fiscale, piva, phone, cellphone,
             indirizzo, sede_citta, sede_prov, codice_sga)
          VALUES
            (" . sql_quote($email) . ",
             " . sql_quote($ragione_sociale) . ",
             " . sql_quote($cod_fiscale) . ",
             " . sql_quote($piva) . ",
             " . sql_quote($phone) . ",
             " . sql_quote($cellphone) . ",
             " . sql_quote($indirizzo) . ",
             " . sql_quote($sede_citta) . ",
             " . sql_quote($sede_prov) . ",
             " . sql_quote($codice_vettore) . ")
        ";
        sc_exec_sql($insSub, "pigliacelli");

        sc_lookup(lastSubId, "SELECT LAST_INSERT_ID()", "pigliacelli");
        if (empty({lastSubId})) {
            continue;
        }
        $subvettore_id = {lastSubId[0][0]};

        $intestatario_contratto = recupera_intestatario_contratto($subvettore_id, $email, $ragione_sociale, $phone);
    } else {
        $subvettore_id = {sub[0][0]};
        $intestatario_contratto = recupera_intestatario_contratto($subvettore_id, $email, $ragione_sociale, $phone);
    }

    if ($intestatario_contratto === null) {
        $intestatario_contratto = 'SUBVETTORE_' . $subvettore_id;
    }
    $intestatari_sub[$subvettore_id] = $intestatario_contratto;

    if (empty({sub})) {
        // Tipo 1: Accettazione nuovo contratto quadro.
        recupera_contratto_quadro($contratti_batch, $intestatario_contratto, $subvettore_id);
    }

    if ($tariffa_sigla === '') $tariffa_sigla = null;
    $totale  = (0 + $importo_unitario) + (0 + $extra_totale);

    // Mappa sigla tariffa (P/G/F) -> tipo_tariffa_id
    $tipo_tariffa_id = null;
    if ($tariffa_sigla !== null) {
        $tariffa_sigla = strtoupper($tariffa_sigla);
        $qTipoTar = "SELECT id FROM tipo_tariffe WHERE UPPER(descrizione) = " . sql_quote($tariffa_sigla) . " LIMIT 1";
        sc_lookup(tipotar, $qTipoTar, "pigliacelli");
        if (!empty({tipotar})) {
            $tipo_tariffa_id = {tipotar[0][0]};
        }
    }
    $tipo_tariffa_sql = $tipo_tariffa_id === null ? "NULL" : sql_num($tipo_tariffa_id);

    // Controllo veloce per hash: se esiste, la tratta e' gia' presente.
    $qHash = "
      SELECT id
      FROM tratte
      WHERE hash = " . sql_quote($hash) . "
        AND subvettore_id = " . sql_num($subvettore_id) . "
      LIMIT 1
    ";
    sc_lookup(hashRow, $qHash, "pigliacelli");
    if (!empty({hashRow})) {
        $tratta_id_esistente = {hashRow[0][0]};
        $contratto_id = contratto_per_assicura($tratta_id_esistente, 2, $intestatario_contratto, $subvettore_id);
        if ($contratto_id !== null) {
            assicura_contratto_tratta(
                $tratta_id_esistente,
                $contratto_id,
                1,
                $carico_str,
                $scarico_str,
                $tipo_tariffa_id,
                $importo_unitario,
                $extra_totale,
                $totale,
                $hash
            );
        }
        log_tratta_senza_localita($tratta_id_esistente, $subvettore_id, $hash, $carico_str, $scarico_str);
        continue;
    }

    // Se cambia solo l'importo, l'hash cambia: cerco allora la tratta per localita.
    $qExist = "
        SELECT t.id, t.tariffa, t.extra, t.totale, t.version
        FROM tratte t
        WHERE t.subvettore_id = " . sql_num($subvettore_id) . "
          AND (
                SELECT GROUP_CONCAT(tl.localita ORDER BY tl.progressivo SEPARATOR ' + ')
                FROM tratte_localita tl
                WHERE tl.tratta_id = t.id AND tl.tipo_tratta = 'C'
              ) = " . sql_quote($carico_str) . "
          AND (
                SELECT GROUP_CONCAT(tl.localita ORDER BY tl.progressivo SEPARATOR ' + ')
                FROM tratte_localita tl
                WHERE tl.tratta_id = t.id AND tl.tipo_tratta = 'S'
              ) = " . sql_quote($scarico_str) . "
        LIMIT 1
    ";
    sc_lookup(existRow, $qExist, "pigliacelli");

    if (!empty({existRow})) {
        $tratta_id_esistente = {existRow[0][0]};
        $importo_esistente   = {existRow[0][1]};
        $extra_esistente     = {existRow[0][2]};
        $totale_esistente    = {existRow[0][3]};
        $version_esistente   = {existRow[0][4]};

        $has_modifica_tratta = (
            abs((float)$importo_esistente - (float)$importo_unitario) > 0.0001 ||
            abs((float)$extra_esistente - (float)$extra_totale) > 0.0001 ||
            abs((float)$totale_esistente - (float)$totale) > 0.0001
        );

        if ($has_modifica_tratta) {
            $nuova_version = ($version_esistente === null || $version_esistente === '') ? 2 : ((int)$version_esistente + 1);

            sc_exec_sql("
                UPDATE tratte
                SET tipo_tariffa_id = " . $tipo_tariffa_sql . ",
                    tariffa = " . sql_num($importo_unitario) . ",
                    extra = " . sql_num($extra_totale) . ",
                    totale = " . sql_num($totale) . ",
                    hash = " . sql_quote($hash) . ",
                    version = " . sql_num($nuova_version) . "
                WHERE id = " . sql_num($tratta_id_esistente),
                "pigliacelli");

            $pending_modifiche_tariffa[$subvettore_id][(int)$tratta_id_esistente] = true;
        } else {
            $contratto_id = contratto_per_assicura($tratta_id_esistente, 2, $intestatario_contratto, $subvettore_id);
            $version = ($version_esistente === null || $version_esistente === '') ? 1 : (int)$version_esistente;
            if ($contratto_id === null) {
                continue;
            }
            assicura_contratto_tratta(
                $tratta_id_esistente,
                $contratto_id,
                $version,
                $carico_str,
                $scarico_str,
                $tipo_tariffa_id,
                $importo_unitario,
                $extra_totale,
                $totale,
                $hash
            );
        }

        continue;
    }

    // Tipo 2: Nuovo viaggio/tratta.
    $insTratta = "
      INSERT INTO tratte
        (subvettore_id, merce, caricatore, proprietario_merce, tipo_tariffa_id, tariffa, extra, totale, hash, version)
      VALUES
        (" . sql_num($subvettore_id) . ",
         NULL, NULL, NULL,
         " . $tipo_tariffa_sql . ",
         " . sql_num($importo_unitario) . ",
         " . sql_num($extra_totale) . ",
         " . sql_num($totale) . ",
         " . sql_quote($hash) . ",
         1)
      ON DUPLICATE KEY UPDATE id = LAST_INSERT_ID(id)
    ";
    sc_exec_sql($insTratta, "pigliacelli");

    sc_lookup(lastId, "SELECT LAST_INSERT_ID(), ROW_COUNT()", "pigliacelli");
    if (empty({lastId}) || {lastId[0][0]} === null || {lastId[0][0]} === '') {
        log_export_tratte(
            "ERROR",
            "Impossibile recuperare LAST_INSERT_ID per subvettore " . $subvettore_id .
            ", hash " . $hash .
            ", carico '" . $carico_str .
            "', scarico '" . $scarico_str . "'"
        );
        continue;
    }

    $tratta_id = {lastId[0][0]};
    $row_count = (int){lastId[0][1]};

    if ($row_count !== 1) {
        log_export_tratte(
            "DUPLICATE",
            "Tratta gia' presente o inserita da job concorrente: uso tratta " . $tratta_id .
            " per subvettore " . $subvettore_id .
            ", hash " . $hash .
            ", carico '" . $carico_str .
            "', scarico '" . $scarico_str . "'"
        );
        $contratto_id = contratto_per_assicura($tratta_id, 2, $intestatario_contratto, $subvettore_id);
        if ($contratto_id !== null) {
            assicura_contratto_tratta(
                $tratta_id,
                $contratto_id,
                1,
                $carico_str,
                $scarico_str,
                $tipo_tariffa_id,
                $importo_unitario,
                $extra_totale,
                $totale,
                $hash
            );
        }
        log_tratta_senza_localita($tratta_id, $subvettore_id, $hash, $carico_str, $scarico_str);
        continue;
    }

    // Tipo 2: Nuova tratta — sempre nuovo contratto.
    // Inserisci località con progressivo (ordine preservato)
    $i = 1;
    foreach (split_localita($carico_str) as $loc) {
        $insLoc = "
          INSERT INTO tratte_localita (tratta_id, tipo_tratta, localita, progressivo)
          VALUES (" . sql_num($tratta_id) . ", 'C', " . sql_quote($loc) . ", " . sql_num($i) . ")
        ";
        sc_exec_sql($insLoc, "pigliacelli");
        $i++;
    }

    $i = 1;
    foreach (split_localita($scarico_str) as $loc) {
        $insLoc = "
          INSERT INTO tratte_localita (tratta_id, tipo_tratta, localita, progressivo)
          VALUES (" . sql_num($tratta_id) . ", 'S', " . sql_quote($loc) . ", " . sql_num($i) . ")
        ";
        sc_exec_sql($insLoc, "pigliacelli");
        $i++;
    }

    $pending_nuove_tratte[$subvettore_id][] = (int)$tratta_id;
}

// Fine run: un contratto consolidato per subvettore con variazioni rilevate
foreach ($pending_nuove_tratte as $sub_id => $tratte_ids) {
    $sub_id = (int)$sub_id;
    $intest = isset($intestatari_sub[$sub_id]) ? $intestatari_sub[$sub_id] : ('SUBVETTORE_' . $sub_id);
    consolida_contratto_tipo2_run($sub_id, $intest, $tratte_ids);
}

foreach ($pending_modifiche_tariffa as $sub_id => $tratte_map) {
    $sub_id = (int)$sub_id;
    if (empty($tratte_map)) {
        continue;
    }
    $intest = isset($intestatari_sub[$sub_id]) ? $intestatari_sub[$sub_id] : ('SUBVETTORE_' . $sub_id);
    consolida_contratto_tipo3_run($sub_id, $intest, array_keys($tratte_map));
}

$nuova_sync_data_ora = $fine_sync_data_ora;
if ($ultima_sync_data_ora !== null && $ultima_sync_data_ora > $fine_sync_data_ora) {
    $nuova_sync_data_ora = $ultima_sync_data_ora;
}

sc_exec_sql("
    UPDATE sec_settings
    SET set_value = " . sql_quote($nuova_sync_data_ora) . "
    WHERE set_name = 'sync_date'
", "pigliacelli");

