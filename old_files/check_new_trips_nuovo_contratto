// Scriptcase app: check_new_trips_nuovo_contratto
// A fine job: se ci sono nuove tratte (o modifiche tariffa) per subvettore, crea UN solo
// nuovo contratto che include le tratte del contratto precedente + le variazioni del run.
// Senza mail automatica.
function sql_quote($v) {
    if ($v === null) return "NULL";
    return "'" . str_replace("'", "''", (string)$v) . "'";
}
function sql_num($v) {
    if ($v === null || $v === '') return "NULL";
    return (string)(0 + $v);
}
function split_localita($s) {
    $s = trim((string)$s);
    if ($s === '') return [];

    // Split su "+" con o senza spazi, preservando l'ordine.
    $parts = preg_split('/\s*\+\s*/', $s);

    return array_values(array_filter($parts, fn($x) => $x !== ''));
}

function normalizza_stringa($s) {
    $s = trim((string)$s);
    $s = strtoupper($s);
    $s = preg_replace('/\s+/', ' ', $s);
    return $s;
}

function crea_hash_tratta($carico_str, $scarico_str, $codice_vettore, $importo_unitario) {
    $carichi = [];
    foreach (split_localita($carico_str) as $loc) {
        $carichi[] = normalizza_stringa($loc);
    }

    $scarichi = [];
    foreach (split_localita($scarico_str) as $loc) {
        $scarichi[] = normalizza_stringa($loc);
    }

    $carico_norm  = implode('|', $carichi);
    $scarico_norm = implode('|', $scarichi);
    $vettore      = normalizza_stringa($codice_vettore);
    $importo      = number_format((float)$importo_unitario, 2, '.', '');

    return hash('sha256', $carico_norm . '#' . $scarico_norm . '#' . $vettore . '#' . $importo);
}

function crea_contratto($tipo_contratto_id, $intestatario) {
    sc_exec_sql("
        INSERT INTO contratti
          (tipo_contratto_id, intestatario, stato_contratto_id)
        VALUES
          (" . sql_num($tipo_contratto_id) . ", " . sql_quote($intestatario) . ",
           (SELECT id FROM stati_contratti WHERE nome = 'Da inviare al subvettore' LIMIT 1))
    ", "pigliacelli");

    sc_lookup(lastContrattoId, "SELECT LAST_INSERT_ID()", "pigliacelli");
    if (empty({lastContrattoId})) {
        return null;
    }

    return {lastContrattoId[0][0]};
}

function crea_contratto_subvettore($tipo_contratto_id, $intestatario, $subvettore_id) {
    $contratto_id = crea_contratto($tipo_contratto_id, $intestatario);

    if ($contratto_id === null) {
        return null;
    }

    sc_exec_sql("
        INSERT INTO subvettori_contratti
          (subvettore_id, contratto_id)
        VALUES
          (" . sql_num($subvettore_id) . ", " . sql_num($contratto_id) . ")
    ", "pigliacelli");

    return $contratto_id;
}

function ultimo_contratto_tipo($subvettore_id, $tipo_contratto_id) {
    sc_lookup(rsUlt, "
        SELECT c.id
        FROM contratti c
        INNER JOIN subvettori_contratti sc ON sc.contratto_id = c.id
        WHERE sc.subvettore_id = " . sql_num($subvettore_id) . "
          AND c.tipo_contratto_id = " . sql_num($tipo_contratto_id) . "
        ORDER BY c.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (empty({rsUlt})) {
        return null;
    }
    return (int){rsUlt[0][0]};
}

function tratte_ids_del_contratto($contratto_id) {
    sc_lookup(rsTr, "
        SELECT DISTINCT tratta_id
        FROM contratti_tratte
        WHERE contratto_id = " . sql_num($contratto_id) . "
        ORDER BY tratta_id
    ", "pigliacelli");

    $ids = array();
    if (!empty({rsTr})) {
        foreach ({rsTr} as $row) {
            $ids[] = (int)$row[0];
        }
    }
    return $ids;
}

function carica_carico_scarico_tratta($tratta_id) {
    sc_lookup(rsC, "
        SELECT GROUP_CONCAT(localita ORDER BY progressivo SEPARATOR ' + ')
        FROM tratte_localita
        WHERE tratta_id = " . sql_num($tratta_id) . "
          AND tipo_tratta = 'C'
    ", "pigliacelli");
    sc_lookup(rsS, "
        SELECT GROUP_CONCAT(localita ORDER BY progressivo SEPARATOR ' + ')
        FROM tratte_localita
        WHERE tratta_id = " . sql_num($tratta_id) . "
          AND tipo_tratta = 'S'
    ", "pigliacelli");

    $carico = empty({rsC[0][0]}) ? '' : (string){rsC[0][0]};
    $scarico = empty({rsS[0][0]}) ? '' : (string){rsS[0][0]};
    return array($carico, $scarico);
}

function allega_tratta_a_contratto($contratto_id, $tratta_id) {
    sc_lookup(rsT, "
        SELECT tipo_tariffa_id, tariffa, extra, totale, hash, version
        FROM tratte
        WHERE id = " . sql_num($tratta_id) . "
        LIMIT 1
    ", "pigliacelli");

    if (empty({rsT})) {
        return;
    }

    [$carico, $scarico] = carica_carico_scarico_tratta($tratta_id);
    $version = ({rsT[0][5]} === null || {rsT[0][5]} === '') ? 1 : (int){rsT[0][5]};

    crea_contratto_tratta(
        $tratta_id,
        $contratto_id,
        $version,
        $carico,
        $scarico,
        {rsT[0][0]},
        {rsT[0][1]},
        {rsT[0][2]},
        {rsT[0][3]},
        {rsT[0][4]}
    );
}

/**
 * Fine run: un contratto tipo 2 con tratte del contratto precedente + nuove del run.
 */
function consolida_contratto_tipo2_run($subvettore_id, $intestatario, $nuove_tratte_ids) {
    $nuove_tratte_ids = array_values(array_unique(array_filter(array_map('intval', $nuove_tratte_ids))));
    if (empty($nuove_tratte_ids)) {
        return;
    }

    $tratte_da_includere = $nuove_tratte_ids;
    $contratto_prec_id = ultimo_contratto_tipo($subvettore_id, 2);

    if ($contratto_prec_id !== null) {
        $tratte_prec = tratte_ids_del_contratto($contratto_prec_id);
        $tratte_da_includere = array_values(array_unique(array_merge($tratte_prec, $nuove_tratte_ids)));

        if (count($tratte_da_includere) <= count($tratte_prec)) {
            return;
        }
    }

    $contratto_id = crea_contratto_subvettore(2, $intestatario, $subvettore_id);
    if ($contratto_id === null) {
        return;
    }

    log_export_tratte(
        'NUOVO_CONTRATTO',
        'tipo=2 subvettore=' . (int)$subvettore_id .
        ' contratto=' . (int)$contratto_id .
        ' tratte=' . count($tratte_da_includere) .
        ' nuove_run=' . count($nuove_tratte_ids) .
        ' prec_contratto=' . (int)$contratto_prec_id
    );

    foreach ($tratte_da_includere as $tratta_id) {
        allega_tratta_a_contratto($contratto_id, $tratta_id);
    }
}

/**
 * Fine run: un contratto tipo 3 con tratte del contratto precedente + modificate nel run.
 */
function consolida_contratto_tipo3_run($subvettore_id, $intestatario, $tratte_modificate_ids) {
    $tratte_modificate_ids = array_values(array_unique(array_filter(array_map('intval', $tratte_modificate_ids))));
    if (empty($tratte_modificate_ids)) {
        return;
    }

    $contratto_prec_id = ultimo_contratto_tipo($subvettore_id, 3);
    if ($contratto_prec_id === null) {
        $contratto_prec_id = ultimo_contratto_tipo($subvettore_id, 2);
    }

    $tratte_da_includere = $tratte_modificate_ids;
    if ($contratto_prec_id !== null) {
        $tratte_prec = tratte_ids_del_contratto($contratto_prec_id);
        $tratte_da_includere = array_values(array_unique(array_merge($tratte_prec, $tratte_modificate_ids)));
    }

    $contratto_id = crea_contratto_subvettore(3, $intestatario, $subvettore_id);
    if ($contratto_id === null) {
        return;
    }

    log_export_tratte(
        'NUOVO_CONTRATTO',
        'tipo=3 subvettore=' . (int)$subvettore_id .
        ' contratto=' . (int)$contratto_id .
        ' tratte=' . count($tratte_da_includere) .
        ' modificate_run=' . count($tratte_modificate_ids) .
        ' prec_contratto=' . (int)$contratto_prec_id
    );

    foreach ($tratte_da_includere as $tratta_id) {
        allega_tratta_a_contratto($contratto_id, $tratta_id);
    }
}

/**
 * Solo per assicurare un legame gia esistente (nessuna variazione): riusa il contratto
 * gia collegato alla tratta, senza crearne uno nuovo.
 */
function contratto_per_assicura($tratta_id, $tipo_contratto_id, $intestatario, $subvettore_id) {
    sc_lookup(contrattoTratta, "
        SELECT ct.contratto_id
        FROM contratti_tratte ct
        INNER JOIN contratti c ON c.id = ct.contratto_id
        WHERE ct.tratta_id = " . sql_num($tratta_id) . "
          AND c.tipo_contratto_id = " . sql_num($tipo_contratto_id) . "
        ORDER BY ct.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (!empty({contrattoTratta})) {
        return {contrattoTratta[0][0]};
    }

    sc_lookup(ultimoContratto, "
        SELECT c.id
        FROM contratti c
        INNER JOIN subvettori_contratti sc ON sc.contratto_id = c.id
        WHERE c.tipo_contratto_id = " . sql_num($tipo_contratto_id) . "
          AND c.intestatario = " . sql_quote($intestatario) . "
          AND sc.subvettore_id = " . sql_num($subvettore_id) . "
        ORDER BY c.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (!empty({ultimoContratto})) {
        return {ultimoContratto[0][0]};
    }

    return null;
}

/** Tipo 1: primo contratto quadro per subvettore appena creato (una tantum). */
function recupera_contratto_quadro(&$contratti_batch, $intestatario, $subvettore_id) {
    $key = (string)$subvettore_id . '|1';
    if (isset($contratti_batch[$key])) {
        return $contratti_batch[$key];
    }

    sc_lookup(contrattoEsistente, "
        SELECT c.id
        FROM contratti c
        INNER JOIN subvettori_contratti sc ON sc.contratto_id = c.id
        WHERE c.tipo_contratto_id = 1
          AND c.intestatario = " . sql_quote($intestatario) . "
          AND sc.subvettore_id = " . sql_num($subvettore_id) . "
        ORDER BY c.id DESC
        LIMIT 1
    ", "pigliacelli");

    if (!empty({contrattoEsistente})) {
        $contratti_batch[$key] = {contrattoEsistente[0][0]};
        return $contratti_batch[$key];
    }

    $contratto_id = crea_contratto_subvettore(1, $intestatario, $subvettore_id);
    $contratti_batch[$key] = $contratto_id;
    return $contratto_id;
}

