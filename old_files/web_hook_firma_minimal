            . '<div style="font-size:12px;color:#718096;">Messaggio automatico - non rispondere.</div>'
            . '</td></tr></table></td></tr></table></body></html>';
    }
}

if (!function_exists('wh_send_mail')) {
    function wh_send_mail($to, $subject, $text, $html)
    {
        if (!function_exists('sc_send_mail_api')) {
            wh_log('mail SKIP sc_send_mail_api assente');
            return false;
        }
        global $sett_smtp;
        $sett_smtp = wh_load_smtp();
        try {
            sc_send_mail_api(array_merge($sett_smtp, array(
                'message' => array(
                    'to'      => $to,
                    'subject' => $subject,
                    'text'    => $text,
                    'html'    => $html,
                ),
            )));
            return true;
        } catch (Throwable $e) {
            wh_log('mail EXCEPTION to=' . $to . ' ' . $e->getMessage());
            return false;
        }
    }
}

if (!function_exists('wh_find_contratto')) {
    function wh_find_contratto($workflowId, $signerId)
    {
        $workflowId = trim((string)$workflowId);
        $signerId   = trim((string)$signerId);
        if ($workflowId !== '') {
            $wf = wh_sql($workflowId);
            sc_lookup(rsWf, "SELECT id FROM contratti WHERE easygn_workflow_id = '$wf' LIMIT 1");
            if (!empty({rsWf[0][0]})) {
                return (int){rsWf[0][0]};
            }
        }
        if ($signerId !== '') {
            $sid = wh_sql($signerId);
            sc_lookup(rsMem, "SELECT id FROM contratti WHERE easygn_signer_ids LIKE '%$sid%' LIMIT 1");
            if (!empty({rsMem[0][0]})) {
                return (int){rsMem[0][0]};
            }
        }
        return 0;
    }
}

