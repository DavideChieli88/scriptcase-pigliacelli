/**
 * web_hook_firma - EasyGN / Yousign webhook (versione minimale)
 *
 * Flusso tipo 1 (firma ordinata), 3 callback attesi:
 *   1) member  done -> firmatario ha firmato -> firmato_il + mail committente
 *   2) member  done -> committente ha firmato -> solo log
 *   3) procedure done -> Completato + data_inizio + attiva subvettore + mail credenziali
 *
 * Mapping EasyGN:
 *   member:    body.id = signer UUID (easygn_signer_ids)
 *   procedure: body.id = workflow UUID (easygn_workflow_id)
 *
 * Log: INSERT diretto su sc_log (Guest) + file api_logs/
 */
date_default_timezone_set('Europe/Rome');

// --- 1. Body POST (subito, prima di qualsiasi lookup) ---
$WH_RAW = @file_get_contents('php:' . chr(47) . chr(47) . 'input');
if ($WH_RAW === false) {
    $WH_RAW = '';
}
$GLOBALS['wh_raw_body'] = (string)$WH_RAW;
$WH_METHOD = isset($_SERVER['REQUEST_METHOD']) ? strtoupper((string)$_SERVER['REQUEST_METHOD']) : '?';
$WH_URI    = isset($_SERVER['REQUEST_URI']) ? (string)$_SERVER['REQUEST_URI'] : '';
$WH_IP     = isset($_SERVER['REMOTE_ADDR']) ? (string)$_SERVER['REMOTE_ADDR'] : '';
if (!empty($_SERVER['HTTP_X_FORWARDED_FOR'])) {
    $WH_IP .= ' fwd=' . trim(explode(',', (string)$_SERVER['HTTP_X_FORWARDED_FOR'])[0]);
}

// --- 2. Cartella log (senza lookup DB) ---
$WH_LOG_DIR = defined('__DIR__') ? (__DIR__ . DIRECTORY_SEPARATOR . 'api_logs') : 'api_logs';
if (!is_dir($WH_LOG_DIR)) {
    @mkdir($WH_LOG_DIR, 0755, true);
}
if (!is_dir($WH_LOG_DIR) || !is_writable($WH_LOG_DIR)) {
    $WH_LOG_DIR = sys_get_temp_dir();
}
$WH_EARLY_FILE = $WH_LOG_DIR . DIRECTORY_SEPARATOR . 'early_' . date('d-m-Y') . '.txt';
$WH_LOG_FILE   = $WH_LOG_DIR . DIRECTORY_SEPARATOR . date('d-m-Y') . '.txt';

if (!function_exists('wh_file_log')) {
    function wh_file_log($line)
    {
        global $WH_EARLY_FILE, $WH_LOG_FILE;
        $out = date('H:i:s') . ' ' . (string)$line . "\n";
        @file_put_contents($WH_EARLY_FILE, $out, FILE_APPEND | LOCK_EX);
        @file_put_contents($WH_LOG_FILE, $out, FILE_APPEND | LOCK_EX);
    }
}

if (!function_exists('wh_sc_log_insert')) {
    function wh_sc_log_insert($description)
    {
        global $WH_IP;
        $date = str_replace("'", "''", date('Y-m-d H:i:s'));
        $ip   = str_replace("'", "''", (string)$WH_IP);
        $desc = str_replace("'", "''", (string)$description);
        try {
            sc_exec_sql("
                INSERT INTO sc_log (inserted_date, username, application, creator, ip_user, action, description)
                VALUES ('$date', 'Guest', 'web_hook_firma', 'System', '$ip', 'WEB_HOOK_FIRMA', '$desc')
            ");
        } catch (Throwable $e) {
            wh_file_log('SC_LOG_FAIL ' . $e->getMessage());
        }
    }
}

