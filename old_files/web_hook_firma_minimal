    {
        $t = htmlspecialchars((string)$title, ENT_QUOTES, 'UTF-8');
        $base = rtrim(wh_setting('mail_base_url', ''), '/');
        $logo = ($base !== '' && preg_match('#^https?://#i', $base))
            ? htmlspecialchars($base . '/_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png', ENT_QUOTES, 'UTF-8')
            : '';
        $logoTd = $logo !== '' ? '<td align="right"><img src="' . $logo . '" width="140" alt="Logo" /></td>' : '';
        return '<!DOCTYPE html><html lang="it"><body style="margin:0;background:#eef1f4;font-family:Arial,sans-serif;">'
            . '<table width="100%"><tr><td align="center" style="padding:24px;">'
            . '<table width="600" style="background:#fff;border-radius:8px;"><tr><td style="padding:20px;">'
            . '<table width="100%"><tr><td style="font-size:18px;font-weight:bold;color:#1a3a5c;">' . $t . '</td>' . $logoTd . '</tr></table>'
