if (!function_exists('wh_signer_role')) {
    function wh_signer_role($contrattoId, $signerId)
    {
        $signerId = strtolower(trim((string)$signerId));
        $map = wh_signer_map($contrattoId);
        $firm = strtolower(trim((string)($map['signer_id_firmatario'] ?? '')));
        $comm = strtolower(trim((string)($map['signer_id_committente'] ?? '')));
        if ($firm !== '' && $signerId === $firm) {
            return 'firmatario';
        }
        if ($comm !== '' && $signerId === $comm) {
