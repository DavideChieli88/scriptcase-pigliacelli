}

if (!function_exists('wh_activate_subvettore')) {
    function wh_activate_subvettore($contrattoId)
    {
        $contrattoId = (int)$contrattoId;
        sc_lookup(rsSub, "
            SELECT sc.subvettore_id, s.login_subvettore, s.ragione_sociale,
                   sc.email_firmatario, sc.email_rappresentante,
                   TRIM(CONCAT(COALESCE(sc.nome_firmatario,''), ' ', COALESCE(sc.cognome_firmatario,''))) AS nome
            FROM subvettori_contratti sc
            INNER JOIN subvettori s ON s.id = sc.subvettore_id
            WHERE sc.contratto_id = $contrattoId ORDER BY sc.id ASC LIMIT 1
        ");
        if (empty({rsSub[0][0]})) {
            wh_log('completato: subvettore assente contratto_id=' . $contrattoId);
            return;
        }
        $subId   = (int){rsSub[0][0]};
        $login   = trim((string){rsSub[0][1]});
        $ragione = trim((string){rsSub[0][2]});
        $email   = trim((string){rsSub[0][3]}) !== '' ? trim((string){rsSub[0][3]}) : trim((string){rsSub[0][4]});
        $nome    = trim((string){rsSub[0][5]});
        if ($email === '' || filter_var($email, FILTER_VALIDATE_EMAIL) === false) {
            wh_log('completato: email subvettore assente');
            return;
        }
        $userLogin = '';
        if ($login !== '') {
            $lq = wh_sql($login);
            sc_lookup(rsU, "SELECT login, active, email FROM sec_users WHERE login = '$lq' LIMIT 1");
            if (!empty({rsU[0][0]})) {
                $userLogin = trim((string){rsU[0][0]});
            }
        }
        if ($userLogin === '') {
            sc_lookup(rsU2, "SELECT login FROM sec_users WHERE subvettore_id = $subId LIMIT 1");
            if (!empty({rsU2[0][0]})) {
                $userLogin = trim((string){rsU2[0][0]});
                $login = $userLogin;
            }
        }
        $plain = wh_temp_password();
        $hash  = wh_sql(md5($plain));
        if ($userLogin === '') {
            $login = $email;
            $lq = wh_sql($login);
            $le = wh_sql($email);
            $ln = wh_sql($ragione !== '' ? $ragione : $nome);
            sc_exec_sql("INSERT INTO sec_users (login, pswd, name, email, active, subvettore_id) VALUES ('$lq', '$hash', '$ln', '$le', 'Y', $subId)");
            sc_lookup(rsG, "SELECT login FROM sec_users_groups WHERE login = '$lq' AND group_id = 2 LIMIT 1");
            if (empty({rsG[0][0]})) {
                sc_exec_sql("INSERT INTO sec_users_groups (login, group_id) VALUES ('$lq', 2)");
            }
            sc_exec_sql("UPDATE subvettori SET login_subvettore = '$lq' WHERE id = $subId AND (login_subvettore IS NULL OR login_subvettore = '')");
            wh_log('completato: creato sec_users login=' . $login);
        } else {
            $lq = wh_sql($login);
            sc_exec_sql("UPDATE sec_users SET active = 'Y', pswd = '$hash' WHERE login = '$lq'");
            wh_log('completato: aggiornato sec_users login=' . $login);
        }
        wh_commit();
        $portal = wh_setting('portal_url', wh_setting('app_url', ''));
        $titolo = 'Credenziali area riservata - contratto #' . $contrattoId;
        $display = $ragione !== '' ? $ragione : ($nome !== '' ? $nome : 'Gentile utente');
        $testo = $display . ",\n\nContratto #" . $contrattoId . " completato.\nLogin: " . $login . "\nPassword: " . $plain;
        if ($portal !== '') {
            $testo .= "\nArea: " . $portal;
        }
        $inner = '<p>' . htmlspecialchars($display, ENT_QUOTES, 'UTF-8') . ',</p>'
            . '<p>Contratto <strong>#' . $contrattoId . '</strong> completato.</p>'
            . '<p><strong>Login:</strong> ' . htmlspecialchars($login, ENT_QUOTES, 'UTF-8') . '<br>'
            . '<strong>Password temporanea:</strong> ' . htmlspecialchars($plain, ENT_QUOTES, 'UTF-8') . '</p>';
        if ($portal !== '') {
            $inner .= '<p><a href="' . htmlspecialchars($portal, ENT_QUOTES, 'UTF-8') . '">Area riservata</a></p>';
        }
        if (wh_send_mail($email, $titolo, $testo, wh_mail_layout($titolo, $inner))) {
            wh_log('mail credenziali OK to=' . $email);
        } else {
            wh_log('mail credenziali FAIL to=' . $email);
        }
    }
}

if (!function_exists('wh_json_out')) {
    function wh_json_out(array $payload, $code = 200)
    {
        while (ob_get_level() > 0) {
            ob_end_clean();
        }
        header('Content-Type: application/json; charset=utf-8');
        http_response_code((int)$code);
        echo json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
        exit;
    }
}

// --- 5. Elaborazione webhook (logica core) ---
$mailCommittente = null;
$contrattoId     = 0;
$workflowId      = '';
$signerId        = '';
$statoNome       = null;
$tipo            = '';
$status          = '';

try {
    $json = (string)$GLOBALS['wh_raw_body'];
    $cb   = json_decode($json, true);
    if (!is_array($cb)) {
        wh_log('invalid_json len=' . strlen($json));
        wh_sc_log_insert('SUMMARY invalid_json');
        wh_json_out(array('ok' => true, 'note' => 'invalid_json', 'log_file' => $WH_LOG_FILE));
    }

    $tipo   = strtolower(trim((string)($cb['type'] ?? '')));
    $status = strtolower(trim((string)($cb['status'] ?? '')));
    $signerId    = '';
    $workflowId  = '';
    $lookupWf    = '';

    if ($tipo === 'member' || $tipo === 'signer') {
        $signerId = trim((string)($cb['id'] ?? ''));
    } elseif ($tipo === 'procedure' || $tipo === 'workflow') {
        $workflowId = trim((string)($cb['id'] ?? ''));
        $lookupWf   = $workflowId;
    }

    wh_log('HIT type=' . $tipo . ' status=' . $status . ' signer_id=' . $signerId . ' workflow_id=' . $workflowId);
    $contrattoId = wh_find_contratto($lookupWf, $signerId);
    if ($contrattoId > 0 && $workflowId === '') {
        $workflowId = wh_workflow_id($contrattoId);
    }
    $statoNome = wh_resolve_stato($tipo, $status);

    if ($contrattoId <= 0) {
        wh_log('contratto non trovato signer=' . $signerId . ' wf=' . $workflowId);
    } elseif ($tipo === 'member' || $tipo === 'signer') {
        if ($statoNome === 'Rifiutato') {
            $sid = wh_stato_id('Rifiutato');
            if ($sid > 0) {
                sc_exec_sql("UPDATE contratti SET stato_contratto_id = $sid WHERE id = $contrattoId");
                wh_commit();
            }
            wh_log('member rifiutato contratto_id=' . $contrattoId);
        } elseif (wh_is_done($status)) {
            $role = wh_signer_role($contrattoId, $signerId);
            if ($role === 'committente') {
                wh_log('evento 2/3 committente firmato contratto_id=' . $contrattoId);
            } else {
                wh_log('evento 1/3 vettore firmato contratto_id=' . $contrattoId . ' role=' . $role);
                $now = wh_sql(date('Y-m-d H:i:s'));
                sc_exec_sql("UPDATE contratti SET firmato_il = '$now' WHERE id = $contrattoId");
                wh_commit();
                if ($role === 'firmatario' || $role === 'unknown') {
                    $mailCommittente = wh_send_committente_mail($contrattoId);
                }
            }
        } else {
            wh_log('member status=' . $status . ' ignorato');
        }
    } elseif ($tipo === 'procedure' || $tipo === 'workflow') {
        if ($statoNome === 'Completato') {
            $sidCompletato = wh_stato_id('Completato');
            if ($sidCompletato > 0) {
                sc_lookup(rsWas, "SELECT stato_contratto_id, data_inizio_contratto FROM contratti WHERE id = $contrattoId LIMIT 1");
                $giaCompletato = !empty({rsWas[0][0]}) && (int){rsWas[0][0]} === $sidCompletato;
                $now = wh_sql(date('Y-m-d H:i:s'));
                $extra = (!$giaCompletato && empty({rsWas[0][1]})) ? ", data_inizio_contratto = '$now'" : '';
                sc_exec_sql("UPDATE contratti SET stato_contratto_id = $sidCompletato$extra WHERE id = $contrattoId");
                wh_commit();
                wh_log('evento 3/3 procedura completata contratto_id=' . $contrattoId);
                if (!$giaCompletato) {
                    wh_activate_subvettore($contrattoId);
                }
            }
        } elseif ($statoNome === 'Rifiutato') {
            $sid = wh_stato_id('Rifiutato');
            if ($sid > 0) {
                sc_exec_sql("UPDATE contratti SET stato_contratto_id = $sid WHERE id = $contrattoId");
                wh_commit();
            }
            wh_log('procedure rifiutata contratto_id=' . $contrattoId);
        } else {
            wh_log('procedure status=' . $status . ' ignorato (es. activated)');
        }
    }

    wh_commit();
    $mailJson = $mailCommittente !== null ? json_encode($mailCommittente, JSON_UNESCAPED_UNICODE) : 'null';
    if ($mailJson === false) {
        $mailJson = 'null';
    }
    wh_sc_log_insert(
        'SUMMARY type=' . $tipo . ' status=' . $status
        . ' contratto_id=' . (int)$contrattoId
        . ' workflow_id=' . $workflowId
        . ' signer_id=' . $signerId
        . ' mail_committente=' . $mailJson
    );

    wh_json_out(array(
        'ok'               => true,
        'contratto_id'     => (int)$contrattoId,
        'workflow_id'      => (string)$workflowId,
        'signer_id'        => (string)$signerId,
        'stato'            => $statoNome,
        'mail_committente' => $mailCommittente,
        'log_file'         => $WH_LOG_FILE,
    ));
} catch (Throwable $e) {
    wh_log('EXCEPTION ' . $e->getMessage());
    wh_sc_log_insert('SUMMARY EXCEPTION ' . $e->getMessage());
    wh_json_out(array('ok' => false, 'error' => $e->getMessage(), 'log_file' => $WH_LOG_FILE), 500);
}
