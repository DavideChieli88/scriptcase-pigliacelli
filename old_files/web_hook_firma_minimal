if (!function_exists('wh_is_done')) {
    function wh_is_done($status)
    {
        return in_array(strtolower(trim((string)$status)), array('done', 'completed', 'finished', 'complete', 'signed'), true);
    }
}

if (!function_exists('wh_resolve_stato')) {
    function wh_resolve_stato($tipo, $status)
    {
        $tipo   = strtolower(trim((string)$tipo));
        $status = strtolower(trim((string)$status));
        if ($tipo === 'procedure' || $tipo === 'workflow') {
            if (wh_is_done($status)) {
                return 'Completato';
            }
            $bad = array('refused', 'rejected', 'declined', 'canceled', 'cancelled', 'failed', 'failure', 'expired', 'aborted', 'error');
            return in_array($status, $bad, true) ? 'Rifiutato' : null;
        }
        if ($tipo === 'member' || $tipo === 'signer') {
            if (wh_is_done($status)) {
                return null;
            }
            $ok = array('', 'pending', 'waiting', 'opened', 'started', 'in_progress', 'processing', 'sent', 'notified', 'active', 'created', 'initiated', 'activated');
            return in_array($status, $ok, true) ? null : 'Rifiutato';
        }
        return null;
    }
}

if (!function_exists('wh_send_committente_mail')) {
    function wh_send_committente_mail($contrattoId)
    {
        $result = array('sent' => false, 'reason' => '', 'to' => '', 'link_len' => 0);
        $meta = wh_sign_link_json($contrattoId);
        if (!empty($meta['mail_committente_inviata'])) {
            $result['reason'] = 'gia_inviata';
            return $result;
        }
        $to   = trim((string)($meta['committente_email'] ?? ''));
        $nome = trim((string)($meta['committente_nome'] ?? ''));
        $link = trim((string)($meta['link_committente'] ?? ''));
        $result['to'] = $to;
        $result['link_len'] = strlen($link);
        if ($to === '' || filter_var($to, FILTER_VALIDATE_EMAIL) === false) {
            $result['reason'] = 'committente_email_assente';
            return $result;
        }
        if ($link === '' || !preg_match('#^https?://#i', $link)) {
            $result['reason'] = 'link_committente_assente';
            return $result;
        }
        if ($nome === '') {
            $nome = 'Gentile firmatario';
        }
        $titolo = 'Firma contratto - link di firma digitale (committente)';
        $safeUrl  = htmlspecialchars($link, ENT_QUOTES, 'UTF-8');
        $safeNome = htmlspecialchars($nome, ENT_QUOTES, 'UTF-8');
        $testo = $nome . ",\n\nIl subvettore ha completato la firma. Contratto #" . (int)$contrattoId . ".\n\n" . $link;
        $inner = '<p>' . $safeNome . ',</p><p>Il subvettore ha firmato. Firmi il contratto <strong>#' . (int)$contrattoId . '</strong>.</p>'
            . '<p><a href="' . $safeUrl . '" style="background:#5b2d8e;color:#fff;padding:12px 24px;text-decoration:none;border-radius:6px;">Apri link di firma</a></p>'
            . '<p style="word-break:break-all;"><a href="' . $safeUrl . '">' . $safeUrl . '</a></p>';
        wh_log('mail TRY committente to=' . $to . ' link_len=' . strlen($link));
        if (!wh_send_mail($to, $titolo, $testo, wh_mail_layout($titolo, $inner))) {
            $result['reason'] = 'invio_fallito';
            return $result;
        }
        $meta['mail_committente_inviata'] = 1;
        wh_save_sign_link_json($contrattoId, $meta);
        $result['sent'] = true;
        $result['reason'] = 'ok';
        wh_log('mail committente OK to=' . $to);
        return $result;
    }
}

if (!function_exists('wh_temp_password')) {
    function wh_temp_password()
    {
        $chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%';
        $out = '';
        for ($i = 0; $i < 12; $i++) {
            $out .= $chars[random_int(0, strlen($chars) - 1)];
