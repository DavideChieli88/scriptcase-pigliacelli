/**
 * form_subvettori_mezzi → onAfterUpdate
 * Virtuali: carta_circolazione, autista_id
 */

$mezzoId = (int){id};
$subId   = (int){subvettore_id};

sc_log_add('MEZ_DOCS', "onAfterUpdate START mezzo=$mezzoId sub=$subId");

if ($mezzoId <= 0 || $subId <= 0) {
    sc_error_message("MEZ_DOCS: id mezzo o subvettore mancante.");
} else {

    $login = trim((string)[usr_login]);
    sc_lookup(rsMezLoginU, "
        SELECT login FROM sec_users
        WHERE subvettore_id = $subId
        ORDER BY login LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsMezLoginU[0][0]})) {
        $login = trim((string){rsMezLoginU[0][0]});
    }
    $loginSql = str_replace("'", "''", $login);

    // --- carta circolazione (tipo 22): upsert se file nuovo ---
    $fCarta = trim((string){carta_circolazione});
    sc_log_add('MEZ_DOCS', "FILE carta=[$fCarta]");

    if ($fCarta !== '') {
        $fileSql = str_replace("'", "''", basename($fCarta));
        $scadSql = 'NULL';
        if (isset({scadenza_carta_circolazione})
            && {scadenza_carta_circolazione} !== ''
            && {scadenza_carta_circolazione} !== 'null'
        ) {
            $scadSql = "'" . str_replace("'", "''", (string){scadenza_carta_circolazione}) . "'";
        }

        sc_lookup(rsMezDoc22, "
            SELECT id FROM documenti
            WHERE subvettore_mezzo_id = $mezzoId
              AND tipo_documento_id = 22
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');

        if (!empty({rsMezDoc22[0][0]})) {
            $docId = (int){rsMezDoc22[0][0]};
            sc_exec_sql("
                UPDATE documenti
                SET file = '$fileSql',
                    data_scadenza = $scadSql,
                    stato_documento_id = 1,
                    updated_at = NOW()
                WHERE id = $docId
            ", 'pigliacelli');
            sc_log_add('MEZ_DOCS', "UPDATE 22 $fileSql");
        } else {
            sc_exec_sql("
                INSERT INTO documenti (
                    tipo_documento_id, subvettore_id, subvettore_mezzo_id,
                    login, stato_documento_id, file, data_scadenza
                ) VALUES (
                    22, $subId, $mezzoId, '$loginSql', 1, '$fileSql', $scadSql
                )
            ", 'pigliacelli');
            sc_log_add('MEZ_DOCS', "INSERT 22 $fileSql");
        }
    }

    // --- ponte 1 autista (sempre riallinea) ---
    $autId = isset({autista_id}) ? (int){autista_id} : 0;
    sc_exec_sql("
        DELETE FROM subvettori_autisti_mezzi WHERE mezzo_id = $mezzoId
    ", 'pigliacelli');
    if ($autId > 0) {
        sc_exec_sql("
            INSERT INTO subvettori_autisti_mezzi (subvettore_id, autista_id, mezzo_id)
            VALUES ($subId, $autId, $mezzoId)
        ", 'pigliacelli');
        sc_log_add('MEZ_DOCS', "PONTE autista=$autId mezzo=$mezzoId");
    }

    sc_log_add('MEZ_DOCS', "FINE onAfterUpdate mezzo=$mezzoId");
}
