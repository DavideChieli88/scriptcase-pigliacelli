# Anime TV — environment example
# Copy to .env.local for local overrides (never commit secrets).

VITE_DEBUG=false
VITE_DEFAULT_PROVIDER=animesaturn

# Master switch: register experimental adapter shells (still disabled unless per-adapter ON)
VITE_ENABLE_EXTERNAL_ADAPTERS=true
VITE_ADAPTER_ANIMEUNITY_ENABLED=true
VITE_ADAPTER_ANIMESATURN_ENABLED=true

# Per-adapter opt-in (require master switch above)
VITE_ADAPTER_ALPHA_ENABLED=false
VITE_ADAPTER_BETA_ENABLED=false
VITE_ADAPTER_ANIMESATURN_ENABLED=true
# Optional base URLs for experimental adapters
# VITE_ADAPTER_ALPHA_BASE_URL=https://example.invalid
# VITE_ADAPTER_BETA_BASE_URL=https://example.invalid
# VITE_ADAPTER_ANIMESATURN_BASE_URL=https://www.animesaturn.net

# Default LAN host for saturncdn playlist proxy (TV → PC)
VITE_SATURNCDN_PROXY=http://192.168.68.71:8787/__sc
