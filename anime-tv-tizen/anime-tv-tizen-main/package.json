{
  "name": "anime-tv-tizen",
  "version": "0.1.0",
  "private": true,
  "description": "Personal anime aggregator for Samsung Tizen TV (6.5 / Chromium M85)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:tizen": "bash scripts/package-tizen.sh",
    "install:tizen": "SKIP_BUMP=1 bash scripts/deploy-tizen.sh",
    "deploy:tizen": "bash scripts/deploy-tizen.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
