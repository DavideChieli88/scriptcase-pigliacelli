};

$drawTableHeader = function ($tableY) use ($pdf, $tableX, $colW, $hHeader, $headers) {
    $pdf->SetLineWidth(0.25);
    $pdf->SetFont('Arial', 'B', 8.2);
    $x = $tableX;
    for ($i = 0; $i < count($headers); $i++) {
        $pdf->Rect($x, $tableY, $colW[$i], $hHeader, 'D');
        $pdf->SetXY($x + 0.8, $tableY + 1.7);
        $pdf->MultiCell($colW[$i] - 1.6, 3.3, $headers[$i], 0, 'C', false);
        $pdf->SetXY($x + $colW[$i], $tableY);
        $x += $colW[$i];
    }
    return $tableY + $hHeader;
};

$startTablePage = function ($continuation) use (
    $pdf, $marginL, $marginT, $marginR, $drawPageTitle, $drawTableHeader
) {
    if ($continuation) {
        $pdf->AddPage('L');
    }
    $pdf->SetMargins($marginL, $marginT, $marginR);
    $tableY = $drawPageTitle($continuation);
    return $drawTableHeader($tableY);
};

