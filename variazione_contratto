$formatMoney = function ($value) {
    $value = trim((string)$value);
    if ($value === '') return '';

    $normalized = str_replace(',', '.', $value);
    if (!is_numeric($normalized)) return $value;

    return number_format((float)$normalized, 2, ',', '.');
};

