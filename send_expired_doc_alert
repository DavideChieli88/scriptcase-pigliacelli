if (!function_exists('send_expired_doc_email_pulisci')) {
    function send_expired_doc_email_pulisci($email)
    {
        $email = (string)$email;
        if ($email === '') {
            return '';
        }

        static $utf8_invisibili = array(
            "\xEF\xBB\xBF",
            "\xE2\x80\x8B",
            "\xE2\x80\x8C",
            "\xE2\x80\x8D",
            "\xE2\x81\xA0",
            "\xC2\xAD",
            "\xC2\xA0",
            "\xE2\x80\x89",
            "\xE2\x80\x8E",
            "\xE2\x80\x8F",
        );

        do {
            $prev = $email;
            $email = str_replace($utf8_invisibili, '', $email);
            $email = trim($email);
        } while ($email !== $prev && $email !== '');

        return $email;
    }
}

if (!function_exists('send_expired_doc_email_valida')) {
    function send_expired_doc_email_valida($email)
    {
        $email = send_expired_doc_email_pulisci($email);

        if ($email === '') {
            return false;
        }

        if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
            return false;
        }

        return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
    }
}

if (!function_exists('send_expired_doc_resolve_operator_email')) {
    function send_expired_doc_resolve_operator_email($loginRaw, $emailRaw)
    {
        foreach (array($emailRaw, $loginRaw) as $cand) {
            $clean = strtolower(send_expired_doc_email_pulisci($cand));
            if (send_expired_doc_email_valida($clean)) {
                return $clean;
            }
        }
        return '';
    }
}

if (!function_exists('send_expired_doc_resolve_email')) {
    function send_expired_doc_resolve_email($login, $emailSub)
    {
        $emailSub = send_expired_doc_email_pulisci($emailSub);
        if (send_expired_doc_email_valida($emailSub)) {
            return strtolower($emailSub);
        }

        $login = send_expired_doc_email_pulisci($login);
        if ($login === '') {
            return '';
        }

        $loginSql = str_replace("'", "''", $login);
        sc_lookup(rsExpUserMail, "
            SELECT COALESCE(email, '')
            FROM sec_users
            WHERE login = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsExpUserMail[0][0]}) && send_expired_doc_email_valida({rsExpUserMail[0][0]})) {
            return trim((string){rsExpUserMail[0][0]});
        }

        if (send_expired_doc_email_valida($login)) {
            return $login;
        }

        return '';
    }
}

if (!function_exists('send_expired_doc_load_operatori')) {
  /** @return array{emails: string[], logins: string[]} */
    function send_expired_doc_load_operatori()
    {
        $destinatari = array();
        $logins = array();
        $emailPlaceholder = array('admin@admin.com', 'admin@localhost', 'admin@example.com');

        sc_lookup(rsExpOps, "
            SELECT DISTINCT su.login, su.email
            FROM sec_users su
            INNER JOIN sec_users_groups sug ON sug.login = su.login
            WHERE su.active = 'Y'
              AND su.login IS NOT NULL
              AND TRIM(su.login) <> ''
              AND su.email IS NOT NULL
              AND TRIM(su.email) <> ''
              AND sug.group_id IN (1, 3)
        ", 'pigliacelli');

        if (!empty({rsExpOps})) {
            foreach ({rsExpOps} as $row) {
                $loginOpRaw = trim((string)$row[0]);
                $loginOp    = send_expired_doc_email_pulisci($loginOpRaw);

                if ($loginOp === '' || strcasecmp($loginOp, 'Guest') === 0) {
                    continue;
                }

                $emailDest = send_expired_doc_resolve_operator_email($loginOpRaw, $row[1]);
                if ($emailDest === '' || in_array($emailDest, $emailPlaceholder, true)) {
                    continue;
                }

                $destinatari[] = $emailDest;
                $logins[] = $loginOpRaw;
            }
        }

        return array(
            'emails' => array_values(array_unique($destinatari)),
            'logins' => array_values(array_unique($logins)),
        );
    }
}

if (!function_exists('send_expired_doc_mail_setting')) {
    function send_expired_doc_mail_setting($name, $default = '')
    {
        $key = 'sett_' . $name;
        if (isset($_SESSION[$key])) {
            return (string)$_SESSION[$key];
        }
        $safeName = str_replace("'", "''", trim((string)$name));
        sc_lookup(rsExpMailSet, "SELECT set_value FROM sec_settings WHERE set_name = '$safeName' LIMIT 1", 'pigliacelli');
        if (isset({rsExpMailSet[0][0]})) {
            return (string){rsExpMailSet[0][0]};
        }
        return $default;
    }
}

if (!function_exists('send_expired_doc_mail_logo_read_embed')) {
    function send_expired_doc_mail_logo_read_embed($anchorFile = null)
    {
        $rel = '_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png';
        $dir = realpath(dirname($anchorFile ?: __FILE__));
        for ($i = 0; $i < 12 && $dir; $i++) {
            $try = $dir . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $rel);
            if (is_readable($try)) {
                $bin = @file_get_contents($try);
                if ($bin !== false && $bin !== '' && strlen($bin) < 500000) {
                    return 'data:image/png;base64,' . base64_encode($bin);
                }
            }
            $p = dirname($dir);
            if ($p === $dir) {
                break;
            }
            $dir = $p;
        }
        return '';
    }
}

if (!function_exists('send_expired_doc_mail_logo_src')) {
    function send_expired_doc_mail_logo_src()
    {
        $embed = send_expired_doc_mail_logo_read_embed();
        if ($embed !== '') {
            return $embed;
        }
        $base = rtrim(trim(send_expired_doc_mail_setting('mail_base_url', '')), '/');
        if ($base !== '' && preg_match('#^https?://#i', $base) === 1) {
            return htmlspecialchars(
                $base . '/_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png',
                ENT_QUOTES,
                'UTF-8'
            );
        }
        return '';
    }
}

