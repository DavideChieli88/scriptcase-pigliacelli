if (!function_exists('send_expired_doc_build_mails')) {
    /**
     * @return array{htmlSub: string, textSub: string, htmlOp: string, textOp: string, subjectSub: string, subjectOp: string}
     */
    function send_expired_doc_build_mails($documento_id, $nome_documento, $data_scadenza, $subvettore_label, $ragione_label, $loginUrl)
    {
        $mailLogoUrl = send_expired_doc_mail_logo_src();
        $salutoSub = send_expired_doc_saluto_sub($ragione_label);
        $safeSalutoSub = htmlspecialchars($salutoSub, ENT_QUOTES, 'UTF-8');
        $subEtichetta = $ragione_label !== 'n/d'
            ? $ragione_label . ' (ID ' . $subvettore_label . ')'
            : 'ID ' . $subvettore_label;

        $subjectSub = 'Documento scaduto — ' . $nome_documento . ' (#' . (int)$documento_id . ')';
        $subjectOp  = $subjectSub;

        $textSub = $salutoSub . ",\n\n"
            . "il seguente documento è scaduto:\n\n"
            . "Tipo documento: $nome_documento\n"
            . "Riferimento: #" . (int)$documento_id . "\n"
            . "Scaduto il: $data_scadenza\n\n"
            . "Si richiede di effettuare l'upload di una versione aggiornata.\n"
            . ($loginUrl !== '' ? "Per procedere, acceda alla sua area riservata:\n$loginUrl\n\n" : '')
            . "Messaggio automatico — non rispondere.";

        $textOp = "Gentile operatore,\n\n"
            . "il seguente documento è scaduto:\n\n"
            . "Tipo documento: $nome_documento\n"
            . "Riferimento: #" . (int)$documento_id . "\n"
            . "Subvettore: $subEtichetta\n"
            . "Scaduto il: $data_scadenza\n\n"
            . ($loginUrl !== '' ? "Per verificarlo, acceda all'area di gestione:\n$loginUrl\n\n" : '')
            . "Messaggio automatico — non rispondere.";

        $infoSub = send_expired_doc_mail_detail_line('Tipo documento', $nome_documento)
            . send_expired_doc_mail_detail_line('Riferimento', '#' . (int)$documento_id)
            . send_expired_doc_mail_detail_line('Scaduto il', $data_scadenza);

        $innerSub = '<p style="margin:0 0 12px;">' . $safeSalutoSub . ',</p>'
            . '<p style="margin:0 0 12px;">il seguente documento è scaduto. '
            . 'La preghiamo di accedere alla sua <strong>area riservata</strong> per caricare una versione aggiornata.</p>'
            . send_expired_doc_mail_info_box($infoSub)
            . send_expired_doc_mail_btn($loginUrl, 'Accedi all\'area riservata');

        $infoOp = send_expired_doc_mail_detail_line('Tipo documento', $nome_documento)
            . send_expired_doc_mail_detail_line('Riferimento', '#' . (int)$documento_id)
            . send_expired_doc_mail_detail_line('Subvettore', $subEtichetta)
            . send_expired_doc_mail_detail_line('Scaduto il', $data_scadenza);

        $safeSub = htmlspecialchars($subEtichetta, ENT_QUOTES, 'UTF-8');
        $innerOp = '<p style="margin:0 0 12px;">Gentile operatore,</p>'
            . '<p style="margin:0 0 12px;">il documento del subvettore <strong>' . $safeSub . '</strong> '
            . 'è scaduto. Verificare in griglia documenti.</p>'
            . send_expired_doc_mail_info_box($infoOp)
            . send_expired_doc_mail_btn($loginUrl, 'Accedi all\'area di gestione');

        return array(
            'htmlSub'    => send_expired_doc_mail_layout('Documento scaduto', $innerSub, $mailLogoUrl),
            'textSub'    => $textSub,
            'htmlOp'     => send_expired_doc_mail_layout('Documento scaduto', $innerOp, $mailLogoUrl),
            'textOp'     => $textOp,
            'subjectSub' => $subjectSub,
            'subjectOp'  => $subjectOp,
        );
    }
}

$loginUrl = isset($_SESSION['sett_login_url']) ? trim((string)$_SESSION['sett_login_url']) : '';
if ($loginUrl === '') {
    $loginUrl = rtrim(trim(send_expired_doc_mail_setting('login_url', '')), '/');
}

$oggi = date('Y-m-d');
$notifyExpire = date('Y-m-d H:i:s', strtotime('+30 days'));
$notifyFrom = 'admin';
$notifyProfile = 'Pigliacelli_Notifications';

sc_log_add('MAIL_DOCS_EXPIRE', 'START job scadenze oggi=' . $oggi);

$operatori = send_expired_doc_load_operatori();
$operatorEmails = $operatori['emails'];
$operatorLogins = $operatori['logins'];

$sql = "
    SELECT
        d.id,
        td.nome,
        d.data_scadenza,
        d.login,
        d.subvettore_id,
        COALESCE(s.login_subvettore, '') AS email_sub,
        COALESCE(s.ragione_sociale, '') AS ragione_sociale,
        d.stato_documento_id
    FROM documenti d
    INNER JOIN tipi_documento td
        ON td.id = d.tipo_documento_id
    LEFT JOIN subvettori s
        ON s.id = d.subvettore_id
    WHERE d.data_scadenza IS NOT NULL
      AND DATE(d.data_scadenza) <= '$oggi'
      AND d.stato_documento_id IN (2, 3)
    ORDER BY d.data_scadenza, d.id
";

sc_select(ds, $sql, 'pigliacelli');

$statLetti = 0;
$statMailSub = 0;
$statMailOp = 0;
$statNotifSub = 0;
$statNotifOp = 0;
$statSkipEmail = 0;

if ({ds} !== false) {
    while (!{ds}->EOF) {
        $statLetti++;
        $documento_id    = (int){ds}->fields[0];
        $nome_documento  = trim((string){ds}->fields[1]);
        $data_scadenza   = date('d/m/Y', strtotime((string){ds}->fields[2]));
        $login           = trim((string){ds}->fields[3]);
        $subvettore_id   = (int){ds}->fields[4];
        $emailSub        = trim((string){ds}->fields[5]);
        $ragione_sociale = trim((string){ds}->fields[6]);

        $emailSubvettore = send_expired_doc_resolve_email($login, $emailSub);

        $subvettore_label = $subvettore_id > 0 ? (string)$subvettore_id : 'n/d';
        $ragione_label = $ragione_sociale !== '' ? $ragione_sociale : 'n/d';

        $mails = send_expired_doc_build_mails(
            $documento_id,
            $nome_documento,
            $data_scadenza,
            $subvettore_label,
            $ragione_label,
            $loginUrl
        );

        $titoloSub = $mails['subjectSub'];
        $titoloOp  = $mails['subjectOp'];
        $messaggioSub = $mails['textSub'];
        $messaggioOp  = $mails['textOp'];
        $htmlSub = $mails['htmlSub'];
        $htmlOp  = $mails['htmlOp'];

        if ($login !== '' && function_exists('sc_send_notification')) {
            try {
                sc_send_notification(array(
                    'title'        => $titoloSub,
                    'message'      => $messaggioSub,
                    'destiny_type' => 'user',
                    'to'           => $login,
                    'from'         => $notifyFrom,
                    'link'         => '',
                    'dtexpire'     => $notifyExpire,
                    'profile'      => $notifyProfile,
                ));
                $statNotifSub++;
                sc_log_add('MAIL_DOCS_EXPIRE', "notifica SC sub OK doc=$documento_id to=$login");
            } catch (Throwable $e) {
                sc_log_add('MAIL_DOCS_EXPIRE', "notifica SC sub ERRORE doc=$documento_id — " . $e->getMessage());
            }
        } else {
            sc_log_add('MAIL_DOCS_EXPIRE', "notifica SC sub SKIP doc=$documento_id login vuoto");
        }

        if (!empty($operatorLogins) && function_exists('sc_send_notification')) {
            try {
                sc_send_notification(array(
                    'title'        => $titoloOp,
                    'message'      => $messaggioOp,
                    'destiny_type' => 'user',
                    'to'           => implode(';', $operatorLogins),
                    'from'         => $notifyFrom,
                    'link'         => '',
                    'dtexpire'     => $notifyExpire,
                    'profile'      => $notifyProfile,
                ));
                $statNotifOp++;
                sc_log_add('MAIL_DOCS_EXPIRE', "notifica SC operatori OK doc=$documento_id");
            } catch (Throwable $e) {
                sc_log_add('MAIL_DOCS_EXPIRE', "notifica SC operatori ERRORE doc=$documento_id — " . $e->getMessage());
            }
        }

        if ($emailSubvettore !== '') {
            try {
                $mailOk = sc_send_mail_api(array_merge([sett_smtp], array(
                    'message' => array(
                        'html'    => $htmlSub,
                        'text'    => $messaggioSub,
                        'to'      => $emailSubvettore,
                        'subject' => $titoloSub,
                    ),
                )));
                if ($mailOk === false || $mailOk === null) {
                    sc_log_add('MAIL_DOCS_EXPIRE', "mail sub FALLITA doc=$documento_id dest=$emailSubvettore");
                } else {
                    $statMailSub++;
                    sc_log_add('MAIL_DOCS_EXPIRE', "mail sub OK doc=$documento_id dest=$emailSubvettore");
                }
            } catch (Throwable $e) {
                sc_log_add('MAIL_DOCS_EXPIRE', "mail sub ERRORE doc=$documento_id — " . $e->getMessage());
            }
        } else {
            $statSkipEmail++;
            sc_log_add(
                'MAIL_DOCS_EXPIRE',
                "mail sub SKIP doc=$documento_id — email assente subvettore_id=$subvettore_id login=[$login]"
            );
        }

        foreach ($operatorEmails as $emailOp) {
            try {
                $mailOkOp = sc_send_mail_api(array_merge([sett_smtp], array(
                    'message' => array(
                        'html'    => $htmlOp,
                        'text'    => $messaggioOp,
                        'to'      => $emailOp,
                        'subject' => $titoloOp,
                    ),
                )));
                if ($mailOkOp === false || $mailOkOp === null) {
                    sc_log_add('MAIL_DOCS_EXPIRE', "mail operatore FALLITA doc=$documento_id dest=$emailOp");
                } else {
                    $statMailOp++;
                }
            } catch (Throwable $e) {
                sc_log_add('MAIL_DOCS_EXPIRE', "mail operatore ERRORE doc=$documento_id dest=$emailOp — " . $e->getMessage());
            }
        }

        {ds}->MoveNext();
    }

    {ds}->Close();
} else {
    sc_log_add('MAIL_DOCS_EXPIRE', 'ERRORE query documenti in scadenza');
}

sc_log_add(
    'MAIL_DOCS_EXPIRE',
    'END letti=' . $statLetti
    . ' mail_sub=' . $statMailSub
    . ' mail_op=' . $statMailOp
    . ' notif_sub=' . $statNotifSub
    . ' notif_op=' . $statNotifOp
    . ' skip_email_sub=' . $statSkipEmail
    . ' operatori=' . count($operatorLogins)
);
