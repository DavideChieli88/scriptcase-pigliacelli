/**
 * form_subvettori_autisti_wizard → onAfterUpdate
 * Upsert per tipo (patente/cqc entrambi tipo 19: 1ª e 2ª riga).
 */

$autistaId = (int){id};
$subId     = (int){subvettore_id};

sc_log_add('AUT_DOCS', "onAfterUpdate START autista=$autistaId sub=$subId");

if ($autistaId <= 0 || $subId <= 0) {
    sc_error_message("AUT_DOCS: id autista o subvettore mancante.");
} else {

    $login = trim((string)[usr_login]);
    sc_lookup(rsLoginAnyU, "
        SELECT login FROM sec_users
        WHERE subvettore_id = $subId
        ORDER BY login LIMIT 1
    ", 'pigliacelli');
    if (!empty({rsLoginAnyU[0][0]})) {
        $login = trim((string){rsLoginAnyU[0][0]});
    }
    $loginSql = str_replace("'", "''", $login);

    $fPatente  = trim((string){patente});
    $fCqc      = trim((string){cqc});
    $fFormaz   = trim((string){formazione_sicurezza});
    $fIdoneita = trim((string){idoneita_sanitaria});
    $fDpi      = trim((string){dpi_iii_categoria});
    $fPermesso = trim((string){permesso_soggiorno});

    sc_log_add('AUT_DOCS', "FILES patente=[$fPatente] cqc=[$fCqc] form=[$fFormaz] idoneita=[$fIdoneita] dpi=[$fDpi] perm=[$fPermesso]");

    // helper locale: upsert 1 doc per tipo (escluso 19 gestito a parte)
    // --- 18 ---
    if ($fIdoneita !== '') {
        $fileSql = str_replace("'", "''", basename($fIdoneita));
        sc_lookup(rsU18, "
            SELECT id FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 18
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsU18[0][0]})) {
            sc_exec_sql("UPDATE documenti SET file='$fileSql', stato_documento_id=1, updated_at=NOW() WHERE id=" . (int){rsU18[0][0]}, 'pigliacelli');
        } else {
            sc_exec_sql("
                INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
                VALUES (18, $subId, $autistaId, '$loginSql', 1, '$fileSql')
            ", 'pigliacelli');
        }
        sc_log_add('AUT_DOCS', "UPSERT 18 $fileSql");
    }

    // --- 19 patente = prima riga ---
    if ($fPatente !== '') {
        $fileSql = str_replace("'", "''", basename($fPatente));
        $scadSql = 'NULL';
        if (isset({scadenza_patente}) && {scadenza_patente} !== '' && {scadenza_patente} !== 'null') {
            $scadSql = "'" . str_replace("'", "''", (string){scadenza_patente}) . "'";
        }
        sc_lookup(rsU19a, "
            SELECT id FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 19
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsU19a[0][0]})) {
            sc_exec_sql("UPDATE documenti SET file='$fileSql', data_scadenza=$scadSql, stato_documento_id=1, updated_at=NOW() WHERE id=" . (int){rsU19a[0][0]}, 'pigliacelli');
        } else {
            sc_exec_sql("
                INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
                VALUES (19, $subId, $autistaId, '$loginSql', 1, '$fileSql', $scadSql)
            ", 'pigliacelli');
        }
        sc_log_add('AUT_DOCS', "UPSERT 19 patente $fileSql");
    }

    // --- 19 cqc = seconda riga (o nuova se manca) ---
    if ($fCqc !== '') {
        $fileSql = str_replace("'", "''", basename($fCqc));
        $scadSql = 'NULL';
        if (isset({scadenza_cqc}) && {scadenza_cqc} !== '' && {scadenza_cqc} !== 'null') {
            $scadSql = "'" . str_replace("'", "''", (string){scadenza_cqc}) . "'";
        }
        $idPrima = 0;
        sc_lookup(rsU19first, "
            SELECT id FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 19
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsU19first[0][0]})) {
            $idPrima = (int){rsU19first[0][0]};
        }
        sc_lookup(rsU19b, "
            SELECT id FROM documenti
            WHERE subvettore_autista_id = $autistaId
              AND tipo_documento_id = 19
              AND id <> $idPrima
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsU19b[0][0]})) {
            sc_exec_sql("UPDATE documenti SET file='$fileSql', data_scadenza=$scadSql, stato_documento_id=1, updated_at=NOW() WHERE id=" . (int){rsU19b[0][0]}, 'pigliacelli');
        } else {
            sc_exec_sql("
                INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file, data_scadenza)
                VALUES (19, $subId, $autistaId, '$loginSql', 1, '$fileSql', $scadSql)
            ", 'pigliacelli');
        }
        sc_log_add('AUT_DOCS', "UPSERT 19 cqc $fileSql");
    }

    // --- 20 ---
    if ($fFormaz !== '') {
        $fileSql = str_replace("'", "''", basename($fFormaz));
        sc_lookup(rsU20, "
            SELECT id FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 20
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsU20[0][0]})) {
            sc_exec_sql("UPDATE documenti SET file='$fileSql', stato_documento_id=1, updated_at=NOW() WHERE id=" . (int){rsU20[0][0]}, 'pigliacelli');
        } else {
            sc_exec_sql("
                INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
                VALUES (20, $subId, $autistaId, '$loginSql', 1, '$fileSql')
            ", 'pigliacelli');
        }
        sc_log_add('AUT_DOCS', "UPSERT 20 $fileSql");
    }

    // --- 21 ---
    if ($fDpi !== '') {
        $fileSql = str_replace("'", "''", basename($fDpi));
        sc_lookup(rsU21, "
            SELECT id FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 21
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsU21[0][0]})) {
            sc_exec_sql("UPDATE documenti SET file='$fileSql', stato_documento_id=1, updated_at=NOW() WHERE id=" . (int){rsU21[0][0]}, 'pigliacelli');
        } else {
            sc_exec_sql("
                INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
                VALUES (21, $subId, $autistaId, '$loginSql', 1, '$fileSql')
            ", 'pigliacelli');
        }
        sc_log_add('AUT_DOCS', "UPSERT 21 $fileSql");
    }

    // --- 30 ---
    if ($fPermesso !== '') {
        $fileSql = str_replace("'", "''", basename($fPermesso));
        sc_lookup(rsU30, "
            SELECT id FROM documenti
            WHERE subvettore_autista_id = $autistaId AND tipo_documento_id = 30
            ORDER BY id ASC LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsU30[0][0]})) {
            sc_exec_sql("UPDATE documenti SET file='$fileSql', stato_documento_id=1, updated_at=NOW() WHERE id=" . (int){rsU30[0][0]}, 'pigliacelli');
        } else {
            sc_exec_sql("
                INSERT INTO documenti (tipo_documento_id, subvettore_id, subvettore_autista_id, login, stato_documento_id, file)
                VALUES (30, $subId, $autistaId, '$loginSql', 1, '$fileSql')
            ", 'pigliacelli');
        }
        sc_log_add('AUT_DOCS', "UPSERT 30 $fileSql");
    }

    sc_log_add('AUT_DOCS', "FINE onAfterUpdate");
}
