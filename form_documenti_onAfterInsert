if (!function_exists('form_docs_email_pulisci')) {
    function form_docs_email_pulisci($email)
    {
        $email = trim((string)$email);
        if ($email === '') {
            return '';
        }

        $original = $email;
        static $utf8_invisibili = array(
            "\xEF\xBB\xBF",
            "\xE2\x80\x8B",
            "\xE2\x80\x8C",
            "\xE2\x80\x8D",
            "\xE2\x81\xA0",
            "\xC2\xAD",
        );

        do {
            $prev = $email;
            foreach ($utf8_invisibili as $seq) {
                if ($seq !== '' && strpos($email, $seq) === 0) {
                    $email = substr($email, strlen($seq));
                }
            }
            $email = trim($email);
            foreach ($utf8_invisibili as $seq) {
                $len = strlen($seq);
                if ($len > 0 && strlen($email) >= $len && substr($email, -$len) === $seq) {
                    $email = substr($email, 0, -$len);
                }
            }
            $email = trim($email);
        } while ($email !== $prev && $email !== '');

        if ($email !== $original
            && filter_var($original, FILTER_VALIDATE_EMAIL)
            && !filter_var($email, FILTER_VALIDATE_EMAIL)
        ) {
            return trim($original);
        }

        return $email;
    }
}

if (!function_exists('form_docs_email_valida')) {
    function form_docs_email_valida($email)
    {
        $email = form_docs_email_pulisci($email);
        if ($email === '') {
            return false;
        }
        if (strpos($email, ';') !== false || strpos($email, ',') !== false || strpos($email, ' ') !== false) {
            return false;
        }
        return filter_var($email, FILTER_VALIDATE_EMAIL) !== false;
    }
}

if (!function_exists('form_docs_resolve_destinatario')) {
    /** Da sec_users.login (lookup form) → email valida per SMTP. */
    function form_docs_resolve_destinatario($loginField)
    {
        $loginField = trim((string)$loginField);
        if ($loginField === '') {
            return '';
        }
        if (form_docs_email_valida($loginField)) {
            return $loginField;
        }

        $loginSql = str_replace("'", "''", $loginField);
        sc_lookup(rsFdUser, "
            SELECT email, subvettore_id
            FROM sec_users
            WHERE login = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');

        if (!empty({rsFdUser[0][0]})) {
            $emailUser = trim((string){rsFdUser[0][0]});
            if (form_docs_email_valida($emailUser)) {
                return $emailUser;
            }
            $subId = (int){rsFdUser[0][1]};
            if ($subId > 0) {
                sc_lookup(rsFdSub, "
                    SELECT login_subvettore
                    FROM subvettori
                    WHERE id = $subId
                    LIMIT 1
                ", 'pigliacelli');
                if (!empty({rsFdSub[0][0]})) {
                    $emailSub = trim((string){rsFdSub[0][0]});
                    if (form_docs_email_valida($emailSub)) {
                        return $emailSub;
                    }
                }
            }
        }

        sc_lookup(rsFdUserEmail, "
            SELECT email
            FROM sec_users
            WHERE email = '$loginSql'
            LIMIT 1
        ", 'pigliacelli');
        if (!empty({rsFdUserEmail[0][0]}) && form_docs_email_valida({rsFdUserEmail[0][0]})) {
            return trim((string){rsFdUserEmail[0][0]});
        }

        return '';
    }
}

if (!function_exists('form_docs_mail_setting')) {
    function form_docs_mail_setting($name, $default = '')
    {
        $key = 'sett_' . $name;
        if (isset($_SESSION[$key])) {
            return (string)$_SESSION[$key];
        }
        $safeName = str_replace("'", "''", trim((string)$name));
        sc_lookup(rsFdMailSet, "SELECT set_value FROM sec_settings WHERE set_name = '$safeName' LIMIT 1");
        if (isset({rsFdMailSet[0][0]})) {
            return (string){rsFdMailSet[0][0]};
        }
        return $default;
    }
}

if (!function_exists('form_docs_mail_logo_read_embed')) {
    function form_docs_mail_logo_read_embed($anchorFile = null)
    {
        $rel = '_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png';
        $dir = realpath(dirname($anchorFile ?: __FILE__));
        for ($i = 0; $i < 12 && $dir; $i++) {
            $try = $dir . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $rel);
            if (is_readable($try)) {
                $bin = @file_get_contents($try);
                if ($bin !== false && $bin !== '' && strlen($bin) < 500000) {
                    return 'data:image/png;base64,' . base64_encode($bin);
                }
            }
            $p = dirname($dir);
            if ($p === $dir) {
                break;
            }
            $dir = $p;
        }
        return '';
    }
}

if (!function_exists('form_docs_mail_logo_src')) {
    function form_docs_mail_logo_src()
    {
        $embed = form_docs_mail_logo_read_embed();
        if ($embed !== '') {
            return $embed;
        }
        $base = rtrim(trim(form_docs_mail_setting('mail_base_url', '')), '/');
        if ($base !== '' && preg_match('#^https?://#i', $base) === 1) {
            return htmlspecialchars(
                $base . '/_lib/img/grp__NM__menu_img__NM__logo-pigliacelli-bg.png',
                ENT_QUOTES,
                'UTF-8'
            );
        }
        return '';
    }
}

