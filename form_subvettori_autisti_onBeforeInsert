/**
 * form_subvettori_autisti onBeforeInsert
 * Detail wizard: subvettore_id dalla relazione master-detail; subvettore_contratto_id senza valore.
 */

$subId = 0;
if (isset({subvettore_id}) && (int){subvettore_id} > 0) {
    $subId = (int){subvettore_id};
}
if ($subId <= 0 && isset([subvettoreId]) && (int)[subvettoreId] > 0) {
    $subId = (int)[subvettoreId];
}

if ($subId <= 0) {
    sc_error_message("Subvettore non identificato.");
    sc_error_exit();
}

{subvettore_id} = $subId;
{subvettore_contratto_id} = 'null';
